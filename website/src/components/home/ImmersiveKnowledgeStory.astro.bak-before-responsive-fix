<section
  class="knowledge-story"
  data-knowledge-story
  aria-labelledby="knowledge-story-title"
>
  <div class="knowledge-story-sticky">
    <div class="story-atmosphere" aria-hidden="true">
      <span class="story-orb story-orb-a"></span>
      <span class="story-orb story-orb-b"></span>
      <span class="story-grid"></span>
    </div>

    <div class="container story-layout">
      <div class="story-copy">
        <div class="eyebrow story-eyebrow">
          Do caderno ao conhecimento vivo
        </div>

        <h2 id="knowledge-story-title">
          O que você anota não precisa
          <span>desaparecer com o tempo.</span>
        </h2>

        <div class="story-stage-copy" aria-live="polite">
          <div class="story-copy-item is-active" data-copy-stage="0">
            <span class="story-step">01</span>
            <h3>Você anota para não esquecer.</h3>
            <p>
              Muita gente começa pelo caderno: registra uma ideia,
              uma explicação ou algo importante que acabou de aprender.
              O problema é que, com o tempo, essas páginas costumam ficar
              fechadas e raramente são revisitadas.
            </p>
          </div>

          <div class="story-copy-item" data-copy-stage="1">
            <span class="story-step">02</span>
            <h3>No digital, o problema pode continuar.</h3>
            <p>
              Quando as anotações saem do papel, muitas vezes acabam
              espalhadas entre vários blocos de notas, arquivos, conversas
              e aplicativos. A informação existe, mas fica difícil de
              reencontrar e aproveitar.
            </p>
          </div>

          <div class="story-copy-item" data-copy-stage="2">
            <span class="story-step">03</span>
            <h3>O EVRYLUX reúne e organiza o que importa.</h3>
            <p>
              Conceitos, perguntas e relações deixam de ficar isolados.
              O Cérebro ajuda a transformar registros soltos em uma estrutura
              conectada, pesquisável e fácil de retomar quando você precisar.
            </p>
          </div>

          <div class="story-copy-item" data-copy-stage="3">
            <span class="story-step">04</span>
            <h3>O conhecimento volta para você.</h3>
            <p>
              Perguntas mantêm visível o que ainda precisa ser entendido,
              enquanto revisões ajudam você a retomar aquilo que realmente
              vale a pena lembrar — em vez de depender da sorte de reencontrar
              uma anotação antiga.
            </p>
          </div>

          <div class="story-copy-item" data-copy-stage="4">
            <span class="story-step">05</span>
            <h3>O que você está explorando continua com você.</h3>
            <p>
              Seu histórico pode crescer sem perder o contexto. A arquitetura
              do EVRYLUX foi pensada para manter esse conhecimento organizado,
              disponível para revisão e protegido por criptografia durante
              o armazenamento e a sincronização.
            </p>
          </div>
        </div>

        <div class="story-progress" aria-hidden="true">
          <span class="story-progress-line">
            <span class="story-progress-fill"></span>
          </span>

          <div class="story-progress-dots">
            <span class="is-active"></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
          </div>
        </div>
      </div>

      <div class="story-visual-wrap" aria-hidden="true">
        <div class="story-depth-plane story-depth-plane-back"></div>
        <div class="story-depth-plane story-depth-plane-mid"></div>

        <div class="story-visual">
          <div class="story-core-glow"></div>

          <svg
            class="story-network"
            viewBox="0 0 620 620"
            role="presentation"
          >
            <defs>
              <filter id="storyGlow" x="-120%" y="-120%" width="340%" height="340%">
                <feGaussianBlur stdDeviation="8" result="blur" />
                <feMerge>
                  <feMergeNode in="blur" />
                  <feMergeNode in="SourceGraphic" />
                </feMerge>
              </filter>

              <filter id="storySoftGlow" x="-100%" y="-100%" width="300%" height="300%">
                <feGaussianBlur stdDeviation="4" result="blur" />
                <feMerge>
                  <feMergeNode in="blur" />
                  <feMergeNode in="SourceGraphic" />
                </feMerge>
              </filter>
            </defs>

            <g class="story-rings">
              <circle cx="310" cy="310" r="198" />
              <circle cx="310" cy="310" r="138" />
              <circle cx="310" cy="310" r="82" />
            </g>

            <g class="story-paths">
              <path id="storyPathIn" d="M56 410 C130 350, 204 315, 310 310" />
              <path id="storyPathConcept" d="M310 310 C358 243, 420 194, 505 183" />
              <path id="storyPathQuestion" d="M310 310 C390 316, 453 361, 524 416" />
              <path id="storyPathReview" d="M310 310 C278 398, 230 458, 154 493" />
              <path id="storyPathContext" d="M310 310 C246 248, 195 206, 125 187" />
              <path id="storyPathSide" d="M125 187 C230 138, 390 118, 505 183" />
              <path id="storyPathLower" d="M154 493 C282 548, 424 523, 524 416" />
            </g>

            <g class="story-signals" filter="url(#storySoftGlow)">
              <circle class="story-signal signal-a" r="5">
                <animateMotion dur="3.8s" repeatCount="indefinite">
                  <mpath href="#storyPathIn" />
                </animateMotion>
              </circle>

              <circle class="story-signal signal-b" r="4">
                <animateMotion begin="1.3s" dur="4.8s" repeatCount="indefinite">
                  <mpath href="#storyPathConcept" />
                </animateMotion>
              </circle>

              <circle class="story-signal signal-c" r="4">
                <animateMotion begin="2.4s" dur="5.2s" repeatCount="indefinite">
                  <mpath href="#storyPathQuestion" />
                </animateMotion>
              </circle>

              <circle class="story-signal signal-d" r="3.5">
                <animateMotion begin=".8s" dur="5.7s" repeatCount="indefinite">
                  <mpath href="#storyPathReview" />
                </animateMotion>
              </circle>
            </g>

            <g class="story-nodes">
              <g class="story-node story-node-entry" data-node-stage="0">
                <circle class="node-aura" cx="56" cy="410" r="28" />
                <circle class="node-shell" cx="56" cy="410" r="13" />
                <circle class="node-core" cx="56" cy="410" r="5" />
              </g>

              <g class="story-node story-node-center" data-node-stage="1" filter="url(#storyGlow)">
                <circle class="center-wave center-wave-a" cx="310" cy="310" r="56" />
                <circle class="center-wave center-wave-b" cx="310" cy="310" r="39" />
                <circle class="node-aura" cx="310" cy="310" r="46" />
                <circle class="node-shell" cx="310" cy="310" r="22" />
                <circle class="node-core" cx="310" cy="310" r="8" />
              </g>

              <g class="story-node" data-node-stage="2">
                <circle class="node-aura" cx="505" cy="183" r="28" />
                <circle class="node-shell" cx="505" cy="183" r="13" />
                <circle class="node-core" cx="505" cy="183" r="5" />
              </g>

              <g class="story-node" data-node-stage="2">
                <circle class="node-aura" cx="125" cy="187" r="24" />
                <circle class="node-shell" cx="125" cy="187" r="11" />
                <circle class="node-core" cx="125" cy="187" r="4" />
              </g>

              <g class="story-node" data-node-stage="3">
                <circle class="node-aura" cx="524" cy="416" r="27" />
                <circle class="node-shell" cx="524" cy="416" r="12" />
                <circle class="node-core" cx="524" cy="416" r="4.5" />
              </g>

              <g class="story-node" data-node-stage="4">
                <circle class="node-aura" cx="154" cy="493" r="25" />
                <circle class="node-shell" cx="154" cy="493" r="11" />
                <circle class="node-core" cx="154" cy="493" r="4" />
              </g>
            </g>
          </svg>

          <div class="story-idea-chip" data-story-card="0">
            <span class="chip-dot"></span>
            <span>📓 Anotação no caderno</span>
          </div>

          <div class="story-floating-card story-card-concept" data-story-card="1">
            <span class="story-card-icon">🗒️</span>
            <div>
              <strong>Anotações espalhadas</strong>
              <span>Blocos, arquivos e ideias difíceis de reencontrar</span>
            </div>
          </div>

          <div class="story-floating-card story-card-context" data-story-card="2">
            <span class="story-card-icon">🧠</span>
            <div>
              <strong>Conhecimento organizado</strong>
              <span>Conceitos e relações no mesmo contexto</span>
            </div>
          </div>

          <div class="story-floating-card story-card-question" data-story-card="3">
            <span class="story-card-icon">?</span>
            <div>
              <strong>Perguntas e revisões</strong>
              <span>O que importa volta para você</span>
            </div>
          </div>

          <div class="story-floating-card story-card-review" data-story-card="4">
            <span class="story-card-icon">🔐</span>
            <div>
              <strong>Histórico protegido</strong>
              <span>Organização, continuidade e criptografia</span>
            </div>
          </div>

          <div class="story-final-label">
            <span class="story-final-pulse"></span>
            <strong>Seu conhecimento deixa de ser esquecido e passa a continuar com você.</strong>
          </div>
        </div>
      </div>
    </div>

    <div class="story-scroll-hint" aria-hidden="true">
      <span>Role para acompanhar</span>
      <span class="story-scroll-line"></span>
    </div>
  </div>
</section>

<script>
  const stories =
    document.querySelectorAll<HTMLElement>(
      '[data-knowledge-story]',
    );

  stories.forEach((story) => {
    const copyItems =
      Array.from(
        story.querySelectorAll<HTMLElement>(
          '[data-copy-stage]',
        ),
      );

    const progressDots =
      Array.from(
        story.querySelectorAll<HTMLElement>(
          '.story-progress-dots span',
        ),
      );

    const cards =
      Array.from(
        story.querySelectorAll<HTMLElement>(
          '[data-story-card]',
        ),
      );

    const nodeGroups =
      Array.from(
        story.querySelectorAll<SVGGElement>(
          '[data-node-stage]',
        ),
      );

    const visual =
      story.querySelector<HTMLElement>(
        '.story-visual',
      );

    const finalLabel =
      story.querySelector<HTMLElement>(
        '.story-final-label',
      );

    let currentStage = -1;
    let ticking = false;

    const clamp = (
      value: number,
      min: number,
      max: number,
    ) =>
      Math.min(
        max,
        Math.max(
          min,
          value,
        ),
      );

    const updateStage = (
      stage: number,
    ) => {
      if (
        stage ===
        currentStage
      ) {
        return;
      }

      currentStage =
        stage;

      copyItems.forEach(
        (
          item,
          index,
        ) => {
          item.classList.toggle(
            'is-active',
            index ===
              stage,
          );
        },
      );

      progressDots.forEach(
        (
          dot,
          index,
        ) => {
          dot.classList.toggle(
            'is-active',
            index <=
              stage,
          );
        },
      );

      cards.forEach(
        (
          card,
        ) => {
          const cardStage =
            Number(
              card.dataset.storyCard ??
                0,
            );

          card.classList.toggle(
            'is-visible',
            cardStage ===
              stage,
          );
        },
      );

      nodeGroups.forEach(
        (
          node,
        ) => {
          const nodeStage =
            Number(
              node.dataset.nodeStage ??
                0,
            );

          node.classList.toggle(
            'is-visible',
            nodeStage <=
              stage,
          );
        },
      );

      story.dataset.stage =
        String(
          stage,
        );
    };

    const updateScroll = () => {
      ticking =
        false;

      const rect =
        story.getBoundingClientRect();

      const scrollable =
        Math.max(
          1,
          rect.height -
            window.innerHeight,
        );

      const progress =
        clamp(
          -rect.top /
            scrollable,
          0,
          1,
        );

      const stage =
        Math.min(
          4,
          Math.floor(
            progress *
              5,
          ),
        );

      story.style.setProperty(
        '--story-progress',
        progress.toFixed(
          4,
        ),
      );

      story.style.setProperty(
        '--story-depth',
        `${(
          progress *
          42
        ).toFixed(
          2,
        )}px`,
      );

      story.style.setProperty(
        '--story-rotate',
        `${(
          (progress -
            .5) *
          5
        ).toFixed(
          2,
        )}deg`,
      );

      finalLabel?.classList.toggle(
        'is-visible',
        progress >=
          .94,
      );

      updateStage(
        stage,
      );
    };

    const requestScrollUpdate =
      () => {
        if (ticking) {
          return;
        }

        ticking =
          true;

        requestAnimationFrame(
          updateScroll,
        );
      };

    const updatePointer =
      (
        event: PointerEvent,
      ) => {
        if (!visual) {
          return;
        }

        const rect =
          visual.getBoundingClientRect();

        const x =
          clamp(
            (
              event.clientX -
              rect.left
            ) /
              rect.width -
              .5,
            -.5,
            .5,
          );

        const y =
          clamp(
            (
              event.clientY -
              rect.top
            ) /
              rect.height -
              .5,
            -.5,
            .5,
          );

        story.style.setProperty(
          '--pointer-x',
          `${(
            x *
            16
          ).toFixed(
            2,
          )}px`,
        );

        story.style.setProperty(
          '--pointer-y',
          `${(
            y *
            12
          ).toFixed(
            2,
          )}px`,
        );
      };

    const resetPointer =
      () => {
        story.style.setProperty(
          '--pointer-x',
          '0px',
        );

        story.style.setProperty(
          '--pointer-y',
          '0px',
        );
      };

    window.addEventListener(
      'scroll',
      requestScrollUpdate,
      {
        passive: true,
      },
    );

    window.addEventListener(
      'resize',
      requestScrollUpdate,
      {
        passive: true,
      },
    );

    visual?.addEventListener(
      'pointermove',
      updatePointer,
      {
        passive: true,
      },
    );

    visual?.addEventListener(
      'pointerleave',
      resetPointer,
      {
        passive: true,
      },
    );

    updateScroll();
  });
</script>

<style>
  .knowledge-story {
    --story-progress: 0;
    --story-depth: 0px;
    --story-rotate: 0deg;
    --pointer-x: 0px;
    --pointer-y: 0px;
    position: relative;
    height: 510vh;
    min-height: 3400px;
  }

  .knowledge-story-sticky {
    position: sticky;
    top: 0;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
    background:
      linear-gradient(
        180deg,
        rgba(247,251,244,.98),
        rgba(242,248,238,.96)
      );
  }

  .story-atmosphere {
    position: absolute;
    inset: 0;
    z-index: -2;
    pointer-events: none;
  }

  .story-grid {
    position: absolute;
    inset: 0;
    opacity: .24;
    background-image:
      linear-gradient(
        rgba(95,157,89,.055) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(95,157,89,.055) 1px,
        transparent 1px
      );
    background-size: 84px 84px;
    mask-image:
      radial-gradient(
        circle at 66% 50%,
        black,
        transparent 72%
      );
  }

  .story-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(2px);
    will-change: transform;
  }

  .story-orb-a {
    width: 520px;
    height: 520px;
    right: -170px;
    top: -180px;
    background:
      radial-gradient(
        circle,
        rgba(159,211,149,.19),
        rgba(223,241,218,.08) 62%,
        transparent 72%
      );
    transform:
      translate3d(
        calc(var(--pointer-x) * .32),
        calc(var(--pointer-y) * .32),
        0
      );
  }

  .story-orb-b {
    width: 360px;
    height: 360px;
    left: 28%;
    bottom: -190px;
    background:
      radial-gradient(
        circle,
        rgba(95,157,89,.085),
        transparent 68%
      );
    transform:
      translate3d(
        calc(var(--pointer-x) * -.18),
        calc(var(--pointer-y) * -.18),
        0
      );
  }

  .story-layout {
    width: 100%;
    display: grid;
    grid-template-columns:
      minmax(330px,.82fr)
      minmax(520px,1.18fr);
    align-items: center;
    gap: clamp(46px,7vw,110px);
  }

  .story-copy {
    position: relative;
    z-index: 8;
  }

  .story-eyebrow {
    width: max-content;
    margin-bottom: 20px;
  }

  .story-copy > h2 {
    max-width: 620px;
    margin: 0;
    font-size:
      clamp(
        40px,
        4.55vw,
        66px
      );
    line-height: 1.02;
    letter-spacing: -.052em;
    text-wrap: balance;
  }

  .story-copy > h2 span {
    display: block;
    color: var(--primary-deep);
  }

  .story-stage-copy {
    position: relative;
    min-height: 205px;
    margin-top: 34px;
  }

  .story-copy-item {
    position: absolute;
    inset: 0;
    max-width: 590px;
    opacity: 0;
    transform:
      translate3d(
        0,
        18px,
        0
      );
    pointer-events: none;
    transition:
      opacity .42s ease,
      transform .55s cubic-bezier(.22,1,.36,1);
  }

  .story-copy-item.is-active {
    opacity: 1;
    transform:
      translate3d(
        0,
        0,
        0
      );
  }

  .story-step {
    display: inline-flex;
    min-width: 36px;
    min-height: 26px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgba(255,255,255,.66);
    color: var(--primary-deep);
    font-size: 10px;
    font-weight: 850;
  }

  .story-copy-item h3 {
    max-width: 540px;
    margin: 14px 0 0;
    font-size: 21px;
    line-height: 1.25;
    letter-spacing: -.025em;
  }

  .story-copy-item p {
    max-width: 560px;
    margin: 11px 0 0;
    color: var(--text-soft);
    font-size: 14px;
    line-height: 1.78;
  }

  .story-progress {
    margin-top: 34px;
    max-width: 500px;
  }

  .story-progress-line {
    position: relative;
    display: block;
    height: 2px;
    overflow: hidden;
    border-radius: 999px;
    background:
      rgba(95,157,89,.12);
  }

  .story-progress-fill {
    position: absolute;
    inset: 0;
    transform-origin: left center;
    transform:
      scaleX(
        var(--story-progress)
      );
    background:
      linear-gradient(
        90deg,
        var(--primary),
        var(--primary-strong)
      );
    transition:
      transform .12s linear;
  }

  .story-progress-dots {
    margin-top: 11px;
    display: flex;
    justify-content: space-between;
  }

  .story-progress-dots span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background:
      rgba(95,157,89,.15);
    transition:
      transform .25s ease,
      background .25s ease,
      box-shadow .25s ease;
  }

  .story-progress-dots span.is-active {
    background:
      var(--primary-strong);
    transform:
      scale(1.14);
    box-shadow:
      0 0 0 5px
      rgba(159,211,149,.12);
  }

  .story-visual-wrap {
    position: relative;
    min-height: 680px;
    display: grid;
    place-items: center;
    perspective: 1200px;
  }

  .story-depth-plane {
    position: absolute;
    left: 50%;
    top: 50%;
    border: 1px solid rgba(95,157,89,.08);
    border-radius: 42px;
    background: rgba(255,255,255,.22);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    pointer-events: none;
    will-change: transform;
  }

  .story-depth-plane-back {
    width: 72%;
    height: 72%;
    opacity: .42;
    transform:
      translate3d(
        -50%,
        -50%,
        calc(-150px - var(--story-depth))
      )
      rotateX(10deg)
      rotateZ(-5deg)
      scale(.92);
  }

  .story-depth-plane-mid {
    width: 82%;
    height: 82%;
    opacity: .62;
    transform:
      translate3d(
        -50%,
        -50%,
        calc(-75px - var(--story-depth))
      )
      rotateX(6deg)
      rotateZ(3deg)
      scale(.96);
  }

  .story-visual {
    position: relative;
    width:
      min(
        100%,
        680px
      );
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    transform-style: preserve-3d;
    will-change: transform;
    transform:
      translate3d(
        var(--pointer-x),
        var(--pointer-y),
        var(--story-depth)
      )
      rotateY(
        var(--story-rotate)
      );
    transition:
      transform .18s linear;
  }

  .story-core-glow {
    position: absolute;
    width: 62%;
    height: 62%;
    border-radius: 50%;
    background:
      radial-gradient(
        circle,
        rgba(159,211,149,.18),
        rgba(223,241,218,.08) 48%,
        transparent 72%
      );
    filter: blur(7px);
    transform:
      translateZ(-20px)
      scale(
        calc(
          .88 +
          var(--story-progress) * .2
        )
      );
  }

  .story-network {
    position: relative;
    z-index: 3;
    width: 100%;
    overflow: visible;
    filter:
      drop-shadow(
        0 24px 48px
        rgba(54,92,51,.06)
      );
  }

  .story-rings circle {
    fill: none;
    stroke:
      rgba(95,157,89,.075);
    stroke-width: 1;
    stroke-dasharray: 4 12;
    transform-origin: center;
    animation:
      storyRingRotate 28s
      linear infinite;
  }

  .story-rings circle:nth-child(2) {
    animation-duration: 22s;
    animation-direction: reverse;
  }

  .story-rings circle:nth-child(3) {
    animation-duration: 17s;
  }

  .story-paths path {
    fill: none;
    stroke:
      rgba(95,157,89,.25);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-dasharray: 9 11;
    vector-effect: non-scaling-stroke;
