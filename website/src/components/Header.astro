<script>
  import {
    supabase as headerLogoutSupabase,
  } from '../lib/supabase';

  const headerLogoutButton =
    document.querySelector<HTMLButtonElement>(
      '#header-logout-button',
    );

  function hideLegacyColabLogout() {
    if (
      !window.location.pathname.startsWith(
        '/colab',
      )
    ) {
      return;
    }

    const candidates =
      Array.from(
        document.querySelectorAll<
          HTMLAnchorElement |
          HTMLButtonElement
        >(
          'a, button, [role="button"]',
        ),
      );

    candidates.forEach(
      (
        element,
      ) => {
        if (
          element.id ===
          'header-logout-button'
        ) {
          return;
        }

        const label =
          (
            element.textContent ||
            ''
          )
            .replace(
              /\s+/g,
              ' ',
            )
            .trim()
            .toLocaleLowerCase(
              'pt-BR',
            );

        const ariaLabel =
          (
            element.getAttribute(
              'aria-label',
            ) ||
            ''
          )
            .trim()
            .toLocaleLowerCase(
              'pt-BR',
            );

        if (
          label === 'sair' ||
          ariaLabel === 'sair' ||
          ariaLabel === 'sair da conta'
        ) {
          element.classList.add(
            'evrylux-legacy-logout-hidden',
          );

          element.setAttribute(
            'aria-hidden',
            'true',
          );

          element.setAttribute(
            'tabindex',
            '-1',
          );
        }
      },
    );
  }

  function updateHeaderLogoutVisibility(
    authenticated: boolean,
  ) {
    headerLogoutButton?.classList.toggle(
      'header-hidden',
      !authenticated,
    );

    if (
      authenticated
    ) {
      hideLegacyColabLogout();
    }
  }

  async function loadHeaderLogoutState() {
    try {
      const {
        data: {
          session,
        },
      } =
        await headerLogoutSupabase.auth.getSession();

      updateHeaderLogoutVisibility(
        Boolean(
          session,
        ),
      );
    } catch (
      error
    ) {
      console.warn(
        '[EVRYLUX] Não foi possível verificar o logout do Header:',
        error,
      );

      updateHeaderLogoutVisibility(
        false,
      );
    }
  }

  headerLogoutButton?.addEventListener(
    'click',
    async () => {
      if (
        !headerLogoutButton ||
        headerLogoutButton.disabled
      ) {
        return;
      }

      headerLogoutButton.disabled =
        true;

      headerLogoutButton.classList.add(
        'is-loading',
      );

      try {
        const {
          error,
        } =
          await headerLogoutSupabase.auth.signOut();

        if (
          error
        ) {
          throw error;
        }

        window.location.assign(
          '/login',
        );
      } catch (
        error
      ) {
        console.error(
          '[EVRYLUX] Não foi possível sair da conta:',
          error,
        );

        headerLogoutButton.disabled =
          false;

        headerLogoutButton.classList.remove(
          'is-loading',
        );
      }
    },
  );

  await loadHeaderLogoutState();

  hideLegacyColabLogout();

  const legacyLogoutObserver =
    new MutationObserver(
      () => {
        hideLegacyColabLogout();
      },
    );

  legacyLogoutObserver.observe(
    document.body,
    {
      childList: true,
      subtree: true,
    },
  );

  headerLogoutSupabase.auth.onAuthStateChange(
    (
      _event,
      session,
    ) => {
      updateHeaderLogoutVisibility(
        Boolean(
          session,
        ),
      );
    },
  );

  window.addEventListener(
    'pagehide',
    () => {
      legacyLogoutObserver.disconnect();
    },
    {
      once: true,
    },
  );
</script>


<script>
