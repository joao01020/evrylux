---
const nav = [
  { label: 'Produto', href: '/' },
  { label: 'Colaboradores', href: '/contributors' },
  { label: 'Download', href: '/download' },
  { label: 'Planos', href: '/plans' },
  { label: 'Suporte', href: '/support' },
  { label: 'Roadmap', href: '/roadmap' },
  { label: 'Licença', href: '/license' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a
      class="brand"
      href="/"
      aria-label="EVRYLUX"
    >
      <span class="brand-mark">
        <img
          src="/branding/evrylux-logo.png"
          alt="EVRYLUX"
          class="brand-logo"
        />
      </span>

      <span class="brand-name">
        EVRYLUX
      </span>
    </a>

    <nav
      class="nav"
      aria-label="Navegação principal"
    >
      {
        nav.map(
          (item) => (
            <a href={item.href}>
              {item.label}
            </a>
          ),
        )
      }
    </nav>

    <div class="header-actions">
      <a
        id="support-admin-notification"
        class="admin-notification header-hidden"
        href="/colab/support"
        aria-label="Novas mensagens de suporte"
        title="Suporte"
      >
        <span class="notification-icon">
          S
        </span>

        <span
          id="support-admin-count"
          class="notification-count header-hidden"
        >
          0
        </span>
      </a>

      <a
        id="demo-admin-notification"
        class="admin-notification header-hidden"
        href="/colab/demo"
        aria-label="Novas inscrições no demo"
        title="Fila do Demo"
      >
        <span class="notification-icon">
          D
        </span>

        <span
          id="demo-admin-count"
          class="notification-count header-hidden"
        >
          0
        </span>
      </a>

      <a
        class="github"
        href="https://github.com/joao01020/ghost-core"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub do projeto EVRYLUX"
      >
        <span>
          GitHub
        </span>

        <span
          class="external-arrow"
          aria-hidden="true"
        >
          ↗
        </span>
      </a>

      <a
        id="collaborator-access"
        class="collaborator-access"
        href="/login"
        aria-label="Entrar na área de colaboradores"
      >
        <span
          id="collaborator-access-icon"
          class="collaborator-access-icon"
          aria-hidden="true"
        >
          ↗
        </span>

        <span id="collaborator-access-label">
          Entrar
        </span>
      </a>
    </div>
  </div>
</header>

<script>
  import {
    supabase,
  } from '../lib/supabase';

  import {
    isCurrentUserAdmin,
  } from '../lib/colab-admin';

  import {
    getUnreadDemoCount,
  } from '../lib/demo-waitlist';

  import {
    getUnreadSupportCount,
    subscribeAdminSupportNotifications,
  } from '../lib/support';

  const collaboratorAccess =
    document.querySelector<HTMLAnchorElement>(
      '#collaborator-access',
    );

  const collaboratorAccessLabel =
    document.querySelector<HTMLElement>(
      '#collaborator-access-label',
    );

  const collaboratorAccessIcon =
    document.querySelector<HTMLElement>(
      '#collaborator-access-icon',
    );

  const demoNotification =
    document.querySelector<HTMLAnchorElement>(
      '#demo-admin-notification',
    );

  const demoCount =
    document.querySelector<HTMLElement>(
      '#demo-admin-count',
    );

  const supportNotification =
    document.querySelector<HTMLAnchorElement>(
      '#support-admin-notification',
    );

  const supportCount =
    document.querySelector<HTMLElement>(
      '#support-admin-count',
    );

  let supportNotifications:
    ReturnType<
      typeof subscribeAdminSupportNotifications
    > | null =
      null;

  function updateCollaboratorAccess(
    authenticated: boolean,
  ) {
    if (
      !collaboratorAccess ||
      !collaboratorAccessLabel ||
      !collaboratorAccessIcon
    ) {
      return;
    }

    if (authenticated) {
      collaboratorAccess.href =
        '/colab';

      collaboratorAccessLabel.textContent =
        'Minha área';

      collaboratorAccessIcon.textContent =
        '●';

      collaboratorAccess.classList.add(
        'authenticated',
      );

      return;
    }

    collaboratorAccess.href =
      '/login';

    collaboratorAccessLabel.textContent =
      'Entrar';

    collaboratorAccessIcon.textContent =
      '↗';

    collaboratorAccess.classList.remove(
      'authenticated',
    );
  }

  async function refreshSupportCount() {
    if (
      !supportNotification
    ) {
      return;
    }

    const count =
      await getUnreadSupportCount();

    supportNotification.classList.remove(
      'header-hidden',
    );

    if (
      count > 0 &&
      supportCount
    ) {
      supportCount.textContent =
        count > 99
          ? '99+'
          : String(
              count,
            );

      supportCount.classList.remove(
        'header-hidden',
      );
    } else {
      supportCount?.classList.add(
        'header-hidden',
      );
    }
  }

  async function loadAdminNotifications() {
    try {
      const admin =
        await isCurrentUserAdmin();

      if (!admin) {
        return;
      }

      if (
        demoNotification
      ) {
        demoNotification.classList.remove(
          'header-hidden',
        );

        const demo =
          await getUnreadDemoCount();

        if (
          demo > 0 &&
          demoCount
        ) {
          demoCount.textContent =
            demo > 99
              ? '99+'
              : String(
                  demo,
                );

          demoCount.classList.remove(
            'header-hidden',
          );
        }
      }

      await refreshSupportCount();

      supportNotifications =
        subscribeAdminSupportNotifications(
          async () => {
            await refreshSupportCount();
          },
        );
    } catch (error) {
      console.warn(
        '[EVRYLUX] Não foi possível carregar notificações administrativas:',
        error,
      );
    }
  }

  async function loadCollaboratorState() {
    try {
      const {
        data: {
          session,
        },
      } =
        await supabase.auth.getSession();

      const authenticated =
        Boolean(
          session,
        );

      updateCollaboratorAccess(
        authenticated,
      );

      if (authenticated) {
        await loadAdminNotifications();
      }
    } catch (error) {
      console.warn(
        '[EVRYLUX] Não foi possível verificar a sessão:',
        error,
      );

      updateCollaboratorAccess(
        false,
      );
    }
  }

  await loadCollaboratorState();

  supabase.auth.onAuthStateChange(
    async (
      _event,
      session,
    ) => {
      const authenticated =
        Boolean(
          session,
        );

      updateCollaboratorAccess(
        authenticated,
      );

      if (authenticated) {
        await loadAdminNotifications();
      }
    },
  );

  window.addEventListener(
    'pagehide',
    () => {
      void supportNotifications?.disconnect();
    },
  );
</script>

<style>
  .header-hidden {
    display: none !important;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding: 14px 0;
    background: rgba(247,251,244,.78);
    border-bottom: 1px solid rgba(65,104,62,.08);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }

  .brand {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 850;
    letter-spacing: -.02em;
  }

  .brand-mark {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: 11px;
    background: linear-gradient(145deg,var(--primary-soft),var(--primary));
  }

  .brand-logo {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
    padding: 4px;
  }

  .brand-name {
    color: var(--text);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1px;
  }

  .nav a {
    padding: 10px 8px;
    border-radius: 11px;
    color: var(--text-soft);
    font-size: 12px;
    font-weight: 650;
    transition: color .2s ease, background .2s ease;
  }

  .nav a:hover {
    color: var(--text);
    background: rgba(255,255,255,.72);
  }

  .header-actions {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .admin-notification {
    position: relative;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 11px;
    background: rgba(255,255,255,.72);
  }

  .notification-icon {
    width: 20px;
    height: 20px;
    display: grid;
    place-items: center;
    border-radius: 7px;
    background: var(--primary-soft);
    color: var(--primary-deep);
    font-size: 8px;
    font-weight: 900;
  }

  .notification-count {
    position: absolute;
    top: -5px;
    right: -5px;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    display: grid;
    place-items: center;
    border: 2px solid var(--bg);
    border-radius: 999px;
    background: var(--primary-deep);
    color: #fff;
    font-size: 8px;
    font-weight: 850;
  }

  .github {
    min-height: 42px;
    padding: 0 10px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border-radius: 12px;
    color: var(--primary-deep);
    font-size: 13px;
    font-weight: 700;
  }

  .external-arrow {
    font-size: 13px;
  }

  .collaborator-access {
    min-height: 42px;
    padding: 0 13px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1px solid rgba(65,104,62,.14);
    border-radius: 13px;
    background: rgba(255,255,255,.76);
    color: var(--text);
    box-shadow: 0 7px 22px rgba(54,92,51,.045);
    font-size: 13px;
    font-weight: 750;
  }

  .collaborator-access-icon {
    width: 21px;
    height: 21px;
    display: grid;
    place-items: center;
    border-radius: 7px;
    background: var(--primary-soft);
    color: var(--primary-deep);
    font-size: 11px;
    font-weight: 900;
  }

  .collaborator-access.authenticated {
    background: linear-gradient(180deg,rgba(223,241,218,.9),rgba(204,232,197,.86));
    color: var(--primary-deep);
  }

  @media (max-width: 1180px) {
    .brand-name {
      display: none;
    }

    .github span:first-child {
      display: none;
    }
  }

  @media (max-width: 980px) {
    .nav {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .site-header {
      padding: 11px 0;
    }

    .github {
      width: 38px;
      padding: 0;
      justify-content: center;
    }

    .collaborator-access {
      padding: 0 10px;
    }
  }
</style>
