    document.querySelector<HTMLElement>(
      '#notification-popover-demo-copy',
    );

  let currentSupportUnread =
    0;

  let currentDemoUnread =
    0;

  let currentTaskUnread:
    MyRoadmapTask[] =
      [];

  let currentUserId:
    string | null =
      null;

  let currentUserIsAdmin =
    false;

  let supportNotifications:
    ReturnType<
      typeof subscribeAdminSupportNotifications
    > | null =
      null;

  let disconnectTaskAssignments:
    (() => Promise<void>) | null =
      null;

  let globalPresenceDisconnect:
    (() => Promise<void>) | null =
      null;

  let audioUnlocked =
    false;

  function unlockNotificationAudio() {
    audioUnlocked =
      true;
  }

  window.addEventListener(
    'pointerdown',
    unlockNotificationAudio,
    {
      once: true,
      passive: true,
    },
  );

  window.addEventListener(
    'keydown',
    unlockNotificationAudio,
    {
      once: true,
    },
  );

  function playTaskNotificationSound() {
    if (
      !audioUnlocked
    ) {
      return;
    }

    try {
      const AudioContextCtor =
        window.AudioContext ||
        (
          window as typeof window & {
            webkitAudioContext?:
              typeof AudioContext;
          }
        ).webkitAudioContext;

      if (
        !AudioContextCtor
      ) {
        return;
      }

      const context =
        new AudioContextCtor();

      const oscillator =
        context.createOscillator();

      const gain =
        context.createGain();

      oscillator.type =
        'sine';

      oscillator.frequency.setValueAtTime(
        720,
        context.currentTime,
      );

      oscillator.frequency.exponentialRampToValueAtTime(
        940,
        context.currentTime +
          .12,
      );

      gain.gain.setValueAtTime(
        .0001,
        context.currentTime,
      );

      gain.gain.exponentialRampToValueAtTime(
        .09,
        context.currentTime +
          .02,
      );

      gain.gain.exponentialRampToValueAtTime(
        .0001,
        context.currentTime +
          .18,
      );

      oscillator.connect(
        gain,
      );

      gain.connect(
        context.destination,
      );

      oscillator.start();
      oscillator.stop(
        context.currentTime +
          .19,
      );

      window.setTimeout(
        () => {
          void context.close();
        },
        260,
      );
    } catch {
      // O navegador pode bloquear áudio até a primeira interação.
    }
  }

  function updateCollaboratorAccess(
    authenticated: boolean,
    avatarUrl:
      string | null =
        null,
  ) {
    if (
      !collaboratorAccess ||
      !collaboratorAccessLabel ||
      !collaboratorAccessIcon ||
      !collaboratorAccessAvatar ||
      !collaboratorAccessFallbackIcon
    ) {
      return;
    }

    if (
      authenticated
    ) {
      collaboratorAccess.href =
        '/colab';

      collaboratorAccessLabel.textContent =
        'Minha área';

      collaboratorAccess.setAttribute(
        'aria-label',
        'Abrir minha área',
      );

      collaboratorAccess.classList.add(
        'authenticated',
      );

      collaboratorAccessAvatar.src =
        avatarUrl?.trim() ||
        '/branding/default-profile-avatar.png';

      collaboratorAccessAvatar.classList.remove(
        'header-hidden',
      );

      collaboratorAccessFallbackIcon.classList.add(
        'header-hidden',
      );

      collaboratorAccessAvatar.addEventListener(
        'error',
        () => {
          collaboratorAccessAvatar.src =
            '/branding/default-profile-avatar.png';
        },
        {
          once: true,
        },
      );

      collaboratorAccess.classList.remove(
        'auth-pending',
      );

      return;
    }

    collaboratorAccess.href =
      '/login';

    collaboratorAccessLabel.textContent =
      'Entrar';

    collaboratorAccessAvatar.classList.add(
      'header-hidden',
    );

    collaboratorAccessAvatar.removeAttribute(
      'src',
    );

    collaboratorAccessFallbackIcon.classList.remove(
      'header-hidden',
    );

    collaboratorAccess.setAttribute(
      'aria-label',
      'Entrar na área de colaboradores',
    );

    collaboratorAccess.classList.remove(
      'authenticated',
    );

    collaboratorAccess.classList.remove(
      'auth-pending',
    );
  }

  async function loadCollaboratorAvatar(
    userId: string,
  ) {
    try {
      const {
        data,
        error,
      } =
        await supabase
          .from(
            'member_profiles',
          )
          .select(
            'avatar_url',
          )
          .eq(
            'user_id',
            userId,
          )
          .maybeSingle();

      if (
        error
      ) {
        console.warn(
          '[EVRYLUX] Não foi possível carregar a foto do colaborador:',
          error.message,
        );

        return null;
      }

      return (
        data?.avatar_url?.trim() ||
        null
      );
    } catch (
      error
    ) {
      console.warn(
        '[EVRYLUX] Não foi possível carregar a foto do colaborador:',
        error,
      );

      return null;
    }
  }

  type GlobalPresenceProfile = {
    display_name: string | null;
    avatar_url: string | null;
    area: string | null;
    github_login: string | null;
  };

  async function loadGlobalPresenceProfile(
    userId: string,
  ): Promise<GlobalPresenceProfile | null> {
    try {
      const {
        data,
        error,
      } =
        await supabase
          .from(
            'member_profiles',
          )
          .select(
            'display_name, avatar_url, area, github_login',
          )
          .eq(
            'user_id',
            userId,
          )
          .maybeSingle();

      if (
        error
      ) {
        console.warn(
          '[EVRYLUX] Não foi possível carregar o perfil para presença global:',
          error.message,
        );

        return null;
      }

      return {
        display_name:
          data?.display_name?.trim() ||
          null,

        avatar_url:
          data?.avatar_url?.trim() ||
          null,

        area:
          data?.area?.trim() ||
          null,

        github_login:
          data?.github_login?.trim() ||
          null,
      };
    } catch (
      error
    ) {
      console.warn(
        '[EVRYLUX] Não foi possível carregar o perfil para presença global:',
        error,
      );

      return null;
    }
  }

  async function connectGlobalColabPresence(
    userId: string,
    email:
      string | null |
      undefined,
  ) {
    // A presença representa o portal Colab.
    // Em páginas públicas, o usuário não é contado como ativo no Colab.
    if (
      !window.location.pathname.startsWith(
        '/colab',
      )
    ) {
      return;
    }

    if (
      globalPresenceDisconnect
    ) {
      try {
        await globalPresenceDisconnect();
      } catch {
        // Ignora erro ao substituir uma sessão anterior.
      }

      globalPresenceDisconnect =
        null;
    }

    const profile =
      await loadGlobalPresenceProfile(
        userId,
      );

    const displayName =
      profile?.display_name?.trim() ||
      email?.trim() ||
      'Colaborador EVRYLUX';

    globalPresenceDisconnect =
      await connectColabPresence(
        {
          user_id:
            userId,

          display_name:
            displayName,

          avatar_url:
            profile?.avatar_url ||
            null,

          area:
            profile?.area ||
            null,

          github_login:
            profile?.github_login ||
            null,
        },
      );

    // Disponibiliza um sinal simples para outras páginas/componentes.
    window.dispatchEvent(
      new CustomEvent(
        'evrylux:presence-connected',
        {
          detail: {
            user_id:
              userId,
          },
        },
      ),
    );
  }

  const seenStorageKeys = {
    support:
      'evrylux:admin-notifications:support-seen',

    demo:
      'evrylux:admin-notifications:demo-seen',
  } as const;

  function readSeenCount(
    key:
      keyof typeof seenStorageKeys,
  ) {
    try {
      const value =
        Number(
          localStorage.getItem(
            seenStorageKeys[key],
          ) ??
          '0',
        );

      return Number.isFinite(
        value,
      )
        ? Math.max(
            0,
            Math.floor(
              value,
            ),
          )
        : 0;
    } catch {
      return 0;
    }
  }

  function writeSeenCount(
    key:
      keyof typeof seenStorageKeys,
    value: number,
  ) {
    try {
      localStorage.setItem(
        seenStorageKeys[key],
        String(
          Math.max(
            0,
            Math.floor(
              value,
            ),
          ),
        ),
      );
    } catch {
      // localStorage pode estar indisponível.
    }
  }

  function visibleUnread(
    key:
      keyof typeof seenStorageKeys,
    rawCount: number,
  ) {
    const normalized =
      Math.max(
        0,
        Math.floor(
          rawCount,
        ),
      );

    if (
      normalized ===
      0
    ) {
      writeSeenCount(
        key,
        0,
      );

      return 0;
    }

    const seen =
      readSeenCount(
        key,
      );

    return Math.max(
      0,
      normalized -
        seen,
    );
  }

  function formatBadgeCount(
    value: number,
  ) {
    return value > 99
      ? '99+'
      : String(
          value,
        );
  }

  function taskNotificationText() {
    if (
      currentTaskUnread.length ===
      0
    ) {
      return 'Nenhuma tarefa nova';
    }

    const latest =
      currentTaskUnread[0];

    if (
      currentTaskUnread.length >
      1
    ) {
      return `${currentTaskUnread.length} novas tarefas atribuídas a você`;
    }

    const by =
      latest.assigned_by_name?.trim();

    if (
      by
    ) {
      return `${by} marcou você em “${latest.title}”`;
    }

    return `Você foi marcado(a) em “${latest.title}”`;
  }

  function updateNotificationCenter() {
    const supportVisible =
      currentUserIsAdmin
        ? visibleUnread(
            'support',
            currentSupportUnread,
          )
        : 0;

    const demoVisible =
      currentUserIsAdmin
        ? visibleUnread(
            'demo',
            currentDemoUnread,
          )
        : 0;

    const taskVisible =
      currentTaskUnread.length;

    const total =
      taskVisible +
      supportVisible +
      demoVisible;

    if (
      notificationCenterCount
    ) {
      notificationCenterCount.textContent =
        formatBadgeCount(
          total,
        );

      notificationCenterCount.classList.toggle(
        'header-hidden',
        total <=
          0,
      );
    }

    notificationCenterButton?.classList.toggle(
      'has-unread',
      total >
        0,
    );

    if (
      notificationPopoverTotal
    ) {
      notificationPopoverTotal.textContent =
        total >
        0
          ? `${total} nova${total === 1 ? '' : 's'}`
          : 'Tudo em dia';
    }

    if (
      notificationPopoverTaskCount
    ) {
      notificationPopoverTaskCount.textContent =
        formatBadgeCount(
          taskVisible,
        );

      notificationPopoverTaskCount.classList.toggle(
        'header-hidden',
        taskVisible <=
          0,
      );
    }

    if (
      notificationPopoverTaskCopy
    ) {
      notificationPopoverTaskCopy.textContent =
        taskNotificationText();
    }

    if (
      notificationPopoverSupport
    ) {
      notificationPopoverSupport.classList.toggle(
        'header-hidden',
        !currentUserIsAdmin,
      );
    }

    if (
      notificationPopoverDemo
    ) {
      notificationPopoverDemo.classList.toggle(
        'header-hidden',
        !currentUserIsAdmin,
      );
    }

    if (
      notificationPopoverSupportCount
    ) {
      notificationPopoverSupportCount.textContent =
        formatBadgeCount(
          supportVisible,
        );

      notificationPopoverSupportCount.classList.toggle(
        'header-hidden',
        supportVisible <=
          0,
      );
    }

    if (
      notificationPopoverDemoCount
    ) {
      notificationPopoverDemoCount.textContent =
        formatBadgeCount(
          demoVisible,
        );

      notificationPopoverDemoCount.classList.toggle(
        'header-hidden',
        demoVisible <=
          0,
      );
    }

    if (
      notificationPopoverSupportCopy
    ) {
      notificationPopoverSupportCopy.textContent =
        supportVisible >
        0
          ? `${supportVisible} conversa${supportVisible === 1 ? '' : 's'} nova${supportVisible === 1 ? '' : 's'}`
          : 'Nenhuma conversa nova';
    }

    if (
      notificationPopoverDemoCopy
    ) {
      notificationPopoverDemoCopy.textContent =
        demoVisible >
        0
          ? `${demoVisible} inscrição${demoVisible === 1 ? '' : 'ões'} nova${demoVisible === 1 ? '' : 's'}`
          : 'Nenhuma inscrição nova';
    }
  }

  function markAdminNotificationAsSeen(
    type:
      | 'support'
      | 'demo',
  ) {
    if (
      type ===
      'support'
    ) {
      writeSeenCount(
        'support',
        currentSupportUnread,
      );
    } else {
      writeSeenCount(
        'demo',
        currentDemoUnread,
      );
    }

    updateNotificationCenter();
  }

  function closeNotificationPopover() {
    notificationPopover?.classList.add(
      'header-hidden',
    );

    notificationCenterButton?.setAttribute(
      'aria-expanded',
      'false',
    );
  }

  async function refreshTaskNotifications() {
    try {
      const tasks =
        await getMyRoadmapTasks();

      currentTaskUnread =
        tasks.filter(
          (
            task,
          ) =>
            Boolean(
              task.notification_id,
            ) &&
            !task.notification_is_read,
        );

      updateNotificationCenter();
    } catch (
      error
    ) {
      console.warn(
        '[EVRYLUX] Não foi possível carregar notificações de tarefas:',
        error,
      );

      currentTaskUnread =
        [];

      updateNotificationCenter();
    }
  }

  async function refreshSupportCount() {
    if (
      !currentUserIsAdmin
    ) {
      currentSupportUnread =
        0;

      updateNotificationCenter();

      return;
    }

    currentSupportUnread =
      await getUnreadSupportCount();

    updateNotificationCenter();
  }

  async function loadAdminNotifications() {
    if (
      !currentUserIsAdmin
    ) {
      currentSupportUnread =
        0;

      currentDemoUnread =
        0;

      updateNotificationCenter();

      return;
    }

    currentDemoUnread =
      await getUnreadDemoCount();

    await refreshSupportCount();

    supportNotifications =
      subscribeAdminSupportNotifications(
        async () => {
          await refreshSupportCount();
        },
      );

    updateNotificationCenter();
  }

  async function connectCurrentUserTasks(
    userId: string,
  ) {
    if (
      disconnectTaskAssignments
    ) {
      await disconnectTaskAssignments();

      disconnectTaskAssignments =
        null;
    }

    await refreshTaskNotifications();

    try {
      disconnectTaskAssignments =
        await connectTaskAssignments(
          userId,
          async () => {
            await refreshTaskNotifications();

            playTaskNotificationSound();
          },
        );
    } catch (
      error
    ) {
      console.warn(
        '[EVRYLUX] Não foi possível conectar notificações em tempo real de tarefas:',
        error,
      );
    }
  }

  notificationPopoverSupport?.addEventListener(
    'click',
    () => {
      markAdminNotificationAsSeen(
        'support',
      );
    },
  );

  notificationPopoverDemo?.addEventListener(
    'click',
    () => {
      markAdminNotificationAsSeen(
        'demo',
      );
    },
  );

  notificationPopoverTasks?.addEventListener(
    'click',
    async (
      event,
    ) => {
      if (
        currentTaskUnread.length ===
        0
      ) {
        return;
      }

      event.preventDefault();

      const notifications =
        currentTaskUnread
          .map(
            (
              task,
            ) =>
              task.notification_id,
          )
          .filter(
            (
              id,
            ):
              id is string =>
                Boolean(
                  id,
                ),
          );

      await Promise.allSettled(
        notifications.map(
          (
            id,
          ) =>
            markTaskNotificationRead(
              id,
            ),
        ),
      );

      currentTaskUnread =
        [];

      updateNotificationCenter();

      window.location.href =
        '/colab/tasks';
    },
  );

  notificationCenterButton?.addEventListener(
    'click',
    (
      event,
    ) => {
      event.stopPropagation();

      const isOpen =
        !notificationPopover?.classList.contains(
          'header-hidden',
        );

      if (
        isOpen
      ) {
        closeNotificationPopover();

        return;
      }

      notificationPopover?.classList.remove(
        'header-hidden',
      );

      notificationCenterButton.setAttribute(
        'aria-expanded',
        'true',
      );
    },
  );

  document.addEventListener(
    'click',
    (
      event,
    ) => {
      if (
        !notificationCenter ||
        !(
          event.target instanceof
          Node
        )
      ) {
        return;
      }

      if (
        !notificationCenter.contains(
          event.target,
        )
      ) {
        closeNotificationPopover();
      }
    },
  );

  document.addEventListener(
    'keydown',
    (
      event,
    ) => {
      if (
        event.key ===
        'Escape'
      ) {
        closeNotificationPopover();
      }
    },
  );

  async function clearSubscriptions() {
    try {
      await supportNotifications?.disconnect();
    } catch {
      // ignora erro de encerramento
    }

    supportNotifications =
      null;

    try {
      await disconnectTaskAssignments?.();
    } catch {
      // ignora erro de encerramento
    }

    disconnectTaskAssignments =
      null;

    try {
      await globalPresenceDisconnect?.();
    } catch {
      // A sessão também expira automaticamente pelo heartbeat.
    }

    globalPresenceDisconnect =
      null;
  }

  async function loadCollaboratorState() {
    try {
      const {
        data: {
          session,
        },
      } =
        await supabase.auth.getSession();

      const authenticated =
        Boolean(
          session,
        );

      if (
        authenticated &&
        session
      ) {
        currentUserId =
          session.user.id;

        const avatarUrl =
          await loadCollaboratorAvatar(
            currentUserId,
          );

        updateCollaboratorAccess(
          true,
          avatarUrl,
        );

        // O sino agora é de todos os colaboradores autenticados.
        notificationCenter?.classList.remove(
          'header-hidden',
        );

        currentUserIsAdmin =
          await isCurrentUserAdmin();

        await Promise.all([
          loadAdminNotifications(),

          connectCurrentUserTasks(
            currentUserId,
          ),

          connectGlobalColabPresence(
            currentUserId,
            session.user.email,
          ),
        ]);

        updateNotificationCenter();

        return;
      }

      currentUserId =
        null;

      currentUserIsAdmin =
        false;

      currentTaskUnread =
        [];

      currentSupportUnread =
        0;

      currentDemoUnread =
        0;

      await clearSubscriptions();

      notificationCenter?.classList.add(
        'header-hidden',
      );

      closeNotificationPopover();

      updateCollaboratorAccess(
        false,
      );
    } catch (
      error
    ) {
      console.warn(
        '[EVRYLUX] Não foi possível verificar a sessão:',
        error,
      );

      notificationCenter?.classList.add(
        'header-hidden',
      );

      updateCollaboratorAccess(
        false,
      );
    }
  }

  await loadCollaboratorState();

  supabase.auth.onAuthStateChange(
    async (
      _event,
      session,
    ) => {
      await clearSubscriptions();

      if (
        session
      ) {
        currentUserId =
          session.user.id;

        const avatarUrl =
          await loadCollaboratorAvatar(
            currentUserId,
          );

        updateCollaboratorAccess(
          true,
          avatarUrl,
        );

        notificationCenter?.classList.remove(
          'header-hidden',
        );

        currentUserIsAdmin =
          await isCurrentUserAdmin();

        await Promise.all([
          loadAdminNotifications(),

          connectCurrentUserTasks(
            currentUserId,
          ),

          connectGlobalColabPresence(
            currentUserId,
            session.user.email,
          ),
        ]);

        updateNotificationCenter();

        return;
      }

      currentUserId =
        null;

      currentUserIsAdmin =
        false;

      currentTaskUnread =
        [];

      currentSupportUnread =
        0;

      currentDemoUnread =
        0;

      notificationCenter?.classList.add(
        'header-hidden',
      );

      closeNotificationPopover();

      updateCollaboratorAccess(
        false,
      );
    },
  );

  window.addEventListener(
    'pagehide',
    () => {
      void clearSubscriptions();
    },
  );
</script>

