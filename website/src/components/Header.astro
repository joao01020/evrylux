---
const nav = [
  { label: 'Produto', href: '/' },
  { label: 'Colaboradores', href: '/contributors' },
  { label: 'Download', href: '/download' },
  { label: 'Planos', href: '/plans' },
  { label: 'Suporte', href: '/support' },
  { label: 'Roadmap', href: '/roadmap' },
  { label: 'Licença', href: '/license' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a
      class="brand"
      href="/"
      aria-label="EVRYLUX"
    >
      <span class="brand-mark">
        <img
          src="/branding/evrylux-logo.png"
          alt=""
          class="brand-logo"
          draggable="false"
          aria-hidden="true"
        />
      </span>
    </a>

    <nav
      class="nav"
      aria-label="Navegação principal"
    >
      {
        nav.map(
          (item) => (
            <a href={item.href}>
              {item.label}
            </a>
          ),
        )
      }
    </nav>

    <div class="header-actions">
      <div
        id="admin-notification-center"
        class="notification-center header-hidden"
      >
        <button
          id="notification-center-button"
          class="admin-notification notification-center-button"
          type="button"
          aria-label="Abrir notificações"
          aria-expanded="false"
          title="Notificações"
        >
          <span class="notification-icon notification-bell-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path
                d="M18 8.7a6 6 0 1 0-12 0c0 6.4-2.6 6.6-2.6 8.3h17.2C20.6 15.3 18 15.1 18 8.7Z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <path
                d="M9.7 20h4.6"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
              />
            </svg>
          </span>

          <span
            id="notification-center-count"
            class="notification-count header-hidden"
          >
            0
          </span>
        </button>

        <div
          id="notification-popover"
          class="notification-popover header-hidden"
          role="dialog"
          aria-label="Notificações administrativas"
        >
          <div class="notification-popover-head">
            <div>
              <span class="notification-popover-kicker">
                EVRYLUX Colab
              </span>

              <strong>
                Notificações
              </strong>
            </div>

            <span
              id="notification-popover-total"
              class="notification-popover-total"
            >
              Tudo em dia
            </span>
          </div>

          <div class="notification-popover-list">
            <a
              id="notification-popover-support"
              class="notification-popover-item"
              href="/colab/support"
            >
              <span class="popover-item-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path
                    d="M7 8.5h10a3 3 0 0 1 3 3v3a3 3 0 0 1-3 3h-4.2L9 20v-2.5H7a3 3 0 0 1-3-3v-3a3 3 0 0 1 3-3Z"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linejoin="round"
                  />
                  <path
                    d="M8.5 12.5h7"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                  />
                </svg>
              </span>

              <span class="popover-item-copy">
                <strong>Suporte</strong>
                <small id="notification-popover-support-copy">
                  Nenhuma conversa nova
                </small>
              </span>

              <span
                id="notification-popover-support-count"
                class="popover-item-count header-hidden"
              >
                0
              </span>
            </a>

            <a
              id="notification-popover-demo"
              class="notification-popover-item"
              href="/colab/demo"
            >
              <span class="popover-item-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <rect
                    x="5"
                    y="4"
                    width="14"
                    height="16"
                    rx="3"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                  />
                  <path
                    d="M9 8h6M9 12h6M9 16h3"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                  />
                  <circle
                    cx="16.8"
                    cy="16.2"
                    r="1.8"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                  />
                </svg>
              </span>

              <span class="popover-item-copy">
                <strong>Fila do Demo</strong>
                <small id="notification-popover-demo-copy">
                  Nenhuma inscrição nova
                </small>
              </span>

              <span
                id="notification-popover-demo-count"
                class="popover-item-count header-hidden"
              >
                0
              </span>
            </a>
          </div>
        </div>
      </div>

      <a
        id="support-admin-notification"
        class="admin-notification header-hidden"
        href="/colab/support"
        aria-label="Novas mensagens de suporte"
        title="Suporte"
      >
        <span class="notification-icon notification-support-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path
              d="M7 8.5h10a3 3 0 0 1 3 3v3a3 3 0 0 1-3 3h-4.2L9 20v-2.5H7a3 3 0 0 1-3-3v-3a3 3 0 0 1 3-3Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linejoin="round"
            />
            <path
              d="M8.5 12.5h7"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
            />
          </svg>
        </span>

        <span
          id="support-admin-count"
          class="notification-count header-hidden"
        >
          0
        </span>
      </a>

      <a
        id="demo-admin-notification"
        class="admin-notification header-hidden"
        href="/colab/demo"
        aria-label="Novas inscrições no demo"
        title="Fila do Demo"
      >
        <span class="notification-icon notification-demo-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <rect
              x="5"
              y="4"
              width="14"
              height="16"
              rx="3"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
            />
            <path
              d="M9 8h6M9 12h6M9 16h3"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
            />
            <circle
              cx="16.8"
              cy="16.2"
              r="1.8"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
            />
          </svg>
        </span>

        <span
          id="demo-admin-count"
          class="notification-count header-hidden"
        >
          0
        </span>
      </a>

      <a
        id="collaborator-access"
        class="collaborator-access auth-pending"
        href="/login"
        aria-label="Acessar área de colaboradores"
      >
        <span
          id="collaborator-access-icon"
          class="collaborator-access-icon"
          aria-hidden="true"
        >
          <img
            id="collaborator-access-avatar"
            class="collaborator-access-avatar header-hidden"
            src="/branding/default-profile-avatar.png"
            alt=""
            draggable="false"
          />

          <span
            id="collaborator-access-fallback-icon"
            class="collaborator-access-fallback-icon"
          >
            <svg
              class="collaborator-entry-symbol"
              viewBox="0 0 64 64"
              aria-hidden="true"
            >
              <g
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle
                  cx="32"
                  cy="27"
                  r="7"
                  stroke-width="3"
                />

                <circle
                  cx="17"
                  cy="31"
                  r="5.5"
                  stroke-width="3"
                />

                <circle
                  cx="47"
                  cy="31"
                  r="5.5"
                  stroke-width="3"
                />

                <path
                  d="M20 50c.8-8 5.2-12 12-12s11.2 4 12 12"
                  stroke-width="3"
                />

                <path
                  d="M6.5 48.5c.6-6.3 4-9.5 10.5-9.5 3.2 0 5.7.9 7.5 2.7"
                  stroke-width="3"
                />

                <path
                  d="M57.5 48.5C56.9 42.2 53.5 39 47 39c-3.2 0-5.7.9-7.5 2.7"
                  stroke-width="3"
                />

                <path
                  d="M22.8 12.8 27 11.2l1.6-4.4h6.8l1.6 4.4 4.2 1.6 4.2-2.1 4.8 4.8-2.1 4.2 1.6 4.2"
                  stroke-width="3"
                />

                <path
                  d="M14.3 23.9 12.7 19.7l-2.1-4.2 4.8-4.8 4.2 2.1"
                  stroke-width="3"
                />
              </g>
            </svg>
          </span>
        </span>

        <span id="collaborator-access-label"></span>
      </a>
    </div>
  </div>
</header>

<script>
  import {
    supabase,
  } from '../lib/supabase';

  import {
    isCurrentUserAdmin,
  } from '../lib/colab-admin';

  import {
    getUnreadDemoCount,
  } from '../lib/demo-waitlist';

  import {
    getUnreadSupportCount,
    subscribeAdminSupportNotifications,
  } from '../lib/support';

  const collaboratorAccess =
    document.querySelector<HTMLAnchorElement>(
      '#collaborator-access',
    );

  const collaboratorAccessLabel =
    document.querySelector<HTMLElement>(
      '#collaborator-access-label',
    );

  const collaboratorAccessIcon =
    document.querySelector<HTMLElement>(
      '#collaborator-access-icon',
    );

  const collaboratorAccessAvatar =
    document.querySelector<HTMLImageElement>(
      '#collaborator-access-avatar',
    );

  const collaboratorAccessFallbackIcon =
    document.querySelector<HTMLElement>(
      '#collaborator-access-fallback-icon',
    );

  const demoNotification =
    document.querySelector<HTMLAnchorElement>(
      '#demo-admin-notification',
    );

  const demoCount =
    document.querySelector<HTMLElement>(
      '#demo-admin-count',
    );

  const supportNotification =
    document.querySelector<HTMLAnchorElement>(
      '#support-admin-notification',
    );

  const supportCount =
    document.querySelector<HTMLElement>(
      '#support-admin-count',
    );

  const notificationCenter =
    document.querySelector<HTMLElement>(
      '#admin-notification-center',
    );

  const notificationCenterButton =
    document.querySelector<HTMLButtonElement>(
      '#notification-center-button',
    );

  const notificationCenterCount =
    document.querySelector<HTMLElement>(
      '#notification-center-count',
    );

  const notificationPopover =
    document.querySelector<HTMLElement>(
      '#notification-popover',
    );

  const notificationPopoverTotal =
    document.querySelector<HTMLElement>(
      '#notification-popover-total',
    );

  const notificationPopoverSupportCount =
    document.querySelector<HTMLElement>(
      '#notification-popover-support-count',
    );

  const notificationPopoverDemoCount =
    document.querySelector<HTMLElement>(
      '#notification-popover-demo-count',
    );

  const notificationPopoverSupportCopy =
    document.querySelector<HTMLElement>(
      '#notification-popover-support-copy',
    );

  const notificationPopoverDemoCopy =
    document.querySelector<HTMLElement>(
      '#notification-popover-demo-copy',
    );

  const notificationPopoverSupport =
    document.querySelector<HTMLAnchorElement>(
      '#notification-popover-support',
    );

  const notificationPopoverDemo =
    document.querySelector<HTMLAnchorElement>(
      '#notification-popover-demo',
    );

  let currentSupportUnread =
    0;

  let currentDemoUnread =
    0;

  let supportNotifications:
    ReturnType<
      typeof subscribeAdminSupportNotifications
    > | null =
      null;

  function updateCollaboratorAccess(
    authenticated: boolean,
    avatarUrl:
      string | null =
        null,
  ) {
    if (
      !collaboratorAccess ||
      !collaboratorAccessLabel ||
      !collaboratorAccessIcon ||
      !collaboratorAccessAvatar ||
      !collaboratorAccessFallbackIcon
    ) {
      return;
    }

    if (authenticated) {
      collaboratorAccess.href =
        '/colab';

      collaboratorAccessLabel.textContent =
        'Minha área';

      collaboratorAccess.setAttribute(
        'aria-label',
        'Abrir minha área',
      );

      collaboratorAccess.classList.add(
        'authenticated',
      );

      collaboratorAccessAvatar.src =
        avatarUrl?.trim() ||
        '/branding/default-profile-avatar.png';

      collaboratorAccessAvatar.classList.remove(
        'header-hidden',
      );

      collaboratorAccessFallbackIcon.classList.add(
        'header-hidden',
      );

      collaboratorAccessAvatar.addEventListener(
        'error',
        () => {
          collaboratorAccessAvatar.src =
            '/branding/default-profile-avatar.png';
        },
        {
          once: true,
        },
      );

      collaboratorAccess.classList.remove(
        'auth-pending',
      );

      return;
    }

    collaboratorAccess.href =
      '/login';

    collaboratorAccessLabel.textContent =
      'Entrar';

    collaboratorAccessAvatar.classList.add(
      'header-hidden',
    );

    collaboratorAccessAvatar.removeAttribute(
      'src',
    );

    collaboratorAccessFallbackIcon.classList.remove(
      'header-hidden',
    );

    collaboratorAccess.setAttribute(
      'aria-label',
      'Entrar na área de colaboradores',
    );

    collaboratorAccess.classList.remove(
      'authenticated',
    );

    collaboratorAccess.classList.remove(
      'auth-pending',
    );
  }

  async function loadCollaboratorAvatar(
    userId: string,
  ) {
    try {
      const {
        data,
        error,
      } =
        await supabase
          .from(
            'member_profiles',
          )
          .select(
            'avatar_url',
          )
          .eq(
            'user_id',
            userId,
          )
          .maybeSingle();

      if (error) {
        console.warn(
          '[EVRYLUX] Não foi possível carregar a foto do colaborador:',
          error.message,
        );

        return null;
      }

      return (
        data?.avatar_url?.trim() ||
        null
      );
    } catch (error) {
      console.warn(
        '[EVRYLUX] Não foi possível carregar a foto do colaborador:',
        error,
      );

      return null;
    }
  }

  const seenStorageKeys = {
    support:
      'evrylux:admin-notifications:support-seen',
    demo:
      'evrylux:admin-notifications:demo-seen',
  } as const;

  function readSeenCount(
    key: keyof typeof seenStorageKeys,
  ) {
    try {
      const value =
        Number(
          localStorage.getItem(
            seenStorageKeys[key],
          ) ?? '0',
        );

      return Number.isFinite(
        value,
      )
        ? Math.max(
            0,
            Math.floor(
              value,
            ),
          )
        : 0;
    } catch {
      return 0;
    }
  }

  function writeSeenCount(
    key: keyof typeof seenStorageKeys,
    value: number,
  ) {
    try {
      localStorage.setItem(
        seenStorageKeys[key],
        String(
          Math.max(
            0,
            Math.floor(
              value,
            ),
          ),
        ),
      );
    } catch {
      // localStorage pode estar indisponível em modos privados restritos.
    }
  }

  function visibleUnread(
    key: keyof typeof seenStorageKeys,
    rawCount: number,
  ) {
    const normalized =
      Math.max(
        0,
        Math.floor(
          rawCount,
        ),
      );

    if (
      normalized ===
      0
    ) {
      writeSeenCount(
        key,
        0,
      );

      return 0;
    }

    const seen =
      readSeenCount(
        key,
      );

    return Math.max(
      0,
      normalized -
        seen,
    );
  }

  function formatBadgeCount(
    value: number,
  ) {
    return value > 99
      ? '99+'
      : String(
          value,
        );
  }

  function updateNotificationCenter() {
    const supportVisible =
      visibleUnread(
        'support',
        currentSupportUnread,
      );

    const demoVisible =
      visibleUnread(
        'demo',
        currentDemoUnread,
      );

    const total =
      supportVisible +
      demoVisible;

    if (
      notificationCenterCount
    ) {
      notificationCenterCount.textContent =
        formatBadgeCount(
          total,
        );

      notificationCenterCount.classList.toggle(
        'header-hidden',
        total <= 0,
      );
    }

    if (
      notificationPopoverTotal
    ) {
      notificationPopoverTotal.textContent =
        total > 0
          ? `${total} nova${total === 1 ? '' : 's'}`
          : 'Tudo em dia';
    }

    if (
      notificationPopoverSupportCount
    ) {
      notificationPopoverSupportCount.textContent =
        formatBadgeCount(
          supportVisible,
        );

      notificationPopoverSupportCount.classList.toggle(
        'header-hidden',
        supportVisible <= 0,
      );
    }

    if (
      notificationPopoverDemoCount
    ) {
      notificationPopoverDemoCount.textContent =
        formatBadgeCount(
          demoVisible,
        );

      notificationPopoverDemoCount.classList.toggle(
        'header-hidden',
        demoVisible <= 0,
      );
    }

    if (
      notificationPopoverSupportCopy
    ) {
      notificationPopoverSupportCopy.textContent =
        supportVisible > 0
          ? `${supportVisible} conversa${supportVisible === 1 ? '' : 's'} nova${supportVisible === 1 ? '' : 's'}`
          : 'Nenhuma conversa nova';
    }

    if (
      notificationPopoverDemoCopy
    ) {
      notificationPopoverDemoCopy.textContent =
        demoVisible > 0
          ? `${demoVisible} inscrição${demoVisible === 1 ? '' : 'ões'} nova${demoVisible === 1 ? '' : 's'}`
          : 'Nenhuma inscrição nova';
    }

    if (
      supportCount
    ) {
      supportCount.textContent =
        formatBadgeCount(
          supportVisible,
        );

      supportCount.classList.toggle(
        'header-hidden',
        supportVisible <= 0,
      );
    }

    if (
      demoCount
    ) {
      demoCount.textContent =
        formatBadgeCount(
          demoVisible,
        );

      demoCount.classList.toggle(
        'header-hidden',
        demoVisible <= 0,
      );
    }

    supportNotification?.classList.toggle(
      'has-unread',
      supportVisible > 0,
    );

    demoNotification?.classList.toggle(
      'has-unread',
      demoVisible > 0,
    );

    notificationCenterButton?.classList.toggle(
      'has-unread',
      total > 0,
    );
  }

  function markNotificationAsSeen(
    type:
      | 'support'
      | 'demo',
  ) {
    if (
      type ===
      'support'
    ) {
      writeSeenCount(
        'support',
        currentSupportUnread,
      );
    } else {
      writeSeenCount(
        'demo',
        currentDemoUnread,
      );
    }

    updateNotificationCenter();
  }

  function closeNotificationPopover() {
    notificationPopover?.classList.add(
      'header-hidden',
    );

    notificationCenterButton?.setAttribute(
      'aria-expanded',
      'false',
    );
  }

  async function refreshSupportCount() {
    if (
      !supportNotification
    ) {
      return;
    }

    currentSupportUnread =
      await getUnreadSupportCount();

    supportNotification.classList.remove(
      'header-hidden',
    );

    updateNotificationCenter();
  }

  async function loadAdminNotifications() {
    try {
      const admin =
        await isCurrentUserAdmin();

      if (!admin) {
        return;
      }

      if (
        demoNotification
      ) {
        demoNotification.classList.remove(
          'header-hidden',
        );

        currentDemoUnread =
          await getUnreadDemoCount();

        updateNotificationCenter();
      }

      notificationCenter?.classList.remove(
        'header-hidden',
      );

      await refreshSupportCount();

      supportNotifications =
        subscribeAdminSupportNotifications(
          async () => {
            await refreshSupportCount();
          },
        );
    } catch (error) {
      console.warn(
        '[EVRYLUX] Não foi possível carregar notificações administrativas:',
        error,
      );
    }
  }

  supportNotification?.addEventListener(
    'click',
    () => {
      markNotificationAsSeen(
        'support',
      );
    },
  );

  demoNotification?.addEventListener(
    'click',
    () => {
      markNotificationAsSeen(
        'demo',
      );
    },
  );

  notificationPopoverSupport?.addEventListener(
    'click',
    () => {
      markNotificationAsSeen(
        'support',
      );
    },
  );

  notificationPopoverDemo?.addEventListener(
    'click',
    () => {
      markNotificationAsSeen(
        'demo',
      );
    },
  );

  notificationCenterButton?.addEventListener(
    'click',
    (event) => {
      event.stopPropagation();

      const isOpen =
        !notificationPopover?.classList.contains(
          'header-hidden',
        );

      if (
        isOpen
      ) {
        closeNotificationPopover();
        return;
      }

      notificationPopover?.classList.remove(
        'header-hidden',
      );

      notificationCenterButton.setAttribute(
        'aria-expanded',
        'true',
      );
    },
  );

  document.addEventListener(
    'click',
    (event) => {
      if (
        !notificationCenter ||
        !(event.target instanceof Node)
      ) {
        return;
      }

      if (
        !notificationCenter.contains(
          event.target,
        )
      ) {
        closeNotificationPopover();
      }
    },
  );

  document.addEventListener(
    'keydown',
    (event) => {
      if (
        event.key ===
        'Escape'
      ) {
        closeNotificationPopover();
      }
    },
  );

  async function loadCollaboratorState() {
    try {
      const {
        data: {
          session,
        },
      } =
        await supabase.auth.getSession();

      const authenticated =
        Boolean(
          session,
        );

      if (
        authenticated &&
        session
      ) {
        const avatarUrl =
          await loadCollaboratorAvatar(
            session.user.id,
          );

        updateCollaboratorAccess(
          true,
          avatarUrl,
        );

        await loadAdminNotifications();
      } else {
        updateCollaboratorAccess(
          false,
        );
      }
    } catch (error) {
      console.warn(
        '[EVRYLUX] Não foi possível verificar a sessão:',
        error,
      );

      updateCollaboratorAccess(
        false,
      );
    }
  }

  await loadCollaboratorState();

  supabase.auth.onAuthStateChange(
    async (
      _event,
      session,
    ) => {
      const authenticated =
        Boolean(
          session,
        );

      if (
        authenticated &&
        session
      ) {
        const avatarUrl =
          await loadCollaboratorAvatar(
            session.user.id,
          );

        updateCollaboratorAccess(
          true,
          avatarUrl,
        );

        await loadAdminNotifications();
      } else {
        updateCollaboratorAccess(
          false,
        );
      }
    },
  );

  window.addEventListener(
    'pagehide',
    () => {
      void supportNotifications?.disconnect();
    },
  );
</script>

<style>
  .header-hidden {
    display: none !important;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding: 14px 0;
    background: rgba(247,251,244,.78);
