              </p>
            </div>
          </a>

          <a
            id="admin-users-card"
            class="tool-card admin-tool"
            href="/colab/admins"
          >
            <div class="tool-card-top">
              <span class="tool-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
