                  <path d="M7 16v-4a2 2 0 0 1 2-2h1v8H9a2 2 0 0 1-2-2Zm10 0v-4a2 2 0 0 0-2-2h-1v8h1a2 2 0 0 0 2-2Z" fill="none" stroke="currentColor" stroke-width="1.8"/>
                </svg>
              </span>

