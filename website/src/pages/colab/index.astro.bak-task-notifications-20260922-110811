<script>
  import {
    supabase,
  } from '../../lib/supabase';

  import {
    requireMemberSession,
  } from '../../lib/member-auth';

  import {
    isCurrentUserAdmin,
  } from '../../lib/colab-admin';


  import {
    connectColabPresence,
    type ColabPresenceUser,
  } from '../../lib/colab-presence';


  const onlineCount =
    document.querySelector<HTMLElement>(
      '#dashboard-online-count',
    );

  const onlineList =
    document.querySelector<HTMLElement>(
      '#dashboard-online-list',
    );

  const toastRegion =
    document.querySelector<HTMLElement>(
      '#online-join-toast-region',
    );

  let presenceDisconnect:
    (() => Promise<void>) | null =
      null;

  let audioContext:
    AudioContext | null =
      null;

  let audioUnlocked =
    false;

  function escapeHtml(
    value: string,
  ) {
    return value
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');
  }

  function defaultAvatarMarkup(
    name: string,
  ) {
    return `
      <img
        src="/branding/default-profile-avatar.png"
        alt=""
        class="dashboard-online-avatar-image"
        draggable="false"
      />
    `;
  }

  function avatarMarkup(
    user: ColabPresenceUser,
  ) {
    const name =
      escapeHtml(
        user.display_name ||
        'Colaborador EVRYLUX',
      );

    if (
      user.avatar_url?.trim()
    ) {
      const avatar =
        escapeHtml(
          user.avatar_url,
        );

      return `
        <img
          src="${avatar}"
          alt="Avatar de ${name}"
          class="dashboard-online-avatar-image"
          draggable="false"
          onerror="this.src='/branding/default-profile-avatar.png'"
        />
      `;
    }

    return defaultAvatarMarkup(
      name,
    );
  }

  function renderOnlineUsers(
    users: ColabPresenceUser[],
    currentUserId: string,
  ) {
    if (
      onlineCount
    ) {
      onlineCount.textContent =
        String(
          users.length,
        );
    }

    if (
      !onlineList
    ) {
      return;
    }

    if (
      users.length ===
      0
    ) {
      onlineList.innerHTML = `
        <div class="dashboard-online-empty">
          <span class="dashboard-online-empty-dot"></span>

          <div>
            <strong>
              Ninguém online no momento
            </strong>

            <p>
              Quando alguém entrar no Colab, aparecerá aqui automaticamente.
            </p>
          </div>
        </div>
      `;

      return;
    }

    onlineList.innerHTML =
      users
        .map(
          (
            user,
          ) => {
            const name =
              escapeHtml(
                user.display_name ||
                'Colaborador EVRYLUX',
              );

            const area =
              user.area?.trim()
                ? escapeHtml(
                    user.area,
                  )
                : 'Colaborador';

            const isMe =
              user.user_id ===
              currentUserId;

            return `
              <article class="dashboard-online-person">
                <div class="dashboard-online-avatar-wrap">
                  ${avatarMarkup(user)}

                  <span
                    class="dashboard-online-person-dot"
                    aria-label="Online"
                  ></span>
                </div>

                <div class="dashboard-online-person-copy">
                  <strong>
                    ${name}
                    ${
                      isMe
                        ? '<span class="dashboard-online-you">Você</span>'
                        : ''
                    }
                  </strong>

                  <span>
                    ${area}
                  </span>
                </div>

                <span class="dashboard-online-state">
                  Online
                </span>
              </article>
            `;
          },
        )
        .join('');
  }

  function unlockPresenceAudio() {
    if (
      audioUnlocked
    ) {
      return;
    }

    try {
      audioContext =
        audioContext ??
        new AudioContext();

      if (
        audioContext.state ===
        'suspended'
      ) {
        void audioContext.resume();
      }

      audioUnlocked =
        true;
    } catch (
      error
    ) {
      console.warn(
        '[EVRYLUX] Áudio de presença indisponível:',
        error,
      );
    }
  }

  function playPresenceSound() {
    if (
      !audioUnlocked ||
      !audioContext
    ) {
      return;
    }

    try {
      const now =
        audioContext.currentTime;

      const gain =
        audioContext.createGain();

      const first =
        audioContext.createOscillator();

      const second =
        audioContext.createOscillator();

      first.type =
        'sine';

      second.type =
        'sine';

      first.frequency.setValueAtTime(
        620,
        now,
      );

      second.frequency.setValueAtTime(
        820,
        now + 0.08,
      );

      gain.gain.setValueAtTime(
        0.0001,
        now,
      );

      gain.gain.exponentialRampToValueAtTime(
        0.055,
        now + 0.015,
      );

      gain.gain.exponentialRampToValueAtTime(
        0.0001,
        now + 0.24,
      );

      first.connect(
        gain,
      );

      second.connect(
        gain,
      );

      gain.connect(
        audioContext.destination,
      );

      first.start(
        now,
      );

      first.stop(
        now + 0.14,
      );

      second.start(
        now + 0.08,
      );

      second.stop(
        now + 0.24,
      );
    } catch (
      error
    ) {
      console.warn(
        '[EVRYLUX] Não foi possível tocar o aviso de presença:',
        error,
      );
    }
  }

  function showOnlineToast(
    user: ColabPresenceUser,
  ) {
    if (
      !toastRegion
    ) {
      return;
    }

    const toast =
      document.createElement(
        'article',
      );

    toast.className =
      'online-join-toast';

    const name =
      escapeHtml(
        user.display_name ||
        'Colaborador EVRYLUX',
      );

    const area =
      user.area?.trim()
        ? escapeHtml(
            user.area,
          )
        : 'Entrou no EVRYLUX Colab';

    toast.innerHTML = `
      <div class="online-join-avatar-wrap">
        ${avatarMarkup(user)}
        <span class="online-join-live-dot"></span>
      </div>

      <div class="online-join-copy">
        <span class="online-join-kicker">
          Agora online
        </span>

        <strong>
          ${name}
        </strong>

        <small>
          ${area}
        </small>
      </div>

      <button
        type="button"
        class="online-join-close"
        aria-label="Fechar aviso"
      >
        ×
      </button>
    `;

    toastRegion.appendChild(
      toast,
    );

    requestAnimationFrame(
      () => {
        toast.classList.add(
          'show',
        );
      },
    );

    playPresenceSound();

    const removeToast =
      () => {
        toast.classList.remove(
          'show',
        );

        window.setTimeout(
          () => {
            toast.remove();
          },
          220,
        );
      };

    toast
      .querySelector<HTMLButtonElement>(
        '.online-join-close',
      )
      ?.addEventListener(
        'click',
        removeToast,
      );

    window.setTimeout(
      removeToast,
      5200,
    );
  }

  [
    'pointerdown',
    'keydown',
    'touchstart',
  ].forEach(
    (
      eventName,
    ) => {
      window.addEventListener(
        eventName,
        unlockPresenceAudio,
        {
          once: true,
          passive: true,
        },
      );
    },
  );

  const session =
    await requireMemberSession();

  if (session) {
    const loading =
      document.querySelector<HTMLElement>(
        '#colab-loading',
      );

    const content =
      document.querySelector<HTMLElement>(
        '#colab-content',
      );

    const {
      data: profile,
      error,
    } =
      await supabase
        .from('member_profiles')
        .select(
          'display_name, github_login, bio, avatar_url, area, skills, availability',
        )
        .eq(
          'user_id',
          session.user.id,
        )
        .maybeSingle();

    if (error) {
      console.warn(
        '[EVRYLUX] Não foi possível carregar o perfil:',
        error.message,
      );
    }

    const welcome =
      document.querySelector<HTMLElement>(
        '#dashboard-welcome',
      );

    const name =
      document.querySelector<HTMLElement>(
        '#dashboard-name',
      );

    const area =
      document.querySelector<HTMLElement>(
        '#dashboard-area',
      );

    const github =
      document.querySelector<HTMLElement>(
        '#dashboard-github',
      );

    const availability =
      document.querySelector<HTMLElement>(
        '#dashboard-availability',
      );

    const skills =
      document.querySelector<HTMLElement>(
        '#dashboard-skills',
      );

    const avatar =
      document.querySelector<HTMLImageElement>(
        '#dashboard-avatar',
      );

    const placeholder =
      document.querySelector<HTMLElement>(
        '#dashboard-avatar-placeholder',
      );

    const adminDemoCard =
      document.querySelector<HTMLElement>(
        '#admin-demo-card',
      );

    const adminUsersCard =
      document.querySelector<HTMLElement>(
        '#admin-users-card',
      );

    const adminBadge =
      document.querySelector<HTMLElement>(
        '#dashboard-admin-badge',
      );

    const displayName =
      profile?.display_name?.trim() ||
      session.user.email ||
      'Colaborador EVRYLUX';

    if (welcome) {
      welcome.textContent =
        `Olá, ${displayName}. Esta é sua área dentro do projeto.`;
    }

    if (name) {
      name.textContent =
        displayName;
    }

    if (area) {
      area.textContent =
        profile?.area?.trim() ||
        'Configure sua área principal no perfil.';
    }

    if (github) {
      github.textContent =
        profile?.github_login
          ? `@${profile.github_login}`
          : 'Não informado';
    }

    if (availability) {
      availability.textContent =
        profile?.availability?.trim() ||
        'Não informada';
    }

    if (skills) {
      skills.textContent =
        profile?.skills?.trim() ||
        'Não informadas';
    }

    if (
      profile?.avatar_url?.trim() &&
      avatar
    ) {
      avatar.src =
        profile.avatar_url;

      avatar.alt =
        `Avatar de ${displayName}`;

      avatar.classList.remove(
        'member-hidden',
      );

      placeholder?.classList.add(
        'member-hidden',
      );

      avatar.addEventListener(
        'error',
        () => {
          avatar.classList.add(
            'member-hidden',
          );

          placeholder?.classList.remove(
            'member-hidden',
          );
        },
        {
          once: true,
        },
      );
    } else {
      avatar?.classList.add(
        'member-hidden',
      );

      placeholder?.classList.remove(
        'member-hidden',
      );
    }

    try {
      const admin =
        await isCurrentUserAdmin();

      if (admin) {
        adminBadge?.classList.remove(
          'member-hidden',
        );

        adminDemoCard?.classList.remove(
          'member-hidden',
        );

        adminUsersCard?.classList.remove(
          'member-hidden',
        );
      } else {
        adminBadge?.classList.add(
          'member-hidden',
        );

        adminDemoCard?.classList.add(
          'member-hidden',
        );

        adminUsersCard?.classList.add(
          'member-hidden',
        );
      }
    } catch (adminError) {
      adminBadge?.classList.add(
        'member-hidden',
      );

      adminDemoCard?.classList.add(
        'member-hidden',
      );

      adminUsersCard?.classList.add(
        'member-hidden',
      );

      console.warn(
        '[EVRYLUX] Não foi possível verificar permissões administrativas:',
        adminError,
      );
    }

    try {
      presenceDisconnect =
        await connectColabPresence(
          {
            user_id:
              session.user.id,

            display_name:
              displayName,

            avatar_url:
              profile?.avatar_url?.trim() ||
              null,

            area:
              profile?.area?.trim() ||
              null,

            github_login:
              profile?.github_login?.trim() ||
              null,
          },
          {
            onSync:
              (
                users,
              ) => {
                renderOnlineUsers(
                  users,
                  session.user.id,
                );
              },

            onJoin:
              (
                user,
              ) => {
                if (
                  user.user_id ===
                  session.user.id
                ) {
                  return;
                }

                showOnlineToast(
                  user,
                );
              },
          },
        );
    } catch (
      presenceError
    ) {
      console.warn(
        '[EVRYLUX] Não foi possível iniciar a presença online:',
        presenceError,
      );

      if (
        onlineList
      ) {
        onlineList.innerHTML = `
          <div class="dashboard-online-empty">
            <span class="dashboard-online-empty-dot"></span>

            <div>
              <strong>
                Presença indisponível
              </strong>

              <p>
                Não foi possível conectar ao status online neste momento.
              </p>
            </div>
          </div>
        `;
      }
    }

    const disconnectPresence =
      () => {
        if (
          presenceDisconnect
        ) {
          void presenceDisconnect();

          presenceDisconnect =
            null;
        }
      };

    window.addEventListener(
      'pagehide',
      disconnectPresence,
      {
        once: true,
      },
    );

    loading?.classList.add(
      'member-hidden',
    );

    content?.classList.remove(
      'member-hidden',
    );
  }
</script>

