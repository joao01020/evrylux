---
import Layout from '../../layouts/Layout.astro';
import ColabNav from '../../components/colab/ColabNav.astro';
import '../../styles/members.css';
---

<Layout
  title="Meu perfil — EVRYLUX Colab"
  description="Perfil interno de colaborador do projeto EVRYLUX."
>
  <main class="member-shell">
    <div
      id="profile-loading"
      class="member-container member-loading"
    >
      Carregando perfil...
    </div>

    <div
      id="profile-content"
      class="member-container member-hidden"
    >
      <div class="member-topbar">
        <div class="member-title-block">
          <div class="eyebrow">
            EVRYLUX Colab
          </div>

          <h1>
            Meu perfil
          </h1>

          <p>
            Essas informações serão usadas para organizar
            sua participação como colaborador no projeto.
          </p>
        </div>

        <ColabNav />
      </div>

      <div class="member-grid">
        <section class="member-card">
          <div class="member-card-inner">
            <form
              id="profile-form"
              class="member-form"
            >
              <div class="member-row">
                <div class="member-field">
                  <label for="display-name">
                    Nome público
                  </label>

                  <input
                    id="display-name"
                    type="text"
                    maxlength="80"
                    placeholder="Como você quer aparecer"
                  />
                </div>

                <div class="member-field">
                  <label for="github-login">
                    GitHub
                  </label>

                  <input
                    id="github-login"
                    type="text"
                    maxlength="80"
                    placeholder="seu-usuario"
                  />
                </div>
              </div>

              <div class="member-field">
                <label for="bio">
                  Sobre você
                </label>

                <textarea
                  id="bio"
                  maxlength="500"
                  placeholder="Uma descrição curta sobre você e sua participação no projeto."
                ></textarea>
              </div>

              <div class="member-row">
                <div class="member-field">
                  <label for="area">
                    Área principal
                  </label>

                  <input
                    id="area"
                    type="text"
                    maxlength="120"
                    placeholder="Ex.: Flutter / UI / Backend / Docs"
                  />
                </div>

                <div class="member-field">
                  <label for="availability">
                    Disponibilidade
                  </label>

                  <input
                    id="availability"
                    type="text"
                    maxlength="120"
                    placeholder="Ex.: fins de semana"
                  />
                </div>
              </div>

              <div class="member-field">
                <label for="skills">
                  Tecnologias / habilidades
                </label>

                <input
                  id="skills"
                  type="text"
                  maxlength="240"
                  placeholder="Flutter, Dart, Astro, Supabase..."
                />
              </div>

              <div class="member-field">
                <label>
                  Foto de perfil
                </label>

                <div class="profile-photo-control">
                  <div class="profile-photo-control-preview">
                    <div
                id="profile-upload-placeholder"
                class="default-profile-avatar default-profile-avatar-large"
                aria-label="Sem foto de perfil"
              >
                <img
                  class="default-profile-avatar-image"
                  src="/branding/default-profile-avatar.png"
                  alt=""
                  aria-hidden="true"
                  draggable="false"
                />
              </div>

                    <img
                      id="profile-upload-preview"
                      class="profile-upload-preview member-hidden"
                      alt=""
                    />
                  </div>

                  <div class="profile-photo-control-copy">
                    <strong>
                      Escolha uma foto
                    </strong>

                    <p>
                      JPG, PNG ou WebP de até 5 MB. A imagem será
                      recortada em formato circular.
                    </p>

                    <div class="profile-photo-actions">
                      <label
                        class="member-button profile-photo-button"
                        for="avatar-file"
                      >
                        Escolher foto
                      </label>

                      <button
                        id="remove-avatar"
                        class="profile-photo-remove"
                        type="button"
                      >
                        Remover foto
                      </button>
                    </div>

                    <input
                      id="avatar-file"
                      class="profile-file-input"
                      type="file"
                      accept="image/png,image/jpeg,image/webp"
                    />
                  </div>
                </div>
              </div>

              <button
                id="save-profile"
                class="member-button member-button-primary"
                type="submit"
              >
                Salvar perfil
              </button>
            </form>

            <div
              id="profile-status"
              class="member-status"
              role="status"
            ></div>
          </div>
        </section>

        <aside class="member-card">
          <div class="member-card-inner">
            <div class="member-profile-head">
              <div
                id="profile-avatar-placeholder"
                class="member-avatar-placeholder default-profile-avatar"
                aria-label="Sem foto de perfil"
              >
                <img
                  class="default-profile-avatar-image"
                  src="/branding/default-profile-avatar.png"
                  alt=""
                  aria-hidden="true"
                  draggable="false"
                />
              </div>

              <img
                id="profile-avatar-preview"
                class="member-avatar member-hidden"
                alt=""
              />

              <div>
                <span class="member-badge">
                  Perfil
                </span>

                <h2 id="preview-name">
                  Colaborador EVRYLUX
                </h2>

                <p
                  id="preview-github"
                  class="member-muted"
                >
                  GitHub não informado
                </p>
              </div>
            </div>

            <p
              id="preview-bio"
              class="profile-preview-bio"
            >
              Sua descrição aparecerá aqui.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </main>
</Layout>

<script>
  import {
    supabase,
  } from '../../lib/supabase';

  import {
    requireMemberSession,
  } from '../../lib/member-auth';

  const session =
    await requireMemberSession();

  const loading =
    document.querySelector<HTMLElement>(
      '#profile-loading',
    );

  const content =
    document.querySelector<HTMLElement>(
      '#profile-content',
    );

  const form =
    document.querySelector<HTMLFormElement>(
      '#profile-form',
    );

  const displayName =
    document.querySelector<HTMLInputElement>(
      '#display-name',
    );

  const githubLogin =
    document.querySelector<HTMLInputElement>(
      '#github-login',
    );

  const bio =
    document.querySelector<HTMLTextAreaElement>(
      '#bio',
    );

  const area =
    document.querySelector<HTMLInputElement>(
      '#area',
    );

  const availability =
    document.querySelector<HTMLInputElement>(
      '#availability',
    );

  const skills =
    document.querySelector<HTMLInputElement>(
      '#skills',
    );

  const avatarFile =
    document.querySelector<HTMLInputElement>(
      '#avatar-file',
    );

  const removeAvatarButton =
    document.querySelector<HTMLButtonElement>(
      '#remove-avatar',
    );

  const uploadPreview =
    document.querySelector<HTMLImageElement>(
      '#profile-upload-preview',
    );

  const uploadPlaceholder =
    document.querySelector<HTMLElement>(
      '#profile-upload-placeholder',
    );

  let currentAvatarUrl:
    string | null =
      null;

  let selectedAvatarFile:
    File | null =
      null;

  let removeAvatar =
    false;

  let localPreviewUrl:
    string | null =
      null;

  const saveButton =
    document.querySelector<HTMLButtonElement>(
      '#save-profile',
    );

  const status =
    document.querySelector<HTMLDivElement>(
      '#profile-status',
    );

  const previewName =
    document.querySelector<HTMLElement>(
      '#preview-name',
    );

  const previewGithub =
    document.querySelector<HTMLElement>(
      '#preview-github',
    );

  const previewBio =
    document.querySelector<HTMLElement>(
      '#preview-bio',
    );

  const previewAvatar =
    document.querySelector<HTMLImageElement>(
      '#profile-avatar-preview',
    );

  const previewPlaceholder =
    document.querySelector<HTMLElement>(
      '#profile-avatar-placeholder',
    );

  function showStatus(
    message: string,
    type: 'success' | 'error',
  ) {
    if (!status) {
      return;
    }

    status.textContent = message;
    status.className =
      `member-status show ${type}`;
  }

  function setAvatarPreview(
    avatar:
      string | null,
  ) {
    const hasAvatar =
      Boolean(
        avatar,
      );

    if (
      previewAvatar
    ) {
      if (
        hasAvatar &&
        avatar
      ) {
        previewAvatar.src =
          avatar;

        previewAvatar.alt =
          `Avatar de ${displayName?.value.trim() || 'colaborador EVRYLUX'}`;

        previewAvatar.classList.remove(
          'member-hidden',
        );
      } else {
        previewAvatar.removeAttribute(
          'src',
        );

        previewAvatar.classList.add(
          'member-hidden',
        );
      }
    }

    previewPlaceholder?.classList.toggle(
      'member-hidden',
      hasAvatar,
    );

    if (
      uploadPreview
    ) {
      if (
        hasAvatar &&
        avatar
      ) {
        uploadPreview.src =
          avatar;

        uploadPreview.alt =
          'Prévia da foto de perfil';

        uploadPreview.classList.remove(
          'member-hidden',
        );
      } else {
        uploadPreview.removeAttribute(
          'src',
        );

        uploadPreview.classList.add(
          'member-hidden',
        );
      }
    }

    uploadPlaceholder?.classList.toggle(
      'member-hidden',
      hasAvatar,
    );
  }

  function updatePreview() {
    if (previewName) {
      previewName.textContent =
        displayName?.value.trim() ||
        'Colaborador EVRYLUX';
    }

    if (previewGithub) {
      previewGithub.textContent =
        githubLogin?.value.trim()
          ? `@${githubLogin.value.trim()}`
          : 'GitHub não informado';
    }

    if (previewBio) {
      previewBio.textContent =
        bio?.value.trim() ||
        'Sua descrição aparecerá aqui.';
    }

    const avatar =
      removeAvatar
        ? null
        : localPreviewUrl ||
          currentAvatarUrl;

    setAvatarPreview(
      avatar,
    );
  }

  function clearLocalPreviewUrl() {
    if (
      localPreviewUrl
    ) {
      URL.revokeObjectURL(
        localPreviewUrl,
      );

      localPreviewUrl =
        null;
    }
  }

  function getAvatarExtension(
    file: File,
  ) {
    const byType:
      Record<string, string> = {
        'image/jpeg':
          'jpg',
        'image/png':
          'png',
        'image/webp':
          'webp',
      };

    return (
      byType[file.type] ??
      'jpg'
    );
  }

  async function uploadAvatar(
    file: File,
  ) {
    if (!session) {
      throw new Error(
        'Sessão não encontrada.',
      );
    }

    const extension =
      getAvatarExtension(
        file,
      );

    const path =
      `${session.user.id}/avatar-${Date.now()}.${extension}`;

    const {
      error: uploadError,
    } =
      await supabase.storage
        .from(
          'profile-avatars',
        )
        .upload(
          path,
          file,
          {
            cacheControl:
              '3600',

            upsert:
              false,

            contentType:
              file.type,
          },
        );

    if (
      uploadError
    ) {
      throw uploadError;
    }

    const {
      data,
    } =
      supabase.storage
        .from(
          'profile-avatars',
        )
        .getPublicUrl(
          path,
        );

    return data.publicUrl;
  }

  [
    displayName,
    githubLogin,
    bio,
  ].forEach(
    (input) => {
      input?.addEventListener(
        'input',
        updatePreview,
      );
    },
  );

  avatarFile?.addEventListener(
    'change',
    () => {
      const file =
        avatarFile.files?.[0] ??
        null;

      if (!file) {
        return;
      }

      const allowedTypes =
        [
          'image/jpeg',
          'image/png',
          'image/webp',
        ];

      if (
        !allowedTypes.includes(
          file.type,
        )
      ) {
        avatarFile.value =
          '';

        showStatus(
          'Escolha uma imagem JPG, PNG ou WebP.',
          'error',
        );

        return;
      }

      if (
        file.size >
        5 * 1024 * 1024
      ) {
        avatarFile.value =
          '';

        showStatus(
          'A foto deve ter no máximo 5 MB.',
          'error',
        );

        return;
      }

      clearLocalPreviewUrl();

      selectedAvatarFile =
        file;

      removeAvatar =
        false;

      localPreviewUrl =
        URL.createObjectURL(
          file,
        );

      updatePreview();
    },
  );

  removeAvatarButton?.addEventListener(
    'click',
    () => {
      clearLocalPreviewUrl();

      selectedAvatarFile =
        null;

      removeAvatar =
        true;

      if (
        avatarFile
      ) {
        avatarFile.value =
          '';
      }

      updatePreview();
    },
  );

  previewAvatar?.addEventListener(
    'error',
    () => {
      previewAvatar.classList.add(
        'member-hidden',
      );

      previewPlaceholder?.classList.remove(
        'member-hidden',
      );
    },
  );

  uploadPreview?.addEventListener(
    'error',
    () => {
      uploadPreview.classList.add(
        'member-hidden',
      );

      uploadPlaceholder?.classList.remove(
        'member-hidden',
      );
    },
  );

  if (session) {
    const {
      data: profile,
      error,
    } =
      await supabase
        .from('member_profiles')
        .select(
          'display_name, github_login, bio, avatar_url, area, skills, availability',
        )
        .eq(
          'user_id',
          session.user.id,
        )
        .maybeSingle();

    if (error) {
      showStatus(
        `Não foi possível carregar o perfil: ${error.message}`,
        'error',
      );
    }

    if (profile) {
      if (displayName) {
        displayName.value =
          profile.display_name ?? '';
      }

      if (githubLogin) {
        githubLogin.value =
          profile.github_login ?? '';
      }

      if (bio) {
        bio.value =
          profile.bio ?? '';
      }

      if (area) {
        area.value =
          profile.area ?? '';
      }

      if (availability) {
        availability.value =
          profile.availability ?? '';
      }

      if (skills) {
        skills.value =
          profile.skills ?? '';
      }

      currentAvatarUrl =
        profile.avatar_url?.trim() ||
        null;
    }

    updatePreview();

    loading?.classList.add(
      'member-hidden',
    );

    content?.classList.remove(
      'member-hidden',
    );
  }

  form?.addEventListener(
    'submit',
    async (event) => {
      event.preventDefault();

      if (!session) {
        return;
      }

      if (saveButton) {
        saveButton.disabled =
          true;

        saveButton.textContent =
          selectedAvatarFile
            ? 'Enviando foto...'
            : 'Salvando...';
      }

      try {
        let avatarUrl =
          removeAvatar
            ? null
            : currentAvatarUrl;

        if (
          selectedAvatarFile
        ) {
          avatarUrl =
            await uploadAvatar(
              selectedAvatarFile,
            );
        }

        if (
          saveButton
        ) {
          saveButton.textContent =
            'Salvando...';
        }

        const {
          error,
        } =
          await supabase
            .from(
              'member_profiles',
            )
            .upsert(
              {
                user_id:
                  session.user.id,

                display_name:
                  displayName?.value.trim() ||
                  null,

                github_login:
                  githubLogin?.value.trim() ||
                  null,

                bio:
                  bio?.value.trim() ||
                  null,

                avatar_url:
                  avatarUrl,

                area:
                  area?.value.trim() ||
                  null,

                skills:
                  skills?.value.trim() ||
                  null,

                availability:
                  availability?.value.trim() ||
                  null,

                updated_at:
                  new Date().toISOString(),
              },
              {
                onConflict:
                  'user_id',
              },
            );

        if (error) {
          throw error;
        }

        currentAvatarUrl =
          avatarUrl;

        selectedAvatarFile =
          null;

        removeAvatar =
          false;

        clearLocalPreviewUrl();

        if (
          avatarFile
        ) {
          avatarFile.value =
            '';
        }

        showStatus(
          'Perfil atualizado.',
          'success',
        );

        updatePreview();
      } catch (error: any) {
        console.error(
          '[EVRYLUX] Falha ao salvar perfil:',
          error,
        );

        showStatus(
          error?.message ||
          'Não foi possível salvar o perfil.',
          'error',
        );
      } finally {
        if (saveButton) {
          saveButton.disabled =
            false;

          saveButton.textContent =
            'Salvar perfil';
        }
      }
    },
  );

  window.addEventListener(
    'pagehide',
    clearLocalPreviewUrl,
  );

</script>

<style>
  .profile-preview-bio {
    margin: 24px 0 0;
    color: var(--text-soft);
    line-height: 1.75;
  }

  .default-profile-avatar {
    width: 72px;
    height: 72px;
    padding: 0;
    overflow: hidden;
    flex: 0 0 auto;
    border: 0;
    border-radius: 50%;
    background: transparent;
    box-shadow: none;
  }

  .default-profile-avatar-large {
    width: 92px;
    height: 92px;
  }

  .default-profile-avatar svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .default-profile-avatar .default-avatar-bg {
    fill: #a9abad;
  }

  .default-profile-avatar .default-avatar-person {
    fill: #eef6f3;
  }

  #profile-avatar-preview {
    width: 72px;
    height: 72px;
    flex: 0 0 auto;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid rgba(65,104,62,.1);
    box-shadow: 0 8px 24px rgba(54,92,51,.06);
  }

  .profile-photo-control {
    padding: 18px;
    display: flex;
    align-items: center;
    gap: 18px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background:
      linear-gradient(
        145deg,
        rgba(255,255,255,.88),
        rgba(239,248,235,.58)
      );
  }

  .profile-photo-control-preview {
    width: 92px;
    height: 92px;
    flex: 0 0 auto;
  }

  .profile-upload-preview {
    width: 92px;
    height: 92px;
    display: block;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid rgba(65,104,62,.1);
    box-shadow: 0 10px 30px rgba(54,92,51,.08);
  }

  .profile-photo-control-copy {
    min-width: 0;
  }

  .profile-photo-control-copy > strong {
    display: block;
    font-size: 13px;
  }

  .profile-photo-control-copy > p {
    max-width: 500px;
    margin: 6px 0 0;
    color: var(--text-soft);
    font-size: 10px;
    line-height: 1.55;
  }

  .profile-photo-actions {
    margin-top: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .profile-photo-button {
    min-height: 38px;
    cursor: pointer;
  }

  .profile-photo-remove {
    min-height: 38px;
    padding: 0 12px;
    border: 1px solid var(--border);
    border-radius: 11px;
    background: rgba(255,255,255,.72);
    color: var(--text-soft);
    font: inherit;
    font-size: 10px;
    font-weight: 750;
    cursor: pointer;
  }

  .profile-photo-remove:hover {
    color: var(--text);
    background: #fff;
  }

  .profile-file-input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  @media (max-width: 620px) {
    .profile-photo-control {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
