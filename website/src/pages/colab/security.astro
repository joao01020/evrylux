---
import Layout from '../../layouts/Layout.astro';
import ColabNav from '../../components/colab/ColabNav.astro';
import '../../styles/members.css';
---

<Layout
  title="Segurança — EVRYLUX Colab"
  description="Configure autenticação em dois fatores para proteger sua conta EVRYLUX."
>
  <main class="member-shell security-page">
    <div class="security-ambient" aria-hidden="true">
      <span class="security-orb security-orb-a"></span>
      <span class="security-orb security-orb-b"></span>
      <span class="security-grid"></span>
    </div>

    <div class="member-container security-container">
      <div class="member-topbar security-topbar">
        <div class="member-title-block security-title-block">
          <div class="eyebrow">
            EVRYLUX Colab
          </div>

          <h1>
            Segurança da conta
          </h1>

          <p>
            Proteja seu acesso com uma segunda camada de verificação.
            O 2FA ajuda a impedir que outra pessoa entre mesmo que sua senha seja descoberta.
          </p>
        </div>

        <ColabNav />
      </div>

      <section class="security-overview">
        <article class="security-overview-card security-overview-primary">
          <div class="overview-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path
                d="M12 3 5.5 6v5.2c0 4.1 2.7 7.7 6.5 9.8 3.8-2.1 6.5-5.7 6.5-9.8V6L12 3Z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linejoin="round"
              />
              <path
                d="M9.5 12.2 11.2 14l3.5-4"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </div>

          <div>
            <span class="overview-kicker">
              Proteção adicional
            </span>

            <strong>
              Autenticação em dois fatores
            </strong>

            <p>
              Use um aplicativo autenticador para gerar códigos temporários
              que só você consegue acessar.
            </p>
          </div>
        </article>

        <article class="security-overview-card">
          <div class="overview-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path
                d="M7 10V8a5 5 0 0 1 10 0v2"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
              />
              <rect
                x="5"
                y="10"
                width="14"
                height="10"
                rx="3"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
              />
              <circle
                cx="12"
                cy="15"
                r="1.4"
                fill="currentColor"
              />
            </svg>
          </div>

          <div>
            <span class="overview-kicker">
              Sessão atual
            </span>

            <strong id="security-state">
              Verificando...
            </strong>

            <p>
              O nível de segurança da sua sessão aparece aqui automaticamente.
            </p>
          </div>
        </article>

        <article class="security-overview-card">
          <div class="overview-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <circle
                cx="12"
                cy="12"
                r="8"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
              />
              <path
                d="M12 8v4l2.6 1.6"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </div>

          <div>
            <span class="overview-kicker">
              Códigos temporários
            </span>

            <strong>
              Expiram rapidamente
            </strong>

            <p>
              Os códigos TOTP mudam em poucos segundos e não podem ser reutilizados.
            </p>
          </div>
        </article>
      </section>

      <section class="security-layout">
        <article class="member-card security-main-card">
          <div class="member-card-inner">
            <div class="security-head">
              <div class="security-head-copy">
                <span class="security-badge">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      d="M7 10V8a5 5 0 0 1 10 0v2"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                    />
                    <rect
                      x="5"
                      y="10"
                      width="14"
                      height="10"
                      rx="3"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                    />
                  </svg>

                  2FA / MFA
                </span>

                <h2>
                  Aplicativo autenticador
                </h2>

                <p class="member-muted">
                  Compatível com Google Authenticator, Microsoft Authenticator,
                  Authy, 1Password e outros aplicativos compatíveis com TOTP.
                </p>
              </div>
            </div>

            <div id="loading-panel" class="security-panel security-panel-loading">
              <div class="security-icon security-icon-loading" aria-hidden="true">
                <span></span>
              </div>

              <div>
                <h3>
                  Verificando sua proteção
                </h3>

                <p>
                  Estamos conferindo o nível atual da sessão e se já existe
                  um autenticador configurado.
                </p>
              </div>
            </div>

            <div id="aal2-panel" class="security-panel security-panel-success" hidden>
              <div class="security-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path
                    d="m7.5 12.2 3 3.1 6-7"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </div>

              <div class="security-content">
                <div class="panel-heading-row">
                  <div>
                    <span class="panel-kicker">
                      Proteção confirmada
                    </span>

                    <h3>
                      Sessão protegida
                    </h3>
                  </div>

                  <span class="panel-state-pill">
                    AAL2 ativo
                  </span>
                </div>

                <p>
                  Sua sessão atual já confirmou o segundo fator.
                  Os recursos administrativos protegidos estão liberados.
                </p>

                <button
                  id="continue-button"
                  class="member-button member-button-primary security-primary-button"
                  type="button"
                >
                  Continuar
                  <span aria-hidden="true">→</span>
                </button>
              </div>
            </div>

            <div id="challenge-panel" class="security-panel" hidden>
              <div class="security-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path
                    d="M8 10V8a4 4 0 0 1 8 0v2"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                  />
                  <rect
                    x="6"
                    y="10"
                    width="12"
                    height="9"
                    rx="2.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                  />
                </svg>
              </div>

              <div class="security-content">
                <span class="panel-kicker">
                  Etapa de confirmação
                </span>

                <h3>
                  Confirme seu segundo fator
                </h3>

                <p>
                  Abra seu aplicativo autenticador e digite o código de
                  6 dígitos exibido nele.
                </p>

                <form id="challenge-form" class="security-code-form">
                  <label for="challenge-code">
                    Código do autenticador
                  </label>

                  <div class="security-code-row">
                    <input
                      id="challenge-code"
                      class="security-code"
                      type="text"
                      inputmode="numeric"
                      autocomplete="one-time-code"
                      maxlength="6"
                      placeholder="000000"
                      required
                    />

                    <button
                      id="challenge-submit"
                      class="member-button member-button-primary"
                      type="submit"
                    >
                      Verificar
                    </button>
                  </div>

                  <small>
                    O código muda automaticamente depois de alguns segundos.
                  </small>
                </form>
              </div>
            </div>

            <div id="enroll-panel" class="security-panel" hidden>
              <div class="security-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path
                    d="M12 3 5.5 6v5.2c0 4.1 2.7 7.7 6.5 9.8 3.8-2.1 6.5-5.7 6.5-9.8V6L12 3Z"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linejoin="round"
                  />
                  <path
                    d="M12 8v8M8 12h8"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                  />
                </svg>
              </div>

              <div class="security-content">
                <span class="panel-kicker">
                  Recomendado
                </span>

                <h3>
                  Ative a proteção em dois fatores
                </h3>

                <p>
                  Nenhum autenticador foi configurado para esta conta.
                  A configuração leva poucos minutos e adiciona uma camada
                  importante de proteção.
                </p>

                <button
                  id="start-enroll"
                  class="member-button member-button-primary security-primary-button"
                  type="button"
                >
                  Configurar autenticador
                  <span aria-hidden="true">→</span>
                </button>
              </div>
            </div>

            <div id="qr-panel" class="security-panel" hidden>
              <div class="security-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path
                    d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4z"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                  />
                  <path
                    d="M15 14h2v2h-2zM19 14h1v3h-3v3h-3v-2"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </div>

              <div class="security-content">
                <span class="panel-kicker">
                  Etapa 1 de 2
                </span>

                <h3>
                  Escaneie o QR Code
                </h3>

                <p>
                  Abra seu aplicativo autenticador e use a opção de adicionar
                  uma nova conta escaneando o código abaixo.
                </p>

                <div class="qr-content-grid">
                  <div class="qr-wrap">
                    <div class="qr-corners" aria-hidden="true"></div>
                    <img id="mfa-qr" alt="QR Code para configurar 2FA" />
                  </div>

                  <div class="qr-copy">
                    <div class="secret-box">
                      <span>
                        Chave manual
                      </span>

                      <code id="mfa-secret">
                        —
                      </code>
                    </div>

                    <div class="qr-tip">
                      <span class="qr-tip-icon" aria-hidden="true">
                        i
                      </span>

                      <p>
                        Se não puder escanear o QR Code, copie a chave manual
                        e adicione-a diretamente no aplicativo autenticador.
                      </p>
                    </div>
                  </div>
                </div>

                <div class="security-step-divider">
                  <span>
                    Etapa 2 de 2
                  </span>
                </div>

                <form id="enroll-form" class="security-code-form">
                  <label for="enroll-code">
                    Código gerado pelo aplicativo
                  </label>

                  <div class="security-code-row">
                    <input
                      id="enroll-code"
                      class="security-code"
                      type="text"
                      inputmode="numeric"
                      autocomplete="one-time-code"
                      maxlength="6"
                      placeholder="000000"
                      required
                    />

                    <button
                      id="enroll-submit"
                      class="member-button member-button-primary"
                      type="submit"
                    >
                      Ativar 2FA
                    </button>
                  </div>

                  <small>
                    Digite o primeiro código gerado para confirmar a configuração.
                  </small>
                </form>
              </div>
            </div>

            <div id="security-status" class="member-status" role="status"></div>
          </div>
        </article>

        <aside class="security-side-column">
          <article class="member-card security-side-card">
            <div class="member-card-inner">
              <div class="side-card-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path
                    d="M12 3 5.5 6v5.2c0 4.1 2.7 7.7 6.5 9.8 3.8-2.1 6.5-5.7 6.5-9.8V6L12 3Z"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linejoin="round"
                  />
                </svg>
              </div>

              <div class="eyebrow">
                Proteção administrativa
              </div>

              <h2>
                Segundo fator obrigatório
              </h2>

              <p class="member-muted">
                Administradores precisam confirmar o segundo fator antes
                de acessar operações sensíveis do portal.
              </p>

              <div class="protected-list">
                <div>
                  <span class="protected-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      <path d="M7 12.5 10.2 16 17 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>

                  <strong>
                    Gestão de administradores
                  </strong>
                </div>

                <div>
                  <span class="protected-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      <path d="M7 12.5 10.2 16 17 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>

                  <strong>
                    Fila do Demo
                  </strong>
                </div>

                <div>
                  <span class="protected-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      <path d="M7 12.5 10.2 16 17 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>

                  <strong>
                    Suporte administrativo
                  </strong>
                </div>

                <div>
                  <span class="protected-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      <path d="M7 12.5 10.2 16 17 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>

                  <strong>
                    Edição do roadmap
                  </strong>
                </div>
              </div>

              <p id="admin-note" class="admin-note" hidden>
                <span class="admin-note-dot" aria-hidden="true"></span>
                Sua conta possui papel de administrador. O 2FA é obrigatório
                para usar as ferramentas administrativas.
              </p>
            </div>
          </article>

          <article class="security-info-card">
            <div class="security-info-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.8"/>
                <path d="M12 10.5v5M12 7.5v.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            </div>

            <div>
              <strong>
                Seu código não é sua senha
              </strong>

              <p>
                Nunca compartilhe os códigos temporários do autenticador.
                O EVRYLUX não precisa pedir esses códigos fora da tela de login ou segurança.
              </p>
            </div>
          </article>
        </aside>
      </section>
    </div>
  </main>
</Layout>

<script>
  import { supabase } from '../../lib/supabase';
  import {
    getMfaAalState,
    getVerifiedTotpFactor,
    hasAdminRole,
  } from '../../lib/mfa';

  const loadingPanel = document.querySelector<HTMLElement>('#loading-panel');
  const aal2Panel = document.querySelector<HTMLElement>('#aal2-panel');
  const challengePanel = document.querySelector<HTMLElement>('#challenge-panel');
  const enrollPanel = document.querySelector<HTMLElement>('#enroll-panel');
  const qrPanel = document.querySelector<HTMLElement>('#qr-panel');
  const stateLabel = document.querySelector<HTMLElement>('#security-state');
  const status = document.querySelector<HTMLElement>('#security-status');
  const adminNote = document.querySelector<HTMLElement>('#admin-note');

  const startEnroll = document.querySelector<HTMLButtonElement>('#start-enroll');
  const qrImage = document.querySelector<HTMLImageElement>('#mfa-qr');
  const secret = document.querySelector<HTMLElement>('#mfa-secret');

  const enrollForm = document.querySelector<HTMLFormElement>('#enroll-form');
  const enrollCode = document.querySelector<HTMLInputElement>('#enroll-code');
  const enrollSubmit = document.querySelector<HTMLButtonElement>('#enroll-submit');

  const challengeForm = document.querySelector<HTMLFormElement>('#challenge-form');
  const challengeCode = document.querySelector<HTMLInputElement>('#challenge-code');
  const challengeSubmit = document.querySelector<HTMLButtonElement>('#challenge-submit');
  const continueButton = document.querySelector<HTMLButtonElement>('#continue-button');

  let enrollmentFactorId = '';
  let verifiedFactorId = '';

  function nextUrl() {
    const params = new URLSearchParams(window.location.search);
    const value = params.get('next');

    if (value && value.startsWith('/') && !value.startsWith('//')) {
      return value;
    }

    return '/colab';
  }

  function hidePanels() {
    for (const panel of [loadingPanel, aal2Panel, challengePanel, enrollPanel, qrPanel]) {
      if (panel) panel.hidden = true;
    }
  }

  function showStatus(message: string, type: 'success' | 'error' | '') {
    if (!status) return;
    status.textContent = message;
    status.className = type ? `member-status show ${type}` : 'member-status';
  }

  function normalizeCode(value: string) {
    return value.replace(/\D/g, '').slice(0, 6);
  }

  function qrSource(value: string) {
    const qr = value.trim();

    if (qr.startsWith('data:')) return qr;

    if (qr.startsWith('<svg')) {
      return 'data:image/svg+xml;charset=UTF-8,' + encodeURIComponent(qr);
    }

    return qr;
  }

  async function refreshState() {
    hidePanels();

    const { data: sessionData, error: sessionError } =
      await supabase.auth.getSession();

    if (sessionError || !sessionData.session) {
      window.location.href =
        `/login?next=${encodeURIComponent(window.location.pathname + window.location.search)}`;
      return;
    }

    try {
      const [aal, factor, admin] = await Promise.all([
        getMfaAalState(),
        getVerifiedTotpFactor(),
        hasAdminRole().catch(() => false),
      ]);

      if (adminNote) {
        adminNote.hidden = !admin;
      }

      if (aal.currentLevel === 'aal2') {
        if (stateLabel) {
          stateLabel.textContent = 'AAL2 ativo';
          stateLabel.classList.add('active');
        }

        if (aal2Panel) aal2Panel.hidden = false;
        return;
      }

      if (stateLabel) {
        stateLabel.textContent = 'AAL1';
        stateLabel.classList.remove('active');
      }

      if (factor) {
        verifiedFactorId = factor.id;
        if (challengePanel) challengePanel.hidden = false;
        challengeCode?.focus();
        return;
      }

      if (enrollPanel) enrollPanel.hidden = false;
    } catch (error) {
      console.error('[EVRYLUX] Falha ao verificar MFA:', error);
      showStatus('Não foi possível carregar as configurações de 2FA.', 'error');
    }
  }

  startEnroll?.addEventListener('click', async () => {
    startEnroll.disabled = true;
    showStatus('', '');

    try {
      const { data, error } = await supabase.auth.mfa.enroll({
        factorType: 'totp',
        friendlyName: 'EVRYLUX Authenticator',
      });

      if (error) throw error;

      enrollmentFactorId = data.id;

      if (qrImage) {
        qrImage.src = qrSource(data.totp.qr_code);
      }

      if (secret) {
        secret.textContent = data.totp.secret;
      }

      hidePanels();
      if (qrPanel) qrPanel.hidden = false;
      enrollCode?.focus();
    } catch (error) {
      console.error('[EVRYLUX] Falha ao iniciar MFA:', error);
      showStatus(
        error instanceof Error ? error.message : 'Não foi possível iniciar a configuração do 2FA.',
        'error',
      );
    } finally {
      startEnroll.disabled = false;
    }
  });

  enrollCode?.addEventListener('input', () => {
    enrollCode.value = normalizeCode(enrollCode.value);
  });

  challengeCode?.addEventListener('input', () => {
    challengeCode.value = normalizeCode(challengeCode.value);
  });

  enrollForm?.addEventListener('submit', async (event) => {
    event.preventDefault();

    const code = normalizeCode(enrollCode?.value ?? '');

    if (!enrollmentFactorId || code.length !== 6) {
      showStatus('Digite o código de 6 dígitos.', 'error');
      return;
    }

    if (enrollSubmit) {
      enrollSubmit.disabled = true;
      enrollSubmit.textContent = 'Ativando...';
    }

    try {
      const { data: challenge, error: challengeError } =
        await supabase.auth.mfa.challenge({
          factorId: enrollmentFactorId,
        });

      if (challengeError) throw challengeError;

      const { error: verifyError } =
        await supabase.auth.mfa.verify({
          factorId: enrollmentFactorId,
          challengeId: challenge.id,
          code,
        });

      if (verifyError) throw verifyError;

      showStatus('2FA ativado com sucesso. Sua sessão agora está em AAL2.', 'success');
      await refreshState();
    } catch (error) {
      console.error('[EVRYLUX] Falha ao ativar MFA:', error);
      showStatus('Código inválido ou expirado. Tente novamente.', 'error');
    } finally {
      if (enrollSubmit) {
        enrollSubmit.disabled = false;
        enrollSubmit.textContent = 'Ativar 2FA';
      }
    }
  });

  challengeForm?.addEventListener('submit', async (event) => {
    event.preventDefault();

    const code = normalizeCode(challengeCode?.value ?? '');

    if (!verifiedFactorId || code.length !== 6) {
      showStatus('Digite o código de 6 dígitos.', 'error');
      return;
    }

    if (challengeSubmit) {
      challengeSubmit.disabled = true;
      challengeSubmit.textContent = 'Verificando...';
    }

    try {
      const { error } =
        await supabase.auth.mfa.challengeAndVerify({
          factorId: verifiedFactorId,
          code,
        });

      if (error) throw error;

      window.location.href = nextUrl();
    } catch (error) {
      console.error('[EVRYLUX] Falha na verificação MFA:', error);
      showStatus('Código inválido ou expirado. Confira o autenticador.', 'error');
    } finally {
      if (challengeSubmit) {
        challengeSubmit.disabled = false;
        challengeSubmit.textContent = 'Verificar';
      }
    }
  });

  continueButton?.addEventListener('click', () => {
    window.location.href = nextUrl();
  });

  await refreshState();
</script>

<style is:global>
  [hidden] {
    display: none !important;
  }
</style>

<style>
  .security-page {
    position: relative;
    overflow: hidden;
  }

  .security-container {
    position: relative;
    z-index: 2;
  }

  .security-ambient {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .security-grid {
    position: absolute;
    inset: 0;
    opacity: .18;
    background-image:
      linear-gradient(rgba(95,157,89,.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(95,157,89,.055) 1px, transparent 1px);
    background-size: 76px 76px;
    mask-image:
      radial-gradient(circle at 72% 26%, black, transparent 72%);
  }

  .security-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(1px);
  }

  .security-orb-a {
    width: 520px;
    height: 520px;
    right: -180px;
    top: -250px;
    background:
      radial-gradient(
        circle,
        rgba(159,211,149,.18),
        rgba(223,241,218,.07) 60%,
        transparent 72%
      );
  }

  .security-orb-b {
    width: 360px;
    height: 360px;
    left: 24%;
