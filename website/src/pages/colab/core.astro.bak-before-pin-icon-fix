    transition:
      transform .16s ease,
      background .16s ease,
      border-color .16s ease !important;
  }

  .core-modal-close:hover {
    transform: translateY(-1px) !important;
    border-color: rgba(95,157,89,.24) !important;
    background: #fff !important;
  }

  #core-form {
    margin-top: 21px !important;
    display: grid !important;
    gap: 17px !important;
  }

  .core-field {
    display: grid !important;
    gap: 7px !important;
    margin: 0 !important;
  }

  .core-field > span {
    color: var(--text, #172019) !important;
    font-size: 10px !important;
    font-weight: 800 !important;
  }

  .core-field input,
  .core-field textarea {
    width: 100% !important;
    box-sizing: border-box !important;
    margin: 0 !important;
    border: 1px solid rgba(65,104,62,.13) !important;
    border-radius: 13px !important;
    background: rgba(255,255,255,.94) !important;
    color: var(--text, #172019) !important;
    font: inherit !important;
    font-size: 11px !important;
    outline: none !important;
    transition:
      border-color .16s ease,
      box-shadow .16s ease,
      background .16s ease !important;
  }

  .core-field input {
    min-height: 46px !important;
    padding: 0 13px !important;
  }

  .core-field textarea {
    min-height: 160px !important;
    padding: 13px !important;
    resize: vertical !important;
    line-height: 1.65 !important;
  }

  .core-field input::placeholder,
  .core-field textarea::placeholder {
    color: rgba(75,89,78,.50) !important;
  }

  .core-field input:focus,
  .core-field textarea:focus {
    border-color: rgba(95,157,89,.43) !important;
    background: #fff !important;
    box-shadow:
      0 0 0 4px rgba(159,211,149,.11) !important;
  }

  .core-pin-option {
    min-height: 72px !important;
    padding: 13px 14px !important;
    display: flex !important;
    align-items: flex-start !important;
    gap: 11px !important;
    box-sizing: border-box !important;
    border: 1px solid rgba(95,157,89,.12) !important;
    border-radius: 14px !important;
    background:
      linear-gradient(
