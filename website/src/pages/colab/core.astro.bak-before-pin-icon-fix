     EVRYLUX NÚCLEO — MODAL PREMIUM / RESPONSIVO
     ========================================================== */

  body.core-modal-open {
    overflow: hidden !important;
  }

  .core-modal {
    position: fixed !important;
    inset: 0 !important;
    z-index: 10000 !important;
    display: grid !important;
    place-items: center !important;
    padding: 22px !important;
    box-sizing: border-box !important;
    isolation: isolate !important;
  }

  .core-modal.member-hidden {
    display: none !important;
  }

  .core-modal-backdrop {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    border: 0 !important;
    background:
      radial-gradient(
        circle at 50% 15%,
        rgba(239,248,235,.12),
        transparent 36%
      ),
      rgba(18,27,20,.42) !important;
    backdrop-filter: blur(11px) saturate(105%) !important;
    -webkit-backdrop-filter: blur(11px) saturate(105%) !important;
    cursor: default !important;
  }

  .core-modal-card {
    width: min(650px, calc(100vw - 36px)) !important;
    max-height: min(760px, calc(100vh - 44px)) !important;
    position: relative !important;
    z-index: 1 !important;
    overflow-y: auto !important;
    overscroll-behavior: contain !important;
    padding: 26px !important;
    box-sizing: border-box !important;
    border: 1px solid rgba(65,104,62,.12) !important;
    border-radius: 24px !important;
    background:
      radial-gradient(
        circle at 92% 0%,
        rgba(223,241,218,.50),
        transparent 32%
      ),
      rgba(253,254,252,.985) !important;
    box-shadow:
      0 34px 95px rgba(23,32,25,.22),
      0 2px 10px rgba(23,32,25,.04) !important;
    scrollbar-width: thin;
  }

  .core-modal-head {
    display: flex !important;
    align-items: flex-start !important;
    justify-content: space-between !important;
    gap: 20px !important;
    padding-bottom: 18px !important;
    border-bottom: 1px solid rgba(65,104,62,.08) !important;
  }

  .core-modal-head > div {
    min-width: 0 !important;
  }

  .core-modal-head .section-kicker {
    display: inline-flex !important;
    min-height: 24px !important;
    padding: 0 9px !important;
    align-items: center !important;
    border: 1px solid rgba(95,157,89,.14) !important;
    border-radius: 999px !important;
    background: rgba(239,248,235,.78) !important;
    color: var(--primary-deep, #3b6939) !important;
    font-size: 8px !important;
    font-weight: 850 !important;
    letter-spacing: .08em !important;
    text-transform: uppercase !important;
  }

  .core-modal-head h2 {
    margin: 10px 0 0 !important;
    color: var(--text, #172019) !important;
    font-size: clamp(26px, 4vw, 34px) !important;
    line-height: 1.05 !important;
    letter-spacing: -.045em !important;
  }

  .core-modal-close {
    width: 38px !important;
    height: 38px !important;
    flex: 0 0 38px !important;
    display: grid !important;
    place-items: center !important;
