    border: 1px solid rgba(65,104,62,.11) !important;
    border-radius: 12px !important;
    background: rgba(248,251,246,.92) !important;
    color: var(--text, #172019) !important;
    font: inherit !important;
    font-size: 20px !important;
    line-height: 1 !important;
