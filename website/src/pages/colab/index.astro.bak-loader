---
import Layout from '../../layouts/Layout.astro';
import ColabNav from '../../components/colab/ColabNav.astro';
import '../../styles/members.css';
---

<Layout
  title="EVRYLUX Colab — Dashboard"
  description="Dashboard interno dos colaboradores do EVRYLUX."
>
  <main class="member-shell">
    <div
      id="colab-loading"
      class="member-container member-loading"
    >
      Carregando sua área...
    </div>

    <div
      id="colab-content"
      class="member-container member-hidden"
    >
      <div class="member-topbar">
        <div class="member-title-block">
          <div class="eyebrow">
            EVRYLUX Colab
          </div>

          <h1>
            Dashboard
          </h1>

          <p id="dashboard-welcome">
            Sua área dentro do projeto.
          </p>
        </div>

        <ColabNav />
      </div>

      <div class="member-grid">
        <section class="member-card">
          <div class="member-card-inner">
            <div class="dashboard-profile">
              <div
                id="dashboard-avatar-placeholder"
                class="member-avatar-placeholder default-profile-avatar"
                aria-label="Sem foto de perfil"
              >
                <img
                  class="default-profile-avatar-image"
                  src="/branding/default-profile-avatar.png"
                  alt=""
                  aria-hidden="true"
                  draggable="false"
                />
              </div>

              <img
                id="dashboard-avatar"
                class="member-avatar member-hidden"
                alt=""
              />

              <div>
                <div class="dashboard-role-badges">
                  <span class="member-badge">
                    Colaborador
                  </span>

                  <span
                    id="dashboard-admin-badge"
                    class="member-badge dashboard-admin-badge member-hidden"
                    title="Este colaborador possui acesso administrativo"
                  >
                    <svg
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        d="M12 3 5.5 6v5.2c0 4.1 2.7 7.7 6.5 9.8 3.8-2.1 6.5-5.7 6.5-9.8V6L12 3Z"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linejoin="round"
                      />

                      <path
                        d="m9.4 12.1 1.7 1.8 3.6-4"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>

                    Administrador
                  </span>
                </div>

                <h2 id="dashboard-name">
                  Perfil EVRYLUX
                </h2>

                <p
                  id="dashboard-area"
                  class="member-muted"
                >
                  Configure seu perfil para completar suas informações.
                </p>
              </div>
            </div>

            <div class="dashboard-summary">
              <div class="summary-box">
                <span>
                  GitHub
                </span>

                <strong id="dashboard-github">
                  —
                </strong>
              </div>

              <div class="summary-box">
                <span>
                  Disponibilidade
                </span>

                <strong id="dashboard-availability">
                  —
                </strong>
              </div>

              <div class="summary-box">
                <span>
                  Skills
                </span>

                <strong id="dashboard-skills">
                  —
                </strong>
              </div>
            </div>
          </div>
        </section>

        <aside class="member-card">
          <div class="member-card-inner">
            <h2>
              Acesso rápido
            </h2>

            <div class="member-links">
              <a
                class="member-link-card"
                href="/colab/profile"
              >
                <span>
                  Editar meu perfil
                </span>

                <span>
                  →
                </span>
              </a>

              <a
                class="member-link-card"
                href="/colab/security"
              >
                <span>
                  Segurança / 2FA
                </span>

                <span>
                  →
                </span>
              </a>

              <a
                class="member-link-card"
                href="/colab/studio"
              >
                <span>
                  Abrir Studio
                </span>

                <span>
                  →
                </span>
              </a>

              <a
                class="member-link-card"
                href="https://github.com/joao01020/evrylux"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>
                  Repositório
                </span>

                <span>
                  ↗
                </span>
              </a>
            </div>
          </div>
        </aside>
      </div>

      <section class="tools-section">
        <div class="tools-heading">
          <div>
            <div class="eyebrow">
              Ferramentas do portal
            </div>

            <h2>
              O que já está disponível para a equipe.
            </h2>

            <p>
              Acesse os recursos internos usados para organizar,
              acompanhar e operar o projeto.
            </p>
          </div>
        </div>

        <div class="tools-grid">
          <a
            class="tool-card member-card"
            href="/colab/studio"
          >
            <div class="tool-card-top">
              <span class="tool-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4 5.5h16v13H4z" fill="none" stroke="currentColor" stroke-width="1.8" rx="2"/>
                  <path d="M8 9h8M8 12h5M8 15h7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
              </span>

              <span class="tool-arrow">
                →
              </span>
            </div>

            <h3>
              Studio
            </h3>

            <p>
              Central de organização interna do projeto e acesso
              às ferramentas de trabalho da equipe.
            </p>
          </a>

          <a
            class="tool-card member-card"
            href="/colab/studio/roadmap"
          >
            <div class="tool-card-top">
              <span class="tool-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M5 19V8m7 11V5m7 14v-7" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>
                  <circle cx="5" cy="6" r="2" fill="none" stroke="currentColor" stroke-width="1.8"/>
                  <circle cx="12" cy="3" r="2" fill="none" stroke="currentColor" stroke-width="1.8"/>
                  <circle cx="19" cy="10" r="2" fill="none" stroke="currentColor" stroke-width="1.8"/>
                </svg>
              </span>

              <span class="tool-arrow">
                →
              </span>
            </div>

            <h3>
              Roadmap interno
            </h3>

            <p>
              Organize etapas, responsáveis, prioridades,
              prazos e progresso do desenvolvimento.
            </p>
          </a>

          <a
            class="tool-card member-card"
            href="/colab/support"
          >
            <div class="tool-card-top">
              <span class="tool-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M6.5 17.5h-1A2.5 2.5 0 0 1 3 15V9a9 9 0 0 1 18 0v6a2.5 2.5 0 0 1-2.5 2.5h-1" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  <path d="M7 16v-4a2 2 0 0 1 2-2h1v8H9a2 2 0 0 1-2-2Zm10 0v-4a2 2 0 0 0-2-2h-1v8h1a2 2 0 0 0 2-2Z" fill="none" stroke="currentColor" stroke-width="1.8"/>
                </svg>
              </span>

              <span class="tool-arrow">
                →
              </span>
            </div>

            <h3>
              Suporte
            </h3>

            <p>
              Acompanhe conversas de suporte e responda usuários
              diretamente pelo portal.
            </p>
          </a>

          <a
            id="admin-demo-card"
            class="tool-card member-card admin-tool member-hidden"
            href="/colab/demo"
          >
            <div class="tool-card-top">
              <span class="tool-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M5 4.5h14v15H5z" fill="none" stroke="currentColor" stroke-width="1.8" rx="2"/>
                  <path d="M8 8h8M8 12h8M8 16h5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  <circle cx="17" cy="16" r="2.2" fill="none" stroke="currentColor" stroke-width="1.6"/>
                </svg>
              </span>

              <span class="tool-arrow">
                →
              </span>
            </div>

            <h3>
              Fila do Demo
            </h3>

            <p>
              Veja os primeiros usuários interessados no demo,
              seus sistemas e disponibilidade para feedback.
            </p>
          </a>

          <a
            id="admin-users-card"
            class="tool-card member-card admin-tool"
            href="/colab/admins"
          >
            <div class="tool-card-top">
              <span class="tool-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="9" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.8"/>
                  <path d="M4 18a5 5 0 0 1 10 0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  <path d="M16 8h4M18 6v4M16 14h4M18 12v4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
              </span>

              <span class="tool-arrow">
                →
              </span>
            </div>

            <h3>
              Administradores
            </h3>

            <p>
              Gerencie quem pode acessar funções administrativas
              do portal EVRYLUX Colab.
            </p>
          </a>

          <a
            class="tool-card member-card"
            href="/colab/security"
          >
            <div class="tool-card-top">
              <span class="tool-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 3 5.5 6v5.2c0 4.1 2.7 7.7 6.5 9.8 3.8-2.1 6.5-5.7 6.5-9.8V6L12 3Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                  <path d="M9.5 12.2 11.2 14l3.5-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>

              <span class="tool-arrow">
                →
              </span>
            </div>

            <h3>
              Segurança / 2FA
            </h3>

            <p>
              Configure seu aplicativo autenticador e proteja
              sessões administrativas com AAL2.
            </p>
          </a>

          <a
            class="tool-card member-card"
            href="/contributors"
          >
            <div class="tool-card-top">
              <span class="tool-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="8" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.8"/>
                  <circle cx="17" cy="9" r="2.4" fill="none" stroke="currentColor" stroke-width="1.7"/>
                  <path d="M3.5 19a4.5 4.5 0 0 1 9 0M13.5 18.5a3.5 3.5 0 0 1 7 0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
              </span>

              <span class="tool-arrow">
                ↗
              </span>
            </div>

            <h3>
              Colaboradores
            </h3>

            <p>
              Consulte a participação pública e as contribuições
              registradas no projeto.
            </p>
          </a>
        </div>
      </section>
    </div>
  </main>
</Layout>

<script>
  import {
    supabase,
  } from '../../lib/supabase';

  import {
    requireMemberSession,
  } from '../../lib/member-auth';

  import {
    isCurrentUserAdmin,
  } from '../../lib/colab-admin';

  const session =
    await requireMemberSession();

  if (session) {
    const loading =
      document.querySelector<HTMLElement>(
        '#colab-loading',
      );

    const content =
      document.querySelector<HTMLElement>(
        '#colab-content',
      );

    const {
      data: profile,
      error,
    } =
      await supabase
        .from('member_profiles')
        .select(
          'display_name, github_login, bio, avatar_url, area, skills, availability',
        )
        .eq(
          'user_id',
          session.user.id,
        )
        .maybeSingle();

    if (error) {
      console.warn(
        '[EVRYLUX] Não foi possível carregar o perfil:',
        error.message,
      );
    }

    const welcome =
      document.querySelector<HTMLElement>(
        '#dashboard-welcome',
      );

    const name =
      document.querySelector<HTMLElement>(
        '#dashboard-name',
      );

    const area =
      document.querySelector<HTMLElement>(
        '#dashboard-area',
      );

    const github =
      document.querySelector<HTMLElement>(
        '#dashboard-github',
      );

    const availability =
      document.querySelector<HTMLElement>(
        '#dashboard-availability',
      );

    const skills =
      document.querySelector<HTMLElement>(
        '#dashboard-skills',
      );

    const avatar =
      document.querySelector<HTMLImageElement>(
        '#dashboard-avatar',
      );

    const placeholder =
      document.querySelector<HTMLElement>(
        '#dashboard-avatar-placeholder',
      );

    const adminDemoCard =
      document.querySelector<HTMLElement>(
        '#admin-demo-card',
      );

    const adminUsersCard =
      document.querySelector<HTMLElement>(
        '#admin-users-card',
      );

    const adminBadge =
      document.querySelector<HTMLElement>(
        '#dashboard-admin-badge',
      );

    const displayName =
      profile?.display_name?.trim() ||
      session.user.email ||
      'Colaborador EVRYLUX';

    if (welcome) {
      welcome.textContent =
        `Olá, ${displayName}. Esta é sua área dentro do projeto.`;
    }

    if (name) {
      name.textContent =
        displayName;
    }

    if (area) {
      area.textContent =
        profile?.area?.trim() ||
        'Configure sua área principal no perfil.';
    }

    if (github) {
      github.textContent =
        profile?.github_login
          ? `@${profile.github_login}`
          : 'Não informado';
    }

    if (availability) {
      availability.textContent =
        profile?.availability?.trim() ||
        'Não informada';
    }

    if (skills) {
      skills.textContent =
        profile?.skills?.trim() ||
        'Não informadas';
    }

    if (
      profile?.avatar_url?.trim() &&
      avatar
    ) {
      avatar.src =
        profile.avatar_url;

      avatar.alt =
        `Avatar de ${displayName}`;

      avatar.classList.remove(
        'member-hidden',
      );

      placeholder?.classList.add(
        'member-hidden',
      );

      avatar.addEventListener(
        'error',
        () => {
          avatar.classList.add(
            'member-hidden',
          );

          placeholder?.classList.remove(
            'member-hidden',
          );
        },
        {
          once: true,
        },
      );
    } else {
      avatar?.classList.add(
        'member-hidden',
      );

      placeholder?.classList.remove(
        'member-hidden',
      );
    }

    try {
      const admin =
        await isCurrentUserAdmin();

      if (admin) {
        adminBadge?.classList.remove(
          'member-hidden',
        );

        adminDemoCard?.classList.remove(
          'member-hidden',
        );

        adminUsersCard?.classList.remove(
          'member-hidden',
        );
      } else {
        adminBadge?.classList.add(
          'member-hidden',
        );

        adminDemoCard?.classList.add(
          'member-hidden',
        );

        adminUsersCard?.classList.add(
          'member-hidden',
        );
      }
    } catch (adminError) {
      adminBadge?.classList.add(
        'member-hidden',
      );

      adminDemoCard?.classList.add(
        'member-hidden',
      );

      adminUsersCard?.classList.add(
        'member-hidden',
      );

      console.warn(
        '[EVRYLUX] Não foi possível verificar permissões administrativas:',
        adminError,
      );
    }

    loading?.classList.add(
      'member-hidden',
    );

    content?.classList.remove(
      'member-hidden',
    );
  }
</script>

<style>
  .dashboard-profile {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .dashboard-profile h2 {
    margin: 10px 0 0;
  }

  .dashboard-profile p {
    margin: 7px 0 0;
  }

  .dashboard-summary {
    margin-top: 28px;

    display: grid;

    grid-template-columns:
      repeat(
        3,
        minmax(0, 1fr)
      );

    gap: 10px;
  }

  .summary-box {
    padding: 17px;

    border-radius: 16px;

    background:
      var(--surface-muted);

    border:
      1px solid
      rgba(
        65,
        104,
        62,
        0.08
      );
  }

  .summary-box span,
  .summary-box strong {
    display: block;
  }

  .summary-box span {
    color:
      var(--text-soft);

    font-size:
      11px;
  }

  .summary-box strong {
    margin-top: 7px;

    font-size:
      14px;
  }

  .tools-section {
    margin-top: 54px;
  }

  .tools-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
  }

  .tools-heading h2 {
    margin: 10px 0 0;

    max-width: 760px;

    font-size:
      clamp(
        28px,
        4vw,
        42px
      );

    letter-spacing:
      -0.04em;
  }

  .tools-heading p {
    max-width: 700px;

    margin:
      12px
      0
      0;

    color:
      var(--text-soft);

    line-height:
      1.7;
  }

  .tools-grid {
    margin-top: 24px;

    display: grid;

    grid-template-columns:
      repeat(
        3,
        minmax(
          0,
          1fr
        )
      );

    gap: 16px;
  }

  .tool-card {
    min-height: 220px;

    padding: 22px;

    display: flex;

    flex-direction: column;

    color:
      inherit;

    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .tool-card:hover {
    transform:
      translateY(-4px);

    border-color:
      var(--border-strong);

    box-shadow:
      0 16px 42px
      rgba(
        54,
        92,
        51,
        0.07
      );
  }

  .tool-card-top {
    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 12px;
  }

  .tool-icon {
    width: 42px;
    height: 42px;

    display: grid;

    place-items: center;

    border-radius: 12px;

    background:
      linear-gradient(
        145deg,
        rgba(255,255,255,.95),
        var(--primary-soft)
      );

    color:
      var(--primary-deep);

    border:
      1px solid
      rgba(
        95,
        157,
        89,
        .14
      );

    box-shadow:
      0 8px 22px
      rgba(
        54,
        92,
        51,
        .05
      );

    transition:
      transform .2s ease,
      box-shadow .2s ease;
  }

  .tool-icon svg {
    width: 21px;
    height: 21px;
    display: block;
  }

  .tool-arrow {
    color:
      var(--text-soft);

    font-size:
      15px;

    transition:
      transform 0.2s ease;
  }

  .tool-card:hover
  .tool-arrow {
    transform:
      translateX(3px);
  }

  .tool-card:hover
  .tool-icon {
    transform:
      translateY(-1px)
      scale(1.03);
  }

  .tool-card h3 {
    margin:
      24px
      0
      8px;

    font-size:
      18px;

    letter-spacing:
      -0.025em;
  }

  .tool-card p {
    margin: 0;

    color:
      var(--text-soft);

    line-height:
      1.68;

    font-size:
      13px;
  }

  .admin-tool {
    background:
      linear-gradient(
        145deg,
        rgba(
          255,
          255,
          255,
          0.9
        ),
        rgba(
          239,
          248,
          235,
          0.78
        )
      );
  }

  @media (
    max-width: 980px
  ) {
    .tools-grid {
      grid-template-columns:
        repeat(
          2,
          minmax(
            0,
            1fr
          )
        );
    }
  }

  @media (
    max-width: 860px
  ) {
    .dashboard-summary {
      grid-template-columns:
        1fr;
    }
  }

  @media (
    max-width: 620px
  ) {
    .tools-grid {
      grid-template-columns:
        1fr;
    }
  }

  .default-profile-avatar {
    width: 72px;
    height: 72px;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: 50%;
    background: transparent;
    box-shadow: none;
  }

  .default-profile-avatar svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .default-profile-avatar .default-avatar-bg {
    fill: #a9abad;
  }

  .default-profile-avatar .default-avatar-person {
    fill: #eef6f3;
  }

  #dashboard-avatar {
    width: 72px;
    height: 72px;
    flex: 0 0 auto;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid rgba(65,104,62,.1);
    box-shadow: 0 8px 24px rgba(54,92,51,.06);
  }


  .dashboard-role-badges {
    display: flex;
    align-items: center;
    gap: 7px;
    flex-wrap: wrap;
  }

  .dashboard-admin-badge {
    min-height: 28px;
    padding: 0 10px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 1px solid rgba(95,157,89,.22);
    border-radius: 999px;
    background:
      linear-gradient(
        180deg,
        rgba(223,241,218,.96),
        rgba(204,232,197,.84)
      );
    color: var(--primary-deep);
    box-shadow: 0 6px 18px rgba(54,92,51,.055);
    font-size: 10px;
    font-weight: 850;
  }

  .dashboard-admin-badge svg {
    width: 14px;
    height: 14px;
    flex: 0 0 auto;
  }

</style>
