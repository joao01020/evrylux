---
import Layout from '../../layouts/Layout.astro';
import ColabNav from '../../components/colab/ColabNav.astro';
import '../../styles/members.css';
import EvryluxNeuralLoader from '../../components/ui/EvryluxNeuralLoader.astro';
---

<Layout
  title="Meu perfil — EVRYLUX Colab"
  description="Perfil interno de colaborador do projeto EVRYLUX."
>
  <main class="member-shell profile-page">
    <EvryluxNeuralLoader
      id="profile-loading"
      size="md"
    />

    <div
      id="profile-content"
      class="member-container member-hidden"
    >
      <div class="member-topbar profile-topbar">
        <div class="member-title-block">
          <div class="eyebrow">
            EVRYLUX Colab
          </div>

          <h1>
            Meu perfil
          </h1>

          <p>
            Organize sua identidade, sua participação no projeto e a segurança
            da sua conta em um só lugar.
          </p>
        </div>

        <ColabNav />
      </div>

      <section class="profile-overview-grid">
        <article class="member-card profile-preview-card">
          <div class="member-card-inner">
            <div class="profile-preview-layout">
              <div class="profile-preview-avatar-wrap">
                <div
                  id="profile-avatar-placeholder"
                  class="member-avatar-placeholder default-profile-avatar default-profile-avatar-preview"
                  aria-label="Sem foto de perfil"
                >
                  <img
                    class="default-profile-avatar-image"
                    src="/branding/default-profile-avatar.png"
                    alt=""
                    aria-hidden="true"
                    draggable="false"
                  />
                </div>

                <img
                  id="profile-avatar-preview"
                  class="member-avatar member-hidden"
                  alt=""
                />
              </div>

              <div class="profile-preview-copy">
                <span class="member-badge">
                  Perfil
                </span>

                <h2 id="preview-name">
                  Colaborador EVRYLUX
                </h2>

                <p
                  id="preview-github"
                  class="member-muted"
                >
                  GitHub não informado
                </p>

                <p
                  id="preview-bio"
                  class="profile-preview-bio"
                >
                  Sua descrição aparecerá aqui.
                </p>
              </div>
            </div>
          </div>
        </article>

        <article class="profile-tip-card">
          <div class="profile-tip-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path
                d="M12 3 5.5 6v5.2c0 4.1 2.7 7.7 6.5 9.8 3.8-2.1 6.5-5.7 6.5-9.8V6L12 3Z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linejoin="round"
              />
              <path
                d="M9.5 12.2 11.2 14l3.5-4"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </div>

          <div>
            <span>
              Perfil completo
            </span>

            <strong>
              Mantenha seus dados atualizados
            </strong>

            <p>
              Essas informações ajudam a equipe a entender sua área, disponibilidade
              e como você participa do projeto.
            </p>
          </div>
        </article>
      </section>

      <section class="profile-settings-grid">
        <article class="member-card profile-main-card">
          <div class="member-card-inner">
            <div class="section-heading">
              <span class="section-kicker">
                Informações pessoais
              </span>

              <h2>
                Identidade e participação
              </h2>

              <p>
                Defina como você aparece no EVRYLUX Colab e informe os dados
                mais úteis para o trabalho em equipe.
              </p>
            </div>

            <form
              id="profile-form"
              class="member-form profile-form-modern"
            >
              <div class="form-section">
                <div class="form-section-head">
                  <span class="form-section-index">
                    01
                  </span>

                  <div>
                    <strong>
                      Identidade
                    </strong>

                    <p>
                      Nome, GitHub e uma breve apresentação.
                    </p>
                  </div>
                </div>

                <div class="member-row">
                  <div class="member-field">
                    <label for="display-name">
                      Nome público
                    </label>

                    <input
                      id="display-name"
                      type="text"
                      maxlength="80"
                      placeholder="Como você quer aparecer"
                    />
                  </div>

                  <div class="member-field">
                    <label for="github-login">
                      GitHub
                    </label>

                    <input
                      id="github-login"
                      type="text"
                      maxlength="80"
                      placeholder="seu-usuario"
                    />
                  </div>
                </div>

                <div class="member-field">
                  <label for="bio">
                    Sobre você
                  </label>

                  <textarea
                    id="bio"
                    maxlength="500"
                    placeholder="Uma descrição curta sobre você e sua participação no projeto."
                  ></textarea>
                </div>
              </div>

              <div class="form-section">
                <div class="form-section-head">
                  <span class="form-section-index">
                    02
                  </span>

                  <div>
                    <strong>
                      Participação
                    </strong>

                    <p>
                      Área principal, disponibilidade e habilidades.
                    </p>
                  </div>
                </div>

                <div class="member-row">
                  <div class="member-field">
                    <label for="area">
                      Área principal
                    </label>

                    <input
                      id="area"
                      type="text"
                      maxlength="120"
                      placeholder="Ex.: Flutter / UI / Backend / Docs"
                    />
                  </div>

                  <div class="member-field">
                    <label for="availability">
                      Disponibilidade
                    </label>

                    <input
                      id="availability"
                      type="text"
                      maxlength="120"
                      placeholder="Ex.: fins de semana"
                    />
                  </div>
                </div>

                <div class="member-field">
                  <label for="skills">
                    Tecnologias / habilidades
                  </label>

                  <input
                    id="skills"
                    type="text"
                    maxlength="240"
                    placeholder="Flutter, Dart, Astro, Supabase..."
                  />
                </div>
              </div>

              <div class="form-section">
                <div class="form-section-head">
                  <span class="form-section-index">
                    03
                  </span>

                  <div>
                    <strong>
                      Foto de perfil
                    </strong>

                    <p>
                      Personalize como você aparece para a equipe.
                    </p>
                  </div>
                </div>

                <div class="profile-photo-control">
                  <div class="profile-photo-control-preview">
                    <div
                      id="profile-upload-placeholder"
                      class="default-profile-avatar default-profile-avatar-large"
                      aria-label="Sem foto de perfil"
                    >
                      <img
                        class="default-profile-avatar-image"
                        src="/branding/default-profile-avatar.png"
                        alt=""
                        aria-hidden="true"
                        draggable="false"
                      />
                    </div>

                    <img
                      id="profile-upload-preview"
                      class="profile-upload-preview member-hidden"
                      alt=""
                    />
                  </div>

                  <div class="profile-photo-control-copy">
                    <strong>
                      Sua imagem
                    </strong>

                    <p>
                      JPG, PNG ou WebP de até 5 MB. A imagem será exibida
                      em formato circular.
                    </p>

                    <div class="profile-photo-actions">
                      <label
                        class="member-button profile-photo-button"
                        for="avatar-file"
                      >
                        Escolher foto
                      </label>

                      <button
                        id="remove-avatar"
                        class="profile-photo-remove"
                        type="button"
                      >
                        Remover foto
                      </button>
                    </div>

                    <input
                      id="avatar-file"
                      class="profile-file-input"
                      type="file"
                      accept="image/png,image/jpeg,image/webp"
                    />
                  </div>
                </div>
              </div>

              <div class="profile-form-footer">
                <div>
                  <strong>
                    Tudo pronto?
                  </strong>

                  <p>
                    Salve para atualizar seu perfil em todo o portal.
                  </p>
                </div>

                <button
                  id="save-profile"
                  class="member-button member-button-primary"
                  type="submit"
                >
                  Salvar perfil
                </button>
              </div>
            </form>

            <div
              id="profile-status"
              class="member-status"
              role="status"
            ></div>
          </div>
        </article>

        <aside class="profile-side-column">
          <article class="member-card password-card">
            <div class="member-card-inner">
              <div class="password-card-head">
                <div class="password-card-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path
                      d="M7 10V8a5 5 0 0 1 10 0v2"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                    />
                    <rect
                      x="5"
                      y="10"
                      width="14"
                      height="10"
                      rx="3"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                    />
                    <path
                      d="M12 14v2.5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                    />
                  </svg>
                </div>

                <div>
                  <div class="eyebrow">
                    Segurança
                  </div>

                  <h2>
                    Alterar senha
                  </h2>

                  <p>
                    Confirme sua senha atual antes de definir uma nova.
                  </p>
                </div>
              </div>

              <form
                id="password-form"
                class="password-form"
              >
                <div class="member-field">
                  <label for="current-password">
                    Senha atual
                  </label>

                  <div class="password-input-wrap">
                    <input
                      id="current-password"
                      type="password"
                      autocomplete="current-password"
                      placeholder="Digite sua senha atual"
                      required
                    />

                    <button
                      class="password-toggle"
                      type="button"
                      data-password-toggle="current-password"
                      aria-label="Mostrar senha atual"
                    >
                      Mostrar
                    </button>
                  </div>
                </div>

                <div class="member-field">
                  <label for="new-password">
                    Nova senha
                  </label>

                  <div class="password-input-wrap">
                    <input
                      id="new-password"
                      type="password"
                      autocomplete="new-password"
                      minlength="8"
                      placeholder="Mínimo de 8 caracteres"
                      required
                    />

                    <button
                      class="password-toggle"
                      type="button"
                      data-password-toggle="new-password"
                      aria-label="Mostrar nova senha"
                    >
                      Mostrar
                    </button>
                  </div>

                  <div
                    id="password-strength"
                    class="password-strength"
                    aria-live="polite"
                  >
                    <span class="password-strength-bar">
                      <span id="password-strength-fill"></span>
                    </span>

                    <small id="password-strength-label">
                      Use pelo menos 8 caracteres.
                    </small>
                  </div>
                </div>

                <div class="member-field">
                  <label for="confirm-password">
                    Confirmar nova senha
                  </label>

                  <div class="password-input-wrap">
                    <input
                      id="confirm-password"
                      type="password"
                      autocomplete="new-password"
                      minlength="8"
                      placeholder="Repita a nova senha"
                      required
                    />

                    <button
                      class="password-toggle"
                      type="button"
                      data-password-toggle="confirm-password"
                      aria-label="Mostrar confirmação da nova senha"
                    >
                      Mostrar
                    </button>
                  </div>
                </div>

                <div class="password-security-note">
                  <span aria-hidden="true">✓</span>

                  <p>
                    A senha atual será validada antes da alteração.
                  </p>
                </div>

                <button
                  id="change-password"
                  class="member-button member-button-primary password-submit"
                  type="submit"
                >
                  Alterar senha
                </button>
              </form>

              <div
                id="password-status"
                class="member-status"
                role="status"
              ></div>
            </div>
          </article>

          <article class="security-note-card">
            <div class="security-note-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <circle
                  cx="12"
                  cy="12"
                  r="8"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                />

                <path
                  d="M12 10.5v5M12 7.5v.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                />
              </svg>
            </div>

            <div>
              <strong>
                Dica de segurança
              </strong>

              <p>
                Evite reutilizar a mesma senha em outros serviços e mantenha o
                2FA ativado para proteger áreas administrativas.
              </p>
            </div>
          </article>
        </aside>
      </section>
    </div>
  </main>
</Layout>

<script>
  import {
    supabase,
  } from '../../lib/supabase';

  import {
    requireMemberSession,
  } from '../../lib/member-auth';

  const session =
    await requireMemberSession();

  const loading =
    document.querySelector<HTMLElement>(
      '#profile-loading',
    );

  const content =
    document.querySelector<HTMLElement>(
      '#profile-content',
    );

  const form =
    document.querySelector<HTMLFormElement>(
      '#profile-form',
    );

  const displayName =
    document.querySelector<HTMLInputElement>(
      '#display-name',
    );

  const githubLogin =
    document.querySelector<HTMLInputElement>(
      '#github-login',
    );

  const bio =
    document.querySelector<HTMLTextAreaElement>(
      '#bio',
    );

  const area =
    document.querySelector<HTMLInputElement>(
      '#area',
    );

  const availability =
    document.querySelector<HTMLInputElement>(
      '#availability',
    );

  const skills =
    document.querySelector<HTMLInputElement>(
      '#skills',
    );

  const avatarFile =
    document.querySelector<HTMLInputElement>(
      '#avatar-file',
    );

  const removeAvatarButton =
    document.querySelector<HTMLButtonElement>(
      '#remove-avatar',
    );

  const uploadPreview =
    document.querySelector<HTMLImageElement>(
      '#profile-upload-preview',
    );

  const uploadPlaceholder =
    document.querySelector<HTMLElement>(
      '#profile-upload-placeholder',
    );

  let currentAvatarUrl:
    string | null =
      null;

  let selectedAvatarFile:
    File | null =
      null;

  let removeAvatar =
    false;

  let localPreviewUrl:
    string | null =
      null;

  const saveButton =
    document.querySelector<HTMLButtonElement>(
      '#save-profile',
    );

  const status =
    document.querySelector<HTMLDivElement>(
      '#profile-status',
    );

  const passwordForm =
    document.querySelector<HTMLFormElement>(
      '#password-form',
    );

  const currentPassword =
    document.querySelector<HTMLInputElement>(
      '#current-password',
    );

  const newPassword =
    document.querySelector<HTMLInputElement>(
      '#new-password',
    );

  const confirmPassword =
    document.querySelector<HTMLInputElement>(
      '#confirm-password',
    );

  const changePasswordButton =
    document.querySelector<HTMLButtonElement>(
      '#change-password',
    );

  const passwordStatus =
    document.querySelector<HTMLDivElement>(
      '#password-status',
    );

  const passwordStrengthFill =
    document.querySelector<HTMLElement>(
      '#password-strength-fill',
    );

  const passwordStrengthLabel =
    document.querySelector<HTMLElement>(
      '#password-strength-label',
    );

  const previewName =
    document.querySelector<HTMLElement>(
      '#preview-name',
    );

  const previewGithub =
    document.querySelector<HTMLElement>(
      '#preview-github',
    );

  const previewBio =
    document.querySelector<HTMLElement>(
      '#preview-bio',
    );

  const previewAvatar =
    document.querySelector<HTMLImageElement>(
      '#profile-avatar-preview',
    );

  const previewPlaceholder =
    document.querySelector<HTMLElement>(
      '#profile-avatar-placeholder',
    );

  function showStatus(
    message: string,
    type: 'success' | 'error',
  ) {
    if (!status) {
      return;
    }

    status.textContent = message;
    status.className =
      `member-status show ${type}`;
  }

  function showPasswordStatus(
    message: string,
    type:
      | 'success'
      | 'error',
  ) {
    if (
      !passwordStatus
    ) {
      return;
    }

    passwordStatus.textContent =
      message;

    passwordStatus.className =
      `member-status show ${type}`;
  }

  function clearPasswordStatus() {
    if (
      !passwordStatus
    ) {
      return;
    }

    passwordStatus.textContent =
      '';

    passwordStatus.className =
      'member-status';
  }

  function getPasswordStrength(
    password: string,
  ) {
    let score =
      0;

    if (
      password.length >=
      8
    ) {
      score += 1;
    }

    if (
      password.length >=
      12
    ) {
      score += 1;
    }

    if (
      /[a-z]/.test(
        password,
      ) &&
      /[A-Z]/.test(
        password,
      )
    ) {
      score += 1;
    }

    if (
      /\d/.test(
        password,
      )
    ) {
      score += 1;
    }

    if (
      /[^A-Za-z0-9]/.test(
        password,
      )
    ) {
      score += 1;
    }

    return Math.min(
      score,
      5,
    );
  }

  function updatePasswordStrength() {
    const password =
      newPassword?.value ??
      '';

    const strength =
      getPasswordStrength(
        password,
      );

    const percentages =
      [
        0,
        20,
        40,
        60,
        80,
        100,
      ];

    const labels =
      [
        'Use pelo menos 8 caracteres.',
        'Senha fraca',
        'Senha razoável',
        'Senha boa',
        'Senha forte',
        'Senha muito forte',
      ];

    if (
      passwordStrengthFill
    ) {
      passwordStrengthFill.style.width =
        `${percentages[strength]}%`;

      passwordStrengthFill.dataset.strength =
        String(
          strength,
        );
    }

    if (
      passwordStrengthLabel
    ) {
      passwordStrengthLabel.textContent =
        labels[strength];
    }
  }

  document
    .querySelectorAll<HTMLButtonElement>(
      '[data-password-toggle]',
    )
    .forEach(
      (
        button,
      ) => {
        button.addEventListener(
          'click',
          () => {
            const targetId =
              button.dataset.passwordToggle;

            if (
              !targetId
            ) {
              return;
            }

            const input =
              document.getElementById(
                targetId,
              ) as HTMLInputElement | null;

            if (
              !input
            ) {
              return;
            }

            const showing =
              input.type ===
              'text';

            input.type =
              showing
                ? 'password'
                : 'text';

            button.textContent =
              showing
                ? 'Mostrar'
                : 'Ocultar';

            button.setAttribute(
              'aria-label',
              showing
                ? 'Mostrar senha'
                : 'Ocultar senha',
            );
          },
        );
      },
    );

  newPassword?.addEventListener(
    'input',
    () => {
      clearPasswordStatus();
      updatePasswordStrength();
    },
  );

  currentPassword?.addEventListener(
    'input',
    clearPasswordStatus,
  );

  confirmPassword?.addEventListener(
    'input',
    clearPasswordStatus,
  );

  function setAvatarPreview(
    avatar:
      string | null,
  ) {
    const hasAvatar =
      Boolean(
        avatar,
      );

    if (
      previewAvatar
    ) {
      if (
        hasAvatar &&
        avatar
      ) {
        previewAvatar.src =
          avatar;

        previewAvatar.alt =
          `Avatar de ${displayName?.value.trim() || 'colaborador EVRYLUX'}`;

        previewAvatar.classList.remove(
          'member-hidden',
        );
      } else {
        previewAvatar.removeAttribute(
          'src',
        );

        previewAvatar.classList.add(
          'member-hidden',
        );
      }
    }

    previewPlaceholder?.classList.toggle(
      'member-hidden',
      hasAvatar,
    );

    if (
      uploadPreview
    ) {
      if (
        hasAvatar &&
        avatar
      ) {
        uploadPreview.src =
          avatar;

        uploadPreview.alt =
          'Prévia da foto de perfil';

        uploadPreview.classList.remove(
          'member-hidden',
        );
      } else {
        uploadPreview.removeAttribute(
          'src',
        );

        uploadPreview.classList.add(
          'member-hidden',
        );
      }
    }

    uploadPlaceholder?.classList.toggle(
      'member-hidden',
      hasAvatar,
    );
  }

  function updatePreview() {
    if (previewName) {
      previewName.textContent =
        displayName?.value.trim() ||
        'Colaborador EVRYLUX';
    }

    if (previewGithub) {
      previewGithub.textContent =
        githubLogin?.value.trim()
          ? `@${githubLogin.value.trim()}`
          : 'GitHub não informado';
    }

    if (previewBio) {
      previewBio.textContent =
        bio?.value.trim() ||
        'Sua descrição aparecerá aqui.';
    }

    const avatar =
      removeAvatar
        ? null
        : localPreviewUrl ||
          currentAvatarUrl;

    setAvatarPreview(
      avatar,
    );
  }

  function clearLocalPreviewUrl() {
    if (
      localPreviewUrl
    ) {
      URL.revokeObjectURL(
        localPreviewUrl,
      );

      localPreviewUrl =
        null;
    }
  }

  function getAvatarExtension(
    file: File,
  ) {
    const byType:
      Record<string, string> = {
        'image/jpeg':
          'jpg',
        'image/png':
          'png',
        'image/webp':
          'webp',
      };

    return (
      byType[file.type] ??
      'jpg'
    );
  }

  async function uploadAvatar(
    file: File,
  ) {
    if (!session) {
      throw new Error(
        'Sessão não encontrada.',
      );
    }

    const extension =
      getAvatarExtension(
        file,
      );

    const path =
      `${session.user.id}/avatar-${Date.now()}.${extension}`;

    const {
      error: uploadError,
    } =
      await supabase.storage
        .from(
          'profile-avatars',
        )
        .upload(
          path,
          file,
          {
            cacheControl:
              '3600',

            upsert:
              false,

            contentType:
              file.type,
          },
        );

    if (
      uploadError
    ) {
      throw uploadError;
    }

    const {
      data,
    } =
      supabase.storage
        .from(
          'profile-avatars',
        )
        .getPublicUrl(
          path,
        );

    return data.publicUrl;
  }

  [
    displayName,
    githubLogin,
    bio,
  ].forEach(
    (input) => {
      input?.addEventListener(
        'input',
        updatePreview,
      );
    },
  );

  avatarFile?.addEventListener(
    'change',
    () => {
      const file =
        avatarFile.files?.[0] ??
        null;

      if (!file) {
        return;
      }

      const allowedTypes =
        [
          'image/jpeg',
          'image/png',
          'image/webp',
        ];

      if (
        !allowedTypes.includes(
          file.type,
        )
      ) {
        avatarFile.value =
          '';

        showStatus(
          'Escolha uma imagem JPG, PNG ou WebP.',
          'error',
        );

        return;
      }

      if (
        file.size >
        5 * 1024 * 1024
      ) {
        avatarFile.value =
          '';

        showStatus(
          'A foto deve ter no máximo 5 MB.',
          'error',
        );

        return;
      }

      clearLocalPreviewUrl();

      selectedAvatarFile =
        file;

      removeAvatar =
        false;

      localPreviewUrl =
        URL.createObjectURL(
          file,
        );

      updatePreview();
    },
  );

  removeAvatarButton?.addEventListener(
    'click',
    () => {
      clearLocalPreviewUrl();

      selectedAvatarFile =
        null;

      removeAvatar =
        true;

      if (
        avatarFile
      ) {
        avatarFile.value =
          '';
      }

      updatePreview();
    },
  );

  previewAvatar?.addEventListener(
    'error',
    () => {
      previewAvatar.classList.add(
        'member-hidden',
      );

      previewPlaceholder?.classList.remove(
        'member-hidden',
      );
    },
  );

  uploadPreview?.addEventListener(
    'error',
    () => {
      uploadPreview.classList.add(
        'member-hidden',
      );

      uploadPlaceholder?.classList.remove(
        'member-hidden',
      );
    },
  );

  if (session) {
    const {
      data: profile,
      error,
    } =
      await supabase
        .from('member_profiles')
        .select(
          'display_name, github_login, bio, avatar_url, area, skills, availability',
        )
        .eq(
          'user_id',
          session.user.id,
        )
        .maybeSingle();

    if (error) {
      showStatus(
        `Não foi possível carregar o perfil: ${error.message}`,
        'error',
      );
    }

    if (profile) {
      if (displayName) {
        displayName.value =
          profile.display_name ?? '';
      }

      if (githubLogin) {
        githubLogin.value =
          profile.github_login ?? '';
      }

      if (bio) {
        bio.value =
          profile.bio ?? '';
      }

      if (area) {
        area.value =
          profile.area ?? '';
      }

      if (availability) {
        availability.value =
          profile.availability ?? '';
      }

      if (skills) {
        skills.value =
          profile.skills ?? '';
      }

      currentAvatarUrl =
        profile.avatar_url?.trim() ||
        null;
    }

    updatePreview();

    loading?.classList.add(
      'member-hidden',
    );

    content?.classList.remove(
      'member-hidden',
    );
  }

  form?.addEventListener(
    'submit',
    async (event) => {
      event.preventDefault();

      if (!session) {
        return;
      }

      if (saveButton) {
        saveButton.disabled =
          true;

        saveButton.textContent =
          selectedAvatarFile
            ? 'Enviando foto...'
            : 'Salvando...';
      }

      try {
        let avatarUrl =
          removeAvatar
            ? null
            : currentAvatarUrl;

        if (
          selectedAvatarFile
        ) {
          avatarUrl =
            await uploadAvatar(
              selectedAvatarFile,
            );
        }

        if (
          saveButton
        ) {
          saveButton.textContent =
            'Salvando...';
        }

        const {
          error,
        } =
          await supabase
            .from(
              'member_profiles',
            )
            .upsert(
              {
                user_id:
                  session.user.id,

                display_name:
                  displayName?.value.trim() ||
                  null,

                github_login:
                  githubLogin?.value.trim() ||
                  null,

                bio:
                  bio?.value.trim() ||
                  null,

                avatar_url:
                  avatarUrl,

                area:
                  area?.value.trim() ||
                  null,

                skills:
                  skills?.value.trim() ||
                  null,

                availability:
                  availability?.value.trim() ||
                  null,

                updated_at:
                  new Date().toISOString(),
              },
              {
                onConflict:
                  'user_id',
              },
            );

        if (error) {
          throw error;
        }

        currentAvatarUrl =
          avatarUrl;

        selectedAvatarFile =
          null;

        removeAvatar =
          false;

        clearLocalPreviewUrl();

        if (
          avatarFile
        ) {
          avatarFile.value =
            '';
        }

        showStatus(
          'Perfil atualizado.',
          'success',
        );

        updatePreview();
      } catch (error: any) {
        console.error(
          '[EVRYLUX] Falha ao salvar perfil:',
          error,
        );

        showStatus(
          error?.message ||
          'Não foi possível salvar o perfil.',
          'error',
        );
      } finally {
        if (saveButton) {
          saveButton.disabled =
            false;

          saveButton.textContent =
            'Salvar perfil';
        }
      }
    },
  );

  passwordForm?.addEventListener(
    'submit',
    async (
      event,
    ) => {
      event.preventDefault();

      clearPasswordStatus();

      if (
        !session ||
        !currentPassword ||
        !newPassword ||
        !confirmPassword ||
        !changePasswordButton
      ) {
        return;
      }

      const email =
        session.user.email;

      if (
        !email
      ) {
        showPasswordStatus(
          'Sua conta não possui um e-mail disponível para confirmar a senha atual.',
          'error',
        );

        return;
      }

      const current =
        currentPassword.value;

      const next =
        newPassword.value;

      const confirmation =
        confirmPassword.value;

      if (
        !current
      ) {
        showPasswordStatus(
          'Digite sua senha atual.',
          'error',
        );

        return;
      }

      if (
        next.length <
        8
      ) {
        showPasswordStatus(
          'A nova senha precisa ter pelo menos 8 caracteres.',
          'error',
        );

        return;
      }

      if (
        next !==
        confirmation
      ) {
        showPasswordStatus(
          'A confirmação da nova senha não corresponde.',
          'error',
        );

        return;
      }

      if (
        current ===
        next
      ) {
        showPasswordStatus(
          'A nova senha precisa ser diferente da senha atual.',
          'error',
        );

        return;
      }

      changePasswordButton.disabled =
        true;

      changePasswordButton.textContent =
        'Confirmando senha atual...';

      try {
        // Reautentica usando a senha atual.
        // A troca só continua se esta etapa for aceita pelo Supabase Auth.
        const {
          error:
            signInError,
        } =
          await supabase.auth
            .signInWithPassword(
              {
                email,
                password:
                  current,
              },
            );

        if (
          signInError
        ) {
          showPasswordStatus(
            'Senha atual incorreta.',
            'error',
          );

          return;
        }

        changePasswordButton.textContent =
          'Alterando senha...';

        const {
          error:
            updateError,
        } =
          await supabase.auth
            .updateUser(
              {
                password:
                  next,
              },
            );

        if (
          updateError
        ) {
          throw updateError;
        }

        currentPassword.value =
          '';

        newPassword.value =
          '';

        confirmPassword.value =
          '';

        updatePasswordStrength();

        showPasswordStatus(
          'Senha alterada com sucesso.',
          'success',
        );
      } catch (
        error: any
      ) {
        console.error(
          '[EVRYLUX] Falha ao alterar senha:',
          error,
        );

        showPasswordStatus(
          error?.message ||
          'Não foi possível alterar sua senha.',
          'error',
        );
      } finally {
        changePasswordButton.disabled =
          false;

        changePasswordButton.textContent =
          'Alterar senha';
      }
    },
  );

  window.addEventListener(
    'pagehide',
    clearLocalPreviewUrl,
  );

</script>

