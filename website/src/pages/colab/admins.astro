---
import Layout from '../../layouts/Layout.astro';
import ColabNav from '../../components/colab/ColabNav.astro';
import '../../styles/members.css';
---

<Layout
  title="Administradores — EVRYLUX Colab"
  description="Gerencie administradores e permissões do EVRYLUX Colab."
>
  <main class="member-shell admin-access-page">
    <div class="member-container">
      <div class="member-topbar">
        <div class="member-title-block">
          <div class="eyebrow">
            EVRYLUX Colab
          </div>

          <h1>
            Administradores
          </h1>

          <p>
            Controle quem pode acessar cada área administrativa sem entregar
            controle total da conta.
          </p>
        </div>

        <ColabNav />
      </div>

      <div
        id="admin-loading"
        class="member-card admin-loading-card"
      >
        <div class="member-card-inner">
          Verificando suas permissões...
        </div>
      </div>

      <section
        id="owner-setup"
        class="owner-setup member-hidden"
      >
        <article class="owner-setup-card">
          <div class="owner-shield" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path
                d="M12 3 5.5 6v5.2c0 4.1 2.7 7.7 6.5 9.8 3.8-2.1 6.5-5.7 6.5-9.8V6L12 3Z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linejoin="round"
              />
              <path
                d="M9 12.3 11.1 14.4 15.5 9.5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </div>

          <div>
            <span class="owner-kicker">
              Configuração inicial
            </span>

            <h2>
              Defina o proprietário do EVRYLUX Colab
            </h2>

            <p>
              Esta ação só funciona uma vez e apenas para uma conta que já
              possua papel de administrador. O proprietário terá controle total
              e não poderá ser removido por outros administradores.
            </p>

            <button
              id="claim-owner"
              type="button"
              class="member-button member-button-primary"
            >
              Tornar esta conta proprietária
            </button>
          </div>
        </article>
      </section>

      <div
        id="admin-content"
        class="member-hidden"
      >
        <section class="admin-summary-grid">
          <article class="summary-card summary-card-owner">
            <span class="summary-label">
              Proprietário
            </span>

            <strong id="owner-name">
              —
            </strong>

            <p>
              Controle total e permanente sobre a administração.
            </p>
          </article>

          <article class="summary-card">
            <span class="summary-label">
              Administradores
            </span>

            <strong id="admin-count">
              0
            </strong>

            <p>
              Contas com algum nível de acesso administrativo.
            </p>
          </article>

          <article class="summary-card">
            <span class="summary-label">
              Seu acesso
            </span>

            <strong id="my-admin-level">
              Administrador
            </strong>

            <p id="my-admin-copy">
              As ações disponíveis seguem suas permissões.
            </p>
          </article>
        </section>

        <section class="admin-layout">
          <div class="admin-main-column">
            <article
              id="add-admin-card"
              class="member-card member-hidden"
            >
              <div class="member-card-inner">
                <div class="section-heading">
                  <div>
                    <span class="section-kicker">
                      Novo acesso
                    </span>

                    <h2>
                      Adicionar administrador
                    </h2>

                    <p>
                      A conta precisa já existir no Supabase Auth.
                      O novo administrador começa sem permissões.
                    </p>
                  </div>
                </div>

                <form id="add-admin-form" class="add-admin-form">
                  <label for="admin-email">
                    E-mail da conta
                  </label>

                  <div class="add-admin-row">
                    <input
                      id="admin-email"
                      type="email"
                      autocomplete="email"
                      placeholder="colaborador@exemplo.com"
                      required
                    />

                    <button
                      id="lookup-admin-submit"
                      type="button"
                      class="member-button"
                    >
                      Consultar
                    </button>
                  </div>
                </form>

                <div
                  id="admin-preview"
                  class="admin-preview member-hidden"
                >
                  <div class="admin-preview-head">
                    <div
                      id="admin-preview-avatar"
                      class="admin-preview-avatar"
                    >
                      EV
                    </div>

                    <div class="admin-preview-identity">
                      <div class="admin-preview-role-row">
                        <span
                          id="admin-preview-role"
                          class="role-pill"
                        >
                          Usuário
                        </span>
                      </div>

                      <h3 id="admin-preview-name">
                        —
                      </h3>

                      <p id="admin-preview-email">
                        —
                      </p>
                    </div>
                  </div>

                  <div class="admin-preview-permissions">
                    <div class="permissions-editor-head">
                      <div>
                        <strong>
                          Permissões iniciais
                        </strong>

                        <p>
                          Marque o que este administrador poderá fazer antes de conceder o acesso.
                        </p>
                      </div>

                      <span
                        id="admin-preview-permissions-count"
                        class="permissions-count"
                      >
                        0 ativas
                      </span>
                    </div>

                    <div
                      id="admin-preview-permissions-list"
                      class="preview-permissions-list"
                    ></div>
                  </div>

                  <div class="admin-preview-actions">
                    <button
                      id="cancel-admin-preview"
                      type="button"
                      class="member-button"
                    >
                      Cancelar
                    </button>

                    <button
                      id="add-admin-submit"
                      type="button"
                      class="member-button member-button-primary"
                    >
                      Adicionar administrador
                    </button>
                  </div>
                </div>
              </div>
            </article>

            <article class="member-card administrators-card">
              <div class="member-card-inner">
                <div class="section-heading">
                  <div>
                    <span class="section-kicker">
                      Controle de acesso
                    </span>

                    <h2>
                      Equipe administrativa
                    </h2>

                    <p>
                      O proprietário tem acesso total. Os demais só recebem
                      as permissões selecionadas manualmente.
                    </p>
                  </div>
                </div>

                <div
                  id="admins-list"
                  class="admins-list"
                ></div>
              </div>
            </article>
          </div>

          <aside class="admin-side-column">
            <article class="member-card">
              <div class="member-card-inner">
                <div class="side-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path
                      d="M12 3 5.5 6v5.2c0 4.1 2.7 7.7 6.5 9.8 3.8-2.1 6.5-5.7 6.5-9.8V6L12 3Z"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linejoin="round"
                    />
                  </svg>
                </div>

                <div class="eyebrow">
                  Regra principal
                </div>

                <h2>
                  Menor privilégio
                </h2>

                <p class="member-muted">
                  Cada pessoa recebe apenas o acesso necessário para realizar
                  sua função. A autenticação AAL2 continua sendo uma camada
                  separada de segurança.
                </p>

                <div class="rule-list">
                  <div>
                    <span>01</span>
                    <strong>Proprietário não pode ser removido</strong>
                  </div>

                  <div>
                    <span>02</span>
                    <strong>Admins começam sem permissões</strong>
                  </div>

                  <div>
                    <span>03</span>
                    <strong>Só o proprietário altera permissões</strong>
                  </div>

                  <div>
                    <span>04</span>
                    <strong>Ações ficam registradas na auditoria</strong>
                  </div>
                </div>
              </div>
            </article>

            <article
              id="audit-card"
              class="member-card member-hidden"
            >
              <div class="member-card-inner">
                <div class="section-heading compact">
                  <div>
                    <span class="section-kicker">
                      Auditoria
                    </span>

                    <h2>
                      Atividade recente
                    </h2>
                  </div>
                </div>

                <div
                  id="audit-list"
                  class="audit-list"
                ></div>
              </div>
            </article>
          </aside>
        </section>
      </div>

      <div
        id="admin-status"
        class="member-status"
        role="status"
      ></div>
    </div>
  </main>
</Layout>

<script>
  import {
    supabase,
  } from '../../lib/supabase';

  import {
    ADMIN_PERMISSION_DEFINITIONS,
    addColabAdminByEmail,
    claimOwner,
    hasAdminPermission,
    isCurrentUserOwner,
    listAdminAudit,
    listColabAdmins,
    lookupColabUserForAdmin,
    removeColabAdmin,
    setColabAdminPermissions,
    type AdminPermission,
    type ColabAdmin,
  } from '../../lib/admin-permissions';

  const loading =
    document.querySelector<HTMLElement>(
      '#admin-loading',
    );

  const content =
    document.querySelector<HTMLElement>(
      '#admin-content',
    );

  const ownerSetup =
    document.querySelector<HTMLElement>(
      '#owner-setup',
    );

  const claimOwnerButton =
    document.querySelector<HTMLButtonElement>(
      '#claim-owner',
    );

  const ownerName =
    document.querySelector<HTMLElement>(
      '#owner-name',
    );

  const adminCount =
    document.querySelector<HTMLElement>(
      '#admin-count',
    );

  const myAdminLevel =
    document.querySelector<HTMLElement>(
      '#my-admin-level',
    );

  const myAdminCopy =
    document.querySelector<HTMLElement>(
      '#my-admin-copy',
    );

  const addAdminCard =
    document.querySelector<HTMLElement>(
      '#add-admin-card',
    );

  const addAdminForm =
    document.querySelector<HTMLFormElement>(
      '#add-admin-form',
    );

  const adminEmail =
    document.querySelector<HTMLInputElement>(
      '#admin-email',
    );

  const lookupAdminSubmit =
    document.querySelector<HTMLButtonElement>(
      '#lookup-admin-submit',
    );

  const addAdminSubmit =
    document.querySelector<HTMLButtonElement>(
      '#add-admin-submit',
    );

  const adminPreview =
    document.querySelector<HTMLElement>(
      '#admin-preview',
    );

  const adminPreviewAvatar =
    document.querySelector<HTMLElement>(
      '#admin-preview-avatar',
    );

  const adminPreviewRole =
    document.querySelector<HTMLElement>(
      '#admin-preview-role',
    );

  const adminPreviewName =
    document.querySelector<HTMLElement>(
      '#admin-preview-name',
    );

  const adminPreviewEmail =
    document.querySelector<HTMLElement>(
      '#admin-preview-email',
    );

  const adminPreviewPermissionsList =
    document.querySelector<HTMLElement>(
      '#admin-preview-permissions-list',
    );

  const adminPreviewPermissionsCount =
    document.querySelector<HTMLElement>(
      '#admin-preview-permissions-count',
    );

  const cancelAdminPreview =
    document.querySelector<HTMLButtonElement>(
      '#cancel-admin-preview',
    );

  const adminsList =
    document.querySelector<HTMLElement>(
      '#admins-list',
    );

  const auditCard =
    document.querySelector<HTMLElement>(
      '#audit-card',
    );

  const auditList =
    document.querySelector<HTMLElement>(
      '#audit-list',
    );

  const status =
    document.querySelector<HTMLElement>(
      '#admin-status',
    );

  let currentUserId =
    '';

  let currentIsOwner =
    false;

  let canManageAdmins =
    false;

  let canViewAudit =
    false;

  let previewUser:
    Awaited<
      ReturnType<
        typeof lookupColabUserForAdmin
      >
    > =
      null;

  function showStatus(
    message: string,
    type:
      | 'success'
      | 'error'
      | '' =
        '',
  ) {
    if (!status) {
      return;
    }

    status.textContent =
      message;

    status.className =
      type
        ? `member-status show ${type}`
        : 'member-status';
  }

  function escapeHtml(
    value: unknown,
  ) {
    return String(
      value ??
      '',
    )
      .replaceAll(
        '&',
        '&amp;',
      )
      .replaceAll(
        '<',
        '&lt;',
      )
      .replaceAll(
        '>',
        '&gt;',
      )
      .replaceAll(
        '"',
        '&quot;',
      )
      .replaceAll(
        "'",
        '&#039;',
      );
  }

  function initials(
    admin: ColabAdmin,
  ) {
    const value =
      admin.display_name ||
      admin.email ||
      'EV';

    return value
      .trim()
      .split(/\s+/)
      .slice(
        0,
        2,
      )
      .map(
        (
          part,
        ) =>
          part[0]?.toUpperCase() ??
          '',
      )
      .join('');
  }

  function renderPreviewPermissions(
    permissions:
      AdminPermission[],
  ) {
    if (
      !adminPreviewPermissionsList
    ) {
      return;
    }

    const groups =
      new Map<
        string,
        typeof ADMIN_PERMISSION_DEFINITIONS[number][]
      >();

    for (
      const definition
      of ADMIN_PERMISSION_DEFINITIONS
    ) {
      const list =
        groups.get(
          definition.group,
        ) ??
        [];

      list.push(
        definition,
      );

      groups.set(
        definition.group,
        list,
      );
    }

    adminPreviewPermissionsList.innerHTML =
      Array.from(
        groups.entries(),
      )
        .map(
          (
            [
              group,
              definitions,
            ],
          ) => `
            <div class="permission-group">
              <div class="permission-group-title">
                ${escapeHtml(group)}
              </div>

              <div class="permission-options">
                ${
                  definitions
                    .map(
                      (
                        permission,
                      ) => {
                        const checked =
                          permissions.includes(
                            permission.key,
                          );

                        return `
                          <label class="permission-option">
                            <span>
                              <strong>
                                ${escapeHtml(permission.label)}
                              </strong>

                              <small>
                                ${escapeHtml(permission.description)}
                              </small>
                            </span>

                            <input
                              type="checkbox"
                              data-preview-permission="${permission.key}"
                              ${checked ? 'checked' : ''}
                            />

                            <span class="permission-switch" aria-hidden="true"></span>
                          </label>
                        `;
                      },
                    )
                    .join('')
                }
              </div>
            </div>
          `,
        )
        .join('');

    bindPreviewPermissionCounters();
  }

  function getPreviewPermissions():
    AdminPermission[] {
    return Array.from(
      document.querySelectorAll<HTMLInputElement>(
        '[data-preview-permission]:checked',
      ),
    )
      .map(
        (
          input,
        ) =>
          input.dataset.previewPermission,
      )
      .filter(
        (
          permission,
        ): permission is AdminPermission =>
          Boolean(
            permission,
          ),
      );
  }

  function updatePreviewPermissionCount() {
    const count =
      getPreviewPermissions().length;

    if (
      adminPreviewPermissionsCount
    ) {
      adminPreviewPermissionsCount.textContent =
        `${count} ativa${count === 1 ? '' : 's'}`;
    }
  }

  function bindPreviewPermissionCounters() {
    document
      .querySelectorAll<HTMLInputElement>(
        '[data-preview-permission]',
      )
      .forEach(
        (
          input,
        ) => {
          input.addEventListener(
            'change',
            updatePreviewPermissionCount,
          );
        },
      );

    updatePreviewPermissionCount();
  }

  function closeAdminPreview() {
    previewUser =
      null;

    adminPreview?.classList.add(
      'member-hidden',
    );

    if (
      adminPreviewPermissionsList
    ) {
      adminPreviewPermissionsList.innerHTML =
        '';
    }
  }

  async function lookupAdminCandidate() {
    const email =
      adminEmail?.value.trim() ??
      '';

    if (
      !email ||
      !lookupAdminSubmit
    ) {
      return;
    }

    lookupAdminSubmit.disabled =
      true;

    lookupAdminSubmit.textContent =
      'Consultando...';

    try {
      const user =
        await lookupColabUserForAdmin(
          email,
        );

      if (!user) {
        closeAdminPreview();

        showStatus(
          'Nenhum usuário encontrado com esse e-mail.',
          'error',
        );

        return;
      }

      previewUser =
        user;

      if (
        adminPreviewName
      ) {
        adminPreviewName.textContent =
          user.display_name ||
          user.email ||
          'Usuário EVRYLUX';
      }

      if (
        adminPreviewEmail
      ) {
        adminPreviewEmail.textContent =
          user.email ||
          email;
      }

      if (
        adminPreviewRole
      ) {
        adminPreviewRole.textContent =
          user.is_owner
            ? 'Proprietário'
            : user.is_admin
              ? 'Administrador'
              : 'Usuário';
      }

      if (
        adminPreviewAvatar
      ) {
        if (
          user.avatar_url
        ) {
          adminPreviewAvatar.innerHTML =
            `<img src="${escapeHtml(user.avatar_url)}" alt="" class="admin-avatar-image" />`;
        } else {
          const fallback =
            (
              user.display_name ||
              user.email ||
              'EV'
            )
              .trim()
              .split(/\s+/)
              .slice(
                0,
                2,
              )
              .map(
                (
                  part,
                ) =>
                  part[0]?.toUpperCase() ??
                  '',
              )
              .join('');

          adminPreviewAvatar.textContent =
            fallback ||
            'EV';
        }
      }

      renderPreviewPermissions(
        user.permissions,
      );

      adminPreview?.classList.remove(
        'member-hidden',
      );

      showStatus(
        user.is_admin
          ? 'Este usuário já é administrador. Você pode revisar e atualizar as permissões.'
          : 'Usuário encontrado. Escolha as permissões antes de adicionar.',
        'success',
      );
    } catch (
      error
    ) {
      closeAdminPreview();

      showStatus(
        error instanceof Error
          ? error.message
          : 'Não foi possível consultar o usuário.',
        'error',
      );
    } finally {
      lookupAdminSubmit.disabled =
        false;

      lookupAdminSubmit.textContent =
        'Consultar';
    }
  }

  function permissionGroups(
    admin: ColabAdmin,
  ) {
    const groups =
      new Map<
        string,
        typeof ADMIN_PERMISSION_DEFINITIONS[number][]
      >();

    for (
      const definition
      of ADMIN_PERMISSION_DEFINITIONS
    ) {
      const list =
        groups.get(
          definition.group,
        ) ??
        [];

      list.push(
        definition,
      );

      groups.set(
        definition.group,
        list,
      );
    }

    return Array.from(
      groups.entries(),
    )
      .map(
        (
          [
            group,
            permissions,
          ],
        ) => `
          <div class="permission-group">
            <div class="permission-group-title">
              ${escapeHtml(group)}
            </div>

            <div class="permission-options">
              ${
                permissions
                  .map(
                    (
                      permission,
                    ) => {
                      const checked =
                        admin.permissions.includes(
                          permission.key,
                        );

                      return `
                        <label class="permission-option">
                          <span>
                            <strong>
                              ${escapeHtml(permission.label)}
                            </strong>

                            <small>
                              ${escapeHtml(permission.description)}
                            </small>
                          </span>

                          <input
                            type="checkbox"
                            data-permission="${permission.key}"
                            ${checked ? 'checked' : ''}
                          />

                          <span class="permission-switch" aria-hidden="true"></span>
                        </label>
                      `;
                    },
                  )
                  .join('')
              }
            </div>
          </div>
        `,
      )
      .join('');
  }

  function renderAdmins(
    admins: ColabAdmin[],
  ) {
    if (!adminsList) {
      return;
    }

    const owner =
      admins.find(
        (
          admin,
        ) =>
          admin.is_owner,
      );

    if (
      ownerName
    ) {
      ownerName.textContent =
        owner?.display_name ||
        owner?.email ||
        'Não definido';
    }

    if (
      adminCount
    ) {
      adminCount.textContent =
        String(
          admins.length,
        );
    }

    adminsList.innerHTML =
      admins
        .map(
          (
            admin,
          ) => {
            const isSelf =
              admin.user_id ===
              currentUserId;

            const avatar =
              admin.avatar_url
                ? `
                  <img
                    src="${escapeHtml(admin.avatar_url)}"
                    alt=""
                    class="admin-avatar-image"
                  />
                `
                : `
                  <span class="admin-avatar-fallback">
                    ${escapeHtml(initials(admin))}
                  </span>
                `;

            if (
              admin.is_owner
            ) {
              return `
                <article class="admin-person-card owner-person-card">
                  <div class="admin-person-head">
                    <div class="admin-avatar">
                      ${avatar}
                    </div>

                    <div class="admin-person-identity">
                      <div class="admin-role-row">
                        <span class="role-pill role-owner">
                          Proprietário
                        </span>

                        ${isSelf ? '<span class="role-pill role-self">Você</span>' : ''}
                      </div>

                      <h3>
                        ${escapeHtml(admin.display_name || admin.email || 'Proprietário')}
                      </h3>

                      <p>
                        ${escapeHtml(admin.email || '')}
                      </p>
                    </div>
                  </div>

                  <div class="owner-access-note">
                    <strong>
                      Controle total
                    </strong>

                    <span>
                      O proprietário possui todas as permissões e não pode ser removido por outros administradores.
                    </span>
                  </div>
                </article>
              `;
            }

            return `
              <article
                class="admin-person-card"
                data-admin-card="${escapeHtml(admin.user_id)}"
              >
                <div class="admin-person-head">
                  <div class="admin-avatar">
                    ${avatar}
                  </div>

                  <div class="admin-person-identity">
                    <div class="admin-role-row">
                      <span class="role-pill">
                        Administrador
                      </span>

                      ${isSelf ? '<span class="role-pill role-self">Você</span>' : ''}
                    </div>

                    <h3>
                      ${escapeHtml(admin.display_name || admin.email || 'Administrador')}
                    </h3>

                    <p>
                      ${escapeHtml(admin.email || '')}
                    </p>
                  </div>

                  ${
                    canManageAdmins &&
                    !isSelf
                      ? `
                        <button
                          class="remove-admin-button"
                          type="button"
                          data-remove-admin="${escapeHtml(admin.user_id)}"
                        >
                          Remover
                        </button>
                      `
                      : ''
                  }
                </div>

                ${
                  currentIsOwner
                    ? `
                      <div class="permissions-editor">
                        <div class="permissions-editor-head">
                          <div>
                            <strong>
                              Permissões
                            </strong>

                            <p>
                              Selecione exatamente o que esta pessoa pode fazer.
                            </p>
                          </div>

                          <span class="permissions-count">
                            ${admin.permissions.length} ativa${admin.permissions.length === 1 ? '' : 's'}
                          </span>
                        </div>

                        ${permissionGroups(admin)}

                        <div class="permissions-actions">
                          <button
                            type="button"
                            class="member-button member-button-primary"
                            data-save-permissions="${escapeHtml(admin.user_id)}"
                          >
                            Salvar permissões
                          </button>
                        </div>
                      </div>
                    `
                    : `
                      <div class="permission-summary">
                        ${
                          admin.permissions.length
                            ? admin.permissions
                                .map(
                                  (
                                    permission,
                                  ) => {
                                    const definition =
                                      ADMIN_PERMISSION_DEFINITIONS.find(
                                        (
                                          item,
                                        ) =>
                                          item.key ===
                                          permission,
                                      );

                                    return `
                                      <span>
                                        ${escapeHtml(definition?.label || permission)}
                                      </span>
                                    `;
                                  },
                                )
                                .join('')
                            : '<em>Nenhuma permissão concedida</em>'
                        }
                      </div>
                    `
                }
              </article>
            `;
          },
        )
        .join('');

    bindDynamicActions();
  }

  function bindDynamicActions() {
    document
      .querySelectorAll<HTMLButtonElement>(
        '[data-save-permissions]',
      )
      .forEach(
        (
          button,
        ) => {
          button.addEventListener(
            'click',
            async () => {
              const userId =
                button.dataset.savePermissions;

              if (!userId) {
                return;
              }

              const card =
                document.querySelector<HTMLElement>(
                  `[data-admin-card="${CSS.escape(userId)}"]`,
                );

              if (!card) {
                return;
              }

              const permissions =
                Array.from(
                  card.querySelectorAll<HTMLInputElement>(
                    '[data-permission]:checked',
                  ),
                )
                  .map(
                    (
                      input,
                    ) =>
                      input.dataset.permission,
                  )
                  .filter(
                    (
                      permission,
                    ): permission is AdminPermission =>
                      Boolean(
                        permission,
                      ),
                  );

              button.disabled =
                true;

              button.textContent =
                'Salvando...';

              try {
                await setColabAdminPermissions(
                  userId,
                  permissions,
                );

                showStatus(
                  'Permissões atualizadas.',
                  'success',
                );

                await refreshAdmins();
              } catch (
                error
              ) {
                showStatus(
                  error instanceof Error
                    ? error.message
                    : 'Não foi possível atualizar as permissões.',
                  'error',
                );
              } finally {
                button.disabled =
                  false;

                button.textContent =
                  'Salvar permissões';
              }
            },
          );
        },
      );

    document
      .querySelectorAll<HTMLButtonElement>(
        '[data-remove-admin]',
      )
      .forEach(
        (
          button,
        ) => {
          button.addEventListener(
            'click',
            async () => {
              const userId =
                button.dataset.removeAdmin;

              if (!userId) {
                return;
              }

              const confirmed =
                window.confirm(
                  'Remover este administrador? Ele perderá todo o acesso administrativo.',
                );

              if (!confirmed) {
                return;
              }

              button.disabled =
                true;

              try {
                await removeColabAdmin(
                  userId,
                );

                showStatus(
                  'Administrador removido.',
                  'success',
                );

                await refreshAdmins();
              } catch (
                error
              ) {
                showStatus(
                  error instanceof Error
                    ? error.message
                    : 'Não foi possível remover o administrador.',
                  'error',
                );
              } finally {
                button.disabled =
                  false;
              }
            },
          );
        },
      );
  }

  function formatAuditAction(
    action: string,
  ) {
    const labels:
      Record<
        string,
        string
      > = {
        owner_claimed:
          'Proprietário definido',
        admin_added:
          'Administrador adicionado',
        permissions_updated:
          'Permissões atualizadas',
        admin_removed:
          'Administrador removido',
      };

    return labels[action] ??
      action;
  }

  async function refreshAudit() {
    if (
      !canViewAudit ||
      !auditList
    ) {
      return;
    }

    try {
      const entries =
        await listAdminAudit(
          20,
        );

      auditList.innerHTML =
        entries.length
          ? entries
              .map(
                (
                  entry,
                ) => `
                  <div class="audit-entry">
                    <span class="audit-dot"></span>

                    <div>
                      <strong>
                        ${escapeHtml(formatAuditAction(entry.action))}
                      </strong>

                      <p>
                        ${escapeHtml(entry.actor_email || 'Sistema')}
                        ${entry.target_email ? ` → ${escapeHtml(entry.target_email)}` : ''}
                      </p>

                      <time>
                        ${escapeHtml(new Date(entry.created_at).toLocaleString('pt-BR'))}
                      </time>
                    </div>
                  </div>
                `,
              )
              .join('')
          : `
              <div class="audit-empty">
                Nenhuma ação administrativa registrada ainda.
              </div>
            `;
    } catch (
      error
    ) {
      console.warn(
        '[EVRYLUX] Falha ao carregar auditoria:',
        error,
      );
    }
  }

  async function refreshAdmins() {
    const admins =
      await listColabAdmins();

    renderAdmins(
      admins,
    );

    await refreshAudit();
  }

  async function initialize() {
    const {
      data: sessionData,
      error: sessionError,
    } =
      await supabase.auth.getSession();

    if (
      sessionError ||
      !sessionData.session
    ) {
      window.location.href =
        `/login?next=${encodeURIComponent('/colab/admins')}`;

      return;
    }

    currentUserId =
      sessionData.session.user.id;

    try {
      currentIsOwner =
        await isCurrentUserOwner();

      canManageAdmins =
        currentIsOwner ||
        await hasAdminPermission(
          'manage_admins',
        ).catch(
          () =>
            false,
        );

      canViewAudit =
        currentIsOwner ||
        await hasAdminPermission(
          'view_audit_logs',
        ).catch(
          () =>
            false,
        );

      if (
        currentIsOwner
      ) {
        if (
          myAdminLevel
        ) {
          myAdminLevel.textContent =
            'Proprietário';
        }

        if (
          myAdminCopy
        ) {
          myAdminCopy.textContent =
            'Você possui controle total da administração.';
        }
      }

      addAdminCard?.classList.toggle(
        'member-hidden',
        !canManageAdmins,
      );

      auditCard?.classList.toggle(
        'member-hidden',
        !canViewAudit,
      );

      await refreshAdmins();

      loading?.classList.add(
        'member-hidden',
      );

      content?.classList.remove(
        'member-hidden',
      );
    } catch (
      error
    ) {
      // Caso ainda não exista owner, oferecemos o claim inicial.
      const message =
        error instanceof Error
          ? error.message
          : String(
              error,
            );

      if (
        /propriet|permiss|administr/i.test(
          message,
        )
      ) {
        loading?.classList.add(
          'member-hidden',
        );

        ownerSetup?.classList.remove(
          'member-hidden',
        );

        return;
      }

      showStatus(
        message ||
        'Não foi possível carregar a administração.',
        'error',
      );
    }
  }

  claimOwnerButton?.addEventListener(
    'click',
    async () => {
      if (
        !claimOwnerButton
      ) {
        return;
      }

      claimOwnerButton.disabled =
        true;

      claimOwnerButton.textContent =
        'Configurando...';

      try {
        await claimOwner();

        window.location.reload();
      } catch (
        error
      ) {
        showStatus(
          error instanceof Error
            ? error.message
            : 'Não foi possível definir esta conta como proprietária.',
          'error',
        );

        claimOwnerButton.disabled =
          false;

        claimOwnerButton.textContent =
          'Tornar esta conta proprietária';
      }
    },
  );

  addAdminForm?.addEventListener(
    'submit',
    async (
      event,
    ) => {
      event.preventDefault();

      await lookupAdminCandidate();
    },
  );

  lookupAdminSubmit?.addEventListener(
    'click',
    async () => {
      await lookupAdminCandidate();
    },
  );

  cancelAdminPreview?.addEventListener(
    'click',
    () => {
      closeAdminPreview();
    },
  );

  addAdminSubmit?.addEventListener(
    'click',
    async () => {
      if (
        !previewUser ||
        !addAdminSubmit
      ) {
        return;
      }

      const permissions =
        getPreviewPermissions();

      addAdminSubmit.disabled =
        true;

      addAdminSubmit.textContent =
        previewUser.is_admin
          ? 'Atualizando...'
          : 'Adicionando...';

      try {
        if (
          !previewUser.is_admin
        ) {
          await addColabAdminByEmail(
            previewUser.email ??
            adminEmail?.value.trim() ??
            '',
          );
        }

        if (
          !previewUser.is_owner
        ) {
          await setColabAdminPermissions(
            previewUser.user_id,
            permissions,
          );
        }

        showStatus(
          previewUser.is_admin
            ? 'Permissões do administrador atualizadas.'
            : 'Administrador adicionado com as permissões selecionadas.',
          'success',
        );

        if (
          adminEmail
        ) {
          adminEmail.value =
            '';
        }

        closeAdminPreview();

        await refreshAdmins();
      } catch (
        error
      ) {
        showStatus(
          error instanceof Error
            ? error.message
            : 'Não foi possível concluir a configuração do administrador.',
          'error',
        );
      } finally {
        addAdminSubmit.disabled =
          false;

        addAdminSubmit.textContent =
          'Adicionar administrador';
      }
    },
  );

  await initialize();
</script>

