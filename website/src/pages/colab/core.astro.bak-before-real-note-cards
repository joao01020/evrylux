---
import Layout from '../../layouts/Layout.astro';
import ColabNav from '../../components/colab/ColabNav.astro';
import '../../styles/members.css';
---

<Layout
  title="Núcleo — EVRYLUX Colab"
  description="O centro que mantém o EVRYLUX alinhado ao seu propósito."
>
  <main class="member-shell core-page">
    <div class="member-container core-container">
      <section class="core-hero">
        <div>
          <div class="eyebrow">EVRYLUX Colab</div>
          <h1>Núcleo</h1>
          <p>
            O lugar que registra o que é essencial para o projeto e ajuda
            a evitar que o EVRYLUX se afaste do seu propósito.
          </p>
        </div>

        <div class="core-hero-actions">
          <ColabNav />
          <button id="new-core-note" class="member-button member-button-primary member-hidden" type="button">
            + Nova nota
          </button>
        </div>
      </section>

      <section class="core-intro">
        <div class="core-intro-mark">N</div>
        <div>
          <span>Regra do Núcleo</span>
          <strong>
            Se uma decisão afastar o projeto do que está fixado aqui,
            ela merece ser repensada.
          </strong>
        </div>
      </section>

      <div id="core-loading" class="core-loading">Carregando o Núcleo...</div>

      <section id="core-content" class="member-hidden">
        <div class="core-section-head">
          <div>
            <span class="section-kicker">Direção do projeto</span>
            <h2>O que está no centro do EVRYLUX</h2>
            <p>
              Notas fixadas aparecem primeiro. Use esta área para registrar
              princípios, decisões e partes que definem o projeto.
            </p>
          </div>
          <span id="core-access-badge" class="core-access-badge">Visualização</span>
        </div>

        <div id="core-notes" class="core-notes"></div>

        <div id="core-empty" class="core-empty member-hidden">
          <div class="core-empty-icon">✦</div>
          <h3>O Núcleo ainda está vazio</h3>
          <p>
            Quando você adicionar a primeira nota, ela aparecerá aqui.
            Você pode começar fixando “Cérebro” como o núcleo atual do EVRYLUX.
          </p>
        </div>

        <section id="core-permissions" class="core-permissions member-hidden">
          <div class="core-section-head permissions-head">
            <div>
              <span class="section-kicker">Proprietário</span>
              <h2>Quem pode alterar o Núcleo</h2>
              <p>
                Apenas administradores autorizados podem criar, editar,
                fixar ou remover notas.
              </p>
            </div>
          </div>
          <div id="core-admin-list" class="core-admin-list"></div>
        </section>
      </section>

      <div id="core-status" class="member-status" role="status" aria-live="polite"></div>
    </div>

    <div id="core-modal" class="core-modal member-hidden" role="dialog" aria-modal="true" aria-labelledby="core-modal-title">
      <button id="core-modal-backdrop" class="core-modal-backdrop" type="button" aria-label="Fechar"></button>
      <section class="core-modal-card">
        <div class="core-modal-head">
          <div>
            <span class="section-kicker">Núcleo</span>
            <h2 id="core-modal-title">Nova nota</h2>
          </div>
          <button id="core-modal-close" class="core-modal-close" type="button" aria-label="Fechar">×</button>
        </div>

        <form id="core-form">
          <input id="core-note-id" type="hidden" />

          <label class="core-field">
            <span>Título</span>
            <input id="core-note-title" type="text" maxlength="120" required placeholder="Ex.: Cérebro" />
          </label>

          <label class="core-field">
            <span>Nota</span>
            <textarea id="core-note-content" maxlength="8000" rows="9" placeholder="Explique por que isso faz parte do núcleo do EVRYLUX..."></textarea>
          </label>

          <label class="core-pin-option">
            <input id="core-note-pinned" type="checkbox" />
            <span class="core-pin-box">
              <strong>Fixar no Núcleo</strong>
              <small>
                Notas fixadas aparecem primeiro e representam as partes
                mais importantes do projeto.
              </small>
            </span>
          </label>

          <div class="core-modal-actions">
            <button id="core-delete-note" class="core-delete-button member-hidden" type="button">Excluir</button>
            <div>
              <button id="core-cancel-note" class="member-button" type="button">Cancelar</button>
              <button id="core-save-note" class="member-button member-button-primary" type="submit">Salvar nota</button>
            </div>
          </div>
        </form>
      </section>
    </div>
  </main>

<style is:global>
  /* ==========================================================
     EVRYLUX NÚCLEO — NOTAS MODERNAS COM RESUMO + MODAL
     ========================================================== */
  .evx-core-notes-shell {
    margin-top: 1.35rem;
    display: grid;
    gap: 1rem;
  }

  .evx-core-notes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
    align-items: start;
  }

  .evx-core-note-preview {
    position: relative;
    border: 1px solid rgba(45, 76, 46, 0.10);
    background: linear-gradient(180deg, rgba(255,255,255,0.96), rgba(247,250,246,0.96));
    border-radius: 24px;
    padding: 1rem 1rem 1rem;
    box-shadow: 0 20px 50px rgba(30, 44, 31, 0.08);
    transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease;
    cursor: pointer;
    min-height: 180px;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .evx-core-note-preview:hover {
    transform: translateY(-3px);
    box-shadow: 0 24px 60px rgba(30, 44, 31, 0.11);
    border-color: rgba(54, 102, 60, 0.18);
  }

  .evx-core-note-preview-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .evx-core-note-preview-kicker {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #5a745e;
  }

  .evx-core-note-preview-title {
    margin: 0.15rem 0 0;
    font-size: 1.02rem;
    line-height: 1.35;
    font-weight: 800;
    color: #18231a;
  }

  .evx-core-note-open-icon {
    width: 40px;
    height: 40px;
    border-radius: 14px;
    display: inline-grid;
    place-items: center;
    background: #eef5eb;
    color: #345f39;
    flex: 0 0 40px;
    border: 1px solid rgba(52,95,57,0.10);
  }

  .evx-core-note-open-icon svg {
    width: 18px !important;
    height: 18px !important;
    max-width: 18px !important;
    max-height: 18px !important;
  }

  .evx-core-note-preview-summary {
    margin: 0;
    color: #5d685e;
    font-size: 0.94rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .evx-core-note-preview-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: auto;
  }

  .evx-core-note-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    min-height: 30px;
    padding: 0.42rem 0.72rem;
    border-radius: 999px;
    background: #f3f7f1;
    color: #46644b;
    font-size: 0.76rem;
    font-weight: 700;
    border: 1px solid rgba(52,95,57,0.08);
  }

  .evx-core-note-chip--pinned {
    background: rgba(159, 213, 145, 0.18);
    color: #2f5b33;
  }

  .evx-core-note-chip svg {
    width: 14px !important;
    height: 14px !important;
    max-width: 14px !important;
    max-height: 14px !important;
    flex: 0 0 14px;
  }

  .evx-core-note-preview-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.2rem;
    color: #4a5f4e;
  }

  .evx-core-note-preview-link {
    font-size: 0.82rem;
    font-weight: 700;
    color: #2f5b33;
  }

  .evx-core-note-preview-length {
    font-size: 0.78rem;
    color: #79857b;
  }

  .evx-core-hidden-source-note {
    display: none !important;
  }

  .evx-core-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(14, 18, 14, 0.56);
    backdrop-filter: blur(8px);
    z-index: 80;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
  }

  .evx-core-modal {
    width: min(860px, 100%);
    max-height: min(88vh, 920px);
    overflow: hidden;
    border-radius: 28px;
    background: linear-gradient(180deg, #ffffff, #f8fbf7);
    box-shadow: 0 32px 100px rgba(0,0,0,0.22);
    border: 1px solid rgba(45, 76, 46, 0.12);
    display: flex;
    flex-direction: column;
  }

  .evx-core-modal-header {
    padding: 1.1rem 1.2rem;
    border-bottom: 1px solid rgba(45, 76, 46, 0.08);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: rgba(248, 251, 247, 0.88);
  }

  .evx-core-modal-header-copy {
    min-width: 0;
  }

  .evx-core-modal-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 30px;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    background: #eef5eb;
    color: #3d5f43;
    font-size: 0.74rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .evx-core-modal-title {
    margin: 0.55rem 0 0;
    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    line-height: 1.2;
    color: #18231a;
  }

  .evx-core-modal-close {
    width: 46px;
    height: 46px;
    border-radius: 16px;
    border: 1px solid rgba(45, 76, 46, 0.12);
    background: #ffffff;
    color: #263227;
    display: inline-grid;
    place-items: center;
    cursor: pointer;
    transition: transform 140ms ease, background 140ms ease;
  }

  .evx-core-modal-close:hover {
    transform: translateY(-1px);
    background: #f6faf5;
  }

  .evx-core-modal-close svg {
    width: 18px !important;
    height: 18px !important;
  }

  .evx-core-modal-body {
    padding: 1.2rem;
    overflow: auto;
  }

  .evx-core-modal-body > * {
    max-width: 100%;
  }

  .evx-core-modal-body article,
  .evx-core-modal-body section,
  .evx-core-modal-body .core-note-card,
  .evx-core-modal-body [data-core-note],
  .evx-core-modal-body > div {
    border: none !important;
    background: transparent !important;
    box-shadow: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  .evx-core-modal-body h1,
  .evx-core-modal-body h2,
  .evx-core-modal-body h3,
  .evx-core-modal-body h4 {
    margin: 0 0 1rem;
    color: #172219;
    line-height: 1.25;
  }

  .evx-core-modal-body p,
  .evx-core-modal-body li,
  .evx-core-modal-body blockquote {
    color: #3d4740;
    line-height: 1.8;
    font-size: 1rem;
  }

  .evx-core-modal-body ul,
  .evx-core-modal-body ol {
    padding-left: 1.3rem;
  }

  .evx-core-modal-body button,
  .evx-core-modal-body a[role="button"],
  .evx-core-modal-body .button,
  .evx-core-modal-body .btn {
    border-radius: 14px;
    min-height: 42px;
    padding: 0.72rem 1rem;
  }

  .evx-core-empty-state {
    padding: 1rem 1.1rem;
    border: 1px dashed rgba(52,95,57,0.18);
    border-radius: 20px;
    color: #627063;
    background: rgba(255,255,255,0.7);
  }

  @media (max-width: 720px) {
    .evx-core-note-preview {
      border-radius: 20px;
      padding: 0.9rem;
      min-height: 165px;
    }

    .evx-core-modal-overlay {
      padding: 0.75rem;
    }

    .evx-core-modal {
      width: 100%;
      max-height: 92vh;
      border-radius: 22px;
    }

    .evx-core-modal-header,
    .evx-core-modal-body {
      padding: 1rem;
    }
  }
</style>

<script is:inline>
  (() => {
    const MARKER = 'evx-core-notes-modern-ready';

    const getText = (el) => (el?.textContent || '').replace(/\s+/g, ' ').trim();

    const truncate = (text, max = 180) => {
      const clean = (text || '').replace(/\s+/g, ' ').trim();
      if (clean.length <= max) return clean;
      return clean.slice(0, max).trimEnd() + '…';
    };

    const createEl = (tag, className, html) => {
      const el = document.createElement(tag);
      if (className) el.className = className;
      if (html != null) el.innerHTML = html;
      return el;
    };

    const findCoreRoot = () => {
      return document.querySelector('.core-page')
        || document.querySelector('main.member-shell')
        || document.querySelector('main');
    };

    const findHeading = (root) => {
      return [...root.querySelectorAll('h1,h2,h3')].find((el) => /o que está no centro do evrylux/i.test(getText(el)));
    };

    const climbCandidate = (start, stopAt) => {
      let node = start;
      while (node && node !== stopAt && node !== document.body) {
        const tag = node.tagName?.toLowerCase();
        const hasFields = node.querySelector?.('input,textarea,select');
        const hasHeading = node.querySelector?.('h1,h2,h3,h4,strong');
        const txt = getText(node);
        if (['article','section','div','li'].includes(tag) && !hasFields && hasHeading && txt.length > 80) {
          return node;
        }
        node = node.parentElement;
      }
      return null;
    };

    const findNoteCandidates = (root, heading) => {
      const set = new Set();
      const editButtons = [...root.querySelectorAll('button, a')].filter((el) => /editar/i.test(getText(el)));
      for (const btn of editButtons) {
        const candidate = climbCandidate(btn, root);
        if (candidate) set.add(candidate);
      }

      if (!set.size && heading) {
        const blocks = [...root.querySelectorAll('article, section, div')].filter((el) => {
          if (el === root) return false;
          if (el.querySelector('input,textarea,select')) return false;
          if (!el.querySelector('h1,h2,h3,h4,strong')) return false;
          const txt = getText(el);
          if (txt.length < 120) return false;
          if (/o que está no centro do evrylux/i.test(txt)) return false;
          return true;
        });
        for (const block of blocks) set.add(block);
      }

      return [...set].filter((el) => !el.closest('.evx-core-notes-shell'));
    };

    const extractTitle = (node) => {
      const titleEl = node.querySelector('h1,h2,h3,h4,strong');
      return getText(titleEl) || 'Nota do Núcleo';
    };

    const extractSummary = (node, title) => {
      const pieces = [];
      node.querySelectorAll('p, li').forEach((el) => {
        const text = getText(el);
        if (!text) return;
        if (/^fixado$/i.test(text)) return;
        if (/^editar$/i.test(text)) return;
        pieces.push(text);
      });
      let summary = pieces.join(' ');
      if (!summary) {
        summary = getText(node).replace(title, '').replace(/Fixado/gi, '').replace(/Editar/gi, '');
      }
      return truncate(summary, 180);
    };

    const extractTags = (node) => {
      const tags = [];
      if (/fixado/i.test(getText(node))) {
        tags.push({ type: 'pinned', label: 'Fixado' });
      }
      const editExists = [...node.querySelectorAll('button,a')].some((el) => /editar/i.test(getText(el)));
      if (editExists) tags.push({ type: 'editable', label: 'Editável' });
      return tags;
    };

    const countReadingTime = (node) => {
      const words = getText(node).split(/\s+/).filter(Boolean).length;
      const min = Math.max(1, Math.round(words / 180));
      return `${min} min leitura`;
    };

    const createPreviewCard = ({ title, summary, tags, readingTime }) => {
      const card = createEl('article', 'evx-core-note-preview');
      card.innerHTML = `
        <div class="evx-core-note-preview-head">
          <div>
            <div class="evx-core-note-preview-kicker">Núcleo</div>
            <h3 class="evx-core-note-preview-title"></h3>
          </div>
          <span class="evx-core-note-open-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M7 12h10M13 8l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </div>
        <p class="evx-core-note-preview-summary"></p>
        <div class="evx-core-note-preview-meta"></div>
        <div class="evx-core-note-preview-actions">
          <span class="evx-core-note-preview-link">Abrir nota</span>
          <span class="evx-core-note-preview-length"></span>
        </div>
      `;
      card.querySelector('.evx-core-note-preview-title').textContent = title;
      card.querySelector('.evx-core-note-preview-summary').textContent = summary;
      card.querySelector('.evx-core-note-preview-length').textContent = readingTime;

      const meta = card.querySelector('.evx-core-note-preview-meta');
      (tags || []).forEach((tag) => {
        const chip = createEl('span', `evx-core-note-chip ${tag.type === 'pinned' ? 'evx-core-note-chip--pinned' : ''}`);
        if (tag.type === 'pinned') {
          chip.innerHTML = `
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M9 3h6l-1 6 4 4v2H6v-2l4-4-1-6Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
              <path d="M12 15v6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
            <span>${tag.label}</span>
          `;
        } else {
          chip.textContent = tag.label;
        }
        meta.appendChild(chip);
      });
      return card;
    };

    const openModalWithNode = (title, node, placeholder) => {
      const overlay = createEl('div', 'evx-core-modal-overlay');
      const dialog = createEl('div', 'evx-core-modal');
      dialog.setAttribute('role', 'dialog');
      dialog.setAttribute('aria-modal', 'true');
      dialog.setAttribute('aria-label', title);

      const header = createEl('div', 'evx-core-modal-header');
      const copy = createEl('div', 'evx-core-modal-header-copy');
      copy.innerHTML = `
        <div class="evx-core-modal-kicker">Nota do Núcleo</div>
        <h3 class="evx-core-modal-title"></h3>
      `;
      copy.querySelector('.evx-core-modal-title').textContent = title;

      const closeBtn = createEl('button', 'evx-core-modal-close', `
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      `);
      closeBtn.type = 'button';
      closeBtn.setAttribute('aria-label', 'Fechar nota');

      header.appendChild(copy);
      header.appendChild(closeBtn);

      const body = createEl('div', 'evx-core-modal-body');
      dialog.appendChild(header);
      dialog.appendChild(body);
      overlay.appendChild(dialog);
      document.body.appendChild(overlay);
      document.body.style.overflow = 'hidden';

      const originalParent = node.parentElement;
      const nextSibling = node.nextSibling;
      body.appendChild(node);
      node.classList.remove('evx-core-hidden-source-note');

      const cleanup = () => {
        if (placeholder?.parentNode) {
          placeholder.parentNode.insertBefore(node, placeholder.nextSibling);
        } else if (originalParent) {
          if (nextSibling && originalParent.contains(nextSibling)) {
            originalParent.insertBefore(node, nextSibling);
          } else {
            originalParent.appendChild(node);
          }
        }
        node.classList.add('evx-core-hidden-source-note');
        overlay.remove();
        document.body.style.overflow = '';
        document.removeEventListener('keydown', onKeyDown);
      };

      const onKeyDown = (event) => {
        if (event.key === 'Escape') cleanup();
      };

      closeBtn.addEventListener('click', cleanup);
      overlay.addEventListener('click', (event) => {
        if (event.target === overlay) cleanup();
      });
      document.addEventListener('keydown', onKeyDown);
    };

    const init = () => {
      const root = findCoreRoot();
      if (!root || root.dataset[MARKER]) return;
      if (!/\/colab\/core/.test(window.location.pathname)) return;

      const heading = findHeading(root);
      if (!heading) return;

      const noteCandidates = findNoteCandidates(root, heading);
      if (!noteCandidates.length) return;

      const shell = createEl('section', 'evx-core-notes-shell');
      const grid = createEl('div', 'evx-core-notes-grid');
      shell.appendChild(grid);

      let insertAfter = heading;
      const headingParent = heading.parentElement;
      const introParagraphs = headingParent ? [...headingParent.querySelectorAll('p')] : [];
      if (introParagraphs.length) insertAfter = introParagraphs[introParagraphs.length - 1];
      insertAfter.insertAdjacentElement('afterend', shell);

      noteCandidates.forEach((node, index) => {
        const title = extractTitle(node);
        const summary = extractSummary(node, title);
        const tags = extractTags(node);
        const readingTime = countReadingTime(node);
        const card = createPreviewCard({ title, summary, tags, readingTime });
        const placeholder = createEl('div');
        placeholder.style.display = 'none';
        placeholder.dataset.notePlaceholder = String(index);
        node.parentNode.insertBefore(placeholder, node);
        node.classList.add('evx-core-hidden-source-note');
        card.addEventListener('click', (event) => {
          if (event.target.closest('button,a')) return;
          openModalWithNode(title, node, placeholder);
        });
        grid.appendChild(card);
      });

      root.dataset[MARKER] = '1';
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>


</Layout>

<script>
  import { requireMemberSession } from '../../lib/member-auth';
  import {
    canEditProjectCore,
    createProjectCoreNote,
    deleteProjectCoreNote,
    listProjectCoreNotes,
    updateProjectCoreNote,
    type ProjectCoreNote,
  } from '../../lib/project-core';

  const session = await requireMemberSession();
  const loading = document.querySelector<HTMLElement>('#core-loading');
  const content = document.querySelector<HTMLElement>('#core-content');
  const notesContainer = document.querySelector<HTMLElement>('#core-notes');
  const emptyState = document.querySelector<HTMLElement>('#core-empty');
  const newNoteButton = document.querySelector<HTMLButtonElement>('#new-core-note');
  const accessBadge = document.querySelector<HTMLElement>('#core-access-badge');
  const status = document.querySelector<HTMLElement>('#core-status');
  const modal = document.querySelector<HTMLElement>('#core-modal');
  const modalBackdrop = document.querySelector<HTMLButtonElement>('#core-modal-backdrop');
  const modalClose = document.querySelector<HTMLButtonElement>('#core-modal-close');
  const modalTitle = document.querySelector<HTMLElement>('#core-modal-title');
  const form = document.querySelector<HTMLFormElement>('#core-form');
  const noteId = document.querySelector<HTMLInputElement>('#core-note-id');
  const titleInput = document.querySelector<HTMLInputElement>('#core-note-title');
  const contentInput = document.querySelector<HTMLTextAreaElement>('#core-note-content');
  const pinnedInput = document.querySelector<HTMLInputElement>('#core-note-pinned');
  const saveButton = document.querySelector<HTMLButtonElement>('#core-save-note');
  const deleteButton = document.querySelector<HTMLButtonElement>('#core-delete-note');
  const cancelButton = document.querySelector<HTMLButtonElement>('#core-cancel-note');

  let notes: ProjectCoreNote[] = [];
  let canEdit = false;

  function escapeHtml(value: unknown) {
    return String(value ?? '')
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');
  }

  function formatDate(value: string) {
    return new Intl.DateTimeFormat('pt-BR', {
      day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit',
    }).format(new Date(value));
  }

  function showStatus(message: string, type: 'success' | 'error' | '' = '') {
    if (!status) return;
    status.textContent = message;
    status.className = type ? `member-status show ${type}` : 'member-status';
  }

  function handleProtectedError(error: unknown) {
    const message = error instanceof Error ? error.message : 'Não foi possível concluir a operação.';
    if (message.includes('AAL2')) {
      showStatus('Confirme o 2FA antes de alterar o Núcleo.', 'error');
      window.setTimeout(() => {
        window.location.href = `/colab/security?next=${encodeURIComponent('/colab/core')}`;
      }, 900);
      return;
    }
    showStatus(message, 'error');
  }

  function renderNotes() {
    if (!notesContainer || !emptyState) return;
    emptyState.classList.toggle('member-hidden', notes.length > 0);
    if (!notes.length) {
      notesContainer.innerHTML = '';
      return;
    }

    notesContainer.innerHTML = notes.map((note) => `
      <article class="core-note ${note.is_pinned ? 'is-pinned' : ''}" data-note-id="${escapeHtml(note.id)}">
        <div class="core-note-top">
          <div class="core-note-labels">
            ${note.is_pinned ? `
              <span class="core-pin-label">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M9 3h6l-1 6 3 3v1H7v-1l3-3-1-6Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
                  <path d="M12 13v8" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                </svg>
                Fixado
              </span>` : `<span class="core-note-label">Nota</span>`}
          </div>
          ${canEdit ? `<button class="core-edit-button" type="button" data-edit-note="${escapeHtml(note.id)}">Editar</button>` : ''}
        </div>
        <h3>${escapeHtml(note.title)}</h3>
        <p class="core-note-content ${note.content.trim() ? '' : 'core-note-empty-copy'}">
          ${note.content.trim() ? escapeHtml(note.content).replaceAll('\n', '<br />') : 'Sem descrição.'}
        </p>
        <div class="core-note-footer">Atualizado em ${escapeHtml(formatDate(note.updated_at))}</div>
      </article>
    `).join('');

    document.querySelectorAll<HTMLButtonElement>('[data-edit-note]').forEach((button) => {
      button.addEventListener('click', () => {
        const note = notes.find((item) => item.id === button.dataset.editNote);
        if (note) openEditModal(note);
      });
    });
  }

  function openCreateModal() {
    if (!modal || !noteId || !titleInput || !contentInput || !pinnedInput || !deleteButton || !modalTitle) return;
    noteId.value = '';
    titleInput.value = '';
    contentInput.value = '';
    pinnedInput.checked = false;
    deleteButton.classList.add('member-hidden');
    modalTitle.textContent = 'Nova nota';
    modal.classList.remove('member-hidden');
    document.body.classList.add('core-modal-open');
    window.setTimeout(() => titleInput.focus(), 50);
  }

  function openEditModal(note: ProjectCoreNote) {
    if (!modal || !noteId || !titleInput || !contentInput || !pinnedInput || !deleteButton || !modalTitle) return;
    noteId.value = note.id;
    titleInput.value = note.title;
    contentInput.value = note.content;
    pinnedInput.checked = note.is_pinned;
    deleteButton.classList.remove('member-hidden');
    modalTitle.textContent = 'Editar nota';
    modal.classList.remove('member-hidden');
    document.body.classList.add('core-modal-open');
  }

  function closeModal() {
    modal?.classList.add('member-hidden');
    document.body.classList.remove('core-modal-open');
  }

  async function refreshNotes() {
    notes = await listProjectCoreNotes();
    renderNotes();
  }

  newNoteButton?.addEventListener('click', openCreateModal);
  modalBackdrop?.addEventListener('click', closeModal);
  modalClose?.addEventListener('click', closeModal);
  cancelButton?.addEventListener('click', closeModal);
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeModal(); });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!titleInput || !contentInput || !pinnedInput || !noteId || !saveButton) return;
    const title = titleInput.value.trim();
    const noteContent = contentInput.value.trim();
    if (!title) {
      showStatus('Digite um título para a nota.', 'error');
      return;
    }
    saveButton.disabled = true;
    saveButton.textContent = 'Salvando...';
    try {
      if (noteId.value) {
        await updateProjectCoreNote({ id: noteId.value, title, content: noteContent, pinned: pinnedInput.checked });
        showStatus('Nota atualizada.', 'success');
      } else {
        await createProjectCoreNote({ title, content: noteContent, pinned: pinnedInput.checked });
        showStatus('Nota adicionada ao Núcleo.', 'success');
      }
      closeModal();
      await refreshNotes();
    } catch (error) {
      handleProtectedError(error);
    } finally {
      saveButton.disabled = false;
      saveButton.textContent = 'Salvar nota';
    }
  });

  deleteButton?.addEventListener('click', async () => {
    if (!noteId?.value) return;
    const note = notes.find((item) => item.id === noteId.value);
    if (!window.confirm(`Excluir "${note?.title || 'esta nota'}" do Núcleo?`)) return;
    deleteButton.disabled = true;
    try {
      await deleteProjectCoreNote(noteId.value);
      showStatus('Nota removida do Núcleo.', 'success');
      closeModal();
      await refreshNotes();
    } catch (error) {
      handleProtectedError(error);
    } finally {
      deleteButton.disabled = false;
    }
  });

  if (session) {
    try {
      canEdit = await canEditProjectCore();
      if (canEdit) {
        newNoteButton?.classList.remove('member-hidden');
        if (accessBadge) {
          accessBadge.textContent = 'Pode editar';
          accessBadge.classList.add('can-edit');
        }
      }
      await refreshNotes();
      loading?.classList.add('member-hidden');
      content?.classList.remove('member-hidden');
    } catch (error) {
      loading?.classList.add('member-hidden');
      content?.classList.remove('member-hidden');
      showStatus(error instanceof Error ? error.message : 'Não foi possível carregar o Núcleo.', 'error');
    }
  }
</script>

