---
import Layout from '../../layouts/Layout.astro';
import ColabNav from '../../components/colab/ColabNav.astro';
import EvryluxLogoLoader from '../../components/ui/EvryluxLogoLoader.astro';
import '../../styles/members.css';
---

<Layout
  title="Minhas tarefas — EVRYLUX Colab"
  description="Todas as tarefas atribuídas ao colaborador no EVRYLUX."
>
  <main class="member-shell tasks-page-shell">
    <EvryluxLogoLoader
      id="tasks-loading"
      size="md"
    />

    <div
      id="tasks-content"
      class="member-container member-hidden tasks-page"
    >
      <section class="tasks-hero-card">
        <div class="tasks-hero-copy">
          <span class="tasks-eyebrow">
            Painel pessoal
          </span>

          <h1>
            Minhas tarefas
          </h1>

          <p>
            Um espaço mais limpo para acompanhar tudo o que foi atribuído a você,
            priorizando o que merece atenção agora e facilitando a abertura direta no Roadmap.
          </p>
        </div>

        <div class="tasks-hero-side">
          <div class="tasks-hero-highlight">
            <span>
              Organização 
            </span>

            <strong>
              Visão clara das suas entregas
            </strong>

            <small>
              Filtre por proximidade do prazo e abra a tarefa em um clique.
            </small>
          </div>

          <div class="tasks-hero-nav">
            <ColabNav />
          </div>
        </div>
      </section>

      <section class="tasks-summary-strip">
        <article class="tasks-stat-card">
          <span class="tasks-stat-label">
            Total
          </span>
          <strong id="tasks-summary-total">0</strong>
          <small>
            tarefas atribuídas
          </small>
        </article>

        <article class="tasks-stat-card is-emphasis">
          <span class="tasks-stat-label">
            Próximas
          </span>
          <strong id="tasks-summary-near">0</strong>
          <small>
            vencendo em breve
          </small>
        </article>

        <article class="tasks-stat-card">
          <span class="tasks-stat-label">
            Mais distantes
          </span>
          <strong id="tasks-summary-far">0</strong>
          <small>
            com folga de prazo
          </small>
        </article>

        <article class="tasks-stat-card">
          <span class="tasks-stat-label">
            Sem prazo
          </span>
          <strong id="tasks-summary-no-due">0</strong>
          <small>
            aguardando definição
          </small>
        </article>
      </section>

      <section class="tasks-toolbar-card">
        <div class="tasks-toolbar-copy">
          <span class="tasks-section-kicker">
            Filtros
          </span>

          <h2>
            Escolha como visualizar
          </h2>

          <p>
            Mostre todas ou destaque primeiro as tarefas mais urgentes.
          </p>
        </div>

        <div class="tasks-toolbar-actions">
          <div
            class="tasks-filters"
            role="group"
            aria-label="Filtros das tarefas"
          >
            <button class="tasks-filter active" type="button" data-task-filter="all">
              <span class="tasks-filter-label">Todas</span>
              <span id="tasks-count-all" class="tasks-filter-count">0</span>
            </button>

            <button class="tasks-filter" type="button" data-task-filter="near">
              <span class="tasks-filter-label">Próximas do prazo</span>
              <span id="tasks-count-near" class="tasks-filter-count">0</span>
            </button>

            <button class="tasks-filter" type="button" data-task-filter="far">
              <span class="tasks-filter-label">Mais distantes</span>
              <span id="tasks-count-far" class="tasks-filter-count">0</span>
            </button>

            <button class="tasks-filter" type="button" data-task-filter="no_due">
              <span class="tasks-filter-label">Sem prazo</span>
              <span id="tasks-count-no-due" class="tasks-filter-count">0</span>
            </button>
          </div>

          <a
            class="tasks-roadmap-link"
            href="/colab/studio/roadmap"
          >
            <span>
              Abrir Roadmap
            </span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </section>

      <section
        id="tasks-list"
        class="tasks-list"
        aria-live="polite"
      ></section>

      <div
        id="tasks-empty"
        class="tasks-empty member-hidden"
      >
        <span class="tasks-empty-icon">✓</span>

        <div>
          <strong>
            Nenhuma tarefa neste filtro
          </strong>

          <p>
            Tente outro filtro ou abra o Roadmap para revisar tudo.
          </p>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  import {
    requireMemberSession,
  } from '../../lib/member-auth';

  import {
    getMyRoadmapTasks,
    markTaskNotificationRead,
    type MyRoadmapTask,
  } from '../../lib/colab-task-inbox';

  type TaskFilter =
    | 'all'
    | 'near'
    | 'far'
    | 'no_due';

  const NEAR_DAYS =
    7;

  const loading =
    document.querySelector<HTMLElement>('#tasks-loading');

  const content =
    document.querySelector<HTMLElement>('#tasks-content');

  const list =
    document.querySelector<HTMLElement>('#tasks-list');

  const empty =
    document.querySelector<HTMLElement>('#tasks-empty');

  const filters =
    Array.from(
      document.querySelectorAll<HTMLButtonElement>('[data-task-filter]'),
    );

  let tasks: MyRoadmapTask[] = [];
  let activeFilter: TaskFilter = 'all';

  function escapeHtml(value: string) {
    return value
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');
  }

  function stageLabel(stage: string) {
    const labels: Record<string, string> = {
      now: 'Agora',
      next: 'Próximo',
      later: 'Depois',
      done: 'Concluído',
    };

    return labels[stage] ?? stage;
  }

  function statusLabel(status: string) {
    const labels: Record<string, string> = {
      todo: 'A fazer',
      doing: 'Em andamento',
      in_progress: 'Em andamento',
      blocked: 'Bloqueado',
      done: 'Concluído',
    };

    return labels[status] ?? status;
  }

  function dueDate(task: MyRoadmapTask) {
    if (!task.due_date) return null;

    const value =
      new Date(`${task.due_date}T23:59:59`);

    return Number.isNaN(value.getTime())
      ? null
      : value;
  }

  function daysUntil(task: MyRoadmapTask) {
    const due = dueDate(task);
    if (!due) return null;

    const now = new Date();
    const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());

    return Math.ceil((due.getTime() - today.getTime()) / 86400000);
  }

  function dueKind(task: MyRoadmapTask): 'near' | 'far' | 'no_due' {
    const days = daysUntil(task);

    if (days === null) return 'no_due';
    return days <= NEAR_DAYS ? 'near' : 'far';
  }

  function dueLabel(task: MyRoadmapTask) {
    const days = daysUntil(task);

    if (days === null) return 'Sem prazo definido';

    if (days < 0) {
      const amount = Math.abs(days);
      return `Atrasada ${amount} ${amount === 1 ? 'dia' : 'dias'}`;
    }

    if (days === 0) return 'Vence hoje';
    if (days === 1) return 'Vence amanhã';
    if (days <= NEAR_DAYS) return `Vence em ${days} dias`;
    return `Prazo em ${days} dias`;
  }

  function formatDate(value: string | null) {
    if (!value) return '';

    const date = new Date(`${value}T12:00:00`);
    if (Number.isNaN(date.getTime())) return value;

    return new Intl.DateTimeFormat('pt-BR', {
      day: '2-digit',
      month: 'short',
      year: 'numeric',
    }).format(date);
  }

  function taskSort(a: MyRoadmapTask, b: MyRoadmapTask) {
    const aUnread = Boolean(a.notification_id) && !a.notification_is_read;
    const bUnread = Boolean(b.notification_id) && !b.notification_is_read;

    if (aUnread !== bUnread) {
      return aUnread ? -1 : 1;
    }

    const da = dueDate(a);
    const db = dueDate(b);

    if (da && db) return da.getTime() - db.getTime();
    if (da) return -1;
    if (db) return 1;

    return a.title.localeCompare(b.title, 'pt-BR');
  }

  function filteredTasks() {
    const sorted = [...tasks].sort(taskSort);
    if (activeFilter === 'all') return sorted;
    return sorted.filter((task) => dueKind(task) === activeFilter);
  }

  function setText(selector: string, value: number) {
    const element = document.querySelector<HTMLElement>(selector);
    if (element) element.textContent = String(value);
  }

  function renderCounts() {
    const near = tasks.filter((task) => dueKind(task) === 'near').length;
    const far = tasks.filter((task) => dueKind(task) === 'far').length;
    const noDue = tasks.filter((task) => dueKind(task) === 'no_due').length;

    setText('#tasks-count-all', tasks.length);
    setText('#tasks-count-near', near);
    setText('#tasks-count-far', far);
    setText('#tasks-count-no-due', noDue);
    setText('#tasks-summary-total', tasks.length);
    setText('#tasks-summary-near', near);
    setText('#tasks-summary-far', far);
    setText('#tasks-summary-no-due', noDue);
  }

  function render() {
    if (!list || !empty) return;

    renderCounts();
    const visible = filteredTasks();

    empty.classList.toggle('member-hidden', visible.length > 0);

    if (visible.length === 0) {
      list.innerHTML = '';
      return;
    }

    list.innerHTML = visible.map((task) => {
      const isNew = Boolean(task.notification_id) && !task.notification_is_read;
      const area = task.area?.trim() ? escapeHtml(task.area) : 'Roadmap';
      const progress = Math.max(0, Math.min(100, Number(task.progress) || 0));
      const dueType = dueKind(task);
      const dueText = escapeHtml(dueLabel(task));
      const dueDateText = task.due_date ? escapeHtml(formatDate(task.due_date)) : 'Sem prazo';
      const assignedBy = task.assigned_by_name?.trim() ? escapeHtml(task.assigned_by_name) : 'Equipe EVRYLUX';
      const description = task.description?.trim() ? escapeHtml(task.description) : 'Você foi marcado como responsável por esta tarefa.';

      return `
        <article class="task-card ${isNew ? 'is-new' : ''}">
          <div class="task-card-top">
            <div class="task-card-badges">
              ${isNew ? '<span class="task-pill task-pill-new">Nova</span>' : ''}
              <span class="task-pill">${area}</span>
              <span class="task-pill">${escapeHtml(stageLabel(task.stage))}</span>
            </div>

            <span class="task-deadline ${dueType}">${dueText}</span>
          </div>

          <div class="task-card-body">
            <h3>${escapeHtml(task.title)}</h3>
            <p>${description}</p>
          </div>

          <div class="task-meta-grid">
            <div class="task-meta-chip">
              <span class="task-meta-label">Status</span>
              <strong>${escapeHtml(statusLabel(task.status))}</strong>
            </div>

            <div class="task-meta-chip">
              <span class="task-meta-label">Progresso</span>
              <strong>${progress}%</strong>
            </div>

            <div class="task-meta-chip">
              <span class="task-meta-label">Prazo</span>
              <strong>${dueDateText}</strong>
            </div>

            <div class="task-meta-chip">
              <span class="task-meta-label">Atribuída por</span>
              <strong>${assignedBy}</strong>
            </div>
          </div>

          <div class="task-progress-wrap">
            <div class="task-progress-head">
              <span>Andamento</span>
              <strong>${progress}% concluído</strong>
            </div>
            <div class="task-progress-bar">
              <span style="width:${progress}%"></span>
            </div>
          </div>

          <a
            class="task-open-link"
            href="/colab/studio/roadmap?task=${encodeURIComponent(task.id)}"
            data-notification-id="${escapeHtml(task.notification_id ?? '')}"
          >
            <span>Abrir tarefa no Roadmap</span>
            <span aria-hidden="true">→</span>
          </a>
        </article>
      `;
    }).join('');

    list.querySelectorAll<HTMLAnchorElement>('.task-open-link').forEach((link) => {
      link.addEventListener('click', () => {
        const notificationId = link.dataset.notificationId?.trim();
        if (notificationId) {
          void markTaskNotificationRead(notificationId);
        }
      });
    });
  }

  filters.forEach((button) => {
    button.addEventListener('click', () => {
      activeFilter = (button.dataset.taskFilter ?? 'all') as TaskFilter;

      filters.forEach((item) => {
        item.classList.toggle('active', item === button);
      });

      render();
    });
  });

  try {
    await requireMemberSession();
    tasks = await getMyRoadmapTasks();
    render();
    loading?.classList.add('member-hidden');
    content?.classList.remove('member-hidden');
  } catch (error) {
    console.error('[EVRYLUX] Erro ao carregar tarefas:', error);
  }
</script>

<style is:global>
  .tasks-page-shell {
    min-height: calc(100vh - 90px);
  }

  .tasks-page {
    padding-top: 24px;
    padding-bottom: 56px;
  }

  .tasks-page .tasks-hero-card {
    padding: 28px;
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(300px, .9fr);
    gap: 18px;
    border: 1px solid rgba(70, 110, 68, 0.10);
    border-radius: 28px;
    background:
      radial-gradient(circle at 100% 0%, rgba(214, 236, 206, 0.92), transparent 34%),
      linear-gradient(180deg, rgba(255,255,255,0.96), rgba(248,250,246,0.98));
    box-shadow: 0 24px 64px rgba(44, 71, 42, 0.06);
  }

  .tasks-page .tasks-eyebrow,
  .tasks-page .tasks-section-kicker,
  .tasks-page .tasks-stat-label,
  .tasks-page .task-meta-label {
    letter-spacing: .08em;
    text-transform: uppercase;
    font-weight: 900;
  }

  .tasks-page .tasks-eyebrow {
    min-height: 34px;
    padding: 0 14px;
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    background: rgba(232, 244, 226, 0.92);
    color: #3a653b;
    font-size: 8px;
  }

  .tasks-page .tasks-hero-copy h1 {
    margin: 14px 0 0;
    color: var(--text);
    font-size: clamp(36px, 5vw, 60px);
    line-height: .96;
    letter-spacing: -.06em;
  }

  .tasks-page .tasks-hero-copy p {
    max-width: 720px;
    margin: 16px 0 0;
    color: var(--text-soft);
    font-size: 12px;
    line-height: 1.72;
  }

  .tasks-page .tasks-hero-side {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .tasks-page .tasks-hero-highlight {
    min-height: 100%;
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 10px;
    border: 1px solid rgba(95, 157, 89, 0.16);
    border-radius: 22px;
    background: rgba(243, 249, 240, 0.86);
  }

  .tasks-page .tasks-hero-highlight span {
    color: #537357;
    font-size: 8px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: .08em;
  }

  .tasks-page .tasks-hero-highlight strong {
    color: var(--text);
    font-size: 22px;
    line-height: 1.15;
    letter-spacing: -.03em;
  }

  .tasks-page .tasks-hero-highlight small {
    color: var(--text-soft);
    font-size: 9px;
    line-height: 1.7;
  }

  .tasks-page .tasks-hero-nav > * {
    width: 100%;
  }

  .tasks-page .tasks-summary-strip {
    margin-top: 18px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }

  .tasks-page .tasks-stat-card {
    min-height: 118px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: 1px solid rgba(70, 110, 68, 0.10);
    border-radius: 22px;
    background: linear-gradient(180deg, rgba(255,255,255,0.98), rgba(248,251,247,0.98));
    box-shadow: 0 10px 28px rgba(46, 78, 42, 0.04);
  }

  .tasks-page .tasks-stat-card.is-emphasis {
    border-color: rgba(95, 157, 89, 0.20);
    background:
      radial-gradient(circle at 100% 0%, rgba(219, 240, 213, 0.86), transparent 38%),
      linear-gradient(180deg, rgba(255,255,255,0.98), rgba(245,250,242,0.98));
  }

  .tasks-page .tasks-stat-label {
    color: #6a786d;
    font-size: 7px;
  }

  .tasks-page .tasks-stat-card strong {
    color: var(--text);
    font-size: clamp(24px, 3vw, 34px);
    line-height: 1;
    letter-spacing: -.05em;
  }

  .tasks-page .tasks-stat-card small {
    color: var(--text-soft);
    font-size: 8px;
  }

  .tasks-page .tasks-toolbar-card {
    margin-top: 18px;
    padding: 22px;
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.6fr);
    gap: 20px;
    border: 1px solid rgba(70, 110, 68, 0.10);
    border-radius: 24px;
    background: rgba(255,255,255,0.96);
    box-shadow: 0 12px 30px rgba(44, 71, 42, 0.035);
  }

  .tasks-page .tasks-section-kicker {
    color: #537357;
    font-size: 7px;
  }

  .tasks-page .tasks-toolbar-copy h2 {
    margin: 10px 0 0;
    color: var(--text);
    font-size: 24px;
    letter-spacing: -.04em;
  }

  .tasks-page .tasks-toolbar-copy p {
    margin: 10px 0 0;
    color: var(--text-soft);
    font-size: 10px;
    line-height: 1.7;
  }

  .tasks-page .tasks-toolbar-actions {
    display: flex;
    flex-direction: column;
    gap: 14px;
    justify-content: center;
  }

  .tasks-page .tasks-filters {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 9px;
  }

  .tasks-page .tasks-filter {
    min-height: 58px;
    padding: 0 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    border: 1px solid rgba(70, 110, 68, 0.10);
    border-radius: 16px;
    background: linear-gradient(180deg, #ffffff, #f8fbf7);
    color: var(--text-soft);
    font: inherit;
    cursor: pointer;
    transition: .18s ease;
  }

  .tasks-page .tasks-filter:hover {
    transform: translateY(-1px);
    border-color: rgba(95, 157, 89, 0.18);
  }

  .tasks-page .tasks-filter.active {
    border-color: rgba(95, 157, 89, 0.26);
    background: linear-gradient(180deg, rgba(241,248,238,0.98), rgba(233,244,228,0.98));
    color: var(--text);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.8);
  }

  .tasks-page .tasks-filter-label {
    text-align: left;
    font-size: 8px;
    font-weight: 900;
  }

  .tasks-page .tasks-filter-count {
    min-width: 28px;
    min-height: 28px;
    padding: 0 7px;
    display: inline-grid;
    place-items: center;
    border-radius: 999px;
    background: rgba(231, 239, 229, 0.96);
    color: #446747;
    font-size: 7px;
    font-weight: 900;
  }

  .tasks-page .tasks-roadmap-link {
    min-height: 48px;
    padding: 0 16px;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    align-self: flex-start;
    border-radius: 14px;
    border: 1px solid rgba(70, 110, 68, 0.10);
    background: #fff;
    color: var(--text);
    font-size: 8px;
    font-weight: 900;
    text-decoration: none;
  }

  .tasks-page .tasks-list {
    margin-top: 18px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .tasks-page .task-card {
    min-width: 0;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    border: 1px solid rgba(70, 110, 68, 0.10);
    border-radius: 24px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.99), rgba(248,250,246,0.98));
    box-shadow: 0 18px 46px rgba(41, 69, 40, 0.05);
  }

  .tasks-page .task-card.is-new {
    border-color: rgba(95, 157, 89, 0.20);
    background:
      radial-gradient(circle at 100% 0%, rgba(219, 240, 213, 0.90), transparent 36%),
      linear-gradient(180deg, rgba(255,255,255,0.99), rgba(246,251,243,0.98));
  }

  .tasks-page .task-card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .tasks-page .task-card-badges {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .tasks-page .task-pill,
  .tasks-page .task-deadline {
    min-height: 28px;
    padding: 0 10px;
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    font-size: 7px;
    font-weight: 900;
  }

  .tasks-page .task-pill {
    background: #f1f5ef;
    color: #617164;
  }

  .tasks-page .task-pill-new {
    background: #dff0d9;
    color: #366539;
  }

  .tasks-page .task-deadline {
    white-space: nowrap;
    border: 1px solid transparent;
  }

  .tasks-page .task-deadline.near {
    background: #fff1de;
    color: #8c6124;
  }

  .tasks-page .task-deadline.far {
    background: #edf5ea;
    color: #527056;
  }

  .tasks-page .task-deadline.no_due {
    background: #f2f4f1;
    color: #6f7a72;
  }

  .tasks-page .task-card-body h3 {
    margin: 0;
    color: var(--text);
    font-size: 24px;
    line-height: 1.16;
    letter-spacing: -.04em;
  }

  .tasks-page .task-card-body p {
    margin: 12px 0 0;
    color: var(--text-soft);
    font-size: 10px;
    line-height: 1.8;
  }

  .tasks-page .task-meta-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .tasks-page .task-meta-chip {
    min-width: 0;
    min-height: 72px;
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    border: 1px solid rgba(70, 110, 68, 0.08);
    border-radius: 16px;
    background: rgba(250,252,249,0.92);
  }

  .tasks-page .task-meta-label {
    color: #6a786d;
    font-size: 6px;
  }

  .tasks-page .task-meta-chip strong {
    min-width: 0;
    color: var(--text);
    font-size: 10px;
