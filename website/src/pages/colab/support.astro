---
import Layout from '../../layouts/Layout.astro';
import ColabNav from '../../components/colab/ColabNav.astro';
import '../../styles/members.css';
---

<Layout
  title="Suporte — EVRYLUX Colab"
  description="Atendimento de suporte do EVRYLUX."
>
  <main class="member-shell">
    <div
      id="support-admin-loading"
      class="member-container member-loading"
    >
      Carregando suporte...
    </div>

    <div
      id="support-admin-content"
      class="member-container member-hidden"
    >
      <div class="member-topbar">
        <div class="member-title-block">
          <div class="eyebrow">
            Administração
          </div>

          <h1>
            Suporte
          </h1>

          <p>
            Converse com usuários e acompanhe atendimentos em tempo real.
          </p>
        </div>

        <ColabNav />
      </div>

      <section class="support-admin-layout">
        <aside class="tickets-panel">
          <div class="tickets-head">
            <div>
              <span class="tickets-kicker">
                Conversas
              </span>

              <h2>
                Atendimentos
              </h2>
            </div>

            <span
              id="tickets-count"
              class="tickets-count"
            >
              0
            </span>
          </div>

          <div
            id="tickets-list"
            class="tickets-list"
          ></div>
        </aside>

        <section class="admin-chat-panel">
          <div
            id="admin-chat-empty"
            class="admin-chat-empty"
          >
            <strong>
              Selecione uma conversa
            </strong>

            <span>
              As mensagens do usuário aparecerão aqui.
            </span>
          </div>

          <div
            id="admin-chat-content"
            class="member-hidden"
          >
            <div class="admin-chat-head">
              <div>
                <span class="admin-chat-kicker">
                  Atendimento
                </span>

                <h2 id="active-ticket-title">
                  Usuário
                </h2>

                <a
                  id="active-ticket-email"
                  class="member-hidden"
                  href="#"
                ></a>
              </div>

              <select
                id="active-ticket-status"
              >
                <option value="open">
                  Aberto
                </option>

                <option value="closed">
                  Encerrado
                </option>
              </select>
            </div>

            <div
              id="admin-chat-messages"
              class="admin-chat-messages"
            ></div>

            <form
              id="admin-reply-form"
              class="admin-reply-form"
            >
              <textarea
                id="admin-reply"
                rows="3"
                maxlength="2000"
                placeholder="Responder ao usuário..."
                required
              ></textarea>

              <button
                id="admin-reply-button"
                type="submit"
              >
                <span>
                  Responder
                </span>

                <span aria-hidden="true">
                  →
                </span>
              </button>
            </form>
          </div>
        </section>
      </section>
    </div>
  </main>
</Layout>

<script>
  import {
    supabase,
  } from '../../lib/supabase';

  import {
    requireMemberSession,
  } from '../../lib/member-auth';

  import {
    isCurrentUserAdmin,
  } from '../../lib/colab-admin';

  import {
    getAdminSupportMessages,
    getAdminSupportTickets,
    markTicketRead,
    sendAdminSupportReply,
    setSupportTicketStatus,
    subscribeAdminSupportNotifications,
    type AdminSupportMessage,
    type AdminSupportTicket,
  } from '../../lib/support';

  const session =
    await requireMemberSession();

  const loading =
    document.querySelector<HTMLElement>(
      '#support-admin-loading',
    );

  const content =
    document.querySelector<HTMLElement>(
      '#support-admin-content',
    );

  const ticketsList =
    document.querySelector<HTMLElement>(
      '#tickets-list',
    );

  const ticketsCount =
    document.querySelector<HTMLElement>(
      '#tickets-count',
    );

  const emptyState =
    document.querySelector<HTMLElement>(
      '#admin-chat-empty',
    );

  const chatContent =
    document.querySelector<HTMLElement>(
      '#admin-chat-content',
    );

  const activeTitle =
    document.querySelector<HTMLElement>(
      '#active-ticket-title',
    );

  const activeEmail =
    document.querySelector<HTMLAnchorElement>(
      '#active-ticket-email',
    );

  const activeStatus =
    document.querySelector<HTMLSelectElement>(
      '#active-ticket-status',
    );

  const messagesEl =
    document.querySelector<HTMLElement>(
      '#admin-chat-messages',
    );

  const replyForm =
    document.querySelector<HTMLFormElement>(
      '#admin-reply-form',
    );

  const replyInput =
    document.querySelector<HTMLTextAreaElement>(
      '#admin-reply',
    );

  const replyButton =
    document.querySelector<HTMLButtonElement>(
      '#admin-reply-button',
    );

  let tickets:
    AdminSupportTicket[] =
      [];

  let activeTicket:
    AdminSupportTicket | null =
      null;

  let notificationConnection:
    ReturnType<
      typeof subscribeAdminSupportNotifications
    > | null =
      null;

  function formatTime(
    value: string,
  ) {
    return new Date(
      value,
    ).toLocaleString(
      'pt-BR',
      {
        dateStyle:
          'short',
        timeStyle:
          'short',
      },
    );
  }

  function renderTickets() {
    if (
      !ticketsList ||
      !ticketsCount
    ) {
      return;
    }

    ticketsCount.textContent =
      String(
        tickets.length,
      );

    if (!tickets.length) {
      ticketsList.innerHTML = `
        <div class="tickets-empty">
          Nenhuma conversa ainda.
        </div>
      `;

      return;
    }

    ticketsList.innerHTML =
      tickets
        .map(
          (
            ticket,
          ) => `
            <button
              class="ticket-item ${
                activeTicket?.id ===
                ticket.id
                  ? 'active'
                  : ''
              }"
              type="button"
              data-ticket-id="${ticket.id}"
            >
              <span class="ticket-avatar">
                S
              </span>

              <span class="ticket-copy">
                <strong>
                  ${
                    ticket.email
                      ? ticket.email
                      : 'Usuário sem e-mail'
                  }
                </strong>

                <small>
                  ${
                    ticket.status ===
                    'open'
                      ? 'Atendimento aberto'
                      : 'Atendimento encerrado'
                  }
                </small>
              </span>

              <span class="ticket-time">
                ${
                  ticket.last_user_message_at
                    ? formatTime(
                        ticket.last_user_message_at,
                      )
                    : formatTime(
                        ticket.created_at,
                      )
                }
              </span>
            </button>
          `,
        )
        .join('');

    ticketsList
      .querySelectorAll<HTMLButtonElement>(
        '.ticket-item',
      )
      .forEach(
        (
          button,
        ) => {
          button.addEventListener(
            'click',
            async () => {
              const id =
                button.dataset.ticketId;

              const ticket =
                tickets.find(
                  (
                    item,
                  ) =>
                    item.id ===
                    id,
                );

              if (ticket) {
                await openTicket(
                  ticket,
                );
              }
            },
          );
        },
      );
  }

  function renderMessages(
    messages:
      AdminSupportMessage[],
  ) {
    if (!messagesEl) {
      return;
    }

    messagesEl.innerHTML =
      messages
        .map(
          (
            message,
          ) => `
            <article class="admin-support-message ${message.sender_type}">
              <span>
                ${
                  message.sender_type ===
                  'admin'
                    ? 'Equipe EVRYLUX'
                    : 'Usuário'
                }
              </span>

              <p></p>

              <small>
                ${formatTime(
                  message.created_at,
                )}
              </small>
            </article>
          `,
        )
        .join('');

    messagesEl
      .querySelectorAll<HTMLElement>(
        '.admin-support-message',
      )
      .forEach(
        (
          element,
          index,
        ) => {
          const paragraph =
            element.querySelector(
              'p',
            );

          if (
            paragraph &&
            messages[
              index
            ]
          ) {
            paragraph.textContent =
              messages[
                index
              ].body;
          }
        },
      );

    messagesEl.scrollTop =
      messagesEl.scrollHeight;
  }

  async function openTicket(
    ticket:
      AdminSupportTicket,
  ) {
    activeTicket =
      ticket;

    emptyState?.classList.add(
      'member-hidden',
    );

    chatContent?.classList.remove(
      'member-hidden',
    );

    if (activeTitle) {
      activeTitle.textContent =
        ticket.email
          ? ticket.email
          : 'Usuário';
    }

    if (
      activeEmail
    ) {
      if (
        ticket.email
      ) {
        activeEmail.textContent =
          ticket.email;

        activeEmail.href =
          `mailto:${ticket.email}`;

        activeEmail.classList.remove(
          'member-hidden',
        );
      } else {
        activeEmail.classList.add(
          'member-hidden',
        );
      }
    }

    if (activeStatus) {
      activeStatus.value =
        ticket.status;
    }

    const messages =
      await getAdminSupportMessages(
        ticket.id,
      );

    renderMessages(
      messages,
    );

    await markTicketRead(
      ticket.id,
    );

    renderTickets();
  }

  async function loadTickets() {
    tickets =
      await getAdminSupportTickets();

    renderTickets();

    if (
      activeTicket
    ) {
      const updated =
        tickets.find(
          (
            ticket,
          ) =>
            ticket.id ===
            activeTicket?.id,
        );

      if (updated) {
        await openTicket(
          updated,
        );
      }
    }
  }

  replyForm?.addEventListener(
    'submit',
    async (
      event,
    ) => {
      event.preventDefault();

      if (
        !activeTicket ||
        !session ||
        !replyInput?.value.trim()
      ) {
        return;
      }

      const body =
        replyInput.value.trim();

      if (replyButton) {
        replyButton.disabled =
          true;
      }

      try {
        await sendAdminSupportReply(
          activeTicket,
          body,
          session.user.id,
        );

        replyInput.value =
          '';

        await openTicket(
          activeTicket,
        );

        await loadTickets();
      } catch (error) {
        console.error(
          '[EVRYLUX] Não foi possível responder ao suporte:',
          error,
        );
      } finally {
        if (replyButton) {
          replyButton.disabled =
            false;
        }
      }
    },
  );

  activeStatus?.addEventListener(
    'change',
    async () => {
      if (!activeTicket) {
        return;
      }

      try {
        await setSupportTicketStatus(
          activeTicket.id,
          activeStatus.value as
            | 'open'
            | 'closed',
        );

        activeTicket.status =
          activeStatus.value as
            | 'open'
            | 'closed';

        await loadTickets();
      } catch (error) {
        console.error(
          '[EVRYLUX] Não foi possível atualizar o atendimento:',
          error,
        );
      }
    },
  );

  if (session) {
    const admin =
      await isCurrentUserAdmin();

    if (!admin) {
      window.location.replace(
        '/colab',
      );
    } else {
      try {
        await loadTickets();

        notificationConnection =
          subscribeAdminSupportNotifications(
            async () => {
              await loadTickets();
            },
          );

        loading?.classList.add(
          'member-hidden',
        );

        content?.classList.remove(
          'member-hidden',
        );
      } catch (error) {
        console.error(
          '[EVRYLUX] Não foi possível abrir o suporte:',
          error,
        );

        loading!.textContent =
          'Não foi possível carregar o suporte.';
      }
    }
  }

  window.addEventListener(
    'pagehide',
    () => {
      void notificationConnection?.disconnect();
    },
  );
</script>

<style is:global>
  .ticket-item {
    width: 100%;
    min-height: 66px;
    padding: 10px;
    display: grid;
    grid-template-columns: auto minmax(0,1fr) auto;
    align-items: center;
    gap: 10px;
    border: 1px solid var(--border);
    border-radius: 13px;
    background: var(--surface-muted);
    color: var(--text);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .ticket-item.active {
    border-color: rgba(95,157,89,.28);
    background: var(--primary-soft);
  }

  .ticket-avatar {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: #fff;
    color: var(--primary-deep);
    font-size: 10px;
    font-weight: 900;
  }

  .ticket-copy {
    min-width: 0;
  }

  .ticket-copy strong,
  .ticket-copy small {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ticket-copy strong {
    font-size: 10px;
  }

  .ticket-copy small {
    margin-top: 3px;
    color: var(--text-soft);
    font-size: 8px;
  }

  .ticket-time {
    color: var(--text-soft);
    font-size: 7px;
  }

  .admin-support-message {
    max-width: 78%;
    padding: 11px 12px;
    border-radius: 13px;
  }

  .admin-support-message > span {
    display: block;
    font-size: 7px;
    font-weight: 850;
    text-transform: uppercase;
    letter-spacing: .06em;
  }

  .admin-support-message p {
    margin: 4px 0 0;
    font-size: 11px;
    line-height: 1.55;
    white-space: pre-wrap;
  }

  .admin-support-message small {
    display: block;
    margin-top: 5px;
    opacity: .65;
    font-size: 7px;
  }

  .admin-support-message.user {
    margin-right: auto;
    border: 1px solid var(--border);
    background: #fff;
  }

  .admin-support-message.admin {
    margin-left: auto;
    background: var(--primary-soft);
    color: var(--primary-deep);
  }
</style>

<style>
  .support-admin-layout {
    margin-top: 28px;
    min-height: 610px;
    display: grid;
    grid-template-columns: 330px minmax(0,1fr);
    gap: 14px;
  }

  .tickets-panel,
  .admin-chat-panel {
    border: 1px solid var(--border);
    border-radius: 20px;
    background: rgba(255,255,255,.78);
  }

  .tickets-panel {
    padding: 15px;
  }

  .tickets-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 10px;
  }

  .tickets-kicker,
  .admin-chat-kicker {
    display: block;
    color: var(--primary-deep);
    font-size: 8px;
    font-weight: 850;
    text-transform: uppercase;
    letter-spacing: .08em;
  }

  .tickets-head h2 {
    margin: 4px 0 0;
    font-size: 18px;
  }

  .tickets-count {
    min-width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border-radius: 9px;
    background: var(--surface-muted);
    color: var(--text-soft);
    font-size: 10px;
    font-weight: 800;
  }

  .tickets-list {
    margin-top: 14px;
    display: grid;
    gap: 7px;
    max-height: 530px;
    overflow-y: auto;
  }

  .tickets-empty {
    padding: 22px;
    border: 1px dashed var(--border-strong);
    border-radius: 12px;
    color: var(--text-soft);
    font-size: 9px;
    text-align: center;
  }

  .admin-chat-panel {
    padding: 18px;
  }

  .admin-chat-empty {
    min-height: 570px;
    display: grid;
    place-content: center;
    text-align: center;
  }

  .admin-chat-empty strong,
  .admin-chat-empty span {
    display: block;
  }

  .admin-chat-empty strong {
    font-size: 14px;
  }

  .admin-chat-empty span {
    margin-top: 5px;
    color: var(--text-soft);
    font-size: 9px;
  }

  #admin-chat-content {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .admin-chat-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border);
  }

  .admin-chat-head h2 {
    margin: 4px 0 0;
    font-size: 18px;
  }

  .admin-chat-head a {
    display: block;
    margin-top: 4px;
    color: var(--primary-deep);
    font-size: 9px;
  }

  #active-ticket-status {
    min-height: 34px;
    padding: 0 8px;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: var(--surface-muted);
    color: var(--text);
    font-size: 9px;
  }

  .admin-chat-messages {
    flex: 1;
    min-height: 390px;
    max-height: 460px;
    padding: 16px 2px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    overflow-y: auto;
  }

  .admin-reply-form {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 8px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
  }

  .admin-reply-form textarea {
    min-height: 72px;
    padding: 10px;
    resize: none;
    border: 1px solid var(--border);
    border-radius: 11px;
    background: var(--surface-muted);
    color: var(--text);
    font: inherit;
    font-size: 11px;
    outline: none;
  }

  .admin-reply-form button {
    min-width: 100px;
    min-height: 42px;
    padding: 0 11px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 9px;
    border: 1px solid rgba(95,157,89,.2);
    border-radius: 10px;
    background: var(--primary-soft);
    color: var(--primary-deep);
    font: inherit;
    font-size: 9px;
    font-weight: 850;
    cursor: pointer;
  }

  @media (max-width: 900px) {
    .support-admin-layout {
      grid-template-columns: 1fr;
    }

    .tickets-list {
      max-height: 280px;
    }
  }
</style>
