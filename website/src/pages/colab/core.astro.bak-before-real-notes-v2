---
import Layout from '../../layouts/Layout.astro';
import ColabNav from '../../components/colab/ColabNav.astro';
import '../../styles/members.css';
---

<Layout
  title="Núcleo — EVRYLUX Colab"
  description="O centro que mantém o EVRYLUX alinhado ao seu propósito."
>
  <main class="member-shell core-page">
    <div class="member-container core-container">
      <section class="core-hero">
        <div>
          <div class="eyebrow">EVRYLUX Colab</div>
          <h1>Núcleo</h1>
          <p>
            O lugar que registra o que é essencial para o projeto e ajuda
            a evitar que o EVRYLUX se afaste do seu propósito.
          </p>
        </div>

        <div class="core-hero-actions">
          <ColabNav />
          <button id="new-core-note" class="member-button member-button-primary member-hidden" type="button">
            + Nova nota
          </button>
        </div>
      </section>

      <section class="core-intro">
        <div class="core-intro-mark">N</div>
        <div>
          <span>Regra do Núcleo</span>
          <strong>
            Se uma decisão afastar o projeto do que está fixado aqui,
            ela merece ser repensada.
          </strong>
        </div>
      </section>

      <div id="core-loading" class="core-loading">Carregando o Núcleo...</div>

      <section id="core-content" class="member-hidden">
        <div class="core-section-head">
          <div>
            <span class="section-kicker">Direção do projeto</span>
            <h2>O que está no centro do EVRYLUX</h2>
            <p>
              Notas fixadas aparecem primeiro. Use esta área para registrar
              princípios, decisões e partes que definem o projeto.
            </p>
          </div>
          <span id="core-access-badge" class="core-access-badge">Visualização</span>
        </div>

        <div id="core-notes" class="core-notes"></div>

        <div id="core-empty" class="core-empty member-hidden">
          <div class="core-empty-icon">✦</div>
          <h3>O Núcleo ainda está vazio</h3>
          <p>
            Quando você adicionar a primeira nota, ela aparecerá aqui.
            Você pode começar fixando “Cérebro” como o núcleo atual do EVRYLUX.
          </p>
        </div>

        <section id="core-permissions" class="core-permissions member-hidden">
          <div class="core-section-head permissions-head">
            <div>
              <span class="section-kicker">Proprietário</span>
              <h2>Quem pode alterar o Núcleo</h2>
              <p>
                Apenas administradores autorizados podem criar, editar,
                fixar ou remover notas.
              </p>
            </div>
          </div>
          <div id="core-admin-list" class="core-admin-list"></div>
        </section>
      </section>

      <div id="core-status" class="member-status" role="status" aria-live="polite"></div>
    </div>

    <div id="core-modal" class="core-modal member-hidden" role="dialog" aria-modal="true" aria-labelledby="core-modal-title">
      <button id="core-modal-backdrop" class="core-modal-backdrop" type="button" aria-label="Fechar"></button>
      <section class="core-modal-card">
        <div class="core-modal-head">
          <div>
            <span class="section-kicker">Núcleo</span>
            <h2 id="core-modal-title">Nova nota</h2>
          </div>
          <button id="core-modal-close" class="core-modal-close" type="button" aria-label="Fechar">×</button>
        </div>

        <form id="core-form">
          <input id="core-note-id" type="hidden" />

          <label class="core-field">
            <span>Título</span>
            <input id="core-note-title" type="text" maxlength="120" required placeholder="Ex.: Cérebro" />
          </label>

          <label class="core-field">
            <span>Nota</span>
            <textarea id="core-note-content" maxlength="8000" rows="9" placeholder="Explique por que isso faz parte do núcleo do EVRYLUX..."></textarea>
          </label>

          <label class="core-pin-option">
            <input id="core-note-pinned" type="checkbox" />
            <span class="core-pin-box">
              <strong>Fixar no Núcleo</strong>
              <small>
                Notas fixadas aparecem primeiro e representam as partes
                mais importantes do projeto.
              </small>
            </span>
          </label>

          <div class="core-modal-actions">
            <button id="core-delete-note" class="core-delete-button member-hidden" type="button">Excluir</button>
            <div>
              <button id="core-cancel-note" class="member-button" type="button">Cancelar</button>
              <button id="core-save-note" class="member-button member-button-primary" type="submit">Salvar nota</button>
            </div>
          </div>
        </form>
      </section>
    </div>
  </main>


<style is:global>
  /* ==========================================================
     EVRYLUX NÚCLEO — CARDS DE NOTAS REAIS + MODAL
     ========================================================== */
  .evx-real-notes-grid {
    margin-top: 18px;
    display: grid;
    grid-template-columns: repeat(auto-fit,minmax(260px,1fr));
    gap: 14px;
    align-items: start;
  }
  .evx-real-note-card {
    min-height: 168px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    border: 1px solid rgba(65,104,62,.10);
    border-radius: 20px;
    background: linear-gradient(145deg,rgba(255,255,255,.97),rgba(247,251,244,.92));
    box-shadow: 0 15px 42px rgba(54,92,51,.055);
    cursor: pointer;
    transition: transform .18s ease,border-color .18s ease,box-shadow .18s ease;
  }
  .evx-real-note-card:hover {
    transform: translateY(-3px);
    border-color: rgba(95,157,89,.22);
    box-shadow: 0 22px 54px rgba(54,92,51,.09);
  }
  .evx-real-note-head {display:flex;align-items:flex-start;justify-content:space-between;gap:12px}
  .evx-real-note-kicker {color:#4d714f;font-size:8px;font-weight:900;letter-spacing:.09em;text-transform:uppercase}
  .evx-real-note-title {margin:5px 0 0;color:#172019;font-size:16px;line-height:1.25;letter-spacing:-.02em}
  .evx-real-note-arrow {width:36px;height:36px;flex:0 0 36px;display:grid;place-items:center;border-radius:12px;background:#eff6ec;color:#365f3a;border:1px solid rgba(65,104,62,.09)}
  .evx-real-note-arrow svg {width:16px!important;height:16px!important;max-width:16px!important;max-height:16px!important}
  .evx-real-note-summary {margin:0;color:#667268;font-size:11px;line-height:1.65;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}
  .evx-real-note-footer {margin-top:auto;display:flex;align-items:center;justify-content:space-between;gap:10px}
  .evx-real-note-open {color:#315f35;font-size:9px;font-weight:850}
  .evx-real-note-pinned {min-height:25px;padding:0 8px;display:inline-flex;align-items:center;gap:5px;border-radius:999px;background:rgba(159,211,149,.18);color:#315f35;font-size:7px;font-weight:850}
  .evx-real-note-pinned svg {width:12px!important;height:12px!important}
  .evx-real-note-source-hidden {display:none!important}

  .evx-real-note-modal-overlay {position:fixed;inset:0;z-index:15000;padding:22px;display:grid;place-items:center;background:rgba(18,27,20,.46);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
  .evx-real-note-modal {width:min(760px,calc(100vw - 34px));max-height:min(82vh,820px);display:flex;flex-direction:column;overflow:hidden;border:1px solid rgba(65,104,62,.12);border-radius:24px;background:linear-gradient(180deg,#fff,#f8fbf7);box-shadow:0 32px 100px rgba(23,32,25,.22)}
  .evx-real-note-modal-head {padding:20px 22px 16px;display:flex;align-items:flex-start;justify-content:space-between;gap:16px;border-bottom:1px solid rgba(65,104,62,.08)}
  .evx-real-note-modal-kicker {display:inline-flex;min-height:25px;padding:0 9px;align-items:center;border-radius:999px;background:#eff6ec;color:#365f3a;font-size:7px;font-weight:900;letter-spacing:.08em;text-transform:uppercase}
  .evx-real-note-modal-title {margin:9px 0 0;color:#172019;font-size:clamp(22px,3vw,30px);line-height:1.12;letter-spacing:-.035em}
  .evx-real-note-modal-close {width:38px;height:38px;flex:0 0 38px;display:grid;place-items:center;padding:0;border:1px solid rgba(65,104,62,.1);border-radius:12px;background:#f9fcf8;color:#172019;font:inherit;font-size:18px;cursor:pointer}
  .evx-real-note-modal-body {padding:22px;overflow:auto}
  .evx-real-note-modal-body p {margin:0 0 17px;color:#38443b;font-size:14px;line-height:1.8;white-space:pre-wrap}
  .evx-real-note-modal-empty {color:#68756a;font-size:12px;line-height:1.7}
  .evx-real-note-modal-actions {padding:14px 22px 20px;display:flex;justify-content:flex-end;gap:9px;border-top:1px solid rgba(65,104,62,.08)}
  .evx-real-note-modal-actions button {min-height:40px;padding:0 15px;border-radius:11px;border:1px solid rgba(65,104,62,.12);background:#fff;color:#172019;font:inherit;font-size:9px;font-weight:850;cursor:pointer}
  .evx-real-note-modal-actions .primary {border-color:#365f3a;background:#365f3a;color:#fff}
  @media(max-width:620px){
    .evx-real-notes-grid{grid-template-columns:1fr}
    .evx-real-note-card{min-height:150px;border-radius:18px}
    .evx-real-note-modal-overlay{padding:10px;align-items:end}
    .evx-real-note-modal{width:100%;max-height:90dvh;border-radius:22px 22px 14px 14px}
    .evx-real-note-modal-head,.evx-real-note-modal-body{padding:18px}
    .evx-real-note-modal-actions{padding:12px 18px 18px}
  }
</style>

<script is:inline>
(() => {
  const normalize = (value) => (value || '').replace(/\s+/g,' ').trim();
  const root = document.querySelector('main') || document.body;

  function removeOldMockLayer(){
    document.querySelectorAll('.evx-core-notes-shell,.evx-real-notes-grid').forEach(el=>el.remove());
    document.querySelectorAll('.evx-core-hidden-source-note,.evx-real-note-source-hidden').forEach(el=>el.classList.remove('evx-core-hidden-source-note','evx-real-note-source-hidden'));
  }

  function allElements(){ return [...root.querySelectorAll('*')]; }

  function findRealEditButtons(){
    return [...root.querySelectorAll('button,a')].filter((el)=> normalize(el.textContent).toLowerCase()==='editar' && !el.closest('.evx-real-note-modal'));
  }

  function findTitleAfter(button){
    const els=allElements();
    const index=els.indexOf(button);
    for(let i=index+1;i<Math.min(els.length,index+60);i++){
      const el=els[i];
      if(['H1','H2','H3','H4'].includes(el.tagName)){
        const t=normalize(el.textContent);
        if(t && !/^(nova nota|núcleo|o que está no centro do evrylux)$/i.test(t)) return el;
      }
      if((el.tagName==='BUTTON'||el.tagName==='A') && normalize(el.textContent).toLowerCase()==='editar') break;
    }
    return null;
  }

  function nextEditIndex(els,start){
    for(let i=start+1;i<els.length;i++){
      const el=els[i];
      if((el.tagName==='BUTTON'||el.tagName==='A') && normalize(el.textContent).toLowerCase()==='editar') return i;
    }
    return els.length;
  }

  function extractRealNote(button){
    const els=allElements();
    const btnIndex=els.indexOf(button);
    const titleEl=findTitleAfter(button);
    if(!titleEl) return null;
    const titleIndex=els.indexOf(titleEl);
    const endIndex=nextEditIndex(els,titleIndex);
    const paras=[];
    const seen=new Set();
    for(let i=titleIndex+1;i<Math.min(endIndex,titleIndex+120);i++){
      const el=els[i];
      if(['P','LI','BLOCKQUOTE'].includes(el.tagName)){
        if(el.closest('header,footer,nav,.core-modal,.evx-real-note-modal')) continue;
        const t=normalize(el.textContent);
        if(!t || seen.has(t)) continue;
        if(/notas fixadas aparecem primeiro|use esta área para registrar/i.test(t)) continue;
        if(/^(cancelar|salvar nota|excluir|editar)$/i.test(t)) continue;
        seen.add(t); paras.push(t);
      }
      if(paras.length>=20) break;
    }
    if(!paras.length){
      const container=titleEl.parentElement;
      if(container){
        const fallback=normalize(container.textContent).replace(normalize(titleEl.textContent),'').replace(/Editar/g,'').replace(/Fixado/g,'').trim();
        if(fallback) paras.push(fallback);
      }
    }
    const pinned = (()=>{
      for(let i=Math.max(0,btnIndex-12);i<=titleIndex;i++) if(/fixado/i.test(normalize(els[i]?.textContent))) return true;
      return false;
    })();
    return {button,titleEl,title:normalize(titleEl.textContent),paras,pinned};
  }

  function hideOriginalNote(note){
    // A fonte real continua na página/DOM; escondemos apenas os elementos visuais do bloco.
    note.button.classList.add('evx-real-note-source-hidden');
    note.titleEl.classList.add('evx-real-note-source-hidden');
    const els=allElements();
    const titleIndex=els.indexOf(note.titleEl);
    const endIndex=nextEditIndex(els,titleIndex);
    for(let i=Math.max(0,titleIndex-5);i<Math.min(endIndex,titleIndex+120);i++){
      const el=els[i];
      const t=normalize(el.textContent);
      if(el===note.titleEl || note.paras.includes(t) || /^fixado$/i.test(t) || t==='↧' || t==='📌'){
        if(!el.closest('header,nav,footer')) el.classList.add('evx-real-note-source-hidden');
      }
    }
  }

  function makeCard(note){
    const card=document.createElement('article');
    card.className='evx-real-note-card';
    const summary=note.paras.join(' ').slice(0,220)+(note.paras.join(' ').length>220?'…':'');
    card.innerHTML=`
      <div class="evx-real-note-head">
        <div><div class="evx-real-note-kicker">Núcleo</div><h3 class="evx-real-note-title"></h3></div>
        <span class="evx-real-note-arrow"><svg viewBox="0 0 24 24" fill="none"><path d="M7 12h10M13 8l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
      </div>
      <p class="evx-real-note-summary"></p>
      <div class="evx-real-note-footer">
        <span class="evx-real-note-open">Abrir nota</span>
        ${note.pinned?'<span class="evx-real-note-pinned"><svg viewBox="0 0 24 24" fill="none"><path d="M9 3h6l-1 6 4 4v2H6v-2l4-4-1-6Z" stroke="currentColor" stroke-width="1.7"/><path d="M12 15v6" stroke="currentColor" stroke-width="1.7"/></svg>Fixado</span>':''}
      </div>`;
    card.querySelector('.evx-real-note-title').textContent=note.title;
    card.querySelector('.evx-real-note-summary').textContent=summary || 'Abra para visualizar o conteúdo completo desta nota.';
    card.addEventListener('click',()=>openModal(note));
    return card;
  }

  function openModal(note){
    const overlay=document.createElement('div'); overlay.className='evx-real-note-modal-overlay';
    const modal=document.createElement('section'); modal.className='evx-real-note-modal'; modal.setAttribute('role','dialog'); modal.setAttribute('aria-modal','true');
    modal.innerHTML=`<div class="evx-real-note-modal-head"><div><span class="evx-real-note-modal-kicker">${note.pinned?'Nota fixada':'Nota do Núcleo'}</span><h2 class="evx-real-note-modal-title"></h2></div><button class="evx-real-note-modal-close" type="button" aria-label="Fechar">×</button></div><div class="evx-real-note-modal-body"></div><div class="evx-real-note-modal-actions"><button type="button" data-close>Fechar</button><button type="button" class="primary" data-edit>Editar nota</button></div>`;
    modal.querySelector('.evx-real-note-modal-title').textContent=note.title;
    const body=modal.querySelector('.evx-real-note-modal-body');
    if(note.paras.length){ note.paras.forEach(t=>{const p=document.createElement('p');p.textContent=t;body.appendChild(p);}); }
    else { body.innerHTML='<div class="evx-real-note-modal-empty">Esta nota não possui conteúdo adicional.</div>'; }
    overlay.appendChild(modal); document.body.appendChild(overlay); document.body.style.overflow='hidden';
    const close=()=>{overlay.remove();document.body.style.overflow='';document.removeEventListener('keydown',esc)};
    const esc=(e)=>{if(e.key==='Escape')close()}; document.addEventListener('keydown',esc);
    modal.querySelector('.evx-real-note-modal-close').addEventListener('click',close);
    modal.querySelector('[data-close]').addEventListener('click',close);
    overlay.addEventListener('click',(e)=>{if(e.target===overlay)close()});
    modal.querySelector('[data-edit]').addEventListener('click',()=>{close(); note.button.click();});
  }

  function init(){
    if(!/\/colab\/core/.test(location.pathname)) return;
    removeOldMockLayer();
    const buttons=findRealEditButtons();
    const notes=buttons.map(extractRealNote).filter(Boolean);
    if(!notes.length) return;
    const heading=[...root.querySelectorAll('h1,h2,h3')].find(el=>/o que está no centro do evrylux/i.test(normalize(el.textContent)));
    if(!heading) return;
    let anchor=heading;
    const intro=heading.parentElement?.querySelectorAll(':scope > p');
    if(intro?.length) anchor=intro[intro.length-1];
    const grid=document.createElement('div'); grid.className='evx-real-notes-grid';
    notes.forEach(note=>{hideOriginalNote(note);grid.appendChild(makeCard(note));});
    anchor.insertAdjacentElement('afterend',grid);
  }

  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',()=>setTimeout(init,50));
  else setTimeout(init,50);
})();
</script>


</Layout>

<script>
  import { requireMemberSession } from '../../lib/member-auth';
  import {
    canEditProjectCore,
    createProjectCoreNote,
    deleteProjectCoreNote,
    listProjectCoreNotes,
    updateProjectCoreNote,
    type ProjectCoreNote,
  } from '../../lib/project-core';

  const session = await requireMemberSession();
  const loading = document.querySelector<HTMLElement>('#core-loading');
  const content = document.querySelector<HTMLElement>('#core-content');
  const notesContainer = document.querySelector<HTMLElement>('#core-notes');
  const emptyState = document.querySelector<HTMLElement>('#core-empty');
  const newNoteButton = document.querySelector<HTMLButtonElement>('#new-core-note');
  const accessBadge = document.querySelector<HTMLElement>('#core-access-badge');
  const status = document.querySelector<HTMLElement>('#core-status');
  const modal = document.querySelector<HTMLElement>('#core-modal');
  const modalBackdrop = document.querySelector<HTMLButtonElement>('#core-modal-backdrop');
  const modalClose = document.querySelector<HTMLButtonElement>('#core-modal-close');
  const modalTitle = document.querySelector<HTMLElement>('#core-modal-title');
  const form = document.querySelector<HTMLFormElement>('#core-form');
  const noteId = document.querySelector<HTMLInputElement>('#core-note-id');
  const titleInput = document.querySelector<HTMLInputElement>('#core-note-title');
  const contentInput = document.querySelector<HTMLTextAreaElement>('#core-note-content');
  const pinnedInput = document.querySelector<HTMLInputElement>('#core-note-pinned');
  const saveButton = document.querySelector<HTMLButtonElement>('#core-save-note');
  const deleteButton = document.querySelector<HTMLButtonElement>('#core-delete-note');
  const cancelButton = document.querySelector<HTMLButtonElement>('#core-cancel-note');

  let notes: ProjectCoreNote[] = [];
  let canEdit = false;

  function escapeHtml(value: unknown) {
    return String(value ?? '')
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');
  }

  function formatDate(value: string) {
    return new Intl.DateTimeFormat('pt-BR', {
      day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit',
    }).format(new Date(value));
  }

  function showStatus(message: string, type: 'success' | 'error' | '' = '') {
    if (!status) return;
    status.textContent = message;
    status.className = type ? `member-status show ${type}` : 'member-status';
  }

  function handleProtectedError(error: unknown) {
    const message = error instanceof Error ? error.message : 'Não foi possível concluir a operação.';
    if (message.includes('AAL2')) {
      showStatus('Confirme o 2FA antes de alterar o Núcleo.', 'error');
      window.setTimeout(() => {
        window.location.href = `/colab/security?next=${encodeURIComponent('/colab/core')}`;
      }, 900);
      return;
    }
    showStatus(message, 'error');
  }

  function renderNotes() {
    if (!notesContainer || !emptyState) return;
    emptyState.classList.toggle('member-hidden', notes.length > 0);
    if (!notes.length) {
      notesContainer.innerHTML = '';
      return;
    }

    notesContainer.innerHTML = notes.map((note) => `
      <article class="core-note ${note.is_pinned ? 'is-pinned' : ''}" data-note-id="${escapeHtml(note.id)}">
        <div class="core-note-top">
          <div class="core-note-labels">
            ${note.is_pinned ? `
              <span class="core-pin-label">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M9 3h6l-1 6 3 3v1H7v-1l3-3-1-6Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
                  <path d="M12 13v8" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                </svg>
                Fixado
              </span>` : `<span class="core-note-label">Nota</span>`}
          </div>
          ${canEdit ? `<button class="core-edit-button" type="button" data-edit-note="${escapeHtml(note.id)}">Editar</button>` : ''}
        </div>
        <h3>${escapeHtml(note.title)}</h3>
        <p class="core-note-content ${note.content.trim() ? '' : 'core-note-empty-copy'}">
          ${note.content.trim() ? escapeHtml(note.content).replaceAll('\n', '<br />') : 'Sem descrição.'}
        </p>
        <div class="core-note-footer">Atualizado em ${escapeHtml(formatDate(note.updated_at))}</div>
      </article>
    `).join('');

    document.querySelectorAll<HTMLButtonElement>('[data-edit-note]').forEach((button) => {
      button.addEventListener('click', () => {
        const note = notes.find((item) => item.id === button.dataset.editNote);
        if (note) openEditModal(note);
      });
    });
  }

  function openCreateModal() {
    if (!modal || !noteId || !titleInput || !contentInput || !pinnedInput || !deleteButton || !modalTitle) return;
    noteId.value = '';
    titleInput.value = '';
    contentInput.value = '';
    pinnedInput.checked = false;
    deleteButton.classList.add('member-hidden');
    modalTitle.textContent = 'Nova nota';
    modal.classList.remove('member-hidden');
    document.body.classList.add('core-modal-open');
    window.setTimeout(() => titleInput.focus(), 50);
  }

  function openEditModal(note: ProjectCoreNote) {
    if (!modal || !noteId || !titleInput || !contentInput || !pinnedInput || !deleteButton || !modalTitle) return;
    noteId.value = note.id;
    titleInput.value = note.title;
    contentInput.value = note.content;
    pinnedInput.checked = note.is_pinned;
    deleteButton.classList.remove('member-hidden');
    modalTitle.textContent = 'Editar nota';
    modal.classList.remove('member-hidden');
    document.body.classList.add('core-modal-open');
  }

  function closeModal() {
    modal?.classList.add('member-hidden');
    document.body.classList.remove('core-modal-open');
  }

  async function refreshNotes() {
    notes = await listProjectCoreNotes();
    renderNotes();
  }

  newNoteButton?.addEventListener('click', openCreateModal);
  modalBackdrop?.addEventListener('click', closeModal);
  modalClose?.addEventListener('click', closeModal);
  cancelButton?.addEventListener('click', closeModal);
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeModal(); });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!titleInput || !contentInput || !pinnedInput || !noteId || !saveButton) return;
    const title = titleInput.value.trim();
    const noteContent = contentInput.value.trim();
    if (!title) {
      showStatus('Digite um título para a nota.', 'error');
      return;
    }
    saveButton.disabled = true;
    saveButton.textContent = 'Salvando...';
    try {
      if (noteId.value) {
        await updateProjectCoreNote({ id: noteId.value, title, content: noteContent, pinned: pinnedInput.checked });
        showStatus('Nota atualizada.', 'success');
      } else {
        await createProjectCoreNote({ title, content: noteContent, pinned: pinnedInput.checked });
        showStatus('Nota adicionada ao Núcleo.', 'success');
      }
      closeModal();
      await refreshNotes();
    } catch (error) {
      handleProtectedError(error);
    } finally {
      saveButton.disabled = false;
      saveButton.textContent = 'Salvar nota';
    }
  });

  deleteButton?.addEventListener('click', async () => {
    if (!noteId?.value) return;
    const note = notes.find((item) => item.id === noteId.value);
    if (!window.confirm(`Excluir "${note?.title || 'esta nota'}" do Núcleo?`)) return;
    deleteButton.disabled = true;
    try {
      await deleteProjectCoreNote(noteId.value);
      showStatus('Nota removida do Núcleo.', 'success');
      closeModal();
      await refreshNotes();
    } catch (error) {
      handleProtectedError(error);
    } finally {
      deleteButton.disabled = false;
    }
  });

  if (session) {
    try {
      canEdit = await canEditProjectCore();
      if (canEdit) {
        newNoteButton?.classList.remove('member-hidden');
        if (accessBadge) {
          accessBadge.textContent = 'Pode editar';
          accessBadge.classList.add('can-edit');
        }
      }
      await refreshNotes();
      loading?.classList.add('member-hidden');
      content?.classList.remove('member-hidden');
    } catch (error) {
      loading?.classList.add('member-hidden');
      content?.classList.remove('member-hidden');
      showStatus(error instanceof Error ? error.message : 'Não foi possível carregar o Núcleo.', 'error');
    }
  }
</script>

