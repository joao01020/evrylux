---
import Layout from '../../../layouts/Layout.astro';
import ColabNav from '../../../components/colab/ColabNav.astro';
import '../../../styles/members.css';
import EvryluxLogoLoader from '../../../components/ui/EvryluxLogoLoader.astro';
---

<Layout title="Validação — EVRYLUX Studio" description="Validação interna de funcionalidades do EVRYLUX.">
  <main class="member-shell">
    <EvryluxLogoLoader id="validation-loading" size="md" />

    <div id="validation-content" class="member-container member-hidden">
      <div class="member-topbar">
        <div class="member-title-block">
          <div class="eyebrow">Studio / Validação</div>

          <h1>Validação</h1>

          <p>
            Teste o que foi construído e decida com a equipe
            o que manter, revisar ou remover.
          </p>
        </div>

        <ColabNav />
      </div>

      <section class="validation-cycle">
        <div><span>01</span><strong>Roadmap</strong><small>Planejar</small></div>
        <i>→</i>
        <div class="active"><span>02</span><strong>Validar</strong><small>Testar</small></div>
        <i>→</i>
        <div><span>03</span><strong>Decidir</strong><small>Manter · Revisar · Remover</small></div>
      </section>

      <div class="validation-toolbar">
        <div class="validation-filters">
          <button class="validation-filter active" type="button" data-filter="all">Todos</button>
          <button class="validation-filter" type="button" data-filter="untested">Não testados</button>
          <button class="validation-filter" type="button" data-filter="testing">Em teste</button>
          <button class="validation-filter" type="button" data-filter="validated">Validados</button>
          <button class="validation-filter" type="button" data-filter="decision">Revisar / Remover</button>
        </div>

        <div class="validation-toolbar-actions">
          <button id="validation-new-item" class="validation-new-button" type="button">
            ＋ Nova função
          </button>

          <a class="validation-roadmap-link" href="/colab/studio">
            Abrir Roadmap →
          </a>
        </div>
      </div>

      <div id="validation-error" class="validation-error member-hidden"></div>

      <section id="validation-grid" class="validation-grid"></section>

      <section id="validation-empty" class="validation-empty member-hidden">
        <div>✓</div>
        <h2>Nenhum item aqui ainda</h2>
        <p>Envie uma funcionalidade pelo Roadmap para começar.</p>
        <a href="/colab/studio">Ir para o Roadmap →</a>
      </section>
    </div>



    <div id="validation-edit-modal" class="validation-modal member-hidden">
      <button class="validation-backdrop" data-close-edit type="button"></button>

      <section class="validation-modal-card">
        <div class="validation-modal-head">
          <div>
            <span>Validação</span>
            <h2>Editar função</h2>
          </div>

          <button data-close-edit type="button">×</button>
        </div>

        <form id="validation-edit-form">
          <input id="validation-edit-id" type="hidden" />

          <label>
            <span>Nome da função</span>
            <input id="validation-edit-name" maxlength="180" required />
          </label>

          <label>
            <span>Descrição</span>
            <textarea id="validation-edit-description" rows="5" maxlength="3000"></textarea>
          </label>

          <label>
            <span>Área</span>
            <input id="validation-edit-area" maxlength="120" />
          </label>

          <label>
            <span>Responsável</span>
            <select id="validation-edit-assignee">
              <option value="">Sem responsável</option>
            </select>
          </label>

          <div class="validation-modal-actions">
            <button data-close-edit type="button">Cancelar</button>
            <button class="primary" type="submit">Salvar alterações</button>
          </div>
        </form>
      </section>
    </div>

    <div id="validation-create-modal" class="validation-modal member-hidden">
      <button class="validation-backdrop" data-close-create type="button"></button>

      <section class="validation-modal-card">
        <div class="validation-modal-head">
          <div>
            <span>Validação</span>
            <h2>Nova função</h2>
          </div>

          <button data-close-create type="button">×</button>
        </div>

        <p class="validation-create-help">
          Adicione algo diretamente para testar, sem precisar criar primeiro no Roadmap.
        </p>

        <form id="validation-create-form">
          <label>
            <span>Nome da função</span>
            <input id="validation-create-name" maxlength="180" required />
          </label>

          <label>
            <span>Descrição</span>
            <textarea id="validation-create-description" rows="5" maxlength="3000"></textarea>
          </label>

          <label>
            <span>Área</span>
            <input id="validation-create-area" maxlength="120" placeholder="Ex.: Cérebro, Segurança..." />
          </label>

          <label>
            <span>Responsável</span>
            <select id="validation-create-assignee">
              <option value="">Sem responsável</option>
            </select>
          </label>

          <div class="validation-modal-actions">
            <button data-close-create type="button">Cancelar</button>
            <button class="primary" type="submit">Adicionar à validação</button>
          </div>
        </form>
      </section>
    </div>


    <div id="validation-history-modal" class="validation-modal member-hidden">
      <button
        class="validation-backdrop"
        data-close-history
        type="button"
      ></button>

      <section class="validation-modal-card validation-history-modal-card">
        <div class="validation-modal-head">
          <div>
            <span>Etapas da validação</span>
            <h2>Registrar nova etapa</h2>
          </div>

          <button data-close-history type="button">×</button>
        </div>

        <p class="validation-history-help">
          Registre o que aconteceu nesta fase. Este histórico não substitui
          o status atual nem a observação oficial do teste.
        </p>

        <form id="validation-history-form">
          <input id="validation-history-item-id" type="hidden" />

          <div class="validation-history-form-grid">
            <label>
              <span>Fase</span>
              <select id="validation-history-phase">
                <option value="planning">Planejamento</option>
                <option value="implementation">Implementação</option>
                <option value="test">Teste</option>
                <option value="fix">Correção</option>
                <option value="retest">Novo teste</option>
                <option value="validation">Validação</option>
                <option value="review">Revisão</option>
                <option value="removal">Remoção</option>
                <option value="observation">Observação</option>
              </select>
            </label>

            <label>
              <span>Resultado</span>
              <select id="validation-history-result">
                <option value="info">Informativo</option>
                <option value="pending">Pendente</option>
                <option value="partial">Parcial</option>
                <option value="success">Concluído</option>
                <option value="problem">Problema</option>
              </select>
            </label>
          </div>

          <label>
            <span>Título da etapa</span>
            <input
              id="validation-history-title"
              maxlength="180"
              required
              placeholder="Ex.: Segundo teste no macOS"
            />
          </label>

          <label>
            <span>O que aconteceu?</span>
            <textarea
              id="validation-history-description"
              rows="6"
              maxlength="5000"
              placeholder="Descreva a alteração, teste, resultado ou decisão desta fase."
            ></textarea>
          </label>

          <div class="validation-modal-actions">
            <button data-close-history type="button">
              Cancelar
            </button>

            <button class="primary" type="submit">
              Registrar etapa
            </button>
          </div>
        </form>
      </section>
    </div>

    <div id="validation-editor" class="validation-modal member-hidden">
      <button class="validation-backdrop" data-close-editor type="button"></button>

      <section class="validation-modal-card">
        <div class="validation-modal-head">
          <div>
            <span>Validação</span>
            <h2>Atualizar teste</h2>
          </div>

          <button data-close-editor type="button">×</button>
        </div>

        <form id="validation-form">
          <input id="validation-id" type="hidden" />

          <label>
            <span>Situação</span>
            <select id="validation-status">
              <option value="untested">Não testado</option>
              <option value="testing">Em teste</option>
              <option value="validated">Validado</option>
              <option value="review">Revisar</option>
            </select>
          </label>

          <label>
            <span>O que foi observado?</span>
            <textarea id="validation-notes" rows="7" maxlength="5000"></textarea>
          </label>

          <div class="validation-modal-actions">
            <button data-close-editor type="button">Cancelar</button>
            <button class="primary" type="submit">Salvar</button>
          </div>
        </form>
      </section>
    </div>
  </main>
</Layout>

<script>
  import { requireMemberSession } from '../../../lib/member-auth';

  import {
    getCollaboratorProfiles,
    type CollaboratorProfile,
  } from '../../../lib/colab-roadmap';

  import {
    addValidationHistoryEntry,
    canFinalizeValidation,
    downloadValidationMarkdownAttachment,
    createValidationItem,
    editValidationItem,
    finalizeValidation,
    getValidationAttachments,
    getValidationHistory,
    getValidationItems,
    proposeRemoval,
    updateValidation,
    uploadValidationMarkdownAttachment,
    validationHistoryPhaseLabels,
    validationHistoryResultLabels,
    validationStatusLabels,
    voteValidation,
    type ValidationAttachment,
    type ValidationHistoryEntry,
    type ValidationHistoryPhase,
    type ValidationHistoryResult,
    type ValidationItem,
    type ValidationVote,
  } from '../../../lib/colab-validation';

  const session = await requireMemberSession();

  const loading = document.querySelector<HTMLElement>('#validation-loading');
  const content = document.querySelector<HTMLElement>('#validation-content');
  const grid = document.querySelector<HTMLElement>('#validation-grid');
  const empty = document.querySelector<HTMLElement>('#validation-empty');
  const errorBox = document.querySelector<HTMLElement>('#validation-error');
  const editor = document.querySelector<HTMLElement>('#validation-editor');
  const form = document.querySelector<HTMLFormElement>('#validation-form');
  const idInput = document.querySelector<HTMLInputElement>('#validation-id');
  const statusInput = document.querySelector<HTMLSelectElement>('#validation-status');
  const notesInput = document.querySelector<HTMLTextAreaElement>('#validation-notes');
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('.validation-filter'));
  const newItemButton = document.querySelector<HTMLButtonElement>('#validation-new-item');
  const createModal = document.querySelector<HTMLElement>('#validation-create-modal');
  const createForm = document.querySelector<HTMLFormElement>('#validation-create-form');
  const createName = document.querySelector<HTMLInputElement>('#validation-create-name');
  const createDescription = document.querySelector<HTMLTextAreaElement>('#validation-create-description');
  const createArea = document.querySelector<HTMLInputElement>('#validation-create-area');
  const createAssignee = document.querySelector<HTMLSelectElement>('#validation-create-assignee');
  const editModal = document.querySelector<HTMLElement>('#validation-edit-modal');
  const editForm = document.querySelector<HTMLFormElement>('#validation-edit-form');
  const editId = document.querySelector<HTMLInputElement>('#validation-edit-id');
  const editName = document.querySelector<HTMLInputElement>('#validation-edit-name');
  const editDescription = document.querySelector<HTMLTextAreaElement>('#validation-edit-description');
  const editArea = document.querySelector<HTMLInputElement>('#validation-edit-area');
  const editAssignee = document.querySelector<HTMLSelectElement>('#validation-edit-assignee');

  const historyModal =
    document.querySelector<HTMLElement>(
      '#validation-history-modal',
    );

  const historyForm =
    document.querySelector<HTMLFormElement>(
      '#validation-history-form',
    );

  const historyItemId =
    document.querySelector<HTMLInputElement>(
      '#validation-history-item-id',
    );

  const historyPhase =
    document.querySelector<HTMLSelectElement>(
      '#validation-history-phase',
    );

  const historyResult =
    document.querySelector<HTMLSelectElement>(
      '#validation-history-result',
    );

  const historyTitle =
    document.querySelector<HTMLInputElement>(
      '#validation-history-title',
    );

  const historyDescription =
    document.querySelector<HTMLTextAreaElement>(
      '#validation-history-description',
    );

  let items: ValidationItem[] = [];
  let collaborators: CollaboratorProfile[] = [];
  let historyEntries:
    ValidationHistoryEntry[] =
      [];

  let validationAttachments:
    ValidationAttachment[] =
      [];

  const expandedCards =
    new Set<string>();

  let activeFilter = 'all';
  let canFinalize = false;

  function esc(value: unknown) {
    return String(value ?? '')
      .replaceAll('&','&amp;')
      .replaceAll('<','&lt;')
      .replaceAll('>','&gt;')
      .replaceAll('"','&quot;')
      .replaceAll("'",'&#039;');
  }

  function profileFor(userId: string | null) {
    return collaborators.find((p) => p.user_id === userId) ?? null;
  }

  function nameFor(userId: string | null) {
    const p = profileFor(userId);
    return p?.display_name?.trim() || p?.github_login?.trim() || 'Sem responsável';
  }

  function avatarFor(userId: string | null) {
    return profileFor(userId)?.avatar_url?.trim() || '/branding/default-profile-avatar.png';
  }

  function attachmentsFor(
    validationItemId: string,
  ) {
    return validationAttachments
      .filter(
        (
          attachment,
        ) =>
          attachment.validation_item_id ===
          validationItemId,
      )
      .sort(
        (
          a,
          b,
        ) =>
          new Date(
            b.created_at,
          ).getTime() -
          new Date(
            a.created_at,
          ).getTime(),
      );
  }

  function formatFileSize(
    bytes: number,
  ) {
    if (
      !Number.isFinite(
        bytes,
      ) ||
      bytes <=
      0
    ) {
      return '0 KB';
    }

    if (
      bytes <
      1024
    ) {
      return `${bytes} B`;
    }

    const kb =
      bytes /
      1024;

    if (
      kb <
      1024
    ) {
      return `${kb.toFixed(
        kb >= 100
          ? 0
          : 1,
      )} KB`;
    }

    return `${(
      kb /
      1024
    ).toFixed(1)} MB`;
  }

  function attachmentList(
    item: ValidationItem,
  ) {
    const attachments =
      attachmentsFor(
        item.id,
      );

    if (
      !attachments.length
    ) {
      return `
        <div class="validation-attachments-empty">
          <strong>Nenhum arquivo técnico anexado.</strong>
          <span>
            Anexe um .md com classes, variáveis, tabelas,
            decisões e evidências do que foi testado.
          </span>
        </div>
      `;
    }

    return `
      <div class="validation-attachment-list">
        ${attachments.map(
          (
            attachment,
          ) => `
            <article class="validation-attachment-row">
              <div class="validation-attachment-file-icon">
                MD
              </div>

              <div class="validation-attachment-copy">
                <strong>
                  ${esc(
                    attachment.file_name,
                  )}
                </strong>

                <span>
                  ${esc(
                    formatFileSize(
                      attachment.file_size,
                    ),
                  )}
                  ·
                  ${esc(
                    formatHistoryDate(
                      attachment.created_at,
                    ),
                  )}
                </span>
              </div>

              <button
                type="button"
                class="validation-attachment-download"
                data-download-attachment="${esc(
                  attachment.id,
                )}"
              >
                Baixar
              </button>
            </article>
          `,
        ).join('')}
      </div>
    `;
  }

  function historyFor(
    validationItemId: string,
  ) {
    return historyEntries
      .filter(
        (
          entry,
        ) =>
          entry.validation_item_id ===
          validationItemId,
      )
      .sort(
        (
          a,
          b,
        ) =>
          new Date(
            a.created_at,
          ).getTime() -
          new Date(
            b.created_at,
          ).getTime(),
      );
  }

  function formatHistoryDate(
    value: string,
  ) {
    const date =
      new Date(
        value,
      );

    if (
      Number.isNaN(
        date.getTime(),
      )
    ) {
      return '';
    }

    return date.toLocaleString(
      'pt-BR',
      {
        day: '2-digit',
        month: '2-digit',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
      },
    );
  }

  function latestHistoryFor(
    validationItemId: string,
  ) {
    const history =
      historyFor(
        validationItemId,
      );

    return history.length
      ? history[
          history.length - 1
        ]
      : null;
  }

  function historyTimeline(
    item: ValidationItem,
  ) {
    const history =
      historyFor(
        item.id,
      );

    if (
      !history.length
    ) {
      return `
        <div class="validation-history-empty">
          <strong>Nenhuma etapa registrada ainda.</strong>
          <span>
            Use “Registrar etapa” para documentar implementação,
            teste, correção, novo teste ou validação.
          </span>
        </div>
      `;
    }

    return `
      <div class="validation-history-list">
        ${history.map(
          (
            entry,
            index,
          ) => `
            <article
              class="validation-history-entry"
              data-history-result="${esc(
                entry.result,
              )}"
            >
              <div class="validation-history-rail">
                <span></span>
                ${
                  index <
                  history.length - 1
                    ? '<i></i>'
                    : ''
                }
              </div>

              <div class="validation-history-entry-body">
                <div class="validation-history-entry-top">
                  <span class="validation-history-phase">
                    ${esc(
                      validationHistoryPhaseLabels[
                        entry.phase
                      ],
                    )}
                  </span>

                  <span
                    class="validation-history-result"
                    data-result="${esc(
                      entry.result,
                    )}"
                  >
                    ${esc(
                      validationHistoryResultLabels[
                        entry.result
                      ],
                    )}
                  </span>

                  <time>
                    ${esc(
                      formatHistoryDate(
                        entry.created_at,
                      ),
                    )}
                  </time>
                </div>

                <strong>
                  ${esc(
                    entry.title,
                  )}
                </strong>

                ${
                  entry.description
                    ? `
                      <p>
                        ${esc(
                          entry.description,
                        )}
                      </p>
                    `
                    : ''
                }
              </div>
            </article>
          `,
        ).join('')}
      </div>
    `;
  }

  function openHistoryModal(
    item: ValidationItem,
  ) {
    if (
      !historyModal ||
      !historyItemId ||
      !historyPhase ||
      !historyResult ||
      !historyTitle ||
      !historyDescription
    ) {
      return;
    }

    historyItemId.value =
      item.id;

    historyPhase.value =
      item.validation_status ===
      'testing'
        ? 'test'
        : item.validation_status ===
            'validated'
          ? 'validation'
          : item.validation_status ===
              'review'
            ? 'review'
            : item.validation_status ===
                'removal'
              ? 'removal'
              : 'observation';

    historyResult.value =
      'info';

    historyTitle.value =
      '';

    historyDescription.value =
      '';

    historyModal.classList.remove(
      'member-hidden',
    );

    historyTitle.focus();
  }

  function closeHistoryModal() {
    historyModal?.classList.add(
      'member-hidden',
    );

    historyForm?.reset();

    if (
      historyItemId
    ) {
      historyItemId.value =
        '';
    }
  }

  function visibleItems() {
    if (activeFilter === 'all') return items;
    if (activeFilter === 'decision') {
      return items.filter((item) =>
        ['review','removal','removed'].includes(item.validation_status),
      );
    }
    return items.filter((item) => item.validation_status === activeFilter);
  }

  function signal(item: ValidationItem) {
    const values = [
      ['manter', item.vote_keep],
      ['revisar', item.vote_review],
      ['remover', item.vote_remove],
    ] as const;

    const max = Math.max(...values.map((v) => v[1]));
    if (max === 0) return 'Sem votos ainda';

    const leaders = values.filter((v) => v[1] === max);
    return leaders.length > 1
      ? 'Votação equilibrada'
      : `Equipe tende a ${leaders[0][0]}`;
  }

  function voteButton(item: ValidationItem, vote: ValidationVote, label: string, count: number) {
    return `
      <button
        class="validation-vote ${item.my_vote === vote ? 'selected' : ''}"
        type="button"
        data-vote="${vote}"
        data-id="${esc(item.id)}"
      >
        <span>${label}</span>
        <strong>${count}</strong>
      </button>
    `;
  }

  function card(item: ValidationItem) {
    const name =
      nameFor(
        item.assignee_user_id,
      );

    const avatar =
      avatarFor(
        item.assignee_user_id,
      );

    const isAssignedToMe =
      Boolean(
        session?.user?.id,
      ) &&
      item.assignee_user_id ===
        session.user.id;

    const votes =
      item.vote_keep +
      item.vote_review +
      item.vote_remove;

    const removed =
      item.validation_status ===
      'removed';

    const itemHistory =
      historyFor(
        item.id,
      );

    const itemAttachments =
      attachmentsFor(
        item.id,
      );

    const latestHistory =
      latestHistoryFor(
        item.id,
      );

    const expanded =
      expandedCards.has(
        item.id,
      );

    return `
      <article
        class="
          validation-card
          validation-card-collapsible
          status-${esc(
            item.validation_status,
          )}
          ${expanded ? 'is-expanded' : ''}
        "
        data-validation-card="${esc(
          item.id,
        )}"
        aria-expanded="${String(
          expanded,
        )}"
      >
        <div class="validation-card-summary">
          <div class="validation-card-summary-main">
            <div class="validation-card-top">
              <span class="validation-status">
                ${esc(
                  validationStatusLabels[
                    item.validation_status
                  ],
                )}
              </span>

              <span class="validation-source">
                ${
                  item.source_type ===
                  'direct'
                    ? 'Direto'
                    : 'Roadmap'
                }
              </span>
            </div>

            <h2 class="validation-card-title">
              <span>
                ${esc(
                  item.title,
                )}
              </span>

              ${
                isAssignedToMe
                  ? `
                    <i
                      class="validation-my-task-dot"
                      title="Você está marcado nesta tarefa"
                      aria-label="Você está marcado nesta tarefa"
                    ></i>
                  `
                  : ''
              }
            </h2>

            <div class="validation-card-compact-meta">
              <span>
                ${itemHistory.length}
                ${
                  itemHistory.length === 1
                    ? 'etapa'
                    : 'etapas'
                }
              </span>

              ${
                latestHistory
                  ? `
                    <span class="validation-card-latest">
                      Última:
                      ${esc(
                        validationHistoryPhaseLabels[
                          latestHistory.phase
                        ],
                      )}
                      ·
                      ${esc(
                        latestHistory.title,
                      )}
                    </span>
                  `
                  : `
                    <span class="validation-card-latest muted">
                      Nenhuma etapa registrada
                    </span>
                  `
              }
            </div>
          </div>

          <button
            class="validation-card-toggle"
            type="button"
            data-toggle-card="${esc(
              item.id,
            )}"
            aria-label="${
              expanded
                ? 'Recolher função'
                : 'Expandir função'
            }"
            aria-expanded="${String(
              expanded,
            )}"
            title="${
              expanded
                ? 'Recolher'
                : 'Expandir'
            }"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="m7 14 5-5 5 5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
        </div>

        <div
          class="validation-card-expanded"
          aria-hidden="${String(
            !expanded,
          )}"
        >
          ${
            item.description
              ? `
                <p class="validation-description">
                  ${esc(
                    item.description,
                  )}
                </p>
              `
              : ''
          }

          <div class="validation-person">
            <img
              src="${esc(
                avatar,
              )}"
              alt=""
              onerror="this.src='/branding/default-profile-avatar.png'"
            />

            <div>
              <span>Responsável</span>
              <strong>
                ${esc(
                  name,
                )}
              </strong>
            </div>
          </div>

          ${
            item.test_notes
              ? `
                <div class="validation-note">
                  <span>Observação atual do teste</span>
                  <p>
                    ${esc(
                      item.test_notes,
                    )}
                  </p>
                </div>
              `
              : ''
          }

          ${
            item.removal_reason
              ? `
                <div class="validation-removal-note">
                  <span>Motivo da proposta</span>
                  <p>
                    ${esc(
                      item.removal_reason,
                    )}
                  </p>
                </div>
              `
              : ''
          }

          <div class="validation-actions">
            ${
              !removed
                ? `
                  <button
                    type="button"
                    data-edit-details="${esc(
                      item.id,
                    )}"
                  >
                    Editar
                  </button>

                  <button
                    type="button"
                    data-edit="${esc(
                      item.id,
                    )}"
                  >
                    Testar / atualizar
                  </button>
                `
                : ''
            }

            <button
              class="history-action"
              type="button"
              data-add-history="${esc(
                item.id,
              )}"
            >
              ＋ Registrar etapa
            </button>

            ${
              !removed &&
              item.validation_status !==
                'removal'
                ? `
                  <button
                    class="danger-soft"
                    type="button"
                    data-remove="${esc(
                      item.id,
                    )}"
                  >
                    Propor remoção
                  </button>
                `
                : ''
            }
          </div>

          <section class="validation-attachments-section">
            <div class="validation-attachments-head">
              <div>
                <span>Documentação técnica</span>

                <strong>
                  Arquivos da função
                </strong>
              </div>

              <small>
                ${itemAttachments.length}
                ${
                  itemAttachments.length ===
                  1
                    ? 'arquivo'
                    : 'arquivos'
                }
              </small>
            </div>

            <p class="validation-attachments-help">
              Use arquivos Markdown para registrar nomes de classes,
              variáveis, tabelas do banco, decisões de implementação
              e o que foi testado. Os próximos membros poderão baixar
              esse histórico técnico.
            </p>

            <div class="validation-attachment-upload">
              <label>
                <input
                  type="file"
                  accept=".md,text/markdown"
                  data-attachment-file="${esc(
                    item.id,
                  )}"
                />

                <span>
                  Escolher .md
                </span>
              </label>

              <button
                type="button"
                data-upload-attachment="${esc(
                  item.id,
                )}"
              >
                Anexar arquivo
              </button>
            </div>

            <div
              class="validation-attachment-selection"
              data-attachment-selection="${esc(
                item.id,
              )}"
            >
              Nenhum arquivo selecionado
            </div>

            ${attachmentList(
              item,
            )}
          </section>

          <section class="validation-history-section">
            <div class="validation-history-head">
              <div>
                <span>Etapas da validação</span>
                <strong>
                  Histórico da função
                </strong>
              </div>

              <small>
                ${itemHistory.length}
                ${
                  itemHistory.length === 1
                    ? 'registro'
                    : 'registros'
                }
              </small>
            </div>

            ${historyTimeline(
              item,
            )}
          </section>

          <div class="validation-voting">
            <div class="validation-voting-head">
              <div>
                <span>Decisão da equipe</span>
                <strong>
                  ${esc(
                    signal(
                      item,
                    ),
                  )}
                </strong>
              </div>

              <small>
                ${votes}
                ${
                  votes === 1
                    ? 'voto'
                    : 'votos'
                }
              </small>
            </div>

            <div class="validation-votes">
              ${voteButton(
                item,
                'keep',
                'Manter',
                item.vote_keep,
              )}

              ${voteButton(
                item,
                'review',
                'Revisar',
                item.vote_review,
              )}

              ${voteButton(
                item,
                'remove',
                'Remover',
                item.vote_remove,
              )}
            </div>
          </div>

          ${
            canFinalize &&
            [
              'review',
              'removal',
            ].includes(
              item.validation_status,
            )
              ? `
                <div class="validation-finalize">
                  <span>Decisão final</span>

                  <div>
                    <button
                      type="button"
                      data-finalize="${esc(
                        item.id,
                      )}"
                      data-decision="validated"
                    >
                      Manter
                    </button>

                    <button
                      type="button"
                      data-finalize="${esc(
                        item.id,
                      )}"
                      data-decision="review"
                    >
                      Revisar
                    </button>

                    <button
                      class="danger"
                      type="button"
                      data-finalize="${esc(
                        item.id,
                      )}"
                      data-decision="removed"
                    >
                      Confirmar remoção
                    </button>
                  </div>
                </div>
              `
              : ''
          }
        </div>
      </article>
    `;
  }

  function showError(message: string) {
    if (!errorBox) return;
    errorBox.textContent = message;
    errorBox.classList.remove('member-hidden');
  }

  function clearError() {
    errorBox?.classList.add('member-hidden');
  }

  function render() {
    if (!grid || !empty) return;

    const visible = visibleItems();

    if (!visible.length) {
      grid.innerHTML = '';
      empty.classList.remove('member-hidden');
      return;
    }

    empty.classList.add('member-hidden');
    grid.innerHTML = visible.map(card).join('');
    bindDynamic();
  }

  function openEditor(item: ValidationItem) {
    if (!editor || !idInput || !statusInput || !notesInput) return;

    idInput.value = item.id;
    statusInput.value = ['removal','removed'].includes(item.validation_status)
      ? 'review'
      : item.validation_status;
    notesInput.value = item.test_notes ?? '';

    editor.classList.remove('member-hidden');
  }

  function closeEditor() {
    editor?.classList.add('member-hidden');
  }

  async function refresh() {
    const [
      nextItems,
      nextHistory,
      nextAttachments,
    ] =
      await Promise.all([
        getValidationItems(),
        getValidationHistory(),
        getValidationAttachments(),
      ]);

    items =
      nextItems;

    historyEntries =
      nextHistory;

    validationAttachments =
      nextAttachments;

    render();
  }

  function bindDynamic() {
    document
      .querySelectorAll<HTMLButtonElement>(
        '[data-toggle-card]',
      )
      .forEach(
        (
          button,
        ) => {
          button.addEventListener(
            'click',
            () => {
              const id =
                button.dataset.toggleCard ||
                '';

              if (
                !id
              ) {
                return;
              }

              if (
                expandedCards.has(
                  id,
                )
              ) {
                expandedCards.delete(
                  id,
                );
              } else {
                expandedCards.add(
                  id,
                );
              }

              render();
            },
          );
        },
      );

    document
      .querySelectorAll<HTMLButtonElement>(
        '[data-add-history]',
      )
      .forEach(
        (
          button,
        ) => {
          button.addEventListener(
            'click',
            () => {
              const item =
                items.find(
                  (
                    current,
                  ) =>
                    current.id ===
                    button.dataset.addHistory,
                );

              if (
                item
              ) {
                openHistoryModal(
                  item,
                );
              }
            },
          );
        },
      );

    document
      .querySelectorAll<HTMLInputElement>(
        '[data-attachment-file]',
      )
      .forEach(
        (
          input,
        ) => {
          input.addEventListener(
            'change',
            () => {
              const id =
                input.dataset.attachmentFile ||
                '';

              const target =
                document.querySelector<HTMLElement>(
                  `[data-attachment-selection="${CSS.escape(
                    id,
                  )}"]`,
                );

              const file =
                input.files?.[
                  0
                ];

              if (
                target
              ) {
                target.textContent =
                  file
                    ? `${file.name} · ${formatFileSize(
                        file.size,
                      )}`
                    : 'Nenhum arquivo selecionado';
              }
            },
          );
        },
      );

    document
      .querySelectorAll<HTMLButtonElement>(
        '[data-upload-attachment]',
      )
      .forEach(
        (
          button,
        ) => {
          button.addEventListener(
            'click',
            async () => {
              const id =
                button.dataset.uploadAttachment ||
                '';

              const input =
                document.querySelector<HTMLInputElement>(
                  `[data-attachment-file="${CSS.escape(
                    id,
                  )}"]`,
                );

              const file =
                input?.files?.[
                  0
                ];

              if (
                !id ||
                !file
              ) {
                showError(
                  'Escolha um arquivo .md antes de anexar.',
                );

                return;
              }

              if (
                !file.name
                  .toLowerCase()
                  .endsWith(
                    '.md',
                  )
              ) {
                showError(
                  'Somente arquivos .md podem ser anexados.',
                );

                return;
              }

              const oldText =
                button.textContent;

              try {
                clearError();

                button.disabled =
                  true;

                button.textContent =
                  'Enviando...';

                await uploadValidationMarkdownAttachment(
                  id,
                  file,
                );

                expandedCards.add(
                  id,
                );

                await refresh();
              } catch (
                error: any
              ) {
                showError(
                  error?.message ||
                  'Não foi possível anexar o arquivo.',
                );
              } finally {
                button.disabled =
                  false;

                button.textContent =
                  oldText ||
                  'Anexar arquivo';
              }
            },
          );
        },
      );

    document
      .querySelectorAll<HTMLButtonElement>(
        '[data-download-attachment]',
      )
      .forEach(
        (
          button,
        ) => {
          button.addEventListener(
            'click',
            async () => {
              const attachment =
                validationAttachments.find(
                  (
                    current,
                  ) =>
                    current.id ===
                    button.dataset.downloadAttachment,
                );

              if (
                !attachment
              ) {
                return;
              }

              const oldText =
                button.textContent;

              try {
                clearError();

                button.disabled =
                  true;

                button.textContent =
                  'Baixando...';

                const blob =
                  await downloadValidationMarkdownAttachment(
                    attachment.storage_path,
                  );

                const url =
                  URL.createObjectURL(
                    blob,
                  );

                const anchor =
                  document.createElement(
                    'a',
                  );

                anchor.href =
                  url;

                anchor.download =
                  attachment.file_name;

                document.body.appendChild(
                  anchor,
                );

                anchor.click();
                anchor.remove();

                window.setTimeout(
                  () =>
                    URL.revokeObjectURL(
                      url,
                    ),
                  1000,
                );
              } catch (
                error: any
              ) {
                showError(
                  error?.message ||
                  'Não foi possível baixar o arquivo.',
                );
              } finally {
                button.disabled =
                  false;

                button.textContent =
                  oldText ||
                  'Baixar';
              }
            },
          );
        },
      );

    document
      .querySelectorAll<HTMLButtonElement>(
        '[data-edit-details]',
      )
      .forEach(
        (
          button,
        ) => {
          button.addEventListener(
            'click',
            () => {
              const item =
                items.find(
                  (
                    current,
                  ) =>
                    current.id ===
                    button.dataset.editDetails,
                );

              if (item) {
                openEditModal(
                  item,
                );
              }
            },
          );
        },
      );

    document.querySelectorAll<HTMLButtonElement>('[data-edit]').forEach((button) => {
      button.addEventListener('click', () => {
        const item = items.find((i) => i.id === button.dataset.edit);
        if (item) openEditor(item);
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-remove]').forEach((button) => {
      button.addEventListener('click', async () => {
        const item = items.find((i) => i.id === button.dataset.remove);
        if (!item) return;

        const reason = window.prompt(
          'Por que essa funcionalidade deveria ser removida?',
          item.removal_reason ?? '',
        );

        if (!reason) return;

        try {
          clearError();
          await proposeRemoval(item.id, reason);
          await refresh();
        } catch (error: any) {
          showError(error?.message || 'Não foi possível abrir a proposta.');
        }
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-vote]').forEach((button) => {
      button.addEventListener('click', async () => {
        try {
          clearError();
          await voteValidation(
            button.dataset.id || '',
            button.dataset.vote as ValidationVote,
          );
          await refresh();
        } catch (error: any) {
          showError(error?.message || 'Não foi possível registrar o voto.');
        }
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-finalize]').forEach((button) => {
      button.addEventListener('click', async () => {
        if (!window.confirm('Confirmar esta decisão?')) return;

        try {
          clearError();
          await finalizeValidation(
            button.dataset.finalize || '',
            button.dataset.decision as 'validated' | 'review' | 'removed',
          );
          await refresh();
        } catch (error: any) {
          showError(error?.message || 'Não foi possível confirmar a decisão.');
        }
      });
    });
  }


  document
    .querySelectorAll<HTMLElement>(
      '[data-close-history]',
    )
    .forEach(
      (
        element,
      ) => {
        element.addEventListener(
          'click',
          closeHistoryModal,
        );
      },
    );

  historyForm?.addEventListener(
    'submit',
    async (
      event,
    ) => {
      event.preventDefault();

      if (
        !historyItemId?.value ||
        !historyPhase?.value ||
        !historyResult?.value ||
        !historyTitle?.value.trim()
      ) {
        showError(
          'Preencha a fase e o título da etapa.',
        );

        return;
      }

      const submitButton =
        historyForm.querySelector<HTMLButtonElement>(
          'button[type="submit"]',
        );

      if (
        submitButton
      ) {
        submitButton.disabled =
          true;

        submitButton.textContent =
          'Registrando...';
      }

      try {
        clearError();

        await addValidationHistoryEntry(
          {
            validation_item_id:
              historyItemId.value,

            phase:
              historyPhase.value as
                ValidationHistoryPhase,

            title:
              historyTitle.value.trim(),

            description:
              historyDescription?.value.trim() ||
              null,

            result:
              historyResult.value as
                ValidationHistoryResult,
          },
        );

        expandedCards.add(
          historyItemId.value,
        );

        await refresh();

        closeHistoryModal();
      } catch (
        error: any
      ) {
        showError(
          error?.message ||
          'Não foi possível registrar a etapa.',
        );
      } finally {
        if (
          submitButton
        ) {
          submitButton.disabled =
            false;

          submitButton.textContent =
            'Registrar etapa';
        }
      }
    },
  );

  function populateAssignees() {
    const selects =
      [
        createAssignee,
        editAssignee,
      ].filter(Boolean) as HTMLSelectElement[];

    selects.forEach(
      (
        select,
      ) => {
        select.innerHTML =
          '<option value="">Sem responsável</option>';

        collaborators.forEach(
          (
            profile,
          ) => {
            const option =
              document.createElement(
                'option',
              );

            option.value =
              profile.user_id;

            option.textContent =
              profile.display_name?.trim() ||
              profile.github_login?.trim() ||
              'Colaborador';

            select.appendChild(
              option,
            );
          },
        );
      },
    );
  }

  function openCreateModal() {
    createForm?.reset();
    createModal?.classList.remove('member-hidden');
    window.setTimeout(() => createName?.focus(), 30);
  }

  function closeCreateModal() {
    createModal?.classList.add('member-hidden');
  }

  newItemButton?.addEventListener('click', openCreateModal);

  document.querySelectorAll<HTMLButtonElement>('[data-close-create]').forEach((button) => {
    button.addEventListener('click', closeCreateModal);
  });

  createForm?.addEventListener('submit', async (event) => {
    event.preventDefault();

    const title = createName?.value.trim() || '';

    if (title.length < 2) {
      showError('Informe um nome para a função.');
      return;
    }

    const submit =
      createForm.querySelector<HTMLButtonElement>('button[type="submit"]');

    try {
      clearError();

      if (submit) {
        submit.disabled = true;
        submit.textContent = 'Adicionando...';
      }

      await createValidationItem({
        title,
        description: createDescription?.value.trim() || null,
        area: createArea?.value.trim() || null,
        assignee_user_id: createAssignee?.value || null,
      });

      closeCreateModal();
      activeFilter = 'all';

      filters.forEach((item) => {
        item.classList.toggle(
          'active',
          item.dataset.filter === 'all',
        );
      });

      await refresh();
    } catch (error: any) {
      showError(
        error?.message ||
        'Não foi possível adicionar a função.',
      );
    } finally {
      if (submit) {
        submit.disabled = false;
        submit.textContent = 'Adicionar à validação';
      }
    }
  });


  function openEditModal(
    item: ValidationItem,
  ) {
    if (
      !editModal ||
      !editId ||
      !editName ||
      !editDescription ||
      !editArea ||
      !editAssignee
    ) {
      return;
    }

    editId.value =
      item.id;

    editName.value =
      item.title ?? '';

    editDescription.value =
      item.description ?? '';

    editArea.value =
      item.area ?? '';

    editAssignee.value =
      item.assignee_user_id ?? '';

    editModal.classList.remove(
      'member-hidden',
    );

    window.setTimeout(
      () => editName.focus(),
      30,
    );
  }

  function closeEditModal() {
    editModal?.classList.add(
      'member-hidden',
    );
  }

  document
    .querySelectorAll<HTMLButtonElement>(
      '[data-close-edit]',
    )
    .forEach(
      (
        button,
      ) => {
        button.addEventListener(
          'click',
          closeEditModal,
        );
      },
    );

  editForm?.addEventListener(
    'submit',
    async (
      event,
    ) => {
      event.preventDefault();

      if (
        !editId ||
        !editName
      ) {
        return;
      }

      const title =
        editName.value.trim();

      if (
        title.length <
        2
      ) {
        showError(
          'Informe um nome para a função.',
        );

        return;
      }

      const submit =
        editForm.querySelector<HTMLButtonElement>(
          'button[type="submit"]',
        );

      try {
        clearError();

        if (submit) {
          submit.disabled =
            true;

          submit.textContent =
            'Salvando...';
        }

        await editValidationItem(
          {
            id:
              editId.value,

            title,

            description:
              editDescription?.value.trim() ||
              null,

            area:
              editArea?.value.trim() ||
              null,

            assignee_user_id:
              editAssignee?.value ||
              null,
          },
        );

        closeEditModal();

        await refresh();
      } catch (
        error: any
      ) {
        showError(
          error?.message ||
          'Não foi possível editar a função.',
        );
      } finally {
        if (submit) {
          submit.disabled =
            false;

          submit.textContent =
            'Salvar alterações';
        }
      }
    },
  );

  filters.forEach((button) => {
    button.addEventListener('click', () => {
      activeFilter = button.dataset.filter || 'all';

      filters.forEach((item) => {
        item.classList.toggle('active', item === button);
      });

      render();
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-close-editor]').forEach((button) => {
    button.addEventListener('click', closeEditor);
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (!idInput || !statusInput || !notesInput) return;

    try {
      clearError();

      await updateValidation(
        idInput.value,
        statusInput.value as 'untested' | 'testing' | 'validated' | 'review',
        notesInput.value.trim() || null,
      );

      closeEditor();
      await refresh();
    } catch (error: any) {
      showError(error?.message || 'Não foi possível salvar.');
    }
  });

  document.addEventListener(
    'keydown',
    (
      event,
    ) => {
      if (
        event.key !==
        'Escape'
      ) {
        return;
      }

      if (
        historyModal &&
        !historyModal.classList.contains(
          'member-hidden',
        )
      ) {
        closeHistoryModal();
      }
    },
  );

  if (session) {
    try {
      [collaborators, canFinalize] =
        await Promise.all([
          getCollaboratorProfiles(),
          canFinalizeValidation(),
        ]);

      populateAssignees();

      await refresh();

      loading?.classList.add('member-hidden');
      content?.classList.remove('member-hidden');
    } catch (error: any) {
      loading?.classList.add('member-hidden');
      content?.classList.remove('member-hidden');
      showError(error?.message || 'Não foi possível carregar a Validação.');
    }
  }
</script>

<style is:global>
  .member-hidden{display:none!important}
  .validation-cycle{margin-top:26px;padding:15px 17px;display:flex;align-items:center;gap:12px;border:1px solid rgba(65,104,62,.09);border-radius:17px;background:linear-gradient(145deg,rgba(255,255,255,.84),rgba(239,248,235,.66))}
  .validation-cycle>div{flex:1;display:grid;grid-template-columns:28px 1fr;align-items:center;column-gap:9px}
  .validation-cycle>div>span{width:28px;height:28px;grid-row:1/3;display:grid;place-items:center;border-radius:9px;background:rgba(23,32,25,.05);color:var(--text-soft);font-size:8px;font-weight:850}
  .validation-cycle>div.active>span{background:var(--primary-soft);color:var(--primary-deep)}
  .validation-cycle strong{font-size:10px}
  .validation-cycle small{color:var(--text-soft);font-size:8px}
  .validation-cycle>i{color:rgba(65,104,62,.25);font-style:normal}
  .validation-toolbar{margin-top:20px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
  .validation-filters{display:flex;flex-wrap:wrap;gap:6px}
  .validation-filter,.validation-roadmap-link{min-height:37px;padding:0 11px;display:inline-flex;align-items:center;border:1px solid rgba(65,104,62,.10);border-radius:10px;background:rgba(255,255,255,.76);color:var(--text-soft);font:inherit;font-size:9px;font-weight:800}
  .validation-filter{cursor:pointer}
  .validation-filter.active{background:var(--primary-soft);color:var(--primary-deep)}
