---
import Layout from '../../../layouts/Layout.astro';
import ColabNav from '../../../components/colab/ColabNav.astro';
import '../../../styles/members.css';
import EvryluxLogoLoader from '../../../components/ui/EvryluxLogoLoader.astro';
---

<Layout
  title="Roadmap interno — EVRYLUX Colab"
  description="Roadmap interno detalhado do projeto EVRYLUX."
>
  <main class="member-shell roadmap-page">
    <EvryluxLogoLoader
      id="roadmap-loading"
      size="md"
    />

    <div
      id="roadmap-content"
      class="member-container member-hidden"
    >
      <div class="member-topbar">
        <div class="member-title-block">
          <div class="eyebrow">
            Studio / Roadmap
          </div>

          <h1>
            Roadmap interno
          </h1>

          <p>
            Veja todas as etapas do projeto em uma única visão.
          </p>
        </div>

        <ColabNav />
      </div>

      <div class="roadmap-toolbar">
        <div class="roadmap-filter-row">
          <button
            class="roadmap-filter active"
            type="button"
            data-filter="all"
          >
            Todos
          </button>

          <button
            class="roadmap-filter"
            type="button"
            data-filter="mine"
          >
            Meus itens
          </button>

          <button
            class="roadmap-filter"
            type="button"
            data-filter="in_progress"
          >
            Em andamento
          </button>

          <button
            class="roadmap-filter"
            type="button"
            data-filter="done"
          >
            Concluídos
          </button>
        </div>

        
        <a
          class="studio-validation-button"
          href="/colab/studio/validation"
          data-studio-validation-button
        >
          <span class="studio-validation-button-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path
                d="M5 12.5 9.2 17 19 7"
                fill="none"
                stroke="currentColor"
                stroke-width="1.9"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>

          <span>
            Validação
          </span>
        </a>

<button
          id="new-roadmap-item"
          class="roadmap-new-button"
          type="button"
        >
          <span aria-hidden="true">＋</span>
          Novo item
        </button>
      </div>

      <div
        id="roadmap-error"
        class="roadmap-error member-hidden"
        role="status"
      ></div>

      <section
        class="roadmap-board"
        aria-label="Roadmap do projeto"
      >
        {
          [
            {
              id: 'now',
              kicker: 'Foco atual',
              title: 'Agora',
            },
            {
              id: 'next',
              kicker: 'Próximos passos',
              title: 'Próximo',
            },
            {
              id: 'later',
              kicker: 'Planejado',
              title: 'Depois',
            },
            {
              id: 'done',
              kicker: 'Histórico',
              title: 'Concluído',
            },
          ].map(
            (
              stage,
            ) => (
              <section class="roadmap-column">
                <div class="roadmap-column-head">
                  <div>
                    <span class="roadmap-column-kicker">
                      {stage.kicker}
                    </span>

                    <h2>
                      {stage.title}
                    </h2>
                  </div>

                  <span
                    id={`stage-count-${stage.id}`}
                    class="roadmap-column-count"
                  >
                    0
                  </span>
                </div>

                <div
                  id={`stage-${stage.id}`}
                  class="roadmap-column-list"
                ></div>
              </section>
            ),
          )
        }
      </section>
    </div>

    <!-- ===================================================== -->
    <!-- TEMPLATE DO CARD                                      -->
    <!-- ===================================================== -->

    <template id="roadmap-card-template">
      <article
        class="roadmap-item-card roadmap-item-collapsible is-expanded"
        aria-expanded="true"
      >
        <div class="roadmap-card-summary">
          <h3 data-role="title"></h3>

          <button
            class="roadmap-card-toggle"
            type="button"
            data-role="toggle-card"
            aria-label="Encolher item"
            aria-expanded="true"
            title="Encolher"
          >
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                d="m7 14 5-5 5 5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
        </div>

        <div
          class="roadmap-card-expanded"
          aria-hidden="true"
        >
          <div class="roadmap-card-badges">
            <span
              class="roadmap-pill roadmap-priority"
              data-role="priority"
            ></span>

            <span
              class="roadmap-pill roadmap-status"
              data-role="status"
            ></span>
          </div>

          <p
            class="roadmap-card-description"
            data-role="description"
          ></p>

          <div class="roadmap-card-assignee">
            <span
              class="roadmap-card-avatar"
              data-role="assignee-avatar"
            ></span>

            <div>
              <span>
                Responsável
              </span>

              <strong data-role="assignee"></strong>
            </div>
          </div>

          <div class="roadmap-card-progress">
            <div class="roadmap-card-progress-head">
              <span>
                Progresso
              </span>

              <strong data-role="progress-label">
                0%
              </strong>
            </div>

            <div class="roadmap-card-progress-track">
              <span
                data-role="progress-fill"
                class="roadmap-card-progress-fill"
              ></span>
            </div>
          </div>

          <button
            class="roadmap-card-details-button"
            type="button"
            data-role="open-details"
          >
            Ver detalhes / editar
          </button>
        </div>
      </article>
    </template>

    <!-- ===================================================== -->
    <!-- MODAL CRIAR / EDITAR                                  -->
    <!-- ===================================================== -->

    <div
      id="roadmap-modal"
      class="roadmap-modal member-hidden"
      role="dialog"
      aria-modal="true"
      aria-labelledby="roadmap-modal-title"
    >
      <button
        id="roadmap-modal-backdrop"
        class="roadmap-modal-backdrop"
        type="button"
        aria-label="Fechar"
      ></button>

      <section class="roadmap-modal-card">
        <div class="roadmap-modal-head">
          <div>
            <span class="roadmap-modal-kicker">
              Roadmap
            </span>

            <h2 id="roadmap-modal-title">
              Novo item
            </h2>
          </div>

          <button
            id="roadmap-modal-close"
            class="roadmap-modal-close"
            type="button"
            aria-label="Fechar"
          >
            ×
          </button>
        </div>

        <form
          id="roadmap-form"
          class="roadmap-form"
        >
          <input
            id="roadmap-item-id"
            type="hidden"
          />

          <div class="roadmap-main-grid">
            <div class="roadmap-field roadmap-title-field">
              <label for="roadmap-title">
                Título
              </label>

              <input
                id="roadmap-title"
                type="text"
                maxlength="140"
                required
                placeholder="O que precisa ser feito?"
              />
            </div>

            <div class="roadmap-field">
              <label for="roadmap-description">
                Descrição
              </label>

              <textarea
                id="roadmap-description"
                maxlength="2000"
                placeholder="Explique o objetivo deste item."
              ></textarea>
            </div>
          </div>

          <div class="roadmap-visual-grid">
            <div class="roadmap-visual-control">
              <div class="roadmap-control-head">
                <label for="roadmap-stage-range">
                  Etapa
                </label>

                <strong id="roadmap-stage-value">
                  Agora
                </strong>
              </div>

              <input
                id="roadmap-stage-range"
                class="roadmap-range"
                type="range"
                min="0"
                max="3"
                step="1"
                value="0"
              />

              <div class="roadmap-range-labels roadmap-stage-labels">
                <span>Agora</span>
                <span>Próximo</span>
                <span>Depois</span>
                <span>Concluído</span>
              </div>

              <select
                id="roadmap-stage"
                class="roadmap-hidden-select"
                tabindex="-1"
                aria-hidden="true"
              >
                <option value="now">Agora</option>
                <option value="next">Próximo</option>
                <option value="later">Depois</option>
                <option value="done">Concluído</option>
              </select>
            </div>

            <div class="roadmap-visual-control">
              <div class="roadmap-control-head">
                <label for="roadmap-priority-range">
                  Prioridade
                </label>

                <strong id="roadmap-priority-value">
                  Média
                </strong>
              </div>

              <input
                id="roadmap-priority-range"
                class="roadmap-range"
                type="range"
                min="0"
                max="2"
                step="1"
                value="1"
              />

              <div class="roadmap-range-labels roadmap-priority-labels">
                <span>Baixa</span>
                <span>Média</span>
                <span>Alta</span>
              </div>

              <select
                id="roadmap-priority"
                class="roadmap-hidden-select"
                tabindex="-1"
                aria-hidden="true"
              >
                <option value="low">Baixa</option>
                <option value="medium">Média</option>
                <option value="high">Alta</option>
              </select>
            </div>
          </div>

          <div class="roadmap-form-grid">
            <div class="roadmap-field">
              <label for="roadmap-status">
                Status
              </label>

              <select id="roadmap-status">
                <option value="todo">A fazer</option>
                <option value="in_progress">Em andamento</option>
                <option value="blocked">Bloqueado</option>
                <option value="done">Concluído</option>
              </select>
            </div>

            <div class="roadmap-field">
              <label for="roadmap-assignee">
                Responsável
              </label>

              <select id="roadmap-assignee">
                <option value="">
                  Sem responsável
                </option>
              </select>
            </div>

            <div class="roadmap-field">
              <label for="roadmap-area">
                Área
              </label>

              <input
                id="roadmap-area"
                type="text"
                maxlength="120"
                placeholder="Ex.: Front e Backend"
              />
            </div>

            <div class="roadmap-field">
              <label for="roadmap-due-date">
                Prazo
              </label>

              <input
                id="roadmap-due-date"
                type="date"
              />
            </div>
          </div>

          <div class="roadmap-progress-row">
            <div class="roadmap-progress-field">
              <div class="roadmap-control-head">
                <label for="roadmap-progress">
                  Progresso
                </label>

                <strong id="roadmap-progress-value">
                  0%
                </strong>
              </div>

              <input
                id="roadmap-progress"
                class="roadmap-range"
                type="range"
                min="0"
                max="100"
                step="5"
                value="0"
              />
            </div>

            <div class="roadmap-field roadmap-notes-field">
              <label for="roadmap-notes">
                Notas internas
              </label>

              <textarea
                id="roadmap-notes"
                maxlength="3000"
                placeholder="Contexto adicional, decisões, links ou observações."
              ></textarea>
            </div>
          </div>

          <div
            id="roadmap-form-status"
            class="roadmap-form-status"
            role="status"
          ></div>

          <div class="roadmap-modal-actions">
            <button
              id="roadmap-delete"
              class="roadmap-button roadmap-button-danger member-hidden"
              type="button"
            >
              Excluir
            </button>

            <div class="roadmap-modal-actions-right">
              <button
                id="roadmap-cancel"
                class="roadmap-button roadmap-button-secondary"
                type="button"
              >
                Cancelar
              </button>

              <button
                id="roadmap-save"
                class="roadmap-button roadmap-button-primary"
                type="submit"
              >
                Criar item
              </button>
            </div>
          </div>
        </form>
      </section>
    </div>

    <!-- ===================================================== -->
    <!-- MODAL DE DETALHES                                     -->
    <!-- ===================================================== -->

    <div
      id="roadmap-details-modal"
      class="roadmap-details-modal member-hidden"
      role="dialog"
      aria-modal="true"
      aria-labelledby="roadmap-details-title"
    >
      <button
        id="roadmap-details-backdrop"
        class="roadmap-details-backdrop"
        type="button"
        aria-label="Fechar detalhes"
      ></button>

      <section class="roadmap-details-card">
        <div class="roadmap-details-head">
          <div class="roadmap-details-heading">
            <span class="roadmap-details-kicker">
              Item do roadmap
            </span>

            <div
              id="roadmap-details-badges"
              class="roadmap-details-badges"
            ></div>

            <h2 id="roadmap-details-title">
              Item
            </h2>

            <p id="roadmap-details-description">
              —
            </p>
          </div>

          <button
            id="roadmap-details-close"
            class="roadmap-details-close"
            type="button"
            aria-label="Fechar"
          >
            ×
          </button>
        </div>

        <div class="roadmap-details-grid">
          <div class="roadmap-details-info">
            <span
              id="roadmap-details-avatar"
              class="roadmap-details-avatar"
            ></span>

            <div>
              <span>
                Responsável
              </span>

              <strong id="roadmap-details-assignee">
                —
              </strong>
            </div>
          </div>

          <div class="roadmap-details-info">
            <div>
              <span>
                Área
              </span>

              <strong id="roadmap-details-area">
                —
              </strong>
            </div>
          </div>

          <div class="roadmap-details-info">
            <div>
              <span>
                Prazo
              </span>

              <strong id="roadmap-details-due-date">
                —
              </strong>
            </div>
          </div>

          <div class="roadmap-details-info">
            <div>
              <span>
                Etapa
              </span>

              <strong id="roadmap-details-stage">
                —
              </strong>
            </div>
          </div>
        </div>

        <div class="roadmap-details-progress">
          <div class="roadmap-details-progress-head">
            <span>
              Progresso
            </span>

            <strong id="roadmap-details-progress-label">
              0%
            </strong>
          </div>

          <div class="roadmap-details-progress-track">
            <span id="roadmap-details-progress-fill"></span>
          </div>
        </div>

        <div
          id="roadmap-details-notes-wrap"
          class="roadmap-details-notes member-hidden"
        >
          <span>
            Notas internas
          </span>

          <p id="roadmap-details-notes"></p>
        </div>

        <div class="roadmap-details-actions">
          <button
            id="roadmap-details-edit"
            class="roadmap-button roadmap-button-primary"
            type="button"
          >
            Editar item
          </button>
        </div>
      </section>
    </div>
  </main>
</Layout>


<script>
  import {
    requireMemberSession,
  } from '../../../lib/member-auth';

  import {
    createRoadmapItem,
    deleteRoadmapItem,
    getCollaboratorProfiles,
    getRoadmapItems,
    priorityLabels,
    stageLabels,
    statusLabels,
    updateRoadmapItem,
    type CollaboratorProfile,
    type RoadmapItem,
    type RoadmapItemInput,
    type RoadmapPriority,
    type RoadmapStage,
    type RoadmapStatus,
  } from '../../../lib/colab-roadmap';

  const session =
    await requireMemberSession();

  const loading =
    document.querySelector<HTMLElement>('#roadmap-loading');

  const content =
    document.querySelector<HTMLElement>('#roadmap-content');

  const errorBox =
    document.querySelector<HTMLElement>('#roadmap-error');

  const newButton =
    document.querySelector<HTMLButtonElement>('#new-roadmap-item');

  const cardTemplate =
    document.querySelector<HTMLTemplateElement>('#roadmap-card-template');

  const modal =
    document.querySelector<HTMLElement>('#roadmap-modal');

  const modalBackdrop =
    document.querySelector<HTMLButtonElement>('#roadmap-modal-backdrop');

  const modalClose =
    document.querySelector<HTMLButtonElement>('#roadmap-modal-close');

  const modalCancel =
    document.querySelector<HTMLButtonElement>('#roadmap-cancel');

  const modalTitle =
    document.querySelector<HTMLElement>('#roadmap-modal-title');

  const form =
    document.querySelector<HTMLFormElement>('#roadmap-form');

  const itemId =
    document.querySelector<HTMLInputElement>('#roadmap-item-id');

  const titleInput =
    document.querySelector<HTMLInputElement>('#roadmap-title');

  const descriptionInput =
    document.querySelector<HTMLTextAreaElement>('#roadmap-description');

  const stageInput =
    document.querySelector<HTMLSelectElement>('#roadmap-stage');

  const stageRange =
    document.querySelector<HTMLInputElement>('#roadmap-stage-range');

  const stageValue =
    document.querySelector<HTMLElement>('#roadmap-stage-value');

  const statusInput =
    document.querySelector<HTMLSelectElement>('#roadmap-status');

  const priorityInput =
    document.querySelector<HTMLSelectElement>('#roadmap-priority');

  const priorityRange =
    document.querySelector<HTMLInputElement>('#roadmap-priority-range');

  const priorityValue =
    document.querySelector<HTMLElement>('#roadmap-priority-value');

  const assigneeInput =
    document.querySelector<HTMLSelectElement>('#roadmap-assignee');

  const areaInput =
    document.querySelector<HTMLInputElement>('#roadmap-area');

  const dueDateInput =
    document.querySelector<HTMLInputElement>('#roadmap-due-date');

  const progressInput =
    document.querySelector<HTMLInputElement>('#roadmap-progress');

  const progressValue =
    document.querySelector<HTMLElement>('#roadmap-progress-value');

  const notesInput =
    document.querySelector<HTMLTextAreaElement>('#roadmap-notes');

  const saveButton =
    document.querySelector<HTMLButtonElement>('#roadmap-save');

  const deleteButton =
    document.querySelector<HTMLButtonElement>('#roadmap-delete');

  const formStatus =
    document.querySelector<HTMLElement>('#roadmap-form-status');

  const filterButtons =
    Array.from(
      document.querySelectorAll<HTMLButtonElement>(
        '.roadmap-filter',
      ),
    );

  const detailsModal =
    document.querySelector<HTMLElement>('#roadmap-details-modal');

  const detailsBackdrop =
    document.querySelector<HTMLButtonElement>('#roadmap-details-backdrop');

  const detailsClose =
    document.querySelector<HTMLButtonElement>('#roadmap-details-close');

  const detailsEdit =
    document.querySelector<HTMLButtonElement>('#roadmap-details-edit');

  const detailsTitle =
    document.querySelector<HTMLElement>('#roadmap-details-title');

  const detailsDescription =
    document.querySelector<HTMLElement>('#roadmap-details-description');

  const detailsBadges =
    document.querySelector<HTMLElement>('#roadmap-details-badges');

  const detailsAvatar =
    document.querySelector<HTMLElement>('#roadmap-details-avatar');

  const detailsAssignee =
    document.querySelector<HTMLElement>('#roadmap-details-assignee');

  const detailsArea =
    document.querySelector<HTMLElement>('#roadmap-details-area');

  const detailsDueDate =
    document.querySelector<HTMLElement>('#roadmap-details-due-date');

  const detailsStage =
    document.querySelector<HTMLElement>('#roadmap-details-stage');

  const detailsProgressLabel =
    document.querySelector<HTMLElement>('#roadmap-details-progress-label');

  const detailsProgressFill =
    document.querySelector<HTMLElement>('#roadmap-details-progress-fill');

  const detailsNotesWrap =
    document.querySelector<HTMLElement>('#roadmap-details-notes-wrap');

  const detailsNotes =
    document.querySelector<HTMLElement>('#roadmap-details-notes');

  const stages:
    RoadmapStage[] = [
      'now',
      'next',
      'later',
      'done',
    ];

  const stageRangeMap:
    RoadmapStage[] = [
      'now',
      'next',
      'later',
      'done',
    ];

  const priorityRangeMap:
    RoadmapPriority[] = [
      'low',
      'medium',
      'high',
    ];

  let roadmapItems:
    RoadmapItem[] =
      [];

  let collaborators:
    CollaboratorProfile[] =
      [];

  let activeFilter:
    'all' |
    'mine' |
    'in_progress' |
    'done' =
      'all';

  let detailsItem:
    RoadmapItem | null =
      null;

  function syncStageVisualFromRange() {
    if (
      !stageRange ||
      !stageInput ||
      !stageValue
    ) {
      return;
    }

    const index =
      Math.max(
        0,
        Math.min(
          3,
          Number(stageRange.value),
        ),
      );

    const stage =
      stageRangeMap[index];

    stageInput.value =
      stage;

    stageValue.textContent =
      stageLabels[stage];
  }

  function syncStageVisualFromSelect() {
    if (
      !stageRange ||
      !stageInput ||
      !stageValue
    ) {
      return;
    }

    const stage =
      stageInput.value as RoadmapStage;

    const index =
      Math.max(
        0,
        stageRangeMap.indexOf(stage),
      );

    stageRange.value =
      String(index);

    stageValue.textContent =
      stageLabels[stage];
  }

  function syncPriorityVisualFromRange() {
    if (
      !priorityRange ||
      !priorityInput ||
      !priorityValue
    ) {
      return;
    }

    const index =
      Math.max(
        0,
        Math.min(
          2,
          Number(priorityRange.value),
        ),
      );

    const priority =
      priorityRangeMap[index];

    priorityInput.value =
      priority;

    priorityValue.textContent =
      priorityLabels[priority];
  }

  function syncPriorityVisualFromSelect() {
    if (
      !priorityRange ||
      !priorityInput ||
      !priorityValue
    ) {
      return;
    }

    const priority =
      priorityInput.value as RoadmapPriority;

    const index =
      Math.max(
        0,
        priorityRangeMap.indexOf(priority),
      );

    priorityRange.value =
      String(index);

    priorityValue.textContent =
      priorityLabels[priority];
  }

  function showError(
    message: string,
  ) {
    if (!errorBox) {
      return;
    }

    errorBox.textContent =
      message;

    errorBox.classList.remove(
      'member-hidden',
    );
  }

  function clearError() {
    errorBox?.classList.add(
      'member-hidden',
    );
  }

  function showFormStatus(
    message: string,
    type:
      'success' |
      'error' |
      '',
  ) {
    if (!formStatus) {
      return;
    }

    formStatus.textContent =
      message;

    formStatus.className =
      type
        ? `roadmap-form-status ${type}`
        : 'roadmap-form-status';
  }



  function renderRoadmapAvatar(
    target: HTMLElement | null,
    profile: CollaboratorProfile | null,
    name: string,
  ) {
    if (!target) {
      return;
    }

    target.innerHTML = '';
    target.style.backgroundImage = '';
    target.classList.add('has-image');

    const fallback =
      '/branding/default-profile-avatar.png';

    const image =
      document.createElement('img');

    image.className =
      'roadmap-profile-avatar-image';

    image.src =
      profile?.avatar_url?.trim() ||
      fallback;

    image.alt =
      `Foto de ${name}`;

    image.loading =
      'lazy';

    image.draggable =
      false;

    image.addEventListener(
      'error',
      () => {
        const current =
          image.getAttribute('src') ||
          '';

        if (
          !current.endsWith(
            fallback,
          )
        ) {
          image.src =
            fallback;
        }
      },
    );

    target.append(image);
  }

  function formatDate(
    value: string | null,
  ) {
    if (!value) {
      return 'Sem prazo';
    }

    return new Date(
      `${value}T12:00:00`,
    ).toLocaleDateString(
      'pt-BR',
    );
  }

  function collaboratorFor(
    userId: string | null,
  ) {
    if (!userId) {
      return null;
    }

    return (
      collaborators.find(
        (profile) =>
          profile.user_id ===
          userId,
      ) ??
      null
    );
  }

  function collaboratorName(
    userId: string | null,
  ) {
    const profile =
      collaboratorFor(
        userId,
      );

    if (!profile) {
      return 'Sem responsável';
    }

    return (
      profile.display_name?.trim() ||
      profile.github_login?.trim() ||
      'Colaborador EVRYLUX'
    );
  }

  function filteredItems() {
    if (!session) {
      return roadmapItems;
    }

    if (activeFilter === 'mine') {
      return roadmapItems.filter(
        (item) =>
          item.assignee_user_id ===
          session.user.id,
      );
    }

    if (
      activeFilter ===
      'in_progress'
    ) {
      return roadmapItems.filter(
        (item) =>
          item.status ===
          'in_progress',
      );
    }

    if (activeFilter === 'done') {
      return roadmapItems.filter(
        (item) =>
          item.status === 'done' ||
          item.stage === 'done',
      );
    }

    return roadmapItems;
  }

  function createEmpty(
    stage: RoadmapStage,
  ) {
    const empty =
      document.createElement(
        'div',
      );

    empty.className =
      'roadmap-empty';

    const strong =
      document.createElement(
        'strong',
      );

    strong.textContent =
      `Nenhum item em ${stageLabels[stage]}.`;

    const span =
      document.createElement(
        'span',
      );

    span.textContent =
      activeFilter === 'all'
        ? 'Crie um item para começar.'
        : 'Nenhum item corresponde ao filtro atual.';

    empty.append(
      strong,
      span,
    );

    return empty;
  }

  function createCard(
    item: RoadmapItem,
  ) {
    if (!cardTemplate) {
      return null;
    }

    const fragment =
      cardTemplate.content.cloneNode(
        true,
      ) as DocumentFragment;

    const card =
      fragment.querySelector<HTMLElement>(
        '.roadmap-item-card',
      );

    if (!card) {
      return null;
    }

    const profile =
      collaboratorFor(
        item.assignee_user_id,
      );

    const name =
      collaboratorName(
        item.assignee_user_id,
      );

    const setText = (
      selector: string,
      value: string,
    ) => {
      const element =
        card.querySelector<HTMLElement>(
          selector,
        );

      if (element) {
        element.textContent =
          value;
      }

      return element;
    };

    setText(
      '[data-role="title"]',
      item.title,
    );

    setText(
      '[data-role="description"]',
      item.description?.trim() ||
        'Sem descrição.',
    );

    const priority =
      setText(
        '[data-role="priority"]',
        priorityLabels[item.priority],
      );

    if (priority) {
      priority.dataset.priority =
        item.priority;
    }

    const status =
      setText(
        '[data-role="status"]',
        statusLabels[item.status],
      );

    if (status) {
      status.dataset.status =
        item.status;
    }

    setText(
      '[data-role="assignee"]',
      name,
    );

    setText(
      '[data-role="progress-label"]',
      `${item.progress}%`,
    );

    const avatar =
      card.querySelector<HTMLElement>(
        '[data-role="assignee-avatar"]',
      );

    renderRoadmapAvatar(
      avatar,
      profile,
      name,
    );

    const fill =
      card.querySelector<HTMLElement>(
        '[data-role="progress-fill"]',
      );

    if (fill) {
      fill.style.width =
        `${item.progress}%`;
    }

    const expandedBody =
      card.querySelector<HTMLElement>(
        '.roadmap-card-expanded',
      );

    const toggleButton =
      card.querySelector<HTMLButtonElement>(
        '[data-role="toggle-card"]',
      );

    // O item começa completo. O botão permite compactá-lo
    // para ocupar apenas uma linha com o título.
    card.classList.add(
      'is-expanded',
    );

    card.setAttribute(
      'aria-expanded',
      'true',
    );

    expandedBody?.setAttribute(
      'aria-hidden',
      'false',
    );

    const setExpanded =
      (
        expanded: boolean,
      ) => {
        card.classList.toggle(
          'is-expanded',
          expanded,
        );

        card.setAttribute(
          'aria-expanded',
          String(expanded),
        );

        expandedBody?.setAttribute(
          'aria-hidden',
          String(!expanded),
        );

        if (
          toggleButton
        ) {
          toggleButton.setAttribute(
            'aria-expanded',
            String(expanded),
          );

          toggleButton.setAttribute(
            'aria-label',
            expanded
              ? 'Encolher item'
              : 'Expandir item',
          );

          toggleButton.title =
            expanded
              ? 'Encolher'
              : 'Expandir';
        }
      };

    toggleButton?.addEventListener(
      'click',
      (
        event,
      ) => {
        event.stopPropagation();

        setExpanded(
          !card.classList.contains(
            'is-expanded',
          ),
        );
      },
    );

    const detailsButton =
      card.querySelector<HTMLButtonElement>(
        '[data-role="open-details"]',
      );

    detailsButton?.addEventListener(
      'click',
      (event) => {
        event.stopPropagation();

        openDetailsModal(
          item,
        );
      },
    );

    return card;
  }

  function renderRoadmap() {
    const items =
      filteredItems();

    stages.forEach(
      (stage) => {
        const container =
          document.querySelector<HTMLElement>(
            `#stage-${stage}`,
          );

        const count =
          document.querySelector<HTMLElement>(
            `#stage-count-${stage}`,
          );

        if (!container) {
          return;
        }

        const stageItems =
          items.filter(
            (item) =>
              item.stage ===
              stage,
          );

        if (count) {
          count.textContent =
            String(
              stageItems.length,
            );
        }

        container.innerHTML =
          '';

        if (!stageItems.length) {
          container.appendChild(
            createEmpty(
              stage,
            ),
          );

          return;
        }

        stageItems.forEach(
          (item) => {
            const card =
              createCard(
                item,
              );

            if (card) {
              container.appendChild(
                card,
              );
            }
          },
        );
      },
    );
  }

  function fillCollaborators() {
    if (!assigneeInput) {
      return;
    }

    assigneeInput.innerHTML =
      '';

    const emptyOption =
      document.createElement(
        'option',
      );

    emptyOption.value = '';
    emptyOption.textContent =
      'Sem responsável';

    assigneeInput.appendChild(
      emptyOption,
    );

    collaborators.forEach(
      (profile) => {
        const option =
          document.createElement(
            'option',
          );

        option.value =
          profile.user_id;

        option.textContent =
          profile.display_name?.trim() ||
          profile.github_login?.trim() ||
          'Colaborador EVRYLUX';

        assigneeInput.appendChild(
          option,
        );
      },
    );
  }

  function syncProgress() {
    if (
      progressInput &&
      progressValue
    ) {
      progressValue.textContent =
        `${progressInput.value}%`;
    }
  }

  function resetForm() {
    form?.reset();

    if (itemId) {
      itemId.value =
        '';
    }

    if (stageInput) {
      stageInput.value =
        'now';
    }

    if (statusInput) {
      statusInput.value =
        'todo';
    }

    if (priorityInput) {
      priorityInput.value =
        'medium';
    }

    if (progressInput) {
      progressInput.value =
        '0';
    }

    syncStageVisualFromSelect();
    syncPriorityVisualFromSelect();
    syncProgress();

    showFormStatus(
      '',
      '',
    );

    deleteButton?.classList.add(
      'member-hidden',
    );

    if (saveButton) {
      saveButton.textContent =
        'Criar item';
    }
  }

  function openCreateModal() {
    resetForm();

    if (modalTitle) {
      modalTitle.textContent =
        'Novo item';
    }

    modal?.classList.remove(
      'member-hidden',
    );

    document.body.classList.add(
      'roadmap-modal-open',
    );

    titleInput?.focus();
  }

  function openEditModal(
    item: RoadmapItem,
  ) {
    resetForm();

    if (modalTitle) {
      modalTitle.textContent =
        'Editar item';
    }

    if (itemId) {
      itemId.value =
        item.id;
    }

    if (titleInput) {
      titleInput.value =
        item.title;
    }

    if (descriptionInput) {
      descriptionInput.value =
        item.description ??
        '';
    }

    if (stageInput) {
      stageInput.value =
        item.stage;
    }

    if (statusInput) {
      statusInput.value =
        item.status;
    }

    if (priorityInput) {
      priorityInput.value =
        item.priority;
    }

    if (assigneeInput) {
      assigneeInput.value =
        item.assignee_user_id ??
        '';
    }

    if (areaInput) {
      areaInput.value =
        item.area ??
        '';
    }

    if (dueDateInput) {
      dueDateInput.value =
        item.due_date ??
        '';
    }

    if (progressInput) {
      progressInput.value =
        String(
          item.progress,
        );
    }

    if (notesInput) {
      notesInput.value =
        item.notes ??
        '';
    }

    syncStageVisualFromSelect();
    syncPriorityVisualFromSelect();
    syncProgress();

    deleteButton?.classList.remove(
      'member-hidden',
    );

    if (saveButton) {
      saveButton.textContent =
        'Salvar alterações';
    }

    modal?.classList.remove(
      'member-hidden',
    );

    document.body.classList.add(
      'roadmap-modal-open',
    );
  }

  function closeModal() {
    modal?.classList.add(
      'member-hidden',
    );

    document.body.classList.remove(
      'roadmap-modal-open',
    );

    resetForm();
  }

  function openDetailsModal(
    item: RoadmapItem,
  ) {
    detailsItem =
      item;

    const profile =
      collaboratorFor(
        item.assignee_user_id,
      );

    const name =
      collaboratorName(
        item.assignee_user_id,
      );

    if (detailsTitle) {
      detailsTitle.textContent =
        item.title;
    }

    if (detailsDescription) {
      detailsDescription.textContent =
        item.description?.trim() ||
        'Sem descrição.';
    }

    if (detailsBadges) {
      detailsBadges.innerHTML =
        '';

      const priority =
        document.createElement(
          'span',
        );

      priority.className =
        'roadmap-pill roadmap-priority';

      priority.dataset.priority =
        item.priority;

      priority.textContent =
        priorityLabels[item.priority];

      const status =
        document.createElement(
          'span',
        );

      status.className =
        'roadmap-pill roadmap-status';

      status.dataset.status =
        item.status;

      status.textContent =
        statusLabels[item.status];

      detailsBadges.append(
        priority,
        status,
      );
    }

    renderRoadmapAvatar(
      detailsAvatar,
      profile,
      name,
    );

    if (detailsAssignee) {
      detailsAssignee.textContent =
        name;
    }

    if (detailsArea) {
      detailsArea.textContent =
        item.area?.trim() ||
        profile?.area?.trim() ||
        'Não informada';
    }

    if (detailsDueDate) {
      detailsDueDate.textContent =
        formatDate(
          item.due_date,
        );
    }

    if (detailsStage) {
      detailsStage.textContent =
        stageLabels[item.stage];
    }

    if (detailsProgressLabel) {
      detailsProgressLabel.textContent =
        `${item.progress}%`;
    }

    if (detailsProgressFill) {
      detailsProgressFill.style.width =
        `${item.progress}%`;
    }

    if (
      detailsNotesWrap &&
      detailsNotes
    ) {
      if (item.notes?.trim()) {
        detailsNotes.textContent =
          item.notes;

        detailsNotesWrap.classList.remove(
          'member-hidden',
        );
      } else {
        detailsNotes.textContent =
          '';

        detailsNotesWrap.classList.add(
          'member-hidden',
        );
      }
    }

    detailsModal?.classList.remove(
      'member-hidden',
    );

    document.body.classList.add(
      'roadmap-details-open',
    );

    detailsClose?.focus();
  }

  function closeDetailsModal() {
    detailsModal?.classList.add(
      'member-hidden',
    );

    document.body.classList.remove(
      'roadmap-details-open',
    );

    detailsItem =
      null;
  }

  function getFormInput():
    RoadmapItemInput {
    const rawProgress =
      Math.min(
        100,
        Math.max(
          0,
          Number(
            progressInput?.value ??
            0,
          ),
        ),
      );

    let stage =
      (
        stageInput?.value ??
        'now'
      ) as RoadmapStage;

    let status =
      (
        statusInput?.value ??
        'todo'
      ) as RoadmapStatus;

    if (
      stage === 'done' ||
      status === 'done'
    ) {
      stage =
        'done';

      status =
        'done';
    }

    return {
      title:
        titleInput?.value.trim() ??
        '',

      description:
        descriptionInput?.value.trim() ||
        null,

      stage,

      status,

      priority:
        (
          priorityInput?.value ??
          'medium'
        ) as RoadmapPriority,

      assignee_user_id:
        assigneeInput?.value ||
        null,

      area:
        areaInput?.value.trim() ||
        null,

      progress:
        status === 'done'
          ? 100
          : rawProgress,

      due_date:
        dueDateInput?.value ||
        null,

      notes:
        notesInput?.value.trim() ||
        null,
    };
  }

  async function loadRoadmap() {
    clearError();

    try {
      roadmapItems =
        await getRoadmapItems();
    } catch (error) {
      console.error(
        '[EVRYLUX] Erro ao carregar roadmap:',
        error,
      );

      showError(
        'Não foi possível carregar os itens do roadmap.',
      );

      roadmapItems =
        [];
    }

    try {
      collaborators =
        await getCollaboratorProfiles();

      fillCollaborators();
    } catch (error) {
      console.warn(
        '[EVRYLUX] Não foi possível carregar colaboradores:',
        error,
      );

      collaborators =
        [];

      fillCollaborators();
    }

    renderRoadmap();
  }

  stageRange?.addEventListener(
    'input',
    syncStageVisualFromRange,
  );

  priorityRange?.addEventListener(
    'input',
    syncPriorityVisualFromRange,
  );

  newButton?.addEventListener(
    'click',
    openCreateModal,
  );

  modalClose?.addEventListener(
    'click',
    closeModal,
  );

  modalCancel?.addEventListener(
    'click',
    closeModal,
  );

  modalBackdrop?.addEventListener(
    'click',
    closeModal,
  );

  detailsClose?.addEventListener(
    'click',
    closeDetailsModal,
  );

  detailsBackdrop?.addEventListener(
    'click',
    closeDetailsModal,
  );

  detailsEdit?.addEventListener(
    'click',
    () => {
      if (!detailsItem) {
        return;
      }

      const item =
        detailsItem;

      closeDetailsModal();
      openEditModal(item);
    },
  );

  progressInput?.addEventListener(
    'input',
    syncProgress,
  );

  statusInput?.addEventListener(
    'change',
    () => {
      if (
        statusInput.value ===
        'done'
      ) {
        if (stageInput) {
          stageInput.value =
            'done';
        }

        syncStageVisualFromSelect();

        if (progressInput) {
          progressInput.value =
            '100';
        }

        syncProgress();
      }
    },
  );

  filterButtons.forEach(
    (button) => {
      button.addEventListener(
        'click',
        () => {
          activeFilter =
            (
              button.dataset.filter ??
              'all'
            ) as typeof activeFilter;

          filterButtons.forEach(
            (item) => {
              item.classList.toggle(
                'active',
                item === button,
              );
            },
          );

          renderRoadmap();
        },
      );
    },
  );

  form?.addEventListener(
    'submit',
    async (event) => {
      event.preventDefault();

      if (
        !session ||
        !titleInput?.value.trim()
      ) {
        showFormStatus(
          'Informe um título.',
          'error',
        );

        return;
      }

      const editingId =
        itemId?.value ??
        '';

      if (saveButton) {
        saveButton.disabled =
          true;

        saveButton.textContent =
          'Salvando...';
      }

      try {
        const input =
          getFormInput();

        if (editingId) {
          await updateRoadmapItem(
            editingId,
            input,
          );
        } else {
          await createRoadmapItem(
            input,
            session.user.id,
          );
        }

        await loadRoadmap();
        closeModal();
      } catch (error) {
        console.error(
          '[EVRYLUX] Erro ao salvar item:',
          error,
        );

        showFormStatus(
          'Não foi possível salvar o item.',
          'error',
        );
      } finally {
        if (saveButton) {
          saveButton.disabled =
            false;

          saveButton.textContent =
            editingId
              ? 'Salvar alterações'
              : 'Criar item';
        }
      }
    },
  );

  deleteButton?.addEventListener(
    'click',
    async () => {
      const id =
        itemId?.value;

      if (!id) {
        return;
      }

      if (
        !window.confirm(
          'Excluir este item do roadmap?',
        )
      ) {
        return;
      }

      deleteButton.disabled =
        true;

      try {
        await deleteRoadmapItem(id);

        await loadRoadmap();
        closeModal();
      } catch (error) {
        console.error(
          '[EVRYLUX] Erro ao excluir item:',
          error,
        );

        showFormStatus(
          'Não foi possível excluir o item.',
          'error',
        );
      } finally {
        deleteButton.disabled =
          false;
      }
    },
  );

  document.addEventListener(
    'keydown',
    (event) => {
      if (
        event.key === 'Escape'
      ) {
        if (
          detailsModal &&
          !detailsModal.classList.contains(
            'member-hidden',
          )
        ) {
          closeDetailsModal();
          return;
        }

        if (
          modal &&
          !modal.classList.contains(
            'member-hidden',
          )
        ) {
          closeModal();
        }
      }
    },
  );

  if (session) {
    await loadRoadmap();

    loading?.classList.add(
      'member-hidden',
    );

    content?.classList.remove(
      'member-hidden',
    );
  }
</script>


