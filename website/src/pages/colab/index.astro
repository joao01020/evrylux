  [
    'pointerdown',
    'keydown',
    'touchstart',
  ].forEach(
    (
      eventName,
    ) => {
      window.addEventListener(
        eventName,
        unlockPresenceAudio,
        {
          once: true,
          passive: true,
        },
      );
    },
  );

  const session =
    await requireMemberSession();

  if (session) {
    const loading =
      document.querySelector<HTMLElement>(
        '#colab-loading',
      );

    const content =
      document.querySelector<HTMLElement>(
        '#colab-content',
      );

    const {
      data: profile,
      error,
    } =
      await supabase
        .from('member_profiles')
        .select(
          'display_name, github_login, bio, avatar_url, area, skills, availability',
        )
        .eq(
          'user_id',
          session.user.id,
        )
        .maybeSingle();

    if (error) {
      console.warn(
        '[EVRYLUX] Não foi possível carregar o perfil:',
        error.message,
      );
    }

    const welcome =
      document.querySelector<HTMLElement>(
        '#dashboard-welcome',
      );

    const name =
      document.querySelector<HTMLElement>(
        '#dashboard-name',
      );

    const area =
      document.querySelector<HTMLElement>(
        '#dashboard-area',
      );

    const github =
      document.querySelector<HTMLElement>(
        '#dashboard-github',
      );

    const availability =
      document.querySelector<HTMLElement>(
        '#dashboard-availability',
      );

    const skills =
      document.querySelector<HTMLElement>(
        '#dashboard-skills',
      );

    const avatar =
      document.querySelector<HTMLImageElement>(
        '#dashboard-avatar',
      );

    const placeholder =
      document.querySelector<HTMLElement>(
        '#dashboard-avatar-placeholder',
      );

    const adminDemoCard =
      document.querySelector<HTMLElement>(
        '#admin-demo-card',
      );

    const adminUsersCard =
      document.querySelector<HTMLElement>(
        '#admin-users-card',
      );

    const adminBadge =
      document.querySelector<HTMLElement>(
        '#dashboard-admin-badge',
      );

    const displayName =
      profile?.display_name?.trim() ||
      session.user.email ||
      'Colaborador EVRYLUX';

    if (welcome) {
      welcome.textContent =
        `Olá, ${displayName}`;
    }

    if (name) {
      name.textContent =
        displayName;
    }

    if (area) {
      area.textContent =
        profile?.area?.trim() ||
        'Configure sua área principal no perfil.';
    }

    if (github) {
      github.textContent =
        profile?.github_login
          ? `@${profile.github_login}`
          : 'Não informado';
    }

    if (availability) {
      availability.textContent =
        profile?.availability?.trim() ||
        'Não informada';
    }

    if (skills) {
      skills.textContent =
        profile?.skills?.trim() ||
        'Não informadas';
    }

    if (
      profile?.avatar_url?.trim() &&
      avatar
    ) {
      avatar.src =
        profile.avatar_url;

      avatar.alt =
        `Avatar de ${displayName}`;

      avatar.classList.remove(
        'member-hidden',
      );

      placeholder?.classList.add(
        'member-hidden',
      );

      avatar.addEventListener(
        'error',
        () => {
          avatar.classList.add(
            'member-hidden',
          );

          placeholder?.classList.remove(
            'member-hidden',
          );
        },
        {
          once: true,
        },
      );
    } else {
      avatar?.classList.add(
        'member-hidden',
      );

      placeholder?.classList.remove(
        'member-hidden',
      );
    }

    try {
      const admin =
        await isCurrentUserAdmin();

      if (admin) {
        adminBadge?.classList.remove(
          'member-hidden',
        );

        adminDemoCard?.classList.remove(
          'member-hidden',
        );

        adminUsersCard?.classList.remove(
          'member-hidden',
        );
      } else {
        adminBadge?.classList.add(
          'member-hidden',
        );

        adminDemoCard?.classList.add(
          'member-hidden',
        );

        adminUsersCard?.classList.add(
          'member-hidden',
        );
      }
    } catch (adminError) {
      adminBadge?.classList.add(
        'member-hidden',
      );

      adminDemoCard?.classList.add(
        'member-hidden',
      );

      adminUsersCard?.classList.add(
        'member-hidden',
      );

      console.warn(
        '[EVRYLUX] Não foi possível verificar permissões administrativas:',
        adminError,
      );
    }

    await refreshMyTasks();

    try {
      taskNotificationsDisconnect =
        await connectTaskAssignments(
          session.user.id,
          async (
            notificationId,
          ) => {
            const tasks =
              await refreshMyTasks();

            const task =
              tasks.find(
                (
                  item,
                ) =>
                  item.notification_id ===
                  notificationId,
              );

            if (
              task
            ) {
              showTaskAssignmentToast(
                task,
              );
            }
          },
        );
    } catch (
      taskNotificationError
    ) {
      console.warn(
        '[EVRYLUX] Não foi possível iniciar notificações de tarefas:',
        taskNotificationError,
      );
    }

    try {
      presenceDisconnect =
        await connectColabPresence(
          {
            user_id:
              session.user.id,

            display_name:
              displayName,

            avatar_url:
              profile?.avatar_url?.trim() ||
              null,

            area:
              profile?.area?.trim() ||
              null,

            github_login:
              profile?.github_login?.trim() ||
              null,
          },
          {
            onSync:
              (
                users,
              ) => {
                renderOnlineUsers(
                  users,
                  session.user.id,
                );
              },

            onJoin:
              (
                user,
              ) => {
                if (
                  user.user_id ===
                  session.user.id
                ) {
                  return;
                }

                showOnlineToast(
                  user,
                );
              },
          },
        );
    } catch (
      presenceError
    ) {
      console.warn(
        '[EVRYLUX] Não foi possível iniciar a presença online:',
        presenceError,
      );

      if (
        onlineList
      ) {
        onlineList.innerHTML = `
          <div class="dashboard-online-empty">
            <span class="dashboard-online-empty-dot"></span>

            <div>
              <strong>
                Presença indisponível
              </strong>

              <p>
                Não foi possível conectar ao status online neste momento.
              </p>
            </div>
          </div>
        `;
      }
    }

    const disconnectPresence =
      () => {
        if (
          presenceDisconnect
        ) {
          void presenceDisconnect();

          presenceDisconnect =
            null;
        }
      };


    const disconnectTaskNotifications =
      () => {
        if (
          taskNotificationsDisconnect
        ) {
          void taskNotificationsDisconnect();

          taskNotificationsDisconnect =
            null;
        }
      };

    window.addEventListener(
      'pagehide',
      disconnectPresence,
      {
        once: true,
      },
    );


    window.addEventListener(
      'pagehide',
      disconnectTaskNotifications,
      {
        once: true,
      },
    );

    loading?.classList.add(
      'member-hidden',
    );

    content?.classList.remove(
      'member-hidden',
    );
  }
</script>

