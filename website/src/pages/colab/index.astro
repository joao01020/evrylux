---
import Layout from '../../layouts/Layout.astro';
import ColabNav from '../../components/colab/ColabNav.astro';
import '../../styles/members.css';
---

<Layout
  title="EVRYLUX Colab — Dashboard"
  description="Dashboard interno dos colaboradores do EVRYLUX."
>
  <main class="member-shell">
    <div
      id="colab-loading"
      class="member-container member-loading"
    >
      Carregando sua área...
    </div>

    <div
      id="colab-content"
      class="member-container member-hidden"
    >
      <div class="member-topbar">
        <div class="member-title-block">
          <div class="eyebrow">
            EVRYLUX Colab
          </div>

          <h1>
            Dashboard
          </h1>

          <p id="dashboard-welcome">
            Sua área dentro do projeto.
          </p>
        </div>

        <ColabNav />
      </div>

      <div class="member-grid">
        <section class="member-card">
          <div class="member-card-inner">
            <div class="dashboard-profile">
              <div
                id="dashboard-avatar-placeholder"
                class="member-avatar-placeholder"
              >
                E
              </div>

              <img
                id="dashboard-avatar"
                class="member-avatar member-hidden"
                alt=""
              />

              <div>
                <span class="member-badge">
                  Colaborador
                </span>

                <h2 id="dashboard-name">
                  Perfil EVRYLUX
                </h2>

                <p
                  id="dashboard-area"
                  class="member-muted"
                >
                  Configure seu perfil para completar suas informações.
                </p>
              </div>
            </div>

            <div class="dashboard-summary">
              <div class="summary-box">
                <span>
                  GitHub
                </span>

                <strong id="dashboard-github">
                  —
                </strong>
              </div>

              <div class="summary-box">
                <span>
                  Disponibilidade
                </span>

                <strong id="dashboard-availability">
                  —
                </strong>
              </div>

              <div class="summary-box">
                <span>
                  Skills
                </span>

                <strong id="dashboard-skills">
                  —
                </strong>
              </div>
            </div>
          </div>
        </section>

        <aside class="member-card">
          <div class="member-card-inner">
            <h2>
              Acesso rápido
            </h2>

            <div class="member-links">
              <a
                class="member-link-card"
                href="/colab/profile"
              >
                <span>
                  Editar meu perfil
                </span>

                <span>
                  →
                </span>
              </a>

              <a
                class="member-link-card"
                href="/colab/security"
              >
                <span>
                  Segurança / 2FA
                </span>

                <span>
                  →
                </span>
              </a>

              <a
                class="member-link-card"
                href="/colab/studio"
              >
                <span>
                  Abrir Studio
                </span>

                <span>
                  →
                </span>
              </a>

              <a
                class="member-link-card"
                href="https://github.com/joao01020/ghost-core"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>
                  Repositório
                </span>

                <span>
                  ↗
                </span>
              </a>
            </div>
          </div>
        </aside>
      </div>

      <section class="tools-section">
        <div class="tools-heading">
          <div>
            <div class="eyebrow">
              Ferramentas do portal
            </div>

            <h2>
              O que já está disponível para a equipe.
            </h2>

            <p>
              Acesse os recursos internos usados para organizar,
              acompanhar e operar o projeto.
            </p>
          </div>
        </div>

        <div class="tools-grid">
          <a
            class="tool-card member-card"
            href="/colab/studio"
          >
            <div class="tool-card-top">
              <span class="tool-icon">
                S
              </span>

              <span class="tool-arrow">
                →
              </span>
            </div>

            <h3>
              Studio
            </h3>

            <p>
              Central de organização interna do projeto e acesso
              às ferramentas de trabalho da equipe.
            </p>
          </a>

          <a
            class="tool-card member-card"
            href="/colab/studio/roadmap"
          >
            <div class="tool-card-top">
              <span class="tool-icon">
                R
              </span>

              <span class="tool-arrow">
                →
              </span>
            </div>

            <h3>
              Roadmap interno
            </h3>

            <p>
              Organize etapas, responsáveis, prioridades,
              prazos e progresso do desenvolvimento.
            </p>
          </a>

          <a
            class="tool-card member-card"
            href="/colab/support"
          >
            <div class="tool-card-top">
              <span class="tool-icon">
                S
              </span>

              <span class="tool-arrow">
                →
              </span>
            </div>

            <h3>
              Suporte
            </h3>

            <p>
              Acompanhe conversas de suporte e responda usuários
              diretamente pelo portal.
            </p>
          </a>

          <a
            id="admin-demo-card"
            class="tool-card member-card admin-tool member-hidden"
            href="/colab/demo"
          >
            <div class="tool-card-top">
              <span class="tool-icon">
                D
              </span>

              <span class="tool-arrow">
                →
              </span>
            </div>

            <h3>
              Fila do Demo
            </h3>

            <p>
              Veja os primeiros usuários interessados no demo,
              seus sistemas e disponibilidade para feedback.
            </p>
          </a>

          <a
            id="admin-users-card"
            class="tool-card member-card admin-tool member-hidden"
            href="/colab/admins"
          >
            <div class="tool-card-top">
              <span class="tool-icon">
                A
              </span>

              <span class="tool-arrow">
                →
              </span>
            </div>

            <h3>
              Administradores
            </h3>

            <p>
              Gerencie quem pode acessar funções administrativas
              do portal EVRYLUX Colab.
            </p>
          </a>

          <a
            class="tool-card member-card"
            href="/colab/security"
          >
            <div class="tool-card-top">
              <span class="tool-icon">
                2
              </span>

              <span class="tool-arrow">
                →
              </span>
            </div>

            <h3>
              Segurança / 2FA
            </h3>

            <p>
              Configure seu aplicativo autenticador e proteja
              sessões administrativas com AAL2.
            </p>
          </a>

          <a
            class="tool-card member-card"
            href="/contributors"
          >
            <div class="tool-card-top">
              <span class="tool-icon">
                C
              </span>

              <span class="tool-arrow">
                ↗
              </span>
            </div>

            <h3>
              Colaboradores
            </h3>

            <p>
              Consulte a participação pública e as contribuições
              registradas no projeto.
            </p>
          </a>
        </div>
      </section>
    </div>
  </main>
</Layout>

<script>
  import {
    supabase,
  } from '../../lib/supabase';

  import {
    requireMemberSession,
  } from '../../lib/member-auth';

  import {
    isCurrentUserAdmin,
  } from '../../lib/colab-admin';

  const session =
    await requireMemberSession();

  if (session) {
    const loading =
      document.querySelector<HTMLElement>(
        '#colab-loading',
      );

    const content =
      document.querySelector<HTMLElement>(
        '#colab-content',
      );

    const {
      data: profile,
      error,
    } =
      await supabase
        .from('member_profiles')
        .select(
          'display_name, github_login, bio, avatar_url, area, skills, availability',
        )
        .eq(
          'user_id',
          session.user.id,
        )
        .maybeSingle();

    if (error) {
      console.warn(
        '[EVRYLUX] Não foi possível carregar o perfil:',
        error.message,
      );
    }

    const welcome =
      document.querySelector<HTMLElement>(
        '#dashboard-welcome',
      );

    const name =
      document.querySelector<HTMLElement>(
        '#dashboard-name',
      );

    const area =
      document.querySelector<HTMLElement>(
        '#dashboard-area',
      );

    const github =
      document.querySelector<HTMLElement>(
        '#dashboard-github',
      );

    const availability =
      document.querySelector<HTMLElement>(
        '#dashboard-availability',
      );

    const skills =
      document.querySelector<HTMLElement>(
        '#dashboard-skills',
      );

    const avatar =
      document.querySelector<HTMLImageElement>(
        '#dashboard-avatar',
      );

    const placeholder =
      document.querySelector<HTMLElement>(
        '#dashboard-avatar-placeholder',
      );

    const adminDemoCard =
      document.querySelector<HTMLElement>(
        '#admin-demo-card',
      );

    const adminUsersCard =
      document.querySelector<HTMLElement>(
        '#admin-users-card',
      );

    const displayName =
      profile?.display_name?.trim() ||
      session.user.email ||
      'Colaborador EVRYLUX';

    if (welcome) {
      welcome.textContent =
        `Olá, ${displayName}. Esta é sua área dentro do projeto.`;
    }

    if (name) {
      name.textContent =
        displayName;
    }

    if (area) {
      area.textContent =
        profile?.area?.trim() ||
        'Configure sua área principal no perfil.';
    }

    if (github) {
      github.textContent =
        profile?.github_login
          ? `@${profile.github_login}`
          : 'Não informado';
    }

    if (availability) {
      availability.textContent =
        profile?.availability?.trim() ||
        'Não informada';
    }

    if (skills) {
      skills.textContent =
        profile?.skills?.trim() ||
        'Não informadas';
    }

    if (
      profile?.avatar_url?.trim() &&
      avatar
    ) {
      avatar.src =
        profile.avatar_url;

      avatar.alt =
        `Avatar de ${displayName}`;

      avatar.classList.remove(
        'member-hidden',
      );

      placeholder?.classList.add(
        'member-hidden',
      );
    }

    try {
      const admin =
        await isCurrentUserAdmin();

      if (admin) {
        adminDemoCard?.classList.remove(
          'member-hidden',
        );

        adminUsersCard?.classList.remove(
          'member-hidden',
        );
      }
    } catch (adminError) {
      console.warn(
        '[EVRYLUX] Não foi possível verificar permissões administrativas:',
        adminError,
      );
    }

    loading?.classList.add(
      'member-hidden',
    );

    content?.classList.remove(
      'member-hidden',
    );
  }
</script>

<style>
  .dashboard-profile {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .dashboard-profile h2 {
    margin: 10px 0 0;
  }

  .dashboard-profile p {
    margin: 7px 0 0;
  }

  .dashboard-summary {
    margin-top: 28px;

    display: grid;

    grid-template-columns:
      repeat(
        3,
        minmax(0, 1fr)
      );

    gap: 10px;
  }

  .summary-box {
    padding: 17px;

    border-radius: 16px;

    background:
      var(--surface-muted);

    border:
      1px solid
      rgba(
        65,
        104,
        62,
        0.08
      );
  }

  .summary-box span,
  .summary-box strong {
    display: block;
  }

  .summary-box span {
    color:
      var(--text-soft);

    font-size:
      11px;
  }

  .summary-box strong {
    margin-top: 7px;

    font-size:
      14px;
  }

  .tools-section {
    margin-top: 54px;
  }

  .tools-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
  }

  .tools-heading h2 {
    margin: 10px 0 0;

    max-width: 760px;

    font-size:
      clamp(
        28px,
        4vw,
        42px
      );

    letter-spacing:
      -0.04em;
  }

  .tools-heading p {
    max-width: 700px;

    margin:
      12px
      0
      0;

    color:
      var(--text-soft);

    line-height:
      1.7;
  }

  .tools-grid {
    margin-top: 24px;

    display: grid;

    grid-template-columns:
      repeat(
        3,
        minmax(
          0,
          1fr
        )
      );

    gap: 16px;
  }

  .tool-card {
    min-height: 220px;

    padding: 22px;

    display: flex;

    flex-direction: column;

    color:
      inherit;

    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .tool-card:hover {
    transform:
      translateY(-4px);

    border-color:
      var(--border-strong);

    box-shadow:
      0 16px 42px
      rgba(
        54,
        92,
        51,
        0.07
      );
  }

  .tool-card-top {
    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 12px;
  }

  .tool-icon {
    width: 38px;
    height: 38px;

    display: grid;

    place-items: center;

    border-radius: 11px;

    background:
      var(--primary-soft);

    color:
      var(--primary-deep);

    font-size:
      12px;

    font-weight:
      850;
  }

  .tool-arrow {
    color:
      var(--text-soft);

    font-size:
      15px;

    transition:
      transform 0.2s ease;
  }

  .tool-card:hover
  .tool-arrow {
    transform:
      translateX(3px);
  }

  .tool-card h3 {
    margin:
      24px
      0
      8px;

    font-size:
      18px;

    letter-spacing:
      -0.025em;
  }

  .tool-card p {
    margin: 0;

    color:
      var(--text-soft);

    line-height:
      1.68;

    font-size:
      13px;
  }

  .admin-tool {
    background:
      linear-gradient(
        145deg,
        rgba(
          255,
          255,
          255,
          0.9
        ),
        rgba(
          239,
          248,
          235,
          0.78
        )
      );
  }

  @media (
    max-width: 980px
  ) {
    .tools-grid {
      grid-template-columns:
        repeat(
          2,
          minmax(
            0,
            1fr
          )
        );
    }
  }

  @media (
    max-width: 860px
  ) {
    .dashboard-summary {
      grid-template-columns:
        1fr;
    }
  }

  @media (
    max-width: 620px
  ) {
    .tools-grid {
      grid-template-columns:
        1fr;
    }
  }
</style>
