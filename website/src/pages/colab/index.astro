  function taskStageLabel(
    stage: string,
  ) {
    const labels:
      Record<string,string> = {
        now:
          'Agora',
        next:
          'Próximo',
        later:
          'Depois',
        done:
          'Concluído',
      };

    return labels[stage] ??
      stage;
  }

  function taskStatusLabel(
    status: string,
  ) {
    const labels:
      Record<string,string> = {
        todo:
          'A fazer',
        doing:
          'Em andamento',
        blocked:
          'Bloqueado',
        done:
          'Concluído',
      };

    return labels[status] ??
      status;
  }

  const DASHBOARD_TASK_LIMIT =
    4;

  function taskDueTimestamp(
    task: MyRoadmapTask,
  ) {
    if (!task.due_date) {
      return Number.POSITIVE_INFINITY;
    }

    const timestamp =
      new Date(
        `${task.due_date}T23:59:59`,
      ).getTime();

    return Number.isFinite(timestamp)
      ? timestamp
      : Number.POSITIVE_INFINITY;
  }

  function dashboardTasks(
    tasks: MyRoadmapTask[],
  ) {
    return [...tasks]
      .sort(
        (
          a,
          b,
        ) => {
          const aUnread =
            Boolean(a.notification_id) &&
            !a.notification_is_read;

          const bUnread =
            Boolean(b.notification_id) &&
            !b.notification_is_read;

          if (aUnread !== bUnread) {
            return aUnread ? -1 : 1;
          }

          return (
            taskDueTimestamp(a) -
            taskDueTimestamp(b)
          );
        },
      )
      .slice(
        0,
        DASHBOARD_TASK_LIMIT,
      );
  }

  function renderMyTasks(
    tasks: MyRoadmapTask[],
  ) {
    currentTasks =
      tasks;

    const unreadCount =
      tasks.filter(
        (
          task,
        ) =>
          Boolean(
            task.notification_id,
          ) &&
          !task.notification_is_read,
      ).length;

    if (
      taskUnread
    ) {
      taskUnread.textContent =
        `${unreadCount} ${unreadCount === 1 ? 'nova' : 'novas'}`;

      taskUnread.classList.toggle(
        'member-hidden',
        unreadCount ===
          0,
      );
    }

    if (
      taskTotal
    ) {
      taskTotal.textContent =
        `${tasks.length} ${tasks.length === 1 ? 'tarefa' : 'tarefas'}`;
    }

    if (
      !taskList
    ) {
      return;
    }

    if (
      tasks.length ===
      0
    ) {
      taskList.innerHTML = `
        <div class="dashboard-task-empty">
          <span class="dashboard-task-empty-icon" aria-hidden="true">
            ✓
          </span>

          <div>
            <strong>
              Nenhuma tarefa atribuída
            </strong>

            <p>
              Quando alguém marcar você como responsável no Roadmap, a tarefa aparecerá aqui.
            </p>
          </div>
        </div>
      `;

      return;
    }

    const visibleTasks =
      dashboardTasks(
        tasks,
      );

    taskList.innerHTML =
      visibleTasks
        .map(
          (
            task,
          ) => {
            const isNew =
              Boolean(
                task.notification_id,
              ) &&
              !task.notification_is_read;

            const area =
              task.area?.trim()
                ? escapeHtml(
                    task.area,
                  )
                : 'Roadmap';

            const actor =
              task.assigned_by_name?.trim()
                ? escapeHtml(
                    task.assigned_by_name,
                  )
                : 'Equipe EVRYLUX';

            return `
              <article
                class="dashboard-task-card${isNew ? ' is-new' : ''}"
                data-task-card="${escapeHtml(task.id)}"
              >
                <div class="dashboard-task-card-top">
                  <div class="dashboard-task-labels">
                    ${
                      isNew
                        ? '<span class="dashboard-task-new-badge">Nova tarefa</span>'
                        : ''
                    }

                    <span class="dashboard-task-area">
                      ${area}
                    </span>
                  </div>

                  <span class="dashboard-task-stage">
                    ${escapeHtml(taskStageLabel(task.stage))}
                  </span>
                </div>

                <h3>
                  ${escapeHtml(task.title)}
                </h3>

                <p>
                  ${
                    task.description?.trim()
                      ? escapeHtml(task.description)
                      : 'Você foi marcado como responsável por esta tarefa.'
                  }
                </p>

                <div class="dashboard-task-meta">
                  <span>
                    ${escapeHtml(taskStatusLabel(task.status))}
                  </span>

                  <span>
                    ${Math.max(0, Math.min(100, Number(task.progress) || 0))}% concluído
                  </span>

                  ${
                    isNew
                      ? `<span>Atribuída por ${actor}</span>`
                      : ''
                  }
                </div>

                <div class="dashboard-task-progress">
                  <span
                    style="width:${Math.max(0, Math.min(100, Number(task.progress) || 0))}%"
                  ></span>
                </div>

                <a
                  class="dashboard-task-open"
                  href="/colab/studio?task=${encodeURIComponent(task.id)}"
                  data-task-open="${escapeHtml(task.id)}"
                  data-notification-id="${escapeHtml(task.notification_id ?? '')}"
                >
                  <span>
                    Abrir tarefa
                  </span>

                  <span aria-hidden="true">
                    →
                  </span>
                </a>
              </article>
            `;
          },
        )
        .join('');

    if (
      tasks.length >
      DASHBOARD_TASK_LIMIT
    ) {
      const more =
        document.createElement(
          'a',
        );

      const hiddenCount =
        tasks.length -
        DASHBOARD_TASK_LIMIT;

      more.className =
        'dashboard-task-more';

      more.href =
        '/colab/tasks';

      more.innerHTML =
        `<span>+${hiddenCount} ${hiddenCount === 1 ? 'tarefa' : 'tarefas'} para ver</span><span aria-hidden="true">→</span>`;

      taskList.appendChild(
        more,
      );
    }

    taskList
      .querySelectorAll<HTMLAnchorElement>(
        '[data-task-open]',
      )
      .forEach(
        (
          link,
        ) => {
          link.addEventListener(
            'click',
            () => {
              const notificationId =
                link.dataset.notificationId?.trim();

              if (
                notificationId
              ) {
                void markTaskNotificationRead(
                  notificationId,
                );
              }
            },
          );
        },
      );
  }

  async function refreshMyTasks() {
    try {
      const tasks =
        await getMyRoadmapTasks();

      renderMyTasks(
        tasks,
      );

      return tasks;
    } catch (
      error
    ) {
      console.warn(
        '[EVRYLUX] Não foi possível carregar as tarefas:',
        error,
      );

      if (
        taskList
      ) {
        taskList.innerHTML = `
          <div class="dashboard-task-empty">
            <span class="dashboard-task-empty-icon" aria-hidden="true">
              !
            </span>

            <div>
              <strong>
                Tarefas indisponíveis
              </strong>

              <p>
                Não foi possível carregar suas tarefas neste momento.
              </p>
            </div>
          </div>
        `;
      }

      return [];
    }
  }

  function playTaskAssignmentSound() {
    if (
      !audioUnlocked ||
      !audioContext
    ) {
      return;
    }

    try {
      const now =
        audioContext.currentTime;

      const gain =
        audioContext.createGain();

      const first =
        audioContext.createOscillator();

      const second =
        audioContext.createOscillator();

      first.type =
        'sine';

      second.type =
        'sine';

      first.frequency.setValueAtTime(
        740,
        now,
      );

      second.frequency.setValueAtTime(
        980,
        now + 0.105,
      );

      gain.gain.setValueAtTime(
        0.0001,
        now,
      );

      gain.gain.exponentialRampToValueAtTime(
        0.07,
        now + 0.015,
      );

      gain.gain.exponentialRampToValueAtTime(
        0.0001,
        now + 0.34,
      );

      first.connect(
        gain,
      );

      second.connect(
        gain,
      );

      gain.connect(
        audioContext.destination,
      );

      first.start(
        now,
      );

      first.stop(
        now + 0.18,
      );

      second.start(
        now + 0.105,
      );

      second.stop(
        now + 0.34,
      );
    } catch (
      error
    ) {
      console.warn(
        '[EVRYLUX] Som de nova tarefa indisponível:',
        error,
      );
    }
  }

