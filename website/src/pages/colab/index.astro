        );
      },
    );

    toast
      .querySelector<HTMLAnchorElement>(
        '[data-toast-notification]',
      )
      ?.addEventListener(
        'click',
        (
          event,
        ) => {
          const link =
            event.currentTarget as HTMLAnchorElement;

          const notificationId =
            link.dataset.toastNotification?.trim();

          if (
            notificationId
          ) {
            void markTaskNotificationRead(
              notificationId,
            );
          }
        },
      );

    const remove =
      () => {
        toast.classList.remove(
          'show',
        );

        window.setTimeout(
          () => toast.remove(),
          220,
        );
      };

    toast
      .querySelector<HTMLButtonElement>(
        '.task-assignment-toast-close',
      )
      ?.addEventListener(
        'click',
        remove,
      );

    playTaskAssignmentSound();

    window.setTimeout(
