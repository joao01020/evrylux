---
import Layout from '../../layouts/Layout.astro';
import ColabNav from '../../components/colab/ColabNav.astro';
import '../../styles/members.css';
import EvryluxLogoLoader from '../../components/ui/EvryluxLogoLoader.astro';
---

<Layout
  title="EVRYLUX Colab — Dashboard"
  description="Dashboard interno dos colaboradores do EVRYLUX."
>
  <main class="member-shell dashboard-page">
    <EvryluxLogoLoader
      id="colab-loading"
      size="md"
    />

    <div
      id="colab-content"
      class="member-container member-hidden dashboard-container"
    >
      <section class="dashboard-hero">
        <div class="dashboard-hero-copy">
          <div class="eyebrow">
            EVRYLUX Colab
          </div>

          <h1>
            Minha área
          </h1>

          <p id="dashboard-welcome">
            Sua área dentro do projeto.
          </p>
        </div>

        <div class="dashboard-hero-actions">
          <ColabNav />
        </div>
      </section>

      <section class="dashboard-overview">
        <article class="dashboard-profile-card">
          <div class="dashboard-profile-main">
            <div class="dashboard-avatar-wrap">
              <div
                id="dashboard-avatar-placeholder"
                class="member-avatar-placeholder default-profile-avatar"
                aria-label="Sem foto de perfil"
              >
                <img
                  class="default-profile-avatar-image"
                  src="/branding/default-profile-avatar.png"
                  alt=""
                  aria-hidden="true"
                  draggable="false"
                />
              </div>

              <img
                id="dashboard-avatar"
                class="member-avatar member-hidden"
                alt=""
              />
            </div>

            <div class="dashboard-profile-copy">
              <div class="dashboard-role-badges">
                <span class="member-badge">
                  Colaborador
                </span>

                <span
                  id="dashboard-admin-badge"
                  class="member-badge dashboard-admin-badge member-hidden"
                  title="Este colaborador possui acesso administrativo"
                >
                  <svg
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      d="M12 3 5.5 6v5.2c0 4.1 2.7 7.7 6.5 9.8 3.8-2.1 6.5-5.7 6.5-9.8V6L12 3Z"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linejoin="round"
                    />
                    <path
                      d="m9.4 12.1 1.7 1.8 3.6-4"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>

                  Administrador
                </span>
              </div>

              <h2 id="dashboard-name">
                Perfil EVRYLUX
              </h2>

              <p
                id="dashboard-area"
                class="member-muted"
              >
                Configure seu perfil para completar suas informações.
              </p>
            </div>
          </div>

          <section
                id="dashboard-tasks-section"
                class="dashboard-tasks-section dashboard-tasks-embedded"
                aria-labelledby="dashboard-tasks-title"
              >
            <div class="dashboard-tasks-head">
              <div>
                <div class="dashboard-tasks-kicker">
                  <span class="dashboard-tasks-kicker-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      <path
                        d="M7 4.8h10a2 2 0 0 1 2 2V18a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6.8a2 2 0 0 1 2-2Z"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.7"
                      />
                      <path
                        d="m8.5 12 2.1 2.1 4.9-5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
          
                  Trabalho atribuído
                </div>
          
                <h2 id="dashboard-tasks-title">
                  Minhas tarefas
                </h2>
          
                <p>
                  Itens do Roadmap em que você foi marcado como responsável.
                </p>
              </div>
          
              <div class="dashboard-tasks-head-actions">
                <span
                  id="dashboard-task-total"
                  class="dashboard-task-total"
                >
                  0 tarefas
                </span>

                <span
                  id="dashboard-task-unread"
                  class="dashboard-task-unread member-hidden"
                >
                  0 novas
                </span>

                <a
                  class="dashboard-task-roadmap-link"
                  href="/colab/tasks"
                >
                  Ver todas
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          
            <div
              id="dashboard-task-list"
              class="dashboard-task-list"
              aria-live="polite"
            >
              <div class="dashboard-task-empty">
                <span class="dashboard-task-empty-icon" aria-hidden="true">
                  ✓
                </span>
          
                <div>
                  <strong>
                    Verificando suas tarefas...
                  </strong>
          
                  <p>
                    As tarefas atribuídas a você aparecerão aqui.
                  </p>
                </div>
              </div>
            </div>
          </section>
          
        </article>

        <aside class="quick-access-card">
          <div class="quick-access-head">
            <div>
              <span class="quick-access-kicker">
                Atalhos
              </span>

              <h2>
                Acesso rápido
              </h2>
            </div>

            <span class="quick-access-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path
                  d="M7 12h10M13 8l4 4-4 4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
          </div>

          <div class="quick-access-list">
            <a
              class="quick-access-item"
              href="/colab/profile"
            >
              <span class="quick-access-item-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <circle cx="12" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.8"/>
                  <path d="M6 19a6 6 0 0 1 12 0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
              </span>

              <span>
                <strong>Meu perfil</strong>
                <small>Atualize sua identidade e foto</small>
              </span>

              <span class="quick-access-arrow">→</span>
            </a>

            <a
              class="quick-access-item"
              href="/colab/security"
            >
              <span class="quick-access-item-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="M12 3 5.5 6v5.2c0 4.1 2.7 7.7 6.5 9.8 3.8-2.1 6.5-5.7 6.5-9.8V6L12 3Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                  <path d="M9.5 12.2 11.2 14l3.5-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>

              <span>
                <strong>Segurança</strong>
                <small>2FA e proteção da conta</small>
              </span>

              <span class="quick-access-arrow">→</span>
            </a>

            <a
              class="quick-access-item"
              href="/colab/studio"
            >
              <span class="quick-access-item-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <rect x="4" y="5" width="16" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/>
                  <path d="M8 9h8M8 12h5M8 15h7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
              </span>

              <span>
                <strong>Studio</strong>
                <small>Organização interna do projeto</small>
              </span>

              <span class="quick-access-arrow">→</span>
            </a>

            <a
              class="quick-access-item"
              href="/colab/core"
            >
              <span class="quick-access-item-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="3.2" fill="none" stroke="currentColor" stroke-width="1.8"/>
                  <path d="M12 3.8v3M12 17.2v3M3.8 12h3M17.2 12h3M6.2 6.2l2.1 2.1M15.7 15.7l2.1 2.1M17.8 6.2l-2.1 2.1M8.3 15.7l-2.1 2.1" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                </svg>
              </span>

              <span>
                <strong>Núcleo</strong>
                <small>Direção central e decisões do projeto</small>
              </span>

              <span class="quick-access-arrow">→</span>
            </a>

            <a
              class="quick-access-item"
              href="https://github.com/joao01020/ghost-core"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="quick-access-item-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="M7 17 17 7M10 7h7v7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>

              <span>
                <strong>Repositório</strong>
                <small>Abrir código no GitHub</small>
              </span>

              <span class="quick-access-arrow">↗</span>
            </a>
          </div>
        </aside>
      </section>


      <div
        id="task-assignment-toast-region"
        class="task-assignment-toast-region"
        aria-live="assertive"
        aria-atomic="false"
      ></div>

      <section class="dashboard-online-section" aria-labelledby="online-section-title">
        <div class="dashboard-online-head">
          <div>
            <div class="dashboard-online-kicker">
              <span class="dashboard-online-live-dot" aria-hidden="true"></span>
              Presença ao vivo
            </div>

            <h2 id="online-section-title">
              Colaboradores online
            </h2>

            <p>
              Veja quem está no EVRYLUX Colab neste momento.
            </p>
          </div>

          <div class="dashboard-online-count-wrap">
            <strong id="dashboard-online-count">0</strong>
            <span>online</span>
          </div>
        </div>

        <div
          id="dashboard-online-list"
          class="dashboard-online-list"
          aria-live="polite"
        >
          <div class="dashboard-online-empty">
            <span class="dashboard-online-empty-dot"></span>

            <div>
              <strong>
                Verificando presença...
              </strong>

              <p>
                Os colaboradores ativos aparecerão aqui automaticamente.
              </p>
            </div>
          </div>
        </div>
      </section>

      <div
        id="online-join-toast-region"
        class="online-join-toast-region"
        aria-live="polite"
        aria-atomic="false"
      ></div>

      <section class="tools-section">
        <div class="tools-heading">
          <div>
            <div class="eyebrow">
              Ferramentas do portal
            </div>

            <h2>
              Tudo que você precisa, organizado por função.
            </h2>

            <p>
              Acesse os recursos internos do EVRYLUX sem misturar tarefas,
              administração e operação do projeto.
            </p>
          </div>
        </div>

        <div class="tools-grid">
          <a
            class="tool-card tool-card-featured"
            href="/colab/studio"
          >
            <div class="tool-card-top">
              <span class="tool-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4 5.5h16v13H4z" fill="none" stroke="currentColor" stroke-width="1.8"/>
                  <path d="M8 9h8M8 12h5M8 15h7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
              </span>

              <span class="tool-arrow">
                →
              </span>
            </div>

            <div class="tool-card-copy">
              <span class="tool-card-kicker">
                Trabalho
              </span>

              <h3>
                Studio
              </h3>

              <p>
                Central de organização interna e acesso às ferramentas de trabalho da equipe.
              </p>
            </div>
          </a>

          <a
            class="tool-card"
            href="/colab/studio"
          >
            <div class="tool-card-top">
              <span class="tool-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M5 19V8m7 11V5m7 14v-7" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>
                  <circle cx="5" cy="6" r="2" fill="none" stroke="currentColor" stroke-width="1.8"/>
                  <circle cx="12" cy="3" r="2" fill="none" stroke="currentColor" stroke-width="1.8"/>
                  <circle cx="19" cy="10" r="2" fill="none" stroke="currentColor" stroke-width="1.8"/>
                </svg>
              </span>

              <span class="tool-arrow">
                →
              </span>
            </div>

            <div class="tool-card-copy">
              <span class="tool-card-kicker">
                Planejamento
              </span>

              <h3>
                Roadmap interno
              </h3>

              <p>
                Organize etapas, responsáveis, prioridades e progresso do desenvolvimento.
              </p>
            </div>
          </a>

          <a
            class="tool-card"
            href="/colab/core"
          >
            <div class="tool-card-top">
              <span class="tool-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="12" cy="12" r="3.2" fill="none" stroke="currentColor" stroke-width="1.8"/>
                  <path d="M12 3.5v3.2M12 17.3v3.2M3.5 12h3.2M17.3 12h3.2M6 6l2.3 2.3M15.7 15.7 18 18M18 6l-2.3 2.3M8.3 15.7 6 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                </svg>
              </span>

              <span class="tool-arrow">
                →
              </span>
            </div>

            <div class="tool-card-copy">
              <span class="tool-card-kicker">
                Direção do produto
              </span>

              <h3>
                Núcleo
              </h3>

              <p>
                Registre princípios, decisões e partes essenciais que não podem se perder durante a evolução do EVRYLUX.
              </p>
            </div>
          </a>

          <a
            class="tool-card"
            href="/colab/support"
          >
            <div class="tool-card-top">
              <span class="tool-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M6.5 17.5h-1A2.5 2.5 0 0 1 3 15V9a9 9 0 0 1 18 0v6a2.5 2.5 0 0 1-2.5 2.5h-1" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  <path d="M7 16v-4a2 2 0 0 1 2-2h1v8H9a2 2 0 0 1-2-2Zm10 0v-4a2 2 0 0 0-2-2h-1v8h1a2 2 0 0 0 2-2Z" fill="none" stroke="currentColor" stroke-width="1.8"/>
                </svg>
              </span>

              <span class="tool-arrow">
                →
              </span>
            </div>

            <div class="tool-card-copy">
              <span class="tool-card-kicker">
                Atendimento
              </span>

              <h3>
                Suporte
              </h3>

              <p>
                Acompanhe conversas e responda usuários diretamente pelo portal.
              </p>
            </div>
          </a>

          <a
            id="admin-demo-card"
            class="tool-card admin-tool member-hidden"
            href="/colab/demo"
          >
            <div class="tool-card-top">
              <span class="tool-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M5 4.5h14v15H5z" fill="none" stroke="currentColor" stroke-width="1.8"/>
                  <path d="M8 8h8M8 12h8M8 16h5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  <circle cx="17" cy="16" r="2.2" fill="none" stroke="currentColor" stroke-width="1.6"/>
                </svg>
              </span>

              <span class="tool-arrow">
                →
              </span>
            </div>

            <div class="tool-card-copy">
              <span class="tool-card-kicker">
                Administração
              </span>

              <h3>
                Fila do Demo
              </h3>

              <p>
                Veja os usuários interessados no demo, seus sistemas e disponibilidade para feedback.
              </p>
            </div>
          </a>

          <a
            id="admin-users-card"
            class="tool-card admin-tool"
            href="/colab/admins"
          >
            <div class="tool-card-top">
              <span class="tool-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="9" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.8"/>
                  <path d="M4 18a5 5 0 0 1 10 0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  <path d="M16 8h4M18 6v4M16 14h4M18 12v4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
              </span>

              <span class="tool-arrow">
                →
              </span>
            </div>

            <div class="tool-card-copy">
              <span class="tool-card-kicker">
                Administração
              </span>

              <h3>
                Administradores
              </h3>

              <p>
                Gerencie quem pode acessar funções administrativas e permissões do portal.
              </p>
            </div>
          </a>

          <a
            class="tool-card"
            href="/colab/security"
          >
            <div class="tool-card-top">
              <span class="tool-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 3 5.5 6v5.2c0 4.1 2.7 7.7 6.5 9.8 3.8-2.1 6.5-5.7 6.5-9.8V6L12 3Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                  <path d="M9.5 12.2 11.2 14l3.5-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>

              <span class="tool-arrow">
                →
              </span>
            </div>

            <div class="tool-card-copy">
              <span class="tool-card-kicker">
                Proteção
              </span>

              <h3>
                Segurança / 2FA
              </h3>

              <p>
                Configure seu autenticador e proteja sessões administrativas com AAL2.
              </p>
            </div>
          </a>

          <a
            class="tool-card"
            href="/contributors"
          >
            <div class="tool-card-top">
              <span class="tool-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="8" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.8"/>
                  <circle cx="17" cy="9" r="2.4" fill="none" stroke="currentColor" stroke-width="1.7"/>
                  <path d="M3.5 19a4.5 4.5 0 0 1 9 0M13.5 18.5a3.5 3.5 0 0 1 7 0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
              </span>

              <span class="tool-arrow">
                ↗
              </span>
            </div>

            <div class="tool-card-copy">
              <span class="tool-card-kicker">
                Comunidade
              </span>

              <h3>
                Colaboradores
              </h3>

              <p>
                Consulte a participação pública e as contribuições registradas no projeto.
              </p>
            </div>
          </a>
        </div>
      </section>
    </div>
  </main>
</Layout>

<script>
  import {
    supabase,
  } from '../../lib/supabase';

  import {
    requireMemberSession,
  } from '../../lib/member-auth';

  import {
    isCurrentUserAdmin,
  } from '../../lib/colab-admin';


  import {
    connectColabPresence,
    type ColabPresenceUser,
  } from '../../lib/colab-presence';


  import {
    connectTaskAssignments,
    getMyRoadmapTasks,
    markTaskNotificationRead,
    type MyRoadmapTask,
  } from '../../lib/colab-task-inbox';


  const onlineCount =
    document.querySelector<HTMLElement>(
      '#dashboard-online-count',
    );

  const onlineList =
    document.querySelector<HTMLElement>(
      '#dashboard-online-list',
    );

  const toastRegion =
    document.querySelector<HTMLElement>(
      '#online-join-toast-region',
    );


  const taskList =
    document.querySelector<HTMLElement>(
      '#dashboard-task-list',
    );

  const taskUnread =
    document.querySelector<HTMLElement>(
      '#dashboard-task-unread',
    );


  const taskTotal =
    document.querySelector<HTMLElement>(
      '#dashboard-task-total',
    );

  const taskToastRegion =
    document.querySelector<HTMLElement>(
      '#task-assignment-toast-region',
    );

  let taskNotificationsDisconnect:
    (() => Promise<void>) | null =
      null;

  let currentTasks:
    MyRoadmapTask[] =
      [];

  let presenceDisconnect:
    (() => Promise<void>) | null =
      null;

  let audioContext:
    AudioContext | null =
      null;

  let audioUnlocked =
    false;

  function escapeHtml(
    value: string,
  ) {
    return value
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');
  }

  function defaultAvatarMarkup(
    name: string,
  ) {
    return `
      <img
        src="/branding/default-profile-avatar.png"
        alt=""
        class="dashboard-online-avatar-image"
        draggable="false"
      />
    `;
  }

  function avatarMarkup(
    user: ColabPresenceUser,
  ) {
    const name =
      escapeHtml(
        user.display_name ||
        'Colaborador EVRYLUX',
      );

    if (
      user.avatar_url?.trim()
    ) {
      const avatar =
        escapeHtml(
          user.avatar_url,
        );

      return `
        <img
          src="${avatar}"
          alt="Avatar de ${name}"
          class="dashboard-online-avatar-image"
          draggable="false"
          onerror="this.src='/branding/default-profile-avatar.png'"
        />
      `;
    }

    return defaultAvatarMarkup(
      name,
    );
  }

  function renderOnlineUsers(
    users: ColabPresenceUser[],
    currentUserId: string,
  ) {
    if (
      onlineCount
    ) {
      onlineCount.textContent =
        String(
          users.length,
        );
    }

    if (
      !onlineList
    ) {
      return;
    }

    if (
      users.length ===
      0
    ) {
      onlineList.innerHTML = `
        <div class="dashboard-online-empty">
          <span class="dashboard-online-empty-dot"></span>

          <div>
            <strong>
              Ninguém online no momento
            </strong>

            <p>
              Quando alguém entrar no Colab, aparecerá aqui automaticamente.
            </p>
          </div>
        </div>
      `;

      return;
    }

    onlineList.innerHTML =
      users
        .map(
          (
            user,
          ) => {
            const name =
              escapeHtml(
                user.display_name ||
                'Colaborador EVRYLUX',
              );

            const area =
              user.area?.trim()
                ? escapeHtml(
                    user.area,
                  )
                : 'Colaborador';

            const isMe =
              user.user_id ===
              currentUserId;

            return `
