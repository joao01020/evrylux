---
import Layout from '../../layouts/Layout.astro';
import ColabNav from '../../components/colab/ColabNav.astro';
import '../../styles/members.css';
import EvryluxLogoLoader from '../../components/ui/EvryluxLogoLoader.astro';
---

<Layout
  title="EVRYLUX Colab — Dashboard"
  description="Dashboard interno dos colaboradores do EVRYLUX."
>
  <main class="member-shell dashboard-page">
    <EvryluxLogoLoader
      id="colab-loading"
      size="md"
    />

    <div
      id="colab-content"
      class="member-container member-hidden dashboard-container"
    >
      <section class="dashboard-hero">
        <div class="dashboard-hero-copy">
          <div class="eyebrow">
            EVRYLUX Colab
          </div>

          <h1>
            Minha área
          </h1>

          <p id="dashboard-welcome">
            Sua área dentro do projeto.
          </p>
        </div>

        <div class="dashboard-hero-actions">
          <ColabNav />
        </div>
      </section>

      <section class="dashboard-overview">
        <article class="dashboard-profile-card">
          <div class="dashboard-profile-main">
            <div class="dashboard-avatar-wrap">
              <div
                id="dashboard-avatar-placeholder"
                class="member-avatar-placeholder default-profile-avatar"
                aria-label="Sem foto de perfil"
              >
                <img
                  class="default-profile-avatar-image"
                  src="/branding/default-profile-avatar.png"
                  alt=""
                  aria-hidden="true"
                  draggable="false"
                />
              </div>

              <img
                id="dashboard-avatar"
                class="member-avatar member-hidden"
                alt=""
              />
            </div>

            <div class="dashboard-profile-copy">
              <div class="dashboard-role-badges">
                <span class="member-badge">
                  Colaborador
                </span>

                <span
                  id="dashboard-admin-badge"
                  class="member-badge dashboard-admin-badge member-hidden"
                  title="Este colaborador possui acesso administrativo"
                >
                  <svg
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      d="M12 3 5.5 6v5.2c0 4.1 2.7 7.7 6.5 9.8 3.8-2.1 6.5-5.7 6.5-9.8V6L12 3Z"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linejoin="round"
                    />
                    <path
                      d="m9.4 12.1 1.7 1.8 3.6-4"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>

                  Administrador
                </span>
              </div>

              <h2 id="dashboard-name">
                Perfil EVRYLUX
              </h2>

              <p
                id="dashboard-area"
                class="member-muted"
              >
                Configure seu perfil para completar suas informações.
              </p>
            </div>
          </div>

          <div class="dashboard-summary">
            <div class="summary-box">
              <span>
                GitHub
              </span>

              <strong id="dashboard-github">
                —
              </strong>
            </div>

            <div class="summary-box">
              <span>
                Disponibilidade
              </span>

              <strong id="dashboard-availability">
                —
              </strong>
            </div>

            <div class="summary-box">
              <span>
                Habilidades
              </span>

              <strong id="dashboard-skills">
                —
              </strong>
            </div>
          </div>
        </article>

        <aside class="quick-access-card">
          <div class="quick-access-head">
            <div>
              <span class="quick-access-kicker">
                Atalhos
              </span>

              <h2>
                Acesso rápido
              </h2>
            </div>

            <span class="quick-access-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path
                  d="M7 12h10M13 8l4 4-4 4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
          </div>

          <div class="quick-access-list">
            <a
              class="quick-access-item"
              href="/colab/profile"
            >
              <span class="quick-access-item-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <circle cx="12" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.8"/>
                  <path d="M6 19a6 6 0 0 1 12 0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
              </span>

              <span>
                <strong>Meu perfil</strong>
                <small>Atualize sua identidade e foto</small>
              </span>

              <span class="quick-access-arrow">→</span>
            </a>

            <a
              class="quick-access-item"
              href="/colab/security"
            >
              <span class="quick-access-item-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="M12 3 5.5 6v5.2c0 4.1 2.7 7.7 6.5 9.8 3.8-2.1 6.5-5.7 6.5-9.8V6L12 3Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                  <path d="M9.5 12.2 11.2 14l3.5-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>

              <span>
                <strong>Segurança</strong>
                <small>2FA e proteção da conta</small>
              </span>

              <span class="quick-access-arrow">→</span>
            </a>

            <a
              class="quick-access-item"
              href="/colab/studio"
            >
              <span class="quick-access-item-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <rect x="4" y="5" width="16" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/>
                  <path d="M8 9h8M8 12h5M8 15h7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
              </span>

              <span>
                <strong>Studio</strong>
                <small>Organização interna do projeto</small>
              </span>

              <span class="quick-access-arrow">→</span>
            </a>

            <a
              class="quick-access-item"
              href="https://github.com/joao01020/evrylux"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="quick-access-item-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="M7 17 17 7M10 7h7v7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>

              <span>
                <strong>Repositório</strong>
                <small>Abrir código no GitHub</small>
              </span>

              <span class="quick-access-arrow">↗</span>
            </a>
          </div>
        </aside>
      </section>

      <section class="tools-section">
        <div class="tools-heading">
          <div>
            <div class="eyebrow">
              Ferramentas do portal
            </div>

            <h2>
              Tudo que você precisa, organizado por função.
            </h2>

            <p>
              Acesse os recursos internos do EVRYLUX sem misturar tarefas,
              administração e operação do projeto.
            </p>
          </div>
        </div>

        <div class="tools-grid">
          <a
            class="tool-card tool-card-featured"
            href="/colab/studio"
          >
            <div class="tool-card-top">
              <span class="tool-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4 5.5h16v13H4z" fill="none" stroke="currentColor" stroke-width="1.8"/>
                  <path d="M8 9h8M8 12h5M8 15h7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
              </span>

              <span class="tool-arrow">
                →
              </span>
            </div>

            <div class="tool-card-copy">
              <span class="tool-card-kicker">
                Trabalho
              </span>

              <h3>
                Studio
              </h3>

              <p>
                Central de organização interna e acesso às ferramentas de trabalho da equipe.
              </p>
            </div>
          </a>

          <a
            class="tool-card"
            href="/colab/studio/roadmap"
          >
            <div class="tool-card-top">
              <span class="tool-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M5 19V8m7 11V5m7 14v-7" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>
                  <circle cx="5" cy="6" r="2" fill="none" stroke="currentColor" stroke-width="1.8"/>
                  <circle cx="12" cy="3" r="2" fill="none" stroke="currentColor" stroke-width="1.8"/>
                  <circle cx="19" cy="10" r="2" fill="none" stroke="currentColor" stroke-width="1.8"/>
                </svg>
              </span>

              <span class="tool-arrow">
                →
              </span>
            </div>

            <div class="tool-card-copy">
              <span class="tool-card-kicker">
                Planejamento
              </span>

              <h3>
                Roadmap interno
              </h3>

              <p>
                Organize etapas, responsáveis, prioridades e progresso do desenvolvimento.
              </p>
            </div>
          </a>

          <a
            class="tool-card"
            href="/colab/support"
          >
            <div class="tool-card-top">
              <span class="tool-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M6.5 17.5h-1A2.5 2.5 0 0 1 3 15V9a9 9 0 0 1 18 0v6a2.5 2.5 0 0 1-2.5 2.5h-1" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  <path d="M7 16v-4a2 2 0 0 1 2-2h1v8H9a2 2 0 0 1-2-2Zm10 0v-4a2 2 0 0 0-2-2h-1v8h1a2 2 0 0 0 2-2Z" fill="none" stroke="currentColor" stroke-width="1.8"/>
                </svg>
              </span>

              <span class="tool-arrow">
                →
              </span>
            </div>

            <div class="tool-card-copy">
              <span class="tool-card-kicker">
                Atendimento
              </span>

              <h3>
                Suporte
              </h3>

              <p>
                Acompanhe conversas e responda usuários diretamente pelo portal.
              </p>
            </div>
          </a>

          <a
            id="admin-demo-card"
            class="tool-card admin-tool member-hidden"
            href="/colab/demo"
          >
            <div class="tool-card-top">
              <span class="tool-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M5 4.5h14v15H5z" fill="none" stroke="currentColor" stroke-width="1.8"/>
                  <path d="M8 8h8M8 12h8M8 16h5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  <circle cx="17" cy="16" r="2.2" fill="none" stroke="currentColor" stroke-width="1.6"/>
                </svg>
              </span>

              <span class="tool-arrow">
                →
              </span>
            </div>

            <div class="tool-card-copy">
              <span class="tool-card-kicker">
                Administração
              </span>

              <h3>
                Fila do Demo
              </h3>

              <p>
                Veja os usuários interessados no demo, seus sistemas e disponibilidade para feedback.
              </p>
            </div>
          </a>

          <a
            id="admin-users-card"
            class="tool-card admin-tool"
            href="/colab/admins"
          >
            <div class="tool-card-top">
              <span class="tool-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="9" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.8"/>
                  <path d="M4 18a5 5 0 0 1 10 0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  <path d="M16 8h4M18 6v4M16 14h4M18 12v4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
              </span>

              <span class="tool-arrow">
                →
              </span>
            </div>

            <div class="tool-card-copy">
              <span class="tool-card-kicker">
                Administração
              </span>

              <h3>
                Administradores
              </h3>

              <p>
                Gerencie quem pode acessar funções administrativas e permissões do portal.
              </p>
            </div>
          </a>

          <a
            class="tool-card"
            href="/colab/security"
          >
            <div class="tool-card-top">
              <span class="tool-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 3 5.5 6v5.2c0 4.1 2.7 7.7 6.5 9.8 3.8-2.1 6.5-5.7 6.5-9.8V6L12 3Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                  <path d="M9.5 12.2 11.2 14l3.5-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>

              <span class="tool-arrow">
                →
              </span>
            </div>

            <div class="tool-card-copy">
              <span class="tool-card-kicker">
                Proteção
              </span>

              <h3>
                Segurança / 2FA
              </h3>

              <p>
                Configure seu autenticador e proteja sessões administrativas com AAL2.
              </p>
            </div>
          </a>

          <a
            class="tool-card"
            href="/contributors"
          >
            <div class="tool-card-top">
              <span class="tool-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="8" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.8"/>
                  <circle cx="17" cy="9" r="2.4" fill="none" stroke="currentColor" stroke-width="1.7"/>
                  <path d="M3.5 19a4.5 4.5 0 0 1 9 0M13.5 18.5a3.5 3.5 0 0 1 7 0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
              </span>

              <span class="tool-arrow">
                ↗
              </span>
            </div>

            <div class="tool-card-copy">
              <span class="tool-card-kicker">
                Comunidade
              </span>

              <h3>
                Colaboradores
              </h3>

              <p>
                Consulte a participação pública e as contribuições registradas no projeto.
              </p>
            </div>
          </a>
        </div>
      </section>
    </div>
  </main>
</Layout>

<script>
  import {
    supabase,
  } from '../../lib/supabase';

  import {
    requireMemberSession,
  } from '../../lib/member-auth';

  import {
    isCurrentUserAdmin,
  } from '../../lib/colab-admin';

  const session =
    await requireMemberSession();

  if (session) {
    const loading =
      document.querySelector<HTMLElement>(
        '#colab-loading',
      );

    const content =
      document.querySelector<HTMLElement>(
        '#colab-content',
      );

    const {
      data: profile,
      error,
    } =
      await supabase
        .from('member_profiles')
        .select(
          'display_name, github_login, bio, avatar_url, area, skills, availability',
        )
        .eq(
          'user_id',
          session.user.id,
        )
        .maybeSingle();

    if (error) {
      console.warn(
        '[EVRYLUX] Não foi possível carregar o perfil:',
        error.message,
      );
    }

    const welcome =
      document.querySelector<HTMLElement>(
        '#dashboard-welcome',
      );

    const name =
      document.querySelector<HTMLElement>(
        '#dashboard-name',
      );

    const area =
      document.querySelector<HTMLElement>(
        '#dashboard-area',
      );

    const github =
      document.querySelector<HTMLElement>(
        '#dashboard-github',
      );

    const availability =
      document.querySelector<HTMLElement>(
        '#dashboard-availability',
      );

    const skills =
      document.querySelector<HTMLElement>(
        '#dashboard-skills',
      );

    const avatar =
      document.querySelector<HTMLImageElement>(
        '#dashboard-avatar',
      );

    const placeholder =
      document.querySelector<HTMLElement>(
        '#dashboard-avatar-placeholder',
      );

    const adminDemoCard =
      document.querySelector<HTMLElement>(
        '#admin-demo-card',
      );

    const adminUsersCard =
      document.querySelector<HTMLElement>(
        '#admin-users-card',
      );

    const adminBadge =
      document.querySelector<HTMLElement>(
        '#dashboard-admin-badge',
      );

    const displayName =
      profile?.display_name?.trim() ||
      session.user.email ||
      'Colaborador EVRYLUX';

    if (welcome) {
      welcome.textContent =
        `Olá, ${displayName}. Esta é sua área dentro do projeto.`;
    }

    if (name) {
      name.textContent =
        displayName;
    }

    if (area) {
      area.textContent =
        profile?.area?.trim() ||
        'Configure sua área principal no perfil.';
    }

    if (github) {
      github.textContent =
        profile?.github_login
          ? `@${profile.github_login}`
          : 'Não informado';
    }

    if (availability) {
      availability.textContent =
        profile?.availability?.trim() ||
        'Não informada';
    }

    if (skills) {
      skills.textContent =
        profile?.skills?.trim() ||
        'Não informadas';
    }

    if (
      profile?.avatar_url?.trim() &&
      avatar
    ) {
      avatar.src =
        profile.avatar_url;

      avatar.alt =
        `Avatar de ${displayName}`;

      avatar.classList.remove(
        'member-hidden',
      );

      placeholder?.classList.add(
        'member-hidden',
      );

      avatar.addEventListener(
        'error',
        () => {
          avatar.classList.add(
            'member-hidden',
          );

          placeholder?.classList.remove(
            'member-hidden',
          );
        },
        {
          once: true,
        },
      );
    } else {
      avatar?.classList.add(
        'member-hidden',
      );

      placeholder?.classList.remove(
        'member-hidden',
      );
    }

    try {
      const admin =
        await isCurrentUserAdmin();

      if (admin) {
        adminBadge?.classList.remove(
          'member-hidden',
        );

        adminDemoCard?.classList.remove(
          'member-hidden',
        );

        adminUsersCard?.classList.remove(
          'member-hidden',
        );
      } else {
        adminBadge?.classList.add(
          'member-hidden',
        );

        adminDemoCard?.classList.add(
          'member-hidden',
        );

        adminUsersCard?.classList.add(
          'member-hidden',
        );
      }
    } catch (adminError) {
      adminBadge?.classList.add(
        'member-hidden',
      );

      adminDemoCard?.classList.add(
        'member-hidden',
      );

      adminUsersCard?.classList.add(
        'member-hidden',
      );

      console.warn(
        '[EVRYLUX] Não foi possível verificar permissões administrativas:',
        adminError,
      );
    }

    loading?.classList.add(
      'member-hidden',
    );

    content?.classList.remove(
      'member-hidden',
    );
  }
</script>

<style>
  .dashboard-page {
    position: relative;
  }

  .dashboard-container {
    padding-top: 22px;
  }

  .dashboard-hero {
    min-height: 220px;
    padding: 30px 32px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 32px;
    border: 1px solid rgba(65,104,62,.1);
    border-radius: 28px;
    background:
      radial-gradient(circle at 85% 10%, rgba(159,211,149,.19), transparent 34%),
      linear-gradient(145deg, rgba(255,255,255,.96), rgba(247,251,244,.88));
    box-shadow:
      0 24px 70px rgba(54,92,51,.055);
    overflow: hidden;
  }

  .dashboard-hero-copy {
    max-width: 760px;
  }

  .dashboard-hero h1 {
    margin: 14px 0 0;
    font-size: clamp(46px, 6vw, 72px);
    line-height: .95;
    letter-spacing: -.06em;
  }

  .dashboard-hero p {
    max-width: 650px;
    margin: 16px 0 0;
    color: var(--text-soft);
    font-size: 14px;
    line-height: 1.7;
  }

  .dashboard-hero-actions {
    flex: 0 0 auto;
  }

  .dashboard-overview {
    margin-top: 16px;
    display: grid;
    grid-template-columns: minmax(0,1.45fr) minmax(320px,.55fr);
    gap: 16px;
    align-items: stretch;
  }

  .dashboard-profile-card,
  .quick-access-card {
    border: 1px solid rgba(65,104,62,.1);
    border-radius: 22px;
    background: rgba(255,255,255,.86);
    box-shadow:
      0 16px 46px rgba(54,92,51,.04);
  }

  .dashboard-profile-card {
    padding: 24px;
  }

  .dashboard-profile-main {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .dashboard-avatar-wrap {
    width: 78px;
    height: 78px;
    flex: 0 0 auto;
  }

  .dashboard-profile-copy {
    min-width: 0;
  }

  .dashboard-profile-copy h2 {
    margin: 10px 0 0;
    font-size: 26px;
    letter-spacing: -.035em;
  }

  .dashboard-profile-copy p {
    margin: 6px 0 0;
  }

  .dashboard-summary {
    margin-top: 24px;
    display: grid;
    grid-template-columns: repeat(3,minmax(0,1fr));
    gap: 10px;
  }

  .summary-box {
    min-height: 96px;
    padding: 15px;
    border: 1px solid rgba(65,104,62,.08);
    border-radius: 15px;
    background:
      linear-gradient(145deg, rgba(255,255,255,.92), rgba(243,248,239,.84));
  }

  .summary-box span,
  .summary-box strong {
    display: block;
  }

  .summary-box span {
    color: var(--text-soft);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .summary-box strong {
    margin-top: 8px;
    font-size: 13px;
    line-height: 1.45;
  }

  .quick-access-card {
    padding: 20px;
    background:
      linear-gradient(145deg, rgba(255,255,255,.95), rgba(239,248,235,.72));
  }

  .quick-access-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  .quick-access-kicker {
    color: var(--primary-deep);
    font-size: 8px;
    font-weight: 850;
    letter-spacing: .055em;
    text-transform: uppercase;
  }

  .quick-access-head h2 {
    margin: 5px 0 0;
    font-size: 22px;
    letter-spacing: -.035em;
  }

  .quick-access-icon {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: var(--primary-soft);
    color: var(--primary-deep);
  }

  .quick-access-icon svg {
    width: 18px;
    height: 18px;
  }

  .quick-access-list {
    margin-top: 16px;
    display: grid;
    gap: 8px;
  }

  .quick-access-item {
    min-height: 62px;
