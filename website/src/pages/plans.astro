---
import Layout from '../layouts/Layout.astro';

const plans = [
  {
    name: 'Free',
    price: 'US$ 0',
    period: 'para sempre',
    storage: '1 GB',
    description:
      'Para conhecer o EVRYLUX com uma experiência completa, sem anúncios e com espaço suficiente para começar a construir seu histórico. Você usa o produto de verdade e só aumenta a capacidade quando fizer sentido para você.',
    cta: 'Começar grátis',
    featured: false,
    badge: 'Para começar',
    items: [
      '1 GB de armazenamento sincronizado',
      'Acesso ao Cérebro',
      'Acesso ao Financeiro',
      'Acesso ao Treino',
      'Acesso à Rotina',
      'Funciona mesmo sem internet',
      'Sincronização entre dispositivos',
      'Criptografia do conteúdo sincronizado',
    ],
  },
  {
    name: 'Essencial',
    price: 'US$ 9',
    period: '/ mês',
    storage: '10 GB',
    description:
      'Para quem valoriza o que estamos construindo e quer ajudar a manter o EVRYLUX limpo, sem anúncios e com mais espaço para conhecimento, histórico, anexos e arquivos sincronizados.',
    cta: 'Escolher Essencial',
    featured: true,
    badge: 'Mais indicado',
    items: [
      '10 GB de armazenamento sincronizado',
      'Tudo do plano Free',
      'Mais espaço para conhecimento e histórico',
      'Mais espaço para anexos e arquivos',
      'Todos os módulos disponíveis',
      'Funciona mesmo sem internet',
      'Sincronização entre dispositivos',
      'Criptografia do conteúdo sincronizado',
    ],
  },
  {
    name: 'Pro',
    price: 'US$ 29',
    period: '/ mês',
    storage: '50 GB',
    description:
      'Para quem usa o EVRYLUX com intensidade, quer apoiar a continuidade do projeto e precisa de muito mais espaço para histórico, materiais e arquivos dentro do ecossistema.',
    cta: 'Escolher Pro',
    featured: false,
    badge: 'Mais capacidade',
    items: [
      '50 GB de armazenamento sincronizado',
      'Tudo do plano Essencial',
      'Grande capacidade para histórico de longo prazo',
      'Muito mais espaço para arquivos e materiais',
      'Todos os módulos disponíveis',
      'Funciona mesmo sem internet',
      'Sincronização entre dispositivos',
      'Criptografia do conteúdo sincronizado',
    ],
  },
];

const comparisons = [
  ['Armazenamento sincronizado', '1 GB', '10 GB', '50 GB'],
  ['Cérebro', 'Incluído', 'Incluído', 'Incluído'],
  ['Financeiro', 'Incluído', 'Incluído', 'Incluído'],
  ['Treino', 'Incluído', 'Incluído', 'Incluído'],
  ['Rotina', 'Incluído', 'Incluído', 'Incluído'],
  ['Funciona mesmo sem internet', 'Incluído', 'Incluído', 'Incluído'],
  ['Criptografia', 'Incluído', 'Incluído', 'Incluído'],
];
---

<Layout
  title="Planos — EVRYLUX"
  description="Escolha a capacidade de armazenamento sincronizado do EVRYLUX sem perder acesso aos recursos essenciais."
>
  <main class="plans-page">
    <section class="plans-hero">
      <div class="plans-orb plans-orb-one" aria-hidden="true"></div>
      <div class="plans-orb plans-orb-two" aria-hidden="true"></div>

      <div class="container plans-hero-inner">
        <div class="eyebrow">Planos EVRYLUX</div>

        <h1>
          Comece com espaço para usar de verdade.
          <span>Cresça quando precisar.</span>
        </h1>

        <p>
          O EVRYLUX foi pensado para ser limpo, sem anúncios e sem distrações.
          Os recursos principais continuam disponíveis em todos os planos.
          Quem valoriza o que estamos construindo pode escolher um plano pago
          para ajudar a manter o projeto e garantir mais espaço conforme seu histórico cresce.
        </p>

        <div class="plans-principle">
          <span class="principle-dot"></span>

          <div>
            <strong>Sem anúncios. Sem poluição. Sem bloquear a experiência principal.</strong>

            <span>
              Cérebro, Financeiro, Treino e Rotina permanecem disponíveis
              desde o plano gratuito. Os planos pagos existem para ampliar
              o espaço e ajudar a sustentar uma experiência limpa.
            </span>
          </div>
        </div>

        <div class="premium-values">
          <article>
            <span class="premium-value-icon">✦</span>
            <div>
              <strong>Sem anúncios</strong>
              <p>
                Não queremos vender sua atenção. A experiência foi pensada para
                permanecer limpa, calma e focada no que você está construindo.
              </p>
            </div>
          </article>

          <article>
            <span class="premium-value-icon">↗</span>
            <div>
              <strong>Mais espaço quando precisar</strong>
              <p>
                O plano pago não existe para quebrar a experiência. Ele amplia
                a capacidade para quem acumulou mais histórico, anexos e materiais.
              </p>
            </div>
          </article>

          <article>
            <span class="premium-value-icon">♡</span>
            <div>
              <strong>Ajuda a manter o projeto vivo</strong>
              <p>
                Quem valoriza o EVRYLUX pode apoiar a continuidade do produto
                enquanto recebe mais capacidade para usar no dia a dia.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="pricing-section">
      <div class="container">
        <div class="pricing-grid">
          {
            plans.map((plan) => (
              <article
                class:list={[
                  'pricing-card',
                  {
                    featured: plan.featured,
                  },
                ]}
              >
                <div class="pricing-card-top">
                  <div>
                    <span class="plan-badge">
                      {plan.badge}
                    </span>

                    <h2>
                      {plan.name}
                    </h2>
                  </div>

                  <div class="storage-badge">
                    <span>
                      Armazenamento
                    </span>

                    <strong>
                      {plan.storage}
                    </strong>
                  </div>
                </div>

                <div class="plan-price">
                  <strong>
                    {plan.price}
                  </strong>

                  <span>
                    {plan.period}
                  </span>
                </div>

                <p class="plan-description">
                  {plan.description}
                </p>

                <a
                  class:list={[
                    'plan-button',
                    {
                      'plan-button-primary':
                        plan.featured,
                    },
                  ]}
                  href="/download"
                >
                  <span>
                    {plan.cta}
                  </span>

                  <span aria-hidden="true">
                    →
                  </span>
                </a>

                {
                  plan.name !== 'Free' && (
                    <div class="support-note">
                      <span class="support-note-dot"></span>
                      <span>
                        Este plano ajuda a manter o EVRYLUX sem anúncios.
                      </span>
                    </div>
                  )
                }

                <div class="plan-divider"></div>

                <div class="plan-includes">
                  <span class="includes-label">
                    Inclui
                  </span>

                  <ul>
                    {
                      plan.items.map((item) => (
                        <li>
                          <span class="check" aria-hidden="true">✓</span>
                          <span>{item}</span>
                        </li>
                      ))
                    }
                  </ul>
                </div>
              </article>
            ))
          }
        </div>

        <div class="pricing-note">
          <span class="pricing-note-icon">i</span>

          <div>
            <strong>
              Proposta inicial de preços
            </strong>

            <p>
              Os valores e limites desta página representam a estrutura inicial
              dos planos. Antes do lançamento comercial, eles podem ser
              ajustados conforme custo real de infraestrutura, armazenamento e
              sincronização.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="comparison-section">
      <div class="container">
        <div class="comparison-heading">
          <div>
            <div class="eyebrow">
              Comparação
            </div>

            <h2>
              A mesma experiência.
              Mais espaço quando necessário.
            </h2>
          </div>

          <p>
            A proposta é simples: não encher o aplicativo de anúncios
            nem criar dezenas de limitações artificiais. Você começa com
            a experiência principal e aumenta a capacidade quando precisar
            de mais espaço ou quando quiser apoiar o que estamos construindo.
          </p>
        </div>

        <div class="comparison-card">
          <div class="comparison-row comparison-header">
            <div>Recurso</div>
            <div>Free</div>
            <div class="featured-column">Essencial</div>
            <div>Pro</div>
          </div>

          {
            comparisons.map((row) => (
              <div class="comparison-row">
                <div>{row[0]}</div>
                <div>{row[1]}</div>
                <div class="featured-column">{row[2]}</div>
                <div>{row[3]}</div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="storage-explanation">
      <div class="container">
        <div class="storage-card">
          <div class="storage-copy">
            <div class="eyebrow">
              Como funciona
            </div>

            <h2>
              Seu conhecimento continua com você.
            </h2>

            <p>
              A capacidade do plano representa o espaço de dados sincronizados
              na infraestrutura do EVRYLUX. O aplicativo foi pensado para continuar
              útil mesmo sem internet, então o armazenamento local do dispositivo
              e o armazenamento sincronizado são coisas diferentes.
            </p>
          </div>

          <div class="storage-visual">
            <article>
              <span class="storage-number">01</span>

              <div>
                <strong>Você registra</strong>

                <p>
                  Conceitos, perguntas, treinos, objetivos e rotina.
                </p>
              </div>
            </article>

            <span class="storage-line"></span>

            <article>
              <span class="storage-number">02</span>

              <div>
                <strong>O EVRYLUX protege</strong>

                <p>
                  O conteúdo sensível entra no fluxo de proteção e criptografia.
                </p>
              </div>
            </article>

            <span class="storage-line"></span>

            <article>
              <span class="storage-number">03</span>

              <div>
                <strong>Você sincroniza</strong>

                <p>
                  O plano define a capacidade disponível para os dados sincronizados.
                </p>
              </div>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section class="plans-cta">
      <div class="container">
        <div class="plans-cta-card">
          <div>
            <div class="eyebrow">
              Comece sem compromisso
            </div>

            <h2>
              Use primeiro. Apoie quando fizer sentido.
            </h2>

            <p>
              O plano Free oferece 1 GB de armazenamento sincronizado e acesso
              à experiência principal sem anúncios. Se o EVRYLUX passar a fazer
              parte da sua rotina, os planos pagos ajudam a manter o projeto
              limpo e garantem mais espaço para o seu histórico crescer.
            </p>
          </div>

          <a class="button button-primary" href="/download">
            Baixar EVRYLUX
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .plans-page { overflow: hidden; }

  .plans-hero {
    position: relative;
    padding: 122px 0 88px;
    overflow: hidden;
    isolation: isolate;
  }

  .plans-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -3;
    background:
      radial-gradient(circle at 82% 10%, rgba(159,211,149,.22), transparent 28%),
      radial-gradient(circle at 18% 72%, rgba(223,241,218,.5), transparent 34%),
      linear-gradient(180deg, #fbfdf9 0%, var(--bg) 100%);
  }

  .plans-orb {
    position: absolute;
    z-index: -2;
    border-radius: 50%;
    pointer-events: none;
  }

  .plans-orb-one {
    width: 420px;
    height: 420px;
    top: -190px;
    right: -120px;
    background: rgba(223,241,218,.5);
  }

  .plans-orb-two {
    width: 260px;
    height: 260px;
    left: 25%;
    bottom: -150px;
    background: rgba(159,211,149,.08);
  }

  .plans-hero-inner h1 {
    max-width: 940px;
    margin: 20px 0 0;
    font-size: clamp(54px, 7vw, 90px);
    line-height: .96;
    letter-spacing: -.064em;
  }

  .plans-hero-inner h1 span {
    display: block;
    color: var(--primary-deep);
  }

  .plans-hero-inner > p {
    max-width: 790px;
    margin: 28px 0 0;
    color: var(--text-soft);
    font-size: 19px;
    line-height: 1.72;
  }

  .plans-principle {
    max-width: 820px;
    margin-top: 30px;
    padding: 14px 16px;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: rgba(255,255,255,.68);
    box-shadow: 0 10px 34px rgba(54,92,51,.04);
  }

  .principle-dot {
    width: 9px;
    height: 9px;
    margin-top: 5px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--primary-strong);
    box-shadow: 0 0 0 6px rgba(95,157,89,.1);
  }

  .plans-principle strong,
  .plans-principle span { display: block; }

  .plans-principle strong { font-size: 12px; }

  .plans-principle div > span {
    margin-top: 4px;
    color: var(--text-soft);
    font-size: 11px;
    line-height: 1.5;
  }

  .premium-values {
    margin-top: 22px;
    display: grid;
    grid-template-columns: repeat(3,minmax(0,1fr));
    gap: 12px;
  }

  .premium-values article {
    padding: 16px;
    display: flex;
    align-items: flex-start;
    gap: 11px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: rgba(255,255,255,.58);
    box-shadow: 0 12px 32px rgba(54,92,51,.035);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .premium-value-icon {
    width: 32px;
    height: 32px;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: var(--primary-soft);
    color: var(--primary-deep);
    font-size: 12px;
    font-weight: 900;
  }

  .premium-values strong {
    display: block;
    font-size: 11px;
  }

  .premium-values p {
    margin: 4px 0 0;
    color: var(--text-soft);
    font-size: 10px;
    line-height: 1.55;
  }

  .pricing-section { padding: 18px 0 94px; }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0,1fr));
    gap: 18px;
    align-items: stretch;
  }

  .pricing-card {
    position: relative;
    min-height: 640px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgba(65,104,62,.13);
    border-radius: 28px;
    background:
      linear-gradient(
        150deg,
        rgba(255,255,255,.96),
        rgba(247,251,244,.82)
      );
    box-shadow: 0 18px 54px rgba(54,92,51,.055);
    transition:
      transform .25s cubic-bezier(.22,1,.36,1),
      border-color .25s ease,
      box-shadow .25s ease;
  }

  .pricing-card::after {
    content: "";
    position: absolute;
    width: 220px;
    height: 220px;
    right: -115px;
    bottom: -120px;
    border-radius: 50%;
    background: rgba(223,241,218,.34);
    transition: transform .35s ease;
  }

  .pricing-card:hover {
    transform: translateY(-6px);
    border-color: rgba(95,157,89,.25);
    box-shadow: 0 30px 80px rgba(54,92,51,.11);
  }

  .pricing-card:hover::after {
    transform: scale(1.12);
  }

  .pricing-card.featured {
    transform: translateY(-12px);
    border-color: rgba(95,157,89,.32);
    background:
      linear-gradient(
        145deg,
        rgba(255,255,255,.98),
        rgba(239,248,235,.94)
      );
    box-shadow: 0 32px 86px rgba(54,92,51,.13);
  }

  .pricing-card.featured:hover {
    transform: translateY(-18px);
  }

  .pricing-card.featured::before {
    content: "";
    position: absolute;
    width: 230px;
    height: 230px;
    right: -90px;
    top: -110px;
    border-radius: 50%;
    background: rgba(159,211,149,.13);
  }

  .pricing-card-top {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
  }

  .plan-badge {
    min-height: 25px;
    padding: 0 8px;
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    background: var(--surface-muted);
    color: var(--text-soft);
    font-size: 9px;
    font-weight: 850;
    text-transform: uppercase;
    letter-spacing: .07em;
  }

  .featured .plan-badge {
    background: var(--primary-soft);
    color: var(--primary-deep);
  }

  .pricing-card h2 {
    margin: 13px 0 0;
    font-size: 28px;
    letter-spacing: -.04em;
  }

  .storage-badge {
    min-width: 88px;
    padding: 10px;
    border: 1px solid var(--border);
    border-radius: 13px;
    background: rgba(255,255,255,.72);
    text-align: right;
  }

  .storage-badge span,
  .storage-badge strong { display: block; }

  .storage-badge span {
    color: var(--text-soft);
    font-size: 7px;
    text-transform: uppercase;
    letter-spacing: .07em;
  }

  .storage-badge strong {
    margin-top: 3px;
    color: var(--primary-deep);
    font-size: 12px;
  }

  .plan-price {
    position: relative;
    z-index: 2;
    margin-top: 30px;
    display: flex;
    align-items: baseline;
    gap: 7px;
  }

  .plan-price strong {
    font-size: 42px;
    letter-spacing: -.055em;
  }

  .plan-price span {
    color: var(--text-soft);
    font-size: 11px;
  }

  .plan-description {
    position: relative;
    z-index: 2;
    min-height: 90px;
    margin: 16px 0 0;
    color: var(--text-soft);
    font-size: 13px;
    line-height: 1.7;
  }

  .plan-button {
    position: relative;
    z-index: 2;
    min-height: 46px;
    margin-top: 20px;
    padding: 0 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border: 1px solid var(--border);
    border-radius: 13px;
    background: rgba(255,255,255,.78);
    color: var(--text);
    font-size: 12px;
    font-weight: 800;
    transition: transform .18s ease, box-shadow .18s ease;
  }

  .plan-button-primary {
    border-color: rgba(95,157,89,.2);
    background: var(--primary-soft);
    color: var(--primary-deep);
  }

  .plan-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(54,92,51,.07);
  }

  .support-note {
    position: relative;
    z-index: 2;
    margin-top: 18px;
    padding: 10px 11px;
    display: flex;
    align-items: center;
    gap: 8px;
    border: 1px solid rgba(95,157,89,.14);
    border-radius: 11px;
    background: rgba(223,241,218,.52);
    color: var(--primary-deep);
    font-size: 9px;
    font-weight: 750;
    line-height: 1.45;
  }

  .support-note-dot {
    width: 6px;
    height: 6px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--primary-strong);
    box-shadow: 0 0 0 5px rgba(95,157,89,.08);
  }

  .plan-divider {
    height: 1px;
    margin: 24px 0 20px;
    background: var(--border);
  }

  .includes-label {
    color: var(--text-soft);
    font-size: 9px;
    font-weight: 850;
    text-transform: uppercase;
    letter-spacing: .08em;
  }

  .plan-includes ul {
    margin: 14px 0 0;
    padding: 0;
    display: grid;
    gap: 10px;
    list-style: none;
  }

  .plan-includes li {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    color: var(--text-soft);
    font-size: 11px;
    line-height: 1.45;
  }

  .check {
    width: 18px;
    height: 18px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    border-radius: 6px;
    background: var(--primary-soft);
    color: var(--primary-deep);
    font-size: 9px;
    font-weight: 900;
  }

  .pricing-note {
    margin-top: 28px;
    padding: 16px 18px;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: rgba(255,255,255,.52);
  }

  .pricing-note-icon {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    border-radius: 10px;
    background: var(--surface-muted);
    color: var(--text-soft);
    font-size: 11px;
    font-weight: 850;
  }

  .pricing-note strong { display: block; font-size: 11px; }

  .pricing-note p {
    margin: 4px 0 0;
    color: var(--text-soft);
    font-size: 10px;
    line-height: 1.55;
  }

  .comparison-section { padding: 10px 0 88px; }

  .comparison-heading {
    display: grid;
    grid-template-columns: minmax(0,1.05fr) minmax(320px,.95fr);
    align-items: end;
    gap: 60px;
  }

  .comparison-heading h2 {
    max-width: 760px;
    margin: 14px 0 0;
    font-size: clamp(34px,4vw,52px);
    line-height: 1.05;
    letter-spacing: -.052em;
  }

  .comparison-heading > p {
    margin: 0;
    color: var(--text-soft);
    font-size: 14px;
    line-height: 1.7;
  }

  .comparison-card {
    margin-top: 32px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 22px;
    background: rgba(255,255,255,.84);
    box-shadow: 0 18px 48px rgba(54,92,51,.045);
  }

  .comparison-row {
    display: grid;
    grid-template-columns: 1.4fr repeat(3,1fr);
    border-top: 1px solid var(--border);
  }

  .comparison-row:first-child { border-top: 0; }

