---
import Layout from '../layouts/Layout.astro';
import NeuralBrainAnimation from '../components/home/NeuralBrainAnimation.astro';
import ImmersiveKnowledgeStory from '../components/home/ImmersiveKnowledgeStory.astro';

const features = [
  ['Conceitos', 'Organize o que você aprende em conhecimento estruturado e fácil de reencontrar.'],
  ['Perguntas', 'Mantenha visível aquilo que ainda precisa ser entendido ou investigado.'],
  ['Revisões', 'Retome o conteúdo importante e fortaleça o que realmente precisa permanecer.'],
  ['Mapa do conhecimento', 'Visualize relações entre ideias, conceitos e diferentes áreas de estudo.'],
  ['Funciona sem internet', 'Continue acessando e organizando seu conhecimento mesmo quando estiver sem conexão.'],
  ['Privacidade', 'Arquitetura pensada para proteger dados pessoais e sincronização entre dispositivos.'],
];

const featureIcons = ['01', '02', '03', '04', '05', '06'];
---

<Layout
  title="EVRYLUX — Conhecimento que evolui"
  description="EVRYLUX organiza conceitos, perguntas, revisões e conexões em um sistema de conhecimento vivo."
>
  <main>
    <section class="hero">
      <div class="hero-background" aria-hidden="true">
        <div class="hero-orb hero-orb-a"></div>
        <div class="hero-orb hero-orb-b"></div>
        <div class="hero-grid-lines"></div>
      </div>

      <div class="container hero-grid">
        <div class="hero-copy">
          <div class="eyebrow hero-eyebrow">
            <span class="eyebrow-dot"></span>
            EVRYLUX Cérebro
          </div>

          <h1 class="title hero-title">
            Conhecimento que
            <span>continua evoluindo.</span>
          </h1>

          <p class="subtitle hero-subtitle">
            Organize o que você aprende, preserve perguntas importantes,
            revise ideias e conecte conhecimento em uma estrutura viva.
          </p>

          <div class="button-row hero-actions">
            <a
              class="button button-primary hero-primary"
              href="/download"
            >
              <span>Baixar EVRYLUX</span>
              <span class="button-arrow" aria-hidden="true">↗</span>
            </a>

            <a
              class="button button-secondary hero-secondary"
              href="/explore"
            >
              <span>Explorar o EVRYLUX</span>
              <span class="button-arrow" aria-hidden="true">→</span>
            </a>
          </div>

          <div class="hero-trust">
            <div class="hero-trust-item">
              <span class="trust-dot"></span>
              Funciona sem internet
            </div>

            <div class="hero-trust-item">
              <span class="trust-dot"></span>
              Open source
            </div>

            <div class="hero-trust-item">
              <span class="trust-dot"></span>
              Conhecimento conectado
            </div>
          </div>
        </div>

        <div class="cerebro-showcase">
          <div class="floating-note floating-note-top">
            <span class="floating-note-icon">?</span>

            <div>
              <strong>Nova pergunta</strong>
              <span>Conectada ao seu contexto</span>
            </div>
          </div>

          <div class="cerebro-card card">
            <div class="cerebro-glow"></div>

            <div class="cerebro-top">
              <span class="pulse" aria-label="Ativo"></span>
            </div>

            <div class="cerebro-content">
              <div class="cerebro-stat">
                <strong>127</strong>
                <span>conceitos conectados</span>
              </div>

              <div class="cerebro-map">
                <NeuralBrainAnimation />
              </div>
            </div>

            <div class="mini-grid">
              <div><b>18</b><span>Perguntas</span></div>
              <div><b>32</b><span>Revisões</span></div>
              <div><b>5</b><span>Áreas</span></div>
            </div>

            <div class="cerebro-footer">
              <div class="cerebro-footer-status">
                <span class="cerebro-footer-dot"></span>
                Evoluindo com você
              </div>

              <span aria-hidden="true">↗</span>
            </div>
          </div>

          <div class="floating-note floating-note-bottom">
            <span class="floating-note-icon">+</span>

            <div>
              <strong>Conceito salvo</strong>
              <span>Organizado automaticamente</span>
            </div>
          </div>
        </div>
      </div>
    </section>


    <ImmersiveKnowledgeStory />

    <section class="ecosystem-entry">
      <div class="container">
        <div class="ecosystem-entry-card">
          <div class="ecosystem-entry-copy">
            <div class="eyebrow">
              Além do Cérebro
            </div>

            <h2>
              Um sistema para acompanhar diferentes áreas da sua evolução.
            </h2>

            <p>
              Conhecimento, finanças, treino e rotina fazem parte do mesmo
              ecossistema. Cada área foi pensada para tornar progresso
              abstrato em algo visível, acompanhável e útil.
            </p>
          </div>

          <div class="ecosystem-entry-side">
            <div class="ecosystem-mini-list">
              <span>Cérebro</span>
              <span>Financeiro</span>
              <span>Treino</span>
              <span>Rotina</span>
            </div>

            <a class="button button-primary ecosystem-entry-button" href="/explore">
              <span>Conhecer as áreas</span>
              <span class="button-arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="section-tight product-section">
      <div class="container">
        <div class="section-heading">
          <div>
            <div class="eyebrow">
              Produto
            </div>

            <h2 class="section-title">
              Um lugar para organizar
              informação e construir conhecimento.
            </h2>
          </div>

          <p class="section-copy">
            O EVRYLUX reúne conceitos, perguntas, revisões,
            busca e conexões em uma única experiência.
          </p>
        </div>

        <div class="grid grid-3 feature-grid">
          {
            features.map(
              ([title, copy], index) => (
                <article class="feature card">
                  <div class="feature-top">
                    <span class="feature-index">{featureIcons[index]}</span>
                    <span class="feature-arrow" aria-hidden="true">↗</span>
                  </div>

                  <div class="feature-dot"></div>
                  <h3>{title}</h3>
                  <p>{copy}</p>
                </article>
              ),
            )
          }
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container open-source-wrap">
        <div class="open-source card">
          <div class="open-source-copy">
            <div class="eyebrow">
              Open source
            </div>

            <h2 class="section-title">
              Contribuições visíveis.
              Participação real.
            </h2>

            <p class="section-copy">
              A página de colaboradores destaca participação com base
              em contribuições e atividade no repositório, sem criar
              hierarquia entre pessoas.
            </p>
          </div>

          <div class="open-source-side">
            <div class="open-source-badge">
              <span class="open-source-pulse"></span>

              <div>
                <strong>Projeto aberto</strong>
                <span>Construído de forma colaborativa</span>
              </div>
            </div>

            <a class="button button-primary" href="/contributors">
              <span>Explorar contribuições</span>
              <span class="button-arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .hero {
    position: relative;
    min-height: calc(100vh - 72px);
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 104px 0 96px;
    isolation: isolate;
  }

  .hero-background {
    position: absolute;
    inset: 0;
    z-index: -2;
    pointer-events: none;
  }

  .hero-background::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 16% 24%, rgba(159,211,149,.13), transparent 31%),
      radial-gradient(circle at 84% 24%, rgba(223,241,218,.72), transparent 34%),
      linear-gradient(180deg, #f9fcf7 0%, #f7fbf4 100%);
  }

  .hero-grid-lines {
    position: absolute;
    inset: 0;
    opacity: .26;
    background-image:
      linear-gradient(rgba(95,157,89,.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(95,157,89,.05) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: linear-gradient(to bottom, transparent, black 20%, black 74%, transparent);
  }

  .hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(2px);
  }

  .hero-orb-a {
    width: 420px;
    height: 420px;
    right: -150px;
    top: -120px;
    background: rgba(159,211,149,.13);
    animation: orbFloatA 12s ease-in-out infinite;
  }

  .hero-orb-b {
    width: 300px;
    height: 300px;
    left: 38%;
    bottom: -150px;
    background: rgba(223,241,218,.44);
    animation: orbFloatB 15s ease-in-out infinite;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.04fr) minmax(430px, .96fr);
    align-items: center;
    gap: clamp(60px, 8vw, 120px);
  }

  .hero-copy {
    animation: heroCopyIn .85s cubic-bezier(.22,1,.36,1) both;
  }

  .hero-eyebrow {
    width: max-content;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 13px;
    border: 1px solid rgba(65,104,62,.12);
    border-radius: 999px;
    background: rgba(255,255,255,.68);
    box-shadow: 0 8px 28px rgba(54,92,51,.035);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .eyebrow-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--primary-strong);
    box-shadow: 0 0 0 5px rgba(95,157,89,.1);
    animation: softPulse 2.4s ease-in-out infinite;
  }

  .hero-title {
    max-width: 760px;
    margin-top: 24px;
    font-size: clamp(58px, 6.5vw, 94px);
    line-height: .91;
    letter-spacing: -.068em;
  }

  .hero-title span {
    display: block;
    color: var(--primary-deep);
  }

  .hero-subtitle {
    max-width: 660px;
    margin: 28px 0 0;
    color: var(--text-soft);
    font-size: clamp(18px, 1.45vw, 21px);
    line-height: 1.68;
  }

  .hero-actions {
    margin-top: 30px;
  }

  .hero-primary,
  .hero-secondary,
  .ecosystem-entry-button {
    min-height: 50px;
    padding: 0 18px;
    gap: 10px;
    border-radius: 14px;
    transition: transform .2s ease, box-shadow .2s ease, background .2s ease;
  }

  .hero-primary {
    box-shadow: 0 12px 28px rgba(95,157,89,.17);
  }

  .hero-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 36px rgba(95,157,89,.24);
  }

  .hero-secondary {
    background: rgba(255,255,255,.7);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .hero-secondary:hover {
    transform: translateY(-2px);
    background: rgba(255,255,255,.95);
  }

  .button-arrow {
    transition: transform .2s ease;
  }

  .button:hover .button-arrow {
    transform: translateX(3px);
  }

  .hero-primary:hover .button-arrow {
    transform: translate(2px,-2px);
  }

  .hero-trust {
    margin-top: 28px;
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  .hero-trust-item {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--text-soft);
    font-size: 11px;
    font-weight: 700;
  }

  .trust-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--primary);
  }

  .cerebro-showcase {
    position: relative;
    min-height: 520px;
    display: grid;
    place-items: center;
    animation: cerebroIn .95s .12s cubic-bezier(.22,1,.36,1) both;
  }

  .cerebro-card {
    position: relative;
    z-index: 3;
    width: min(100%, 540px);
    min-height: 430px;
    padding: 28px;
    overflow: hidden;
    border-radius: 28px;
    background: linear-gradient(145deg, rgba(255,255,255,.92), rgba(247,251,244,.82));
    border: 1px solid rgba(65,104,62,.13);
    box-shadow: 0 28px 80px rgba(54,92,51,.1);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    animation: cardFloat 6s ease-in-out infinite;
  }

  .cerebro-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, transparent 15%, rgba(255,255,255,.72) 44%, transparent 67%);
    transform: translateX(-135%);
    animation: cardShine 7s ease-in-out infinite;
    pointer-events: none;
  }

  .cerebro-glow {
    position: absolute;
    width: 290px;
    height: 290px;
    right: -75px;
    top: -90px;
    border-radius: 50%;
    background: rgba(159,211,149,.16);
    animation: glowMove 8s ease-in-out infinite;
  }

  .cerebro-top,
  .cerebro-content,
  .mini-grid,
  .cerebro-footer {
    position: relative;
    z-index: 2;
  }

  .cerebro-top {
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
  }

  .pulse {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--primary-strong);
    box-shadow: 0 0 0 7px rgba(159,211,149,.18);
    animation: livePulse 2.1s ease-out infinite;
  }

  .cerebro-content {
    min-height: 172px;
    margin-top: 34px;
    display: grid;
    grid-template-columns: .84fr 1.16fr;
    align-items: center;
    gap: 18px;
  }

  .cerebro-stat strong {
    display: block;
    font-size: 70px;
    line-height: 1;
    letter-spacing: -.06em;
  }

  .cerebro-stat span {
    display: block;
    margin-top: 10px;
    color: var(--text-soft);
    font-size: 14px;
  }

  .cerebro-map {
    display: grid;
    place-items: center;
  }




  .mini-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-top: 28px;
  }

  .mini-grid div {
    padding: 16px;
    border-radius: 16px;
    background: rgba(255,255,255,.66);
    border: 1px solid var(--border);
    transition: transform .2s ease, background .2s ease;
  }

  .mini-grid div:hover {
    transform: translateY(-3px);
    background: rgba(255,255,255,.9);
  }

  .mini-grid b,
  .mini-grid span {
    display: block;
  }

  .mini-grid b { font-size: 16px; }

  .mini-grid span {
    color: var(--text-soft);
    font-size: 11px;
    margin-top: 5px;
  }

  .cerebro-footer {
    margin-top: 20px;
    padding-top: 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid rgba(65,104,62,.08);
  }

  .cerebro-footer-status {
    display: flex;
    align-items: center;
    gap: 7px;
    color: var(--text-soft);
    font-size: 10px;
    font-weight: 700;
  }

  .cerebro-footer-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--primary-strong);
    animation: softPulse 2s ease-in-out infinite;
  }

  .floating-note {
    position: absolute;
    z-index: 5;
    min-width: 190px;
    padding: 11px 13px;
    display: flex;
    align-items: center;
    gap: 10px;
    border: 1px solid rgba(65,104,62,.12);
    border-radius: 14px;
    background: rgba(255,255,255,.86);
    box-shadow: 0 15px 40px rgba(54,92,51,.085);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .floating-note-top {
    top: 38px;
    left: -34px;
    animation: floatNoteA 5.5s ease-in-out infinite;
  }

  .floating-note-bottom {
    right: -24px;
    bottom: 44px;
    animation: floatNoteB 6.3s ease-in-out infinite;
  }

  .floating-note-icon {
    width: 31px;
    height: 31px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    border-radius: 10px;
    background: var(--primary-soft);
    color: var(--primary-deep);
    font-size: 12px;
    font-weight: 900;
  }

  .floating-note strong,
  .floating-note div > span { display: block; }

  .floating-note strong { font-size: 11px; }

  .floating-note div > span {
    margin-top: 2px;
    color: var(--text-soft);
    font-size: 9px;
  }

  .ecosystem-entry {
    padding: 24px 0 68px;
  }

  .ecosystem-entry-card {
    position: relative;
    overflow: hidden;
    padding: 28px 30px;
    display: grid;
    grid-template-columns: minmax(0,1.2fr) minmax(300px,.8fr);
    align-items: center;
    gap: 40px;
    border: 1px solid var(--border);
    border-radius: 22px;
    background:
      linear-gradient(
        145deg,
        rgba(255,255,255,.82),
        rgba(239,248,235,.72)
      );
    box-shadow: 0 16px 48px rgba(54,92,51,.045);
  }

  .ecosystem-entry-card::after {
    content: "";
    position: absolute;
    width: 250px;
    height: 250px;
    right: -110px;
    top: -120px;
    border-radius: 50%;
    background: rgba(159,211,149,.1);
  }

  .ecosystem-entry-copy,
  .ecosystem-entry-side {
    position: relative;
    z-index: 2;
  }

  .ecosystem-entry-copy h2 {
    max-width: 760px;
    margin: 12px 0 0;
    font-size: clamp(26px,3vw,38px);
    line-height: 1.12;
    letter-spacing: -.045em;
  }

  .ecosystem-entry-copy p {
    max-width: 760px;
    margin: 14px 0 0;
    color: var(--text-soft);
    font-size: 14px;
    line-height: 1.7;
  }

  .ecosystem-entry-side {
    display: grid;
    justify-items: end;
    gap: 16px;
  }

  .ecosystem-mini-list {
    width: 100%;
    max-width: 330px;
    display: grid;
    grid-template-columns: repeat(2,1fr);
    gap: 8px;
  }

  .ecosystem-mini-list span {
    min-height: 36px;
    padding: 0 11px;
    display: flex;
    align-items: center;
    border: 1px solid var(--border);
    border-radius: 11px;
    background: rgba(255,255,255,.68);
    color: var(--text-soft);
    font-size: 11px;
    font-weight: 750;
  }

  .product-section { position: relative; }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(320px, .85fr);
    align-items: end;
    gap: 60px;
  }

  .section-heading .section-title { max-width: 760px; }
  .section-heading .section-copy { margin: 0; }
  .feature-grid { margin-top: 38px; }

  .feature {
    position: relative;
    min-height: 270px;
    padding: 24px;
    overflow: hidden;
    transition: transform .22s ease, border-color .22s ease, box-shadow .22s ease;
  }

  .feature::after {
    content: "";
    position: absolute;
    width: 150px;
    height: 150px;
    right: -65px;
    bottom: -70px;
    border-radius: 50%;
    background: rgba(223,241,218,.45);
    transition: transform .3s ease;
  }

  .feature:hover {
    transform: translateY(-5px);
    border-color: var(--border-strong);
    box-shadow: 0 18px 46px rgba(54,92,51,.07);
  }

  .feature:hover::after { transform: scale(1.14); }

  .feature-top {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .feature-index {
    color: var(--text-soft);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .08em;
  }

  .feature-arrow {
    color: var(--text-soft);
    font-size: 12px;
    transition: transform .2s ease;
  }

  .feature:hover .feature-arrow { transform: translate(2px,-2px); }

  .feature-dot {
    position: relative;
    z-index: 2;
    width: 11px;
    height: 11px;
    margin-top: 34px;
    border-radius: 50%;
    background: var(--primary);
    box-shadow: 0 0 0 7px var(--primary-soft);
  }

  .feature h3 {
    position: relative;
    z-index: 2;
    margin: 24px 0 8px;
    font-size: 18px;
    letter-spacing: -.025em;
  }

  .feature p {
    position: relative;
    z-index: 2;
    margin: 0;
    color: var(--text-soft);
    line-height: 1.68;
    font-size: 14px;
  }

  .open-source-wrap { position: relative; }

  .open-source {
    position: relative;
    overflow: hidden;
    padding: 42px;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(300px, .8fr);
    align-items: end;
    gap: 54px;
    background: linear-gradient(145deg, rgba(255,255,255,.9), rgba(239,248,235,.72));
  }

  .open-source::after {
    content: "";
    position: absolute;
    width: 340px;
    height: 340px;
    right: -90px;
    top: -150px;
    border-radius: 50%;
    background: rgba(159,211,149,.11);
  }

  .open-source-copy,
  .open-source-side {
    position: relative;
    z-index: 2;
  }

  .open-source-copy .section-copy { max-width: 760px; }

  .open-source-side {
    display: grid;
    justify-items: end;
    gap: 18px;
  }

  .open-source-badge {
    width: 100%;
    max-width: 320px;
    padding: 15px 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: rgba(255,255,255,.66);
  }

  .open-source-pulse {
    width: 10px;
    height: 10px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--primary-strong);
    box-shadow: 0 0 0 6px rgba(95,157,89,.1);
  }

  .open-source-badge strong,
  .open-source-badge span { display: block; }

  .open-source-badge strong { font-size: 12px; }

  .open-source-badge div > span {
    margin-top: 3px;
    color: var(--text-soft);
    font-size: 10px;
  }

  @keyframes heroCopyIn {
    from { opacity: 0; transform: translateX(-24px); }
    to { opacity: 1; transform: translateX(0); }
  }

  @keyframes cerebroIn {
