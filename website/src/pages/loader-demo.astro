---
import Layout from '../layouts/Layout.astro';
import EvryluxLogoLoader from '../components/ui/EvryluxLogoLoader.astro';
---

<Layout title="Loader EVRYLUX">
  <main class="demo-shell">
    <EvryluxLogoLoader size="lg" />
  </main>
</Layout>

<style>
  .demo-shell {
    min-height: calc(100vh - 80px);
    display: grid;
    place-items: center;
  }
</style>
