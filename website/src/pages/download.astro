---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Download — EVRYLUX"
  description="Entre na fila para testar as primeiras versões do EVRYLUX."
>
  <main class="download-page">
    <section class="download-hero">
      <div class="container">
        <div class="eyebrow">
          Demo antecipado
        </div>

        <div class="download-heading">
          <div>
            <h1>
              Seja um dos primeiros a experimentar o EVRYLUX.
            </h1>

            <p>
              As primeiras builds ainda estão em preparação. Escolha seu sistema,
              garanta seu lugar na fila e receba prioridade quando a primeira
              versão de demonstração estiver pronta.
            </p>
          </div>

          <div class="early-card">
            <span class="early-mark">
              ✦
            </span>

            <div>
              <strong>
                Pioneiro EVRYLUX
              </strong>

              <p>
                Quem entrar agora fará parte do primeiro grupo de usuários e
                poderá receber benefícios especiais de lançamento por ajudar
                a testar, enviar feedback e reportar bugs.
              </p>

              <div class="early-platforms" aria-label="Plataformas previstas">
                <span class="platform-mini platform-mini-linux" title="Linux">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 3.4c-2 0-3.55 1.72-3.55 4.18 0 1.19.35 2.28.94 3.13-.96.98-1.58 2.36-1.58 3.87 0 2.92 1.84 5.02 4.19 5.02s4.19-2.1 4.19-5.02c0-1.51-.62-2.89-1.58-3.87.59-.85.94-1.94.94-3.13C15.55 5.12 14 3.4 12 3.4Z"/>
                    <circle cx="10.55" cy="7.7" r=".85"/>
                    <circle cx="13.45" cy="7.7" r=".85"/>
                    <path d="M10.2 10.5c.6.55 1.2.82 1.8.82s1.2-.27 1.8-.82" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
                  </svg>
                </span>

                <span class="platform-mini platform-mini-windows" title="Windows">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M3.5 4.3 10.6 3.3v7.8H3.5V4.3Zm8.2-1.15L20.5 2v9.1h-8.8V3.15ZM3.5 12.2h7.1V20l-7.1-1v-6.8Zm8.2 0h8.8V22l-8.8-1.2v-8.6Z"/>
                  </svg>
                </span>

                <span class="platform-mini platform-mini-macos" title="macOS">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M15.9 12.1c.02-2.07 1.69-3.06 1.77-3.11-.97-1.43-2.49-1.63-3.03-1.65-1.27-.14-2.51.76-3.15.76-.65 0-1.63-.75-2.69-.73-1.37.02-2.66.81-3.36 2.05-1.46 2.53-.37 6.25 1.03 8.3.7 1 1.51 2.11 2.57 2.07 1.04-.04 1.43-.66 2.69-.66 1.25 0 1.61.66 2.7.63 1.12-.02 1.82-1 2.49-2.01.81-1.15 1.13-2.29 1.14-2.35-.03-.01-2.14-.83-2.16-3.31ZM13.8 6c.56-.71.94-1.68.84-2.65-.81.04-1.82.56-2.41 1.25-.52.61-.99 1.61-.88 2.55.92.07 1.84-.46 2.45-1.15Z"/>
                  </svg>
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="systems-section">
      <div class="container">
        <div class="systems-grid">
          <button
            class="system-card"
            type="button"
            data-platform="linux"
          >
            <div class="system-top">
              <span class="system-icon system-icon-linux" aria-hidden="true">
                <svg viewBox="0 0 96 96">
                  <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                    <path
                      d="M48 10
                         C35 10 28 20 28 35
                         C28 43 25 49 20 57
                         C15 65 13 74 17 80
                         C20 84 26 84 33 82
                         C38 87 43 89 48 89
                         C53 89 58 87 63 82
                         C70 84 76 84 79 80
                         C83 74 81 65 76 57
                         C71 49 68 43 68 35
                         C68 20 61 10 48 10Z"
                      stroke-width="5"
                    />

                    <path
                      d="M30 56
                         C37 51 42 49 48 49
                         C54 49 59 51 66 56"
                      stroke-width="4"
                    />

                    <path
                      d="M33 80
                         C38 77 43 76 48 76
                         C53 76 58 77 63 80"
                      stroke-width="4"
                    />
                  </g>

                  <ellipse cx="39" cy="33" rx="5.5" ry="8" fill="currentColor"/>
                  <ellipse cx="57" cy="33" rx="5.5" ry="8" fill="currentColor"/>

                  <ellipse cx="39" cy="34" rx="2.2" ry="3.2" fill="var(--surface-solid)"/>
                  <ellipse cx="57" cy="34" rx="2.2" ry="3.2" fill="var(--surface-solid)"/>

                  <path
                    d="M35 45
                       L48 38
                       L61 45
                       L48 54
                       Z"
                    fill="currentColor"
                  />

                  <path
                    d="M24 76
                       C18 79 14 85 17 88
                       C20 91 29 90 37 85
                       Z"
                    fill="currentColor"
                  />

                  <path
                    d="M72 76
                       C78 79 82 85 79 88
                       C76 91 67 90 59 85
                       Z"
                    fill="currentColor"
                  />
                </svg>
              </span>

              <span class="system-status">
                Demo em preparação
              </span>
            </div>

            <div class="system-title-row">
              <h2>Linux</h2>
              <span class="system-tag">Desktop</span>
            </div>

            <p>
              Build para distribuições Linux, com foco inicial em desktop.
            </p>

            <div class="system-action">
              <span>
                Entrar na fila
              </span>

              <span aria-hidden="true">
                →
              </span>
            </div>
          </button>

          <button
            class="system-card"
            type="button"
            data-platform="windows"
          >
            <div class="system-top">
              <span class="system-icon system-icon-windows" aria-hidden="true">
                <svg viewBox="0 0 64 64">
                  <path d="M8 11 29 8v22H8V11Zm24-3.5L56 4v26H32V7.5ZM8 34h21v22L8 53V34Zm24 0h24v26l-24-3.5V34Z"/>
                </svg>
              </span>

              <span class="system-status">
                Demo em preparação
              </span>
            </div>

            <div class="system-title-row">
              <h2>Windows</h2>
              <span class="system-tag">64-bit</span>
            </div>

            <p>
              Build para Windows 64-bit, preparada para uso no desktop.
            </p>

            <div class="system-action">
              <span>
                Entrar na fila
              </span>

              <span aria-hidden="true">
                →
              </span>
            </div>
          </button>

          <button
            class="system-card"
            type="button"
            data-platform="macos"
          >
            <div class="system-top">
              <span class="system-icon system-icon-macos" aria-hidden="true">
                <svg viewBox="0 0 64 64">
                  <path d="M42.8 32.7c.1-5.4 4.4-8 4.6-8.1-2.5-3.7-6.4-4.2-7.9-4.3-3.3-.4-6.5 2-8.2 2-1.7 0-4.2-1.9-7-1.9-3.6.1-6.9 2.1-8.7 5.3-3.8 6.6-1 16.2 2.7 21.5 1.8 2.6 3.9 5.5 6.7 5.4 2.7-.1 3.7-1.7 7-1.7 3.2 0 4.2 1.7 7 1.6 2.9-.1 4.7-2.6 6.5-5.2 2.1-3 2.9-5.9 3-6.1-.1 0-5.6-2.2-5.7-8.5ZM37.5 16.8c1.5-1.8 2.4-4.3 2.2-6.8-2.1.1-4.7 1.4-6.3 3.2-1.4 1.6-2.6 4.2-2.3 6.6 2.4.2 4.8-1.2 6.4-3Z"/>
                </svg>
              </span>

              <span class="system-status">
                Demo em preparação
              </span>
            </div>

            <div class="system-title-row">
              <h2>macOS</h2>
              <span class="system-tag">Desktop</span>
            </div>

            <p>
              Build para macOS, com experiência adaptada ao desktop Apple.
            </p>

            <div class="system-action">
              <span>
                Entrar na fila
              </span>

              <span aria-hidden="true">
                →
              </span>
            </div>
          </button>
        </div>

        <div class="demo-benefits">
          <div>
            <span class="benefit-number">
              01
            </span>

            <strong>
              Prioridade no demo
            </strong>

            <p>
              Os primeiros inscritos formam o grupo inicial de testes.
            </p>
          </div>

          <div>
            <span class="benefit-number">
              02
            </span>

            <strong>
              Pioneiro EVRYLUX
            </strong>

            <p>
              Um reconhecimento para quem ajudou o EVRYLUX desde as primeiras versões.
            </p>
          </div>

          <div>
            <span class="benefit-number">
              03
            </span>

            <strong>
              Ajude a construir
            </strong>

            <p>
              Feedbacks e bugs reportados ajudam a decidir o que precisa melhorar.
            </p>
          </div>
        </div>
      </div>
    </section>

    <div
      id="demo-modal"
      class="demo-modal hidden"
      role="dialog"
      aria-modal="true"
      aria-labelledby="demo-modal-title"
    >
      <button
        id="demo-backdrop"
        class="demo-backdrop"
        type="button"
        aria-label="Fechar formulário"
      ></button>

      <section class="demo-modal-card">
        <div class="demo-modal-head">
          <div>
            <div class="eyebrow">
              Primeiros usuários
            </div>

            <h2 id="demo-modal-title">
              Garanta seu lugar no demo
            </h2>

            <p>
              Leva menos de um minuto.
            </p>
          </div>

          <button
            id="demo-close"
            class="demo-close"
            type="button"
            aria-label="Fechar"
          >
            ×
          </button>
        </div>

        <div class="selected-system">
          <span class="selected-system-dot"></span>

          <span>
            Sistema selecionado:
          </span>

          <strong id="selected-system-label">
            Linux
          </strong>
        </div>

        <form id="demo-form">
          <input
            id="demo-platform"
            type="hidden"
            value="linux"
          />

          <div class="form-grid">
            <label class="field">
              <span>
                Nome completo
              </span>

              <input
                id="demo-name"
                type="text"
                maxlength="120"
                autocomplete="name"
                required
                placeholder="Seu nome"
              />
            </label>

            <label class="field">
              <span>
                E-mail
              </span>

              <input
                id="demo-email"
                type="email"
                maxlength="180"
                autocomplete="email"
                required
                placeholder="voce@email.com"
              />
            </label>
          </div>

          <fieldset class="quick-question">
            <legend>
              O que você mais quer testar?
            </legend>

            <div class="choice-grid">
              <label>
                <input
                  type="radio"
                  name="interest"
                  value="brain"
                />
                <span>Cérebro</span>
              </label>

              <label>
                <input
                  type="radio"
                  name="interest"
                  value="finance"
                />
                <span>Financeiro</span>
              </label>

              <label>
                <input
                  type="radio"
                  name="interest"
                  value="training"
                />
                <span>Treino</span>
              </label>

              <label>
                <input
                  type="radio"
                  name="interest"
                  value="routine"
                />
                <span>Rotina</span>
              </label>

              <label class="choice-wide">
                <input
                  type="radio"
                  name="interest"
                  value="all"
                  checked
                />
                <span>Quero explorar tudo</span>
              </label>
            </div>
          </fieldset>

          <label class="feedback-check">
            <input
              id="demo-feedback"
              type="checkbox"
            />

            <span>
              <strong>
                Posso ajudar com feedback e bugs
              </strong>

              <small>
                Quero contar o que funcionou, o que ficou confuso e reportar
                problemas durante o teste.
              </small>
            </span>
          </label>

          <div class="early-offer">
            <span class="early-offer-mark">
              ★
            </span>

            <div>
              <strong>
                Sua inscrição já entra como Pioneiro EVRYLUX.
              </strong>

              <p>
                O primeiro grupo terá prioridade no acesso e poderá receber
                vantagens especiais de lançamento por participar do
                desenvolvimento junto com a comunidade.
              </p>
            </div>
          </div>

          <p
            id="demo-status"
            class="demo-status"
            role="status"
            aria-live="polite"
          ></p>

          <button
            id="demo-submit"
            class="demo-submit"
            type="submit"
          >
            <span>
              Garantir meu lugar
            </span>

            <span aria-hidden="true">
              →
            </span>
          </button>

          <p class="privacy-note">
            Usaremos seus dados apenas para contato sobre o demo e participação
            nos testes iniciais.
          </p>
        </form>
      </section>
    </div>

    <div
      id="demo-success"
      class="demo-modal hidden"
      role="dialog"
      aria-modal="true"
      aria-labelledby="demo-success-title"
    >
      <button
        id="success-backdrop"
        class="demo-backdrop"
        type="button"
        aria-label="Fechar"
      ></button>

      <section class="success-card">
        <span class="success-icon">
          ✓
        </span>

        <div class="eyebrow">
          Pioneiro EVRYLUX
        </div>

        <h2 id="demo-success-title">
          Seu lugar está reservado.
        </h2>

        <p>
          Você entrou na fila do demo. Quando a primeira versão estiver pronta,
          seu cadastro estará entre os primeiros que vamos considerar para o
          grupo de testes.
        </p>

        <button
          id="success-close"
          type="button"
        >
          Entendi
        </button>
      </section>
    </div>
  </main>
</Layout>

<script>
  import {
    joinDemoWaitlist,
    type DemoInterest,
    type DemoPlatform,
  } from '../lib/demo-waitlist';

  const labels:
    Record<
      DemoPlatform,
      string
    > = {
      linux:
        'Linux',
      windows:
        'Windows',
      macos:
        'macOS',
    };

  const modal =
    document.querySelector<HTMLElement>(
      '#demo-modal',
    );

  const successModal =
    document.querySelector<HTMLElement>(
      '#demo-success',
    );

  const platformInput =
    document.querySelector<HTMLInputElement>(
      '#demo-platform',
    );

  const platformLabel =
    document.querySelector<HTMLElement>(
      '#selected-system-label',
    );

  const form =
    document.querySelector<HTMLFormElement>(
      '#demo-form',
    );

  const nameInput =
    document.querySelector<HTMLInputElement>(
      '#demo-name',
    );

  const emailInput =
    document.querySelector<HTMLInputElement>(
      '#demo-email',
    );

  const feedbackInput =
    document.querySelector<HTMLInputElement>(
      '#demo-feedback',
    );

  const submitButton =
    document.querySelector<HTMLButtonElement>(
      '#demo-submit',
    );

  const status =
    document.querySelector<HTMLElement>(
      '#demo-status',
    );

  function openDemo(
    platform: DemoPlatform,
  ) {
    if (platformInput) {
      platformInput.value =
        platform;
    }

    if (platformLabel) {
      platformLabel.textContent =
        labels[platform];
    }

    modal?.classList.remove(
      'hidden',
    );

    document.body.classList.add(
      'demo-modal-open',
    );

    setTimeout(
      () => {
        nameInput?.focus();
      },
      80,
    );
  }

  function closeDemo() {
    modal?.classList.add(
      'hidden',
    );

    document.body.classList.remove(
      'demo-modal-open',
    );
  }

  function closeSuccess() {
    successModal?.classList.add(
      'hidden',
    );

    document.body.classList.remove(
      'demo-modal-open',
    );
  }

  document
    .querySelectorAll<HTMLButtonElement>(
      '.system-card',
    )
    .forEach(
      (button) => {
        button.addEventListener(
          'click',
          () => {
            const platform =
              button.dataset.platform as
                | DemoPlatform
                | undefined;

            if (platform) {
              openDemo(
                platform,
              );
            }
          },
        );
      },
    );

  document
    .querySelector(
      '#demo-close',
    )
    ?.addEventListener(
      'click',
      closeDemo,
    );

  document
    .querySelector(
      '#demo-backdrop',
    )
    ?.addEventListener(
      'click',
      closeDemo,
    );

  document
    .querySelector(
      '#success-close',
    )
    ?.addEventListener(
      'click',
      closeSuccess,
    );

  document
    .querySelector(
      '#success-backdrop',
    )
    ?.addEventListener(
      'click',
      closeSuccess,
    );

  document.addEventListener(
    'keydown',
    (
      event,
    ) => {
      if (
        event.key ===
        'Escape'
      ) {
        closeDemo();
        closeSuccess();
      }
    },
  );

  form?.addEventListener(
    'submit',
    async (
      event,
    ) => {
      event.preventDefault();

      const fullName =
        nameInput?.value.trim() ??
        '';

      const email =
        emailInput?.value.trim() ??
        '';

      const platform =
        (
          platformInput?.value ??
          'linux'
        ) as DemoPlatform;

      const interest =
        (
          document.querySelector<HTMLInputElement>(
            'input[name="interest"]:checked',
          )?.value ??
          'all'
        ) as DemoInterest;

      if (
        fullName.length <
          2 ||
        !email
      ) {
        if (status) {
          status.textContent =
            'Preencha seu nome e e-mail.';
          status.className =
            'demo-status error';
        }

        return;
      }

      if (submitButton) {
        submitButton.disabled =
          true;

        submitButton.querySelector(
          'span',
        )!.textContent =
          'Reservando...';
      }

      if (status) {
        status.textContent =
          '';
        status.className =
          'demo-status';
      }

      try {
        await joinDemoWaitlist(
          {
            full_name:
              fullName,
            email,
            platform,
            interest,
            willing_to_feedback:
              Boolean(
                feedbackInput?.checked,
              ),
          },
        );

        form.reset();

        closeDemo();

        successModal?.classList.remove(
          'hidden',
        );

        document.body.classList.add(
          'demo-modal-open',
        );
      } catch (error: any) {
        console.error(
          '[EVRYLUX] Falha ao entrar na fila do demo:',
          error,
        );

        if (status) {
          const duplicate =
            String(
              error?.code ??
              '',
            ) ===
            '23505';

          status.textContent =
            duplicate
              ? 'Este e-mail já está na fila do demo.'
              : 'Não foi possível reservar seu lugar agora. Tente novamente.';

          status.className =
            'demo-status error';
        }
      } finally {
        if (submitButton) {
          submitButton.disabled =
            false;

          submitButton.querySelector(
            'span',
          )!.textContent =
            'Garantir meu lugar';
        }
      }
    },
  );
</script>

<style is:global>
  body.demo-modal-open {
    overflow: hidden;
  }

  .hidden {
    display: none !important;
  }
</style>

<style>
  .download-page {
    min-height: 100vh;
    overflow: hidden;
  }

  .download-hero {
    position: relative;
    padding: 104px 0 42px;
    overflow: hidden;
  }

  .download-hero::before {
    content: "";
    position: absolute;
    width: 520px;
    height: 520px;
    right: -180px;
    top: -250px;
    border-radius: 50%;
    background:
      radial-gradient(
        circle,
        rgba(159,211,149,.2),
        rgba(223,241,218,.09) 60%,
        transparent 72%
      );
    pointer-events: none;
  }

  .download-hero::after {
    content: "";
    position: absolute;
    width: 320px;
    height: 320px;
    left: 34%;
    bottom: -260px;
    border-radius: 50%;
    background: rgba(159,211,149,.08);
    pointer-events: none;
  }

  .download-hero > .container {
    position: relative;
    z-index: 2;
  }

  .download-heading {
    margin-top: 22px;
    display: grid;
    grid-template-columns:
      minmax(0, 1.18fr)
      minmax(330px, .82fr);
    align-items: end;
    gap: 62px;
  }

  .download-heading h1 {
    max-width: 860px;
    margin: 0;
    font-size: clamp(46px, 5.7vw, 76px);
    line-height: .96;
    letter-spacing: -.062em;
    text-wrap: balance;
  }

  .download-heading > div:first-child > p {
    max-width: 700px;
    margin: 22px 0 0;
    color: var(--text-soft);
    font-size: 17px;
    line-height: 1.7;
  }

  .early-card {
    position: relative;
    overflow: hidden;
    padding: 20px;
    display: flex;
    align-items: flex-start;
    gap: 14px;
    border: 1px solid rgba(95,157,89,.18);
    border-radius: 22px;
    background:
      linear-gradient(
        145deg,
        rgba(255,255,255,.9),
        rgba(239,248,235,.72)
      );
    box-shadow: 0 18px 48px rgba(54,92,51,.06);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .early-card::after {
    content: "";
    position: absolute;
    width: 180px;
    height: 180px;
    right: -85px;
    top: -100px;
    border-radius: 50%;
    background: rgba(159,211,149,.11);
  }

  .early-card > * {
    position: relative;
    z-index: 2;
  }

  .early-mark {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    border-radius: 13px;
    background: var(--primary-soft);
    color: var(--primary-deep);
    font-size: 15px;
    font-weight: 900;
    box-shadow: inset 0 0 0 1px rgba(95,157,89,.08);
  }

  .early-platforms {
    margin-top: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .platform-mini {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: rgba(255,255,255,.72);
    color: var(--primary-deep);
  }

  .platform-mini svg {
    width: 17px;
    height: 17px;
    fill: currentColor;
  }

  .early-card strong {
    display: block;
    font-size: 13px;
