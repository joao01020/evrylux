---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Colaboradores — EVRYLUX">
  <main class="section contributors-page">
    <div class="container">
      <div class="contributors-heading">
        <div>
          <div class="eyebrow">
            Pessoas do projeto
          </div>

          <h1 class="section-title">
            Colaboradores
          </h1>

          <p class="section-copy intro">
            Conheça as pessoas que ajudam a transformar o EVRYLUX em produto.
            Cada perfil reúne identidade, área de atuação e a participação
            de quem está construindo o projeto.
          </p>
        </div>

        <div class="contributors-source">
          <span class="contributors-source-dot"></span>

          <div>
            <strong>
              Equipe EVRYLUX
            </strong>

            <span>
              Perfis conectados ao projeto
            </span>
          </div>
        </div>
      </div>

      <div
        id="contributors-loading"
        class="contributors-loading"
      >
        <div class="contributors-loading-mark">
          <img
            src="/branding/evrylux-logo.png"
            alt=""
            width="27"
            height="27"
            draggable="false"
          />
        </div>

        <span>
          Carregando colaboradores...
        </span>
      </div>

      <div
        id="contributors-grid"
        class="grid grid-3 contributors member-hidden"
      ></div>

      <div
        id="contributors-empty"
        class="card empty-state member-hidden"
      >
        <div class="empty-icon">
          ✦
        </div>

        <div>
          <h2>
            Nenhum colaborador encontrado
          </h2>

          <p>
            Quando perfis forem adicionados ao EVRYLUX,
            eles aparecerão aqui automaticamente.
          </p>
        </div>
      </div>

      <div
        id="contributors-error"
        class="contributors-error member-hidden"
        role="status"
      ></div>

      <section class="github-info-card">
        <div class="github-info-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path
              d="M8 7 3 12l5 5M16 7l5 5-5 5M14 4l-4 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </div>

        <div class="github-info-content">
          <div class="info-label">
            GitHub
          </div>

          <h2>
            Veja o trabalho por trás de cada perfil.
          </h2>

          <p>
            Quando um colaborador possui GitHub vinculado, você pode abrir
            as contribuições públicas dele no EVRYLUX e acompanhar o trabalho
            técnico relacionado ao projeto.
          </p>

          <div class="github-info-points">
            <span>
              Commits
            </span>

            <span>
              Pull Requests
            </span>

            <span>
              Issues
            </span>
          </div>
        </div>

        <a
          class="github-repository-link"
          href="https://github.com/joao01020/evrylux"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>
            Ver repositório
          </span>

          <span aria-hidden="true">
            ↗
          </span>
        </a>
      </section>
    </div>
  </main>
</Layout>

<script>
  import {
    supabase,
  } from '../lib/supabase';

  type PublicContributor = {
    user_id: string;
    display_name: string | null;
    github_login: string | null;
    bio: string | null;
    avatar_url: string | null;
    area: string | null;
    skills: string | null;
  };

  const loading =
    document.querySelector<HTMLElement>(
      '#contributors-loading',
    );

  const grid =
    document.querySelector<HTMLElement>(
      '#contributors-grid',
    );

  const empty =
    document.querySelector<HTMLElement>(
      '#contributors-empty',
    );

  const errorBox =
    document.querySelector<HTMLElement>(
      '#contributors-error',
    );

  function escapeHtml(
    value: unknown,
  ) {
    return String(
      value ??
      '',
    )
      .replaceAll(
        '&',
        '&amp;',
      )
      .replaceAll(
        '<',
        '&lt;',
      )
      .replaceAll(
        '>',
        '&gt;',
      )
      .replaceAll(
        '"',
        '&quot;',
      )
      .replaceAll(
        "'",
        '&#039;',
      );
  }

  function renderContributor(
    contributor: PublicContributor,
  ) {
    const name =
      contributor.display_name?.trim() ||
      contributor.github_login?.trim() ||
      'Colaborador EVRYLUX';

    const github =
      contributor.github_login?.trim()
        .replace(
          /^@/,
          '',
        ) ||
      '';

    const avatarUrl =
      contributor.avatar_url?.trim() ||
      '';

    const avatar = `
      <div class="avatar-shell">
        ${
          avatarUrl
            ? `
              <img
                class="avatar contributor-avatar"
                src="${escapeHtml(avatarUrl)}"
                alt="Foto de ${escapeHtml(name)}"
                loading="lazy"
                onerror="this.classList.add('member-hidden'); this.nextElementSibling?.classList.remove('member-hidden');"
              />
            `
            : ''
        }

        <div
          class="avatar default-profile-avatar ${avatarUrl ? 'member-hidden' : ''}"
          aria-label="Sem foto de perfil"
        >
          <svg
            viewBox="0 0 96 96"
            aria-hidden="true"
          >
            <circle
              cx="48"
              cy="48"
              r="46"
              class="default-avatar-bg"
            />
            <circle
              cx="48"
              cy="35"
              r="17"
              class="default-avatar-person"
            />
            <path
              d="M18 88c2-22 13-34 30-34s28 12 30 34"
              class="default-avatar-person"
            />
          </svg>
        </div>
      </div>
    `;

    const githubBlock =
      github
        ? `
          <a
            class="github-work-link"
            href="/contributors/${encodeURIComponent(github)}"
            aria-label="Ver contribuições de ${escapeHtml(name)} no GitHub"
          >
            <span class="github-work-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path
                  d="M8 7 3 12l5 5M16 7l5 5-5 5M14 4l-4 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>

            <span class="github-work-copy">
              <strong>
                Contribuições no GitHub
              </strong>

              <small>
                @${escapeHtml(github)}
              </small>
            </span>

            <span class="github-work-arrow" aria-hidden="true">
              →
            </span>
          </a>
        `
        : `
          <div class="github-work-link github-work-disabled">
            <span class="github-work-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <circle
                  cx="12"
                  cy="12"
                  r="8"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                />

                <path
                  d="M8.5 12h7"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                />
              </svg>
            </span>

            <span class="github-work-copy">
              <strong>
                GitHub não vinculado
              </strong>

              <small>
                Este colaborador ainda não informou um usuário.
              </small>
            </span>
          </div>
        `;

    return `
      <article class="card contributor">
        <div class="profile-main">
          <div class="profile-top">
            ${avatar}

            <span class="member-origin">
              Colaborador
            </span>
          </div>

          <div class="content">
            <h2>
              ${escapeHtml(name)}
            </h2>

            ${
              contributor.area?.trim()
                ? `
                  <span class="contributor-area">
                    ${escapeHtml(contributor.area)}
                  </span>
                `
                : ''
            }

            <p class="contributor-bio">
              ${
                escapeHtml(
                  contributor.bio?.trim() ||
                  'Colaborador do projeto EVRYLUX.',
                )
              }
            </p>

            ${
              contributor.skills?.trim()
                ? `
                  <div class="contributor-skills">
                    <span>
                      Habilidades
                    </span>

                    <p>
                      ${escapeHtml(contributor.skills)}
                    </p>
                  </div>
                `
                : ''
            }
          </div>
        </div>

        <div class="card-footer">
          ${githubBlock}
        </div>
      </article>
    `;
  }

  async function loadContributors() {
    try {
      const {
        data,
        error,
      } =
        await supabase.rpc(
          'list_public_contributors',
        );

      if (error) {
        throw error;
      }

      const contributors =
        (
          Array.isArray(data)
            ? data
            : []
        ) as PublicContributor[];

      loading?.classList.add(
        'member-hidden',
      );

      if (
        contributors.length ===
        0
      ) {
        empty?.classList.remove(
          'member-hidden',
        );

        return;
      }

      if (grid) {
        grid.innerHTML =
          contributors
            .map(
              renderContributor,
            )
            .join('');

        grid.classList.remove(
          'member-hidden',
        );
      }
    } catch (
      error: any
    ) {
      console.error(
        '[EVRYLUX] Falha ao carregar colaboradores:',
        error,
      );

      loading?.classList.add(
        'member-hidden',
      );

      if (
        errorBox
      ) {
        errorBox.textContent =
          error?.message ||
          'Não foi possível carregar os colaboradores.';

        errorBox.classList.remove(
          'member-hidden',
        );
      }
    }
  }

  void loadContributors();
</script>

<style is:global>
  .member-hidden {
    display: none !important;
  }

  .contributors-page {
    padding-top: 86px;
    padding-bottom: 96px;
  }

  .contributors-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 30px;
  }

  .intro {
    max-width: 760px;
    margin-top: 18px;
    margin-bottom: 0;
  }

  .contributors-source {
    flex: 0 0 auto;
    min-width: 230px;
    padding: 13px 15px;
    display: flex;
    align-items: center;
    gap: 10px;
    border: 1px solid rgba(65,104,62,.10);
    border-radius: 14px;
    background: rgba(255,255,255,.68);
  }

  .contributors-source-dot {
    width: 9px;
    height: 9px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--primary-strong);
    box-shadow:
      0 0 0 5px
      rgba(95,157,89,.10);
  }

  .contributors-source strong,
  .contributors-source span {
    display: block;
  }

  .contributors-source strong {
    font-size: 10px;
  }

  .contributors-source span {
    margin-top: 3px;
    color: var(--text-soft);
    font-size: 8px;
  }

  .contributors-loading {
    min-height: 240px;
    margin-top: 40px;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 12px;
    border: 1px solid rgba(65,104,62,.08);
    border-radius: 20px;
    background: rgba(255,255,255,.45);
    color: var(--text-soft);
    font-size: 10px;
  }

  .contributors-loading-mark {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(65,104,62,.09);
    border-radius: 15px;
    background: rgba(239,248,235,.82);
  }

  .contributors-loading-mark img {
    width: 27px;
    height: 27px;
    object-fit: contain;
  }

  .contributors {
    margin-top: 40px;
    align-items: stretch;
  }

  .contributor {
    min-height: 390px;
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition:
      transform .2s ease,
      border-color .2s ease,
      box-shadow .2s ease;
  }

  .contributor:hover {
    transform: translateY(-4px);
    border-color: var(--border-strong);
    box-shadow:
      0 22px 65px
      rgba(54,92,51,.11);
  }

  .profile-main {
    flex: 1;
    padding: 28px;
  }

  .profile-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .avatar-shell {
    width: 68px;
    height: 68px;
    flex: 0 0 auto;
    position: relative;
  }

  .avatar {
    width: 68px;
    height: 68px;
    display: block;
    object-fit: cover;
    border-radius: 50%;
    border: 1px solid rgba(65,104,62,.10);
    box-shadow:
      0 10px 28px
      rgba(54,92,51,.08);
    background: #fff;
  }

  .contributor-avatar {
    background: #f7faf6;
  }

  .default-profile-avatar {
    padding: 0;
    overflow: hidden;
    background: transparent;
  }

  .default-profile-avatar svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .default-profile-avatar .default-avatar-bg {
    fill: #a9abad;
  }

  .default-profile-avatar .default-avatar-person {
    fill: #eef6f3;
  }

  .member-origin {
    min-height: 25px;
    padding: 0 9px;
    display: inline-flex;
    align-items: center;
    border: 1px solid rgba(95,157,89,.12);
    border-radius: 999px;
    background: rgba(239,248,235,.65);
    color: var(--primary-deep);
    font-size: 8px;
    font-weight: 850;
    letter-spacing: .06em;
  }

  .content {
    margin-top: 20px;
  }

  .content h2 {
    margin: 0;
    font-size: 20px;
    line-height: 1.25;
    letter-spacing: -.025em;
    overflow-wrap: anywhere;
  }

  .contributor-area {
    min-height: 27px;
    margin-top: 10px;
    padding: 0 9px;
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    background: var(--surface-muted);
    color: var(--text-soft);
    font-size: 9px;
    font-weight: 750;
  }

  .contributor-bio {
    margin: 14px 0 0;
    color: var(--text-soft);
    font-size: 12px;
    line-height: 1.7;
  }

  .contributor-skills {
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid rgba(65,104,62,.07);
  }

  .contributor-skills span {
    color: var(--text-soft);
    font-size: 8px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .07em;
  }

  .contributor-skills p {
    margin: 5px 0 0;
    color: var(--text);
    font-size: 10px;
    line-height: 1.55;
  }

  .card-footer {
    padding: 14px;
    border-top:
      1px solid
      rgba(65,104,62,.09);
    background:
      rgba(255,255,255,.45);
  }

  .github-work-link {
    width: 100%;
    min-height: 56px;
    padding: 10px 11px;
    display: grid;
    grid-template-columns:
      34px
      minmax(0,1fr)
      auto;
    align-items: center;
    gap: 10px;
    border: 1px solid rgba(65,104,62,.09);
    border-radius: 12px;
    background: rgba(247,251,244,.72);
    color: var(--text);
    transition:
      transform .18s ease,
      border-color .18s ease,
      background .18s ease;
  }

  .github-work-link:not(.github-work-disabled):hover {
    transform: translateX(2px);
    border-color: rgba(95,157,89,.20);
    background: #fff;
  }

  .github-work-icon {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: var(--primary-soft);
    color: var(--primary-deep);
  }

  .github-work-icon svg {
    width: 18px;
    height: 18px;
  }

  .github-work-copy {
    min-width: 0;
  }

  .github-work-copy strong,
  .github-work-copy small {
    display: block;
  }

  .github-work-copy strong {
    font-size: 10px;
  }

  .github-work-copy small {
    margin-top: 3px;
    overflow: hidden;
    color: var(--text-soft);
    font-size: 8px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .github-work-arrow {
    color: var(--primary-deep);
    font-size: 14px;
  }

  .github-work-disabled {
    cursor: default;
    opacity: .68;
  }

  .empty-state {
    margin-top: 40px;
    padding: 30px;
    display: flex;
    align-items: flex-start;
    gap: 18px;
  }

  .empty-icon {
    width: 48px;
    height: 48px;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    border-radius: 16px;
    background: var(--primary-soft);
    color: var(--primary-deep);
    font-weight: 850;
  }

  .empty-state h2 {
    margin: 0;
  }

  .empty-state p {
    margin: 8px 0 0;
    color: var(--text-soft);
    line-height: 1.7;
  }

  .contributors-error {
    margin-top: 40px;
    padding: 15px 17px;
    border: 1px solid rgba(162,69,55,.15);
    border-radius: 14px;
    background: #fff0ed;
    color: #923f32;
    font-size: 11px;
  }



  .info-label {
    margin-bottom: 10px;
    color: var(--primary-deep);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .05em;
    text-transform: uppercase;
  }





  @media (max-width: 900px) {
    .contributors-heading {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 760px) {
    .contributors-page {
      padding-top: 64px;
      padding-bottom: 80px;
    }

    .profile-main {
      padding: 22px;
    }

    .contribution-info {
      align-items: flex-start;
      flex-direction: column;
      padding: 28px;
    }

    .repository-button {
      width: 100%;
    }
  }

  @media (max-width: 520px) {
    .empty-state {
      flex-direction: column;
    }

    .contributors-source {
      width: 100%;
    }
  }


  /* ==========================================================
     CONTRIBUTORS — VISUAL REFINEMENT
     ========================================================== */

  .contributors-heading {
    padding: 8px 0 6px;
  }

  .contributors-heading .section-title {
    max-width: 760px;
    letter-spacing: -.045em;
  }

  .intro {
    max-width: 720px;
    font-size: 16px;
    line-height: 1.75;
    text-wrap: pretty;
  }

  .contributors-source {
    min-width: 245px;
    padding: 14px 16px;
    border-radius: 16px;
    background:
      linear-gradient(
        145deg,
        rgba(255,255,255,.88),
        rgba(239,248,235,.72)
      );
    box-shadow:
      0 14px 34px
      rgba(54,92,51,.045);
  }

  .contributors {
    gap: 18px;
  }

  .contributor {
    min-height: 365px;
    border-radius: 22px;
    background:
      linear-gradient(
        145deg,
        rgba(255,255,255,.92),
        rgba(247,251,244,.78)
      );
  }

  .profile-main {
    padding: 25px;
  }


  .member-origin {
    min-height: 27px;
    padding-inline: 10px;
    background: rgba(239,248,235,.82);
  }

  .content h2 {
    font-size: 21px;
  }

  .contributor-area {
    margin-top: 9px;
    background: rgba(23,32,25,.045);
  }

  .contributor-bio {
    max-width: 94%;
    margin-top: 13px;
    font-size: 11px;
    line-height: 1.65;
  }

  .contributor-skills {
    margin-top: 16px;
  }

  .card-footer {
    padding: 12px 14px 14px;
    background: rgba(255,255,255,.62);
  }

  .github-work-link {
    min-height: 58px;
    border-radius: 13px;
    background:
      linear-gradient(
        145deg,
        rgba(250,252,248,.94),
        rgba(239,248,235,.68)
      );
  }

  .github-work-icon {
    border-radius: 11px;
  }

  .github-info-card {
    margin-top: 46px;
    padding: 28px 30px;
    display: grid;
    grid-template-columns:
      54px
      minmax(0,1fr)
      auto;
    align-items: center;
    gap: 20px;
    border: 1px solid rgba(65,104,62,.10);
    border-radius: 22px;
    background:
      radial-gradient(
        circle at 92% 12%,
        rgba(223,241,218,.62),
        transparent 30%
      ),
      linear-gradient(
        145deg,
        rgba(255,255,255,.95),
        rgba(247,251,244,.88)
      );
    box-shadow:
      0 18px 55px
      rgba(54,92,51,.055);
  }

  .github-info-icon {
    width: 54px;
    height: 54px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(95,157,89,.14);
    border-radius: 16px;
    background: var(--primary-soft);
    color: var(--primary-deep);
  }

  .github-info-icon svg {
    width: 25px;
    height: 25px;
  }

  .github-info-content {
    min-width: 0;
    max-width: 760px;
  }

  .github-info-content h2 {
    margin: 4px 0 0;
    font-size: 22px;
    line-height: 1.2;
    letter-spacing: -.03em;
  }

  .github-info-content p {
    margin: 10px 0 0;
    color: var(--text-soft);
    font-size: 11px;
    line-height: 1.7;
  }

  .github-info-points {
    margin-top: 13px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .github-info-points span {
    min-height: 25px;
    padding: 0 9px;
    display: inline-flex;
    align-items: center;
    border: 1px solid rgba(65,104,62,.08);
    border-radius: 999px;
    background: rgba(255,255,255,.72);
    color: var(--text-soft);
    font-size: 8px;
    font-weight: 780;
  }

  .github-repository-link {
    min-height: 42px;
    padding: 0 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1px solid rgba(65,104,62,.13);
    border-radius: 12px;
    background: #fff;
    color: var(--text);
    font-size: 10px;
    font-weight: 800;
    white-space: nowrap;
    transition:
      transform .18s ease,
      border-color .18s ease,
      box-shadow .18s ease;
  }

  .github-repository-link:hover {
    transform: translateY(-1px);
