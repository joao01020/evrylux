---
import Layout from '../layouts/Layout.astro';

const permissions = [
  {
    icon: '✓',
    title: 'Usar',
    copy: 'Você pode usar o EVRYLUX para fins pessoais, educacionais e comerciais.',
  },
  {
    icon: '✓',
    title: 'Estudar',
    copy: 'O código-fonte pode ser estudado, analisado e usado como referência.',
  },
  {
    icon: '✓',
    title: 'Modificar',
    copy: 'Você pode criar suas próprias alterações e adaptações do projeto.',
  },
  {
    icon: '✓',
    title: 'Redistribuir',
    copy: 'Você pode compartilhar cópias do EVRYLUX seguindo os termos da licença.',
  },
  {
    icon: '✓',
    title: 'Uso comercial',
    copy: 'A AGPL-3.0 permite que o software seja usado também em contextos comerciais.',
  },
];

const responsibilities = [
  {
    number: '01',
    title: 'Manter a mesma licença',
    copy: 'Versões derivadas distribuídas devem permanecer sob os termos compatíveis da AGPL-3.0.',
  },
  {
    number: '02',
    title: 'Disponibilizar o código-fonte',
    copy: 'Quando uma versão modificada é disponibilizada a usuários, inclusive por uma rede, o código-fonte correspondente deve ser oferecido conforme os termos da AGPL-3.0.',
  },
  {
    number: '03',
    title: 'Preservar avisos',
    copy: 'Avisos de copyright, licença e demais informações exigidas pela licença devem ser preservados.',
  },
  {
    number: '04',
    title: 'Informar modificações',
    copy: 'Alterações realizadas no software devem ser identificadas de acordo com os requisitos da licença.',
  },
];
---

<Layout
  title="Licença — EVRYLUX"
  description="O EVRYLUX é software open source distribuído sob a GNU Affero General Public License v3.0."
>
  <main class="license-page">
    <section class="license-hero">
      <div class="license-glow" aria-hidden="true"></div>

      <div class="container">
        <div class="license-hero-content">
          <div class="eyebrow">
            Projeto open source
          </div>

          <h1>
            Código aberto.
            <span>Conhecimento compartilhado.</span>
          </h1>

          <p class="license-intro">
            O EVRYLUX é distribuído sob a{' '}
            <strong>
              GNU Affero General Public License v3.0
            </strong>
            , também conhecida como{' '}
            <strong>AGPL-3.0</strong>.
          </p>

          <div class="license-badge-row">
            <div class="license-badge">
              <span class="license-badge-dot"></span>

              <div>
                <strong>AGPL-3.0</strong>
                <span>GNU Affero General Public License</span>
              </div>
            </div>

            <a
              class="button button-primary"
              href="https://github.com/joao01020/evrylux/blob/dev-stable/LICENSE"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>Ver LICENSE no GitHub</span>
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="license-section">
      <div class="container">
        <div class="section-heading">
          <div>
            <div class="eyebrow">
              Liberdades
            </div>

            <h2>
              O que você pode fazer.
            </h2>
          </div>

          <p>
            A AGPL-3.0 permite que o EVRYLUX seja usado,
            estudado, modificado e compartilhado, inclusive
            em contextos comerciais.
          </p>
        </div>

        <div class="permissions-grid">
          {
            permissions.map((item) => (
              <article class="permission-card">
                <span class="permission-icon">
                  {item.icon}
                </span>

                <h3>
                  {item.title}
                </h3>

                <p>
                  {item.copy}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="license-section license-section-soft">
      <div class="container">
        <div class="section-heading">
          <div>
            <div class="eyebrow">
              Responsabilidades
            </div>

            <h2>
              O código continua aberto.
            </h2>
          </div>

          <p>
            A liberdade oferecida pela licença também envolve
            responsabilidades quando o projeto é modificado,
            redistribuído ou disponibilizado para outras pessoas.
          </p>
        </div>

        <div class="responsibilities-list">
          {
            responsibilities.map((item) => (
              <article class="responsibility">
                <span class="responsibility-number">
                  {item.number}
                </span>

                <div>
                  <h3>
                    {item.title}
                  </h3>

                  <p>
                    {item.copy}
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="license-section">
      <div class="container">
        <article class="network-card">
          <div class="network-card-copy">
            <div class="eyebrow">
              Software em rede
            </div>

            <h2>
              A diferença da AGPL.
            </h2>

            <p>
              A AGPL foi criada para tratar também do uso de
              software através de uma rede.
            </p>

            <p>
              Se alguém modificar uma versão coberta pela AGPL
              e permitir que outras pessoas interajam com essa
              versão através de uma rede, a licença estabelece
              obrigações relacionadas à disponibilização do
              código-fonte correspondente.
            </p>
          </div>

          <div class="network-flow" aria-hidden="true">
            <div class="network-node">
              Código
            </div>

            <span>→</span>

            <div class="network-node">
              Modificação
            </div>

            <span>→</span>

            <div class="network-node network-node-active">
              Serviço online
            </div>

            <span>→</span>

            <div class="network-node">
              Código acessível
            </div>
          </div>
        </article>
      </div>
    </section>

    <section class="license-section">
      <div class="container">
        <article class="brand-card">
          <div>
            <div class="eyebrow">
              Código e identidade
            </div>

            <h2>
              A licença do código não é a licença da marca.
            </h2>

            <p>
              A AGPL-3.0 regula os direitos relacionados ao
              software e ao código-fonte.
            </p>

            <p>
              O nome, identidade visual, logotipos e demais
              elementos associados à marca EVRYLUX são questões
              distintas da licença do software.
            </p>
          </div>

          <div class="brand-mark">
            <div class="brand-logo-wrap">
              <img
                class="brand-logo-image"
                src="/branding/evrylux-logo.png"
                alt="Logo EVRYLUX"
                draggable="false"
              />
            </div>

            <strong>
              EVRYLUX
            </strong>

            <small>
              Projeto oficial
            </small>
          </div>
        </article>
      </div>
    </section>

    <section class="license-section license-final-section">
      <div class="container">
        <article class="license-final-card">
          <div>
            <div class="eyebrow">
              Licença oficial
            </div>

            <h2>
              GNU Affero General Public License v3.0
            </h2>

            <p>
              Esta página é apenas um resumo para facilitar a
              compreensão. Em caso de diferença de interpretação,
              o texto completo da AGPL-3.0 e o arquivo
              <code>LICENSE</code> do repositório são a referência.
            </p>

            <div class="license-links">
              <a
                class="button button-primary"
                href="https://github.com/joao01020/evrylux/blob/dev-stable/LICENSE"
                target="_blank"
                rel="noopener noreferrer"
              >
                LICENSE no GitHub
                <span aria-hidden="true">↗</span>
              </a>

              <a
                class="button button-secondary"
                href="https://www.gnu.org/licenses/agpl-3.0.html"
                target="_blank"
                rel="noopener noreferrer"
              >
                Texto oficial da GNU
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>

          <div class="license-code">
            <span>
              SPDX
            </span>

            <strong>
              AGPL-3.0-only
            </strong>
          </div>
        </article>

        <p class="license-copyright">
          © 2026 EVRYLUX contributors.
          Software distribuído sob a GNU Affero General Public License v3.0.
        </p>
      </div>
    </section>
  </main>
</Layout>

<style>
  .license-page {
    overflow: hidden;
  }

  .license-hero {
    position: relative;
    padding: 108px 0 92px;
    overflow: hidden;
    background:
      radial-gradient(
        circle at 85% 15%,
        rgba(159, 211, 149, 0.18),
        transparent 34%
      ),
      linear-gradient(
        180deg,
        #f9fcf7 0%,
        var(--bg) 100%
      );
  }

  .license-glow {
    position: absolute;
    width: 420px;
    height: 420px;
    right: -150px;
    top: -180px;
    border-radius: 50%;
    background:
      rgba(159, 211, 149, 0.13);
    pointer-events: none;
  }

  .license-hero-content {
    position: relative;
    z-index: 1;
    max-width: 900px;
  }

  .license-hero h1 {
    max-width: 900px;
    margin:
      20px
      0
      0;
    font-size:
      clamp(
        50px,
        7vw,
        82px
      );
    line-height: 0.98;
    letter-spacing: -0.06em;
  }

  .license-hero h1 span {
    display: block;
    color:
      var(--primary-deep);
  }

  .license-intro {
    max-width: 710px;
    margin:
      28px
      0
      0;
    color:
      var(--text-soft);
    font-size: 18px;
    line-height: 1.75;
  }

  .license-intro strong {
    color:
      var(--text);
  }

  .license-badge-row {
    margin-top: 34px;
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .license-badge {
    min-height: 54px;
    padding:
      10px
      16px;
    display: flex;
    align-items: center;
    gap: 12px;
    border:
      1px solid
      var(--border);
    border-radius: 15px;
    background:
      rgba(
        255,
        255,
        255,
        0.76
      );
    backdrop-filter:
      blur(14px);
    -webkit-backdrop-filter:
      blur(14px);
  }

  .license-badge-dot {
    width: 10px;
    height: 10px;
    flex: 0 0 auto;
    border-radius: 50%;
    background:
      var(--primary-strong);
    box-shadow:
      0 0 0 6px
      rgba(
        95,
        157,
        89,
        0.1
      );
  }

  .license-badge strong,
  .license-badge span {
    display: block;
  }

  .license-badge strong {
    font-size: 13px;
  }

  .license-badge div > span {
    margin-top: 3px;
    color:
      var(--text-soft);
    font-size: 10px;
  }

  .license-section {
    padding:
      82px
      0;
  }

  .license-section-soft {
    background:
      rgba(
        238,
        247,
        233,
        0.5
      );
    border-top:
      1px solid
      rgba(
        65,
        104,
        62,
        0.06
      );
    border-bottom:
      1px solid
      rgba(
        65,
        104,
        62,
        0.06
      );
  }

  .section-heading {
    display: grid;
    grid-template-columns:
      minmax(0, 1.1fr)
      minmax(280px, 0.9fr);
    align-items: end;
    gap: 60px;
  }

  .section-heading h2 {
    max-width: 720px;
    margin:
      12px
      0
      0;
    font-size:
      clamp(
        32px,
        4vw,
        48px
      );
    line-height: 1.06;
    letter-spacing:
      -0.045em;
  }

  .section-heading > p {
    margin: 0;
    color:
      var(--text-soft);
    line-height: 1.75;
    font-size: 15px;
  }

  .permissions-grid {
    margin-top: 38px;
    display: grid;
    grid-template-columns:
      repeat(
        5,
        minmax(
          0,
          1fr
        )
      );
    gap: 12px;
  }

  .permission-card {
    min-height: 220px;
    padding: 22px;
    border:
      1px solid
      var(--border);
    border-radius: 20px;
    background:
      rgba(
        255,
        255,
        255,
        0.78
      );
    box-shadow:
      0 12px 34px
      rgba(
        54,
        92,
        51,
        0.035
      );
  }

  .permission-icon {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 11px;
    background:
      var(--primary-soft);
    color:
      var(--primary-deep);
    font-size: 13px;
    font-weight: 900;
  }

  .permission-card h3 {
    margin:
      28px
      0
      8px;
    font-size: 17px;
    letter-spacing:
      -0.02em;
  }

  .permission-card p {
    margin: 0;
    color:
      var(--text-soft);
    font-size: 13px;
    line-height: 1.68;
  }

  .responsibilities-list {
    margin-top: 38px;
    display: grid;
    border-top:
      1px solid
      var(--border);
  }

  .responsibility {
    padding:
      24px
      0;
    display: grid;
    grid-template-columns:
      70px
      1fr;
    gap: 22px;
    border-bottom:
      1px solid
      var(--border);
  }

  .responsibility-number {
    color:
      var(--primary-strong);
    font-size: 11px;
    font-weight: 850;
    letter-spacing:
      0.08em;
  }

  .responsibility h3 {
    margin: 0;
    font-size: 18px;
  }

  .responsibility p {
    max-width: 800px;
    margin:
      7px
      0
      0;
    color:
      var(--text-soft);
    line-height: 1.7;
    font-size: 14px;
  }

  .network-card,
  .brand-card,
  .license-final-card {
    position: relative;
    overflow: hidden;
    padding: 38px;
    border:
      1px solid
      var(--border);
    border-radius: 26px;
    background:
      linear-gradient(
        145deg,
        rgba(
          255,
          255,
          255,
          0.92
        ),
        rgba(
          239,
          248,
          235,
          0.74
        )
      );
    box-shadow:
      0 18px 54px
      rgba(
        54,
        92,
        51,
        0.05
      );
  }

  .network-card {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      minmax(420px, 0.9fr);
    align-items: center;
    gap: 52px;
  }

  .network-card-copy h2,
  .brand-card h2,
  .license-final-card h2 {
    margin:
      12px
      0
      0;
    font-size:
      clamp(
        30px,
        4vw,
        44px
      );
    line-height: 1.07;
    letter-spacing:
      -0.04em;
  }

  .network-card-copy p,
  .brand-card p,
  .license-final-card p {
    max-width: 720px;
    margin:
      14px
      0
      0;
    color:
      var(--text-soft);
    line-height: 1.72;
    font-size: 14px;
  }

  .network-flow {
    display: grid;
    grid-template-columns:
      1fr
      auto
      1fr;
    align-items: center;
    gap: 9px;
  }

  .network-flow > span {
    color:
      var(--text-soft);
    font-size: 12px;
  }

  .network-node {
    min-height: 56px;
    padding:
      0
      13px;
    display: flex;
    align-items: center;
    justify-content: center;
    border:
      1px solid
      var(--border);
    border-radius: 14px;
    background:
      rgba(
        255,
        255,
        255,
        0.7
      );
    color:
      var(--text-soft);
    text-align: center;
    font-size: 11px;
    font-weight: 750;
  }

  .network-node-active {
    border-color:
      rgba(
        95,
        157,
        89,
        0.25
      );
    background:
      var(--primary-soft);
    color:
      var(--primary-deep);
  }

  .brand-card {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      260px;
    align-items: center;
    gap: 50px;
  }

  .brand-mark {
    min-height: 220px;
    display: grid;
    place-items: center;
    align-content: center;
    border:
      1px solid
      var(--border);
    border-radius: 22px;
    background:
      rgba(
        255,
        255,
        255,
        0.62
      );
  }

  .brand-logo-wrap {
    width: 76px;
    height: 76px;
    display: grid;
    place-items: center;
    overflow: hidden;
    border: 1px solid rgba(65, 104, 62, 0.1);
    border-radius: 22px;
    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.98),
        rgba(223, 241, 218, 0.72)
      );
    box-shadow:
      0 10px 28px
      rgba(54, 92, 51, 0.07);
  }

  .brand-logo-image {
    width: 52px;
    height: 52px;
    display: block;
    object-fit: contain;
  }

  .brand-mark strong {
    margin-top: 14px;
    font-size: 16px;
    letter-spacing:
      0.04em;
  }

  .brand-mark small {
    margin-top: 5px;
    color:
      var(--text-soft);
  }

  .license-final-section {
    padding-top: 40px;
  }

  .license-final-card {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      auto;
    align-items: center;
    gap: 44px;
  }

  .license-links {
    margin-top: 24px;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .license-links .button {
    min-height: 46px;
    padding:
      0
      16px;
    gap: 9px;
    border-radius: 13px;
  }

  .license-code {
    min-width: 180px;
    padding: 22px;
    border:
      1px solid
      var(--border);
    border-radius: 18px;
    background:
      rgba(
        255,
        255,
        255,
        0.68
      );
  }

  .license-code span,
  .license-code strong {
    display: block;
  }

  .license-code span {
    color:
      var(--text-soft);
    font-size: 9px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing:
      0.1em;
  }

  .license-code strong {
    margin-top: 8px;
    font-size: 14px;
  }

  .license-final-card code {
    padding:
      2px
      6px;
    border-radius: 6px;
    background:
      var(--surface-muted);
    color:
      var(--text);
    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;
    font-size: 12px;
  }

  .license-copyright {
    margin:
      22px
      0
      0;
    color:
      var(--text-soft);
    font-size: 11px;
    text-align: center;
  }

  @media (
    max-width: 1080px
  ) {
    .permissions-grid {
      grid-template-columns:
        repeat(
          3,
          minmax(
            0,
            1fr
          )
        );
    }

    .network-card {
      grid-template-columns:
        1fr;
    }
  }

  @media (
    max-width: 820px
  ) {
    .section-heading,
    .brand-card,
    .license-final-card {
      grid-template-columns:
        1fr;
    }

    .section-heading {
      align-items: start;
      gap: 20px;
    }

    .brand-mark {
      max-width: 320px;
    }

    .license-code {
      width: max-content;
    }
  }

  @media (
    max-width: 680px
  ) {
    .license-hero {
      padding:
        72px
        0
        66px;
    }

    .license-section {
      padding:
        62px
        0;
    }

    .permissions-grid {
      grid-template-columns:
        1fr;
    }

    .permission-card {
      min-height: auto;
    }

    .network-card,
    .brand-card,
    .license-final-card {
      padding: 25px;
    }

    .network-flow {
      grid-template-columns:
        1fr;
    }

    .network-flow > span {
      transform:
        rotate(
          90deg
        );
      text-align: center;
    }

    .responsibility {
      grid-template-columns:
        44px
        1fr;
    }
  }
</style>


<style>
  /* ==========================================================
     LICENÇA — AJUSTES DE ESPAÇAMENTO E LOGO
     ========================================================== */

  .license-intro strong {
    margin-inline: 0.12em;
  }

  .license-intro strong:first-of-type {
    margin-left: 0;
  }

  .brand-card > div:first-child {
    min-width: 0;
  }

  .brand-card p + p {
    margin-top: 14px;
  }

  .brand-mark {
    padding: 24px 18px;
  }

  .brand-mark strong {
    margin-top: 16px;
  }

  .brand-mark small {
    margin-top: 6px;
  }

  .license-final-card p {
    text-wrap: pretty;
  }

  .license-final-card code {
    margin-inline: 0.18em;
  }

  @media (max-width: 820px) {
    .brand-mark {
      width: 100%;
      max-width: 320px;
      justify-self: start;
    }
  }
</style>

